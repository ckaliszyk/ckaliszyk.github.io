            (unit_interval_left_half_sub t Ht)
            (HepsuFun
              (mul_SNo 2 t)
              H2tInI)).
        - assume Hright.
          apply (ReplE_impred
            unit_interval_right_half
            (fun t:set => (t, apply_fun (Eps_i (fun g:set => g :e v)) (add_SNo (mul_SNo 2 t) (minus_SNo 1))))
            p
            Hright).
