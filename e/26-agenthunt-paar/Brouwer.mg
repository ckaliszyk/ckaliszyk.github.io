    {
      exact (andEL
        (gv :e loop_space X Tx x0)
        (v = path_homotopy_class_loop X Tx x0 gv)
        HvPack).
    }
    claim HvEq : v = path_homotopy_class_loop X Tx x0 gv.
    {
      exact (andER
        (gv :e loop_space X Tx x0)
