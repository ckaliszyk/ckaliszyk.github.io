Definition sigma_locally_finite_family : set -> set -> set -> prop := fun X Tx F => topology_on X Tx /\ exists Fams : set , countable_set Fams /\ Fams c= Power (Power X) /\ (forall G : set , G :e Fams -> locally_finite_family X Tx G) /\ F = Union Fams.
