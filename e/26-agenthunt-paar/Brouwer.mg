    claim Hf1SNo : SNo (apply_fun f x 1).
    {
      exact (real_SNo
        (apply_fun f x 1)
        Hf1R).
    }
    claim Hf0Linear :
      apply_fun f x 0 = add_SNo (mul_SNo a (x 0)) (x 0).
    {
      claim HlhsEq :
        add_SNo (add_SNo (apply_fun f x 0) (minus_SNo (x 0))) (x 0)
        =
        add_SNo (mul_SNo a (x 0)) (x 0).
      {
        rewrite HcoordEq0.
        reflexivity.
      }
      claim HlhsSimpl :
        add_SNo (add_SNo (apply_fun f x 0) (minus_SNo (x 0))) (x 0)
        = apply_fun f x 0.
      {
        exact (add_SNo_minus_R2'
          (apply_fun f x 0)
          (x 0)
          Hf0SNo
          Hx0SNo).
      }
      rewrite <- HlhsSimpl.
      exact HlhsEq.
    }
    claim Hf1Linear :
      apply_fun f x 1 = add_SNo (mul_SNo a (x 1)) (x 1).
    {
      claim HlhsEq :
        add_SNo (add_SNo (apply_fun f x 1) (minus_SNo (x 1))) (x 1)
        =
        add_SNo (mul_SNo a (x 1)) (x 1).
      {
        rewrite HcoordEq1.
        reflexivity.
      }
      claim HlhsSimpl :
        add_SNo (add_SNo (apply_fun f x 1) (minus_SNo (x 1))) (x 1)
        = apply_fun f x 1.
      {
        exact (add_SNo_minus_R2'
          (apply_fun f x 1)
          (x 1)
          Hf1SNo
          Hx1SNo).
      }
      rewrite <- HlhsSimpl.
      exact HlhsEq.
    }
    claim HfLinear :
      apply_fun f x
      =
      (add_SNo (mul_SNo a (x 0)) (x 0),
       add_SNo (mul_SNo a (x 1)) (x 1)).
    {
      rewrite HfxEta.
      exact (tuple_2_ext
        (apply_fun f x 0)
        (apply_fun f x 1)
        (add_SNo (mul_SNo a (x 0)) (x 0))
        (add_SNo (mul_SNo a (x 1)) (x 1))
        Hf0Linear
        Hf1Linear).
    }
    claim HxEq1 :
      add_SNo (mul_SNo (x 0) (x 0))
        (mul_SNo (x 1) (x 1)) = 1.
    {
      exact (SepE2
        (setprod R R)
        (fun p:set =>
          add_SNo (mul_SNo (p 0) (p 0))
            (mul_SNo (p 1) (p 1)) = 1)
        x
        HxS1).
    }
    claim HaS : SNo a.
    {
      exact (real_SNo
        a
        HaR).
    }
    set c := add_SNo a 1.
    claim HcR : c :e R.
    {
      exact (real_add_SNo
        a
        HaR
        1
        real_1).
    }
    claim HcS : SNo c.
    {
      exact (real_SNo
        c
        HcR).
    }
    claim HoneLtC :
      1 < c.
    {
      claim HrawLt :
        add_SNo 0 1 < c.
      {
        exact (add_SNo_Lt1
          0
          1
          a
          SNo_0
          SNo_1
          HaS
          (RltE_lt
            0
            a
            HaPos)).
      }
      claim H0Eq1 :
        add_SNo 0 1 = 1.
      {
        exact (add_SNo_0L
          1
          SNo_1).
      }
      exact (H0Eq1
        (fun u v:set => u < c)
        HrawLt).
    }
    claim HoneNonneg : 0 <= 1.
    {
      exact (SNoLtLe
        0
        1
        SNoLt_0_1).
    }
    claim HcNonneg : 0 <= c.
    {
      exact (SNoLtLe
        0
        c
        (SNoLt_tra
          0
          1
          c
          SNo_0
          SNo_1
          HcS
          SNoLt_0_1
          HoneLtC)).
    }
    claim HcSqGt1 :
      mul_SNo 1 1 < mul_SNo c c.
    {
      exact (SNoLt_sqr_nonneg
        1
        c
        SNo_1
        HcS
        HoneNonneg
        HcNonneg
        HoneLtC).
    }
    claim HcSqR : mul_SNo c c :e R.
    {
      exact (real_mul_SNo
        c
        HcR
        c
        HcR).
    }
    claim HcSqGt1R :
      Rlt 1 (mul_SNo c c).
    {
      claim HcSqGt1' :
        1 < mul_SNo c c.
      {
        exact ((mul_SNo_oneL
          1
          SNo_1)
          (fun u v:set => u < mul_SNo c c)
          HcSqGt1).
      }
      exact (RltI
        1
        (mul_SNo c c)
        real_1
        HcSqR
        HcSqGt1').
    }
    claim Hf0Scaled :
      add_SNo (mul_SNo a (x 0)) (x 0) = mul_SNo c (x 0).
    {
      rewrite (mul_SNo_com
        c
        (x 0)
        HcS
        Hx0SNo).
      rewrite (mul_SNo_distrL
        (x 0)
        a
        1
        Hx0SNo
        HaS
        SNo_1).
      rewrite (mul_SNo_com
        (x 0)
        a
        Hx0SNo
        HaS).
      rewrite (mul_SNo_oneR
        (x 0)
        Hx0SNo).
      reflexivity.
    }
    claim Hf1Scaled :
      add_SNo (mul_SNo a (x 1)) (x 1) = mul_SNo c (x 1).
    {
      rewrite (mul_SNo_com
        c
        (x 1)
        HcS
        Hx1SNo).
      rewrite (mul_SNo_distrL
        (x 1)
        a
        1
        Hx1SNo
        HaS
        SNo_1).
      rewrite (mul_SNo_com
        (x 1)
        a
        Hx1SNo
        HaS).
      rewrite (mul_SNo_oneR
        (x 1)
        Hx1SNo).
      reflexivity.
    }
    claim HfxNormEq :
      add_SNo
        (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
        (mul_SNo (apply_fun f x 1) (apply_fun f x 1))
      =
      mul_SNo
        (mul_SNo c c)
        (add_SNo
          (mul_SNo (x 0) (x 0))
          (mul_SNo (x 1) (x 1))).
    {
      rewrite Hf0Linear at 1.
      rewrite Hf0Linear at 1.
      rewrite Hf1Linear at 1.
      rewrite Hf1Linear at 1.
      rewrite Hf0Scaled at 1.
      rewrite Hf0Scaled at 1.
      rewrite Hf1Scaled at 1.
      rewrite Hf1Scaled at 1.
      rewrite (mul_SNo_com_4_inner_mid
        c
        (x 0)
        c
        (x 0)
        HcS
        Hx0SNo
        HcS
        Hx0SNo).
      rewrite (mul_SNo_com_4_inner_mid
        c
        (x 1)
        c
        (x 1)
        HcS
        Hx1SNo
        HcS
        Hx1SNo).
      rewrite <- (mul_SNo_distrL
        (mul_SNo c c)
        (mul_SNo (x 0) (x 0))
        (mul_SNo (x 1) (x 1))
        (SNo_mul_SNo
          c
          c
          HcS
          HcS)
        (SNo_mul_SNo
          (x 0)
          (x 0)
          Hx0SNo
          Hx0SNo)
        (SNo_mul_SNo
          (x 1)
          (x 1)
          Hx1SNo
          Hx1SNo)).
      reflexivity.
    }
    claim HfxNormEqC2 :
      add_SNo
        (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
        (mul_SNo (apply_fun f x 1) (apply_fun f x 1))
      = mul_SNo c c.
    {
      rewrite HfxNormEq.
      rewrite HxEq1.
      rewrite (mul_SNo_oneR
        (mul_SNo c c)
        (SNo_mul_SNo
          c
          c
          HcS
          HcS)).
      reflexivity.
    }
    claim HfxNormGt1 :
      Rlt 1
        (add_SNo
          (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
          (mul_SNo (apply_fun f x 1) (apply_fun f x 1))).
    {
      rewrite HfxNormEqC2.
      exact HcSqGt1R.
    }
    claim HfxBound :
      ~(Rlt 1
        (add_SNo
          (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
          (mul_SNo (apply_fun f x 1) (apply_fun f x 1)))).
    {
      exact (SepE2
        (setprod R R)
        (fun p:set =>
          ~(Rlt 1
            (add_SNo (mul_SNo (p 0) (p 0))
              (mul_SNo (p 1) (p 1)))))
        (apply_fun f x)
        HfxB2).
    }
    apply HfxBound.
    exact HfxNormGt1.
  }
  exact (FalseE
    Hcontra
    (exists x:set, x :e B2 /\ apply_fun f x = x)).
Qed.

End Brouwer.
