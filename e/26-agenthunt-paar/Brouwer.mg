  claim HvNonzero :
    forall x:set, x :e B2 -> ~(apply_fun v x 0 = 0 /\ apply_fun v x 1 = 0).
  {
    let x.
    assume HxB2.
    assume HvZero.
    claim HfFun : function_on f B2 B2.
    {
      exact (continuous_map_function_on
        B2
        B2_topology
        B2
        B2_topology
        f
        HfCont).
    }
    claim HfxB2 : apply_fun f x :e B2.
    {
      exact (HfFun x HxB2).
    }
    claim HxR2 : x :e setprod R R.
    {
      exact (SepE1
        (setprod R R)
        (fun p:set =>
          ~(Rlt 1
            (add_SNo (mul_SNo (p 0) (p 0))
              (mul_SNo (p 1) (p 1)))))
        x
        HxB2).
    }
    claim HfxR2 : apply_fun f x :e setprod R R.
    {
      exact (SepE1
        (setprod R R)
        (fun p:set =>
          ~(Rlt 1
            (add_SNo (mul_SNo (p 0) (p 0))
              (mul_SNo (p 1) (p 1)))))
        (apply_fun f x)
        HfxB2).
    }
    claim HxEta : x = (x 0, x 1).
    {
      exact (setprod_eta
        R
        R
        x
        HxR2).
    }
    claim HfxEta :
      apply_fun f x = (apply_fun f x 0, apply_fun f x 1).
    {
      exact (setprod_eta
        R
        R
        (apply_fun f x)
        HfxR2).
    }
    claim HxPairIn : (x 0, x 1) :e setprod R R.
    {
      rewrite <- HxEta.
      exact HxR2.
    }
    claim HfxPairIn :
      (apply_fun f x 0, apply_fun f x 1) :e setprod R R.
    {
      rewrite <- HfxEta.
      exact HfxR2.
    }
    claim HxPairSing :
      (x 0, x 1) :e setprod {x 0} {x 1}.
    {
      exact (tuple_2_setprod_by_pair_Sigma
        {x 0}
        {x 1}
        (x 0)
        (x 1)
        (SingI (x 0))
        (SingI (x 1))).
    }
    claim HfxPairSing :
      (apply_fun f x 0, apply_fun f x 1)
        :e setprod {apply_fun f x 0} {apply_fun f x 1}.
    {
      exact (tuple_2_setprod_by_pair_Sigma
        {apply_fun f x 0}
        {apply_fun f x 1}
        (apply_fun f x 0)
        (apply_fun f x 1)
        (SingI (apply_fun f x 0))
        (SingI (apply_fun f x 1))).
    }
    claim HxCoordsR : x 0 :e R /\ x 1 :e R.
    {
      exact (setprod_coords_in
        (x 0)
        (x 1)
        R
        R
        (x 0, x 1)
        HxPairSing
        HxPairIn).
    }
    claim HfxCoordsR :
      apply_fun f x 0 :e R /\ apply_fun f x 1 :e R.
    {
      exact (setprod_coords_in
        (apply_fun f x 0)
        (apply_fun f x 1)
        R
        R
        (apply_fun f x 0, apply_fun f x 1)
        HfxPairSing
        HfxPairIn).
    }
    claim Hx0R : x 0 :e R.
    {
      exact (andEL
        (x 0 :e R)
        (x 1 :e R)
        HxCoordsR).
    }
    claim Hx1R : x 1 :e R.
    {
      exact (andER
        (x 0 :e R)
        (x 1 :e R)
        HxCoordsR).
    }
    claim Hf0R : apply_fun f x 0 :e R.
    {
      exact (andEL
        (apply_fun f x 0 :e R)
        (apply_fun f x 1 :e R)
        HfxCoordsR).
    }
    claim Hf1R : apply_fun f x 1 :e R.
    {
      exact (andER
        (apply_fun f x 0 :e R)
        (apply_fun f x 1 :e R)
        HfxCoordsR).
    }
    claim Hx0SNo : SNo (x 0).
    {
      exact (real_SNo
        (x 0)
        Hx0R).
    }
    claim Hx1SNo : SNo (x 1).
    {
      exact (real_SNo
        (x 1)
        Hx1R).
    }
