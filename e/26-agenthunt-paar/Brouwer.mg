Axiom normalize01_fun_preimage_open_ray_lower : forall b : set , b :e R -> preimage_of R normalize01_fun (open_ray_lower R b) :e R_standard_topology.
Axiom normalize01_fun_continuous : continuous_map R R_standard_topology R R_standard_topology normalize01_fun.
