Definition Michael_cond41_3_1 : set -> set -> prop := fun X Tx => forall U : set , open_cover X Tx U -> exists V : set , open_cover X Tx V /\ sigma_locally_finite_family X Tx V /\ refine_of V U.
Definition Michael_cond41_3_2 : set -> set -> prop := fun X Tx => forall U : set , open_cover X Tx U -> exists V : set , covers X V /\ locally_finite_family X Tx V /\ refine_of V U.
Definition Michael_cond41_3_3 : set -> set -> prop := fun X Tx => forall U : set , open_cover X Tx U -> exists V : set , closed_cover X Tx V /\ locally_finite_family X Tx V /\ refine_of V U.
Definition Michael_cond41_3_4 : set -> set -> prop := fun X Tx => forall U : set , open_cover X Tx U -> exists V : set , open_cover X Tx V /\ locally_finite_family X Tx V /\ refine_of V U.
Axiom sigma_locally_finite_open_cover_imp_locally_finite_refinement : forall X Tx V : set , regular_space X Tx -> open_cover X Tx V -> sigma_locally_finite_family X Tx V -> exists C : set , covers X C /\ locally_finite_family X Tx C /\ refine_of C V.
