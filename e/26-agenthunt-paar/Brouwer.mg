	                  Tdom
	                  unit_interval
	                  unit_interval_topology
	                  R
	                  R_standard_topology
	                  one_minus_t
	                  HoneMinusContI
	                  unit_interval_sub_R
	                  R_standard_topology_is_topology
	                  (fun P H => H)).
	              }
	              claim HtopR2 : topology_on (setprod R R) R2_topology.
	              {
