    = apply_fun (fundamental_group_mult X Tx x0) (cx, cy).
  { exact (tuple_2_0_eq (apply_fun (fundamental_group_mult X Tx x0) (cx, cy)) cz). }
  claim HLHS1 : (apply_fun (fundamental_group_mult X Tx x0) (cx, cy), cz) 1 = cz.
