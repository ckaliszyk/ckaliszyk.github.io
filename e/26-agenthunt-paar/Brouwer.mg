Axiom metrizable_paracompact : forall X Tx : set , metrizable X Tx -> paracompact_space X Tx.
Axiom regular_Lindelof_paracompact : forall X Tx : set , regular_space X Tx -> Lindelof_space X Tx -> paracompact_space X Tx.
