  { exact (tuple_2_0_eq cx (apply_fun (fundamental_group_mult X Tx x0) (cy, cz))). }
  claim HRHS1 : (cx, apply_fun (fundamental_group_mult X Tx x0) (cy, cz)) 1
    = apply_fun (fundamental_group_mult X Tx x0) (cy, cz).
