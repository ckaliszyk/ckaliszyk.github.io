          {(t, apply_fun (Eps_i (fun f:set => f :e u)) (mul_SNo 2 t)) | t :e unit_interval_left_half}
          {(t, apply_fun (Eps_i (fun g:set => g :e v)) (add_SNo (mul_SNo 2 t) (minus_SNo 1))) | t :e unit_interval_right_half}
          p
          Hp).
