	          {
	            let w wS1.
	            assume HwCont HwS1Cont HwS1Eq HnoInW HwS1Nul.
	            claim HincHomW :
	              homotopic_maps
	                S1
	                S1_topology
	                R2_minus_origin
	                R2_minus_origin_topology
	                (graph S1 (fun x:set => x))
