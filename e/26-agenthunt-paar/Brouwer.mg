            (path_concat alpha (reverse_path alpha)))
          (path_concat
            (Eps_i (fun g:set => g :e v))
            alpha))
        (path_concat
          (path_concat
            (Eps_i (fun f:set => f :e u))
            (constant_path x0))
          (path_concat
            (Eps_i (fun g:set => g :e v))
            alpha))
        HreplaceInner1
        HreplaceInner2).
    }
    claim Hinner123 :
      path_homotopic
        X
        Tx
        x0
        x1
        (path_concat
          (path_concat
            (path_concat
              (Eps_i (fun f:set => f :e u))
              alpha)
            (reverse_path alpha))
          (path_concat
