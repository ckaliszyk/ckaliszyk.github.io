	              {
	                exact (composition_continuous
	                  dom
	                  Tdom
	                  (setprod R R)
	                  R2_topology
	                  R
	                  R_standard_topology
	                  wsq
	                  (projection_map2 R R)
	                  HwsqContR2
	                  Hproj2Cont).
