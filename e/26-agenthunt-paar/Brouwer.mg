	              {
	                exact (andEL
	                  (continuous_map dom Tdom S1 S1_topology xproj)
	                  (continuous_map dom Tdom unit_interval unit_interval_topology tproj)
	                  HprojPack).
	              }
	              claim HtprojContI :
	                continuous_map dom Tdom unit_interval unit_interval_topology tproj.
	              {
	                exact (andER
