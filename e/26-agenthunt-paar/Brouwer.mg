  (0, 0) :e B2.
apply (SepI
  (setprod R R)
  (fun p:set =>
    ~(Rlt 1
      (add_SNo (mul_SNo (p 0) (p 0))
        (mul_SNo (p 1) (p 1)))))
  (0, 0)).
