      claim HlhsEq :
        add_SNo (add_SNo (apply_fun f x 1) (minus_SNo (x 1))) (x 1) = x 1.
      {
        rewrite Hcoord1.
        exact (add_SNo_0L
          (x 1)
          Hx1SNo).
      }
      claim HlhsSimpl :
        add_SNo (add_SNo (apply_fun f x 1) (minus_SNo (x 1))) (x 1)
        = apply_fun f x 1.
      {
        exact (add_SNo_minus_R2'
          (apply_fun f x 1)
          (x 1)
          Hf1SNo
          Hx1SNo).
      }
      rewrite <- HlhsSimpl.
      exact HlhsEq.
    }
    claim HpairEq :
      (apply_fun f x 0, apply_fun f x 1) = (x 0, x 1).
    {
      exact (tuple_2_ext
        (apply_fun f x 0)
        (apply_fun f x 1)
        (x 0)
        (x 1)
        Hf0Eqx0
        Hf1Eqx1).
    }
    claim Hfixx :
