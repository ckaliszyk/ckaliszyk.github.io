Infix :/: 353 := div_SNo.
Infix ^ 342 right := exp_SNo_nat.

Axiom Subq_int_SNoS_omega: int c= SNoS_ omega.

Axiom Subq_SNoS_omega_rational: SNoS_ omega c= rational.

Axiom Subq_rational_real: rational c= real.

Axiom rational_minus_SNo: forall q :e rational, - q :e rational.

Definition nat_pair : set -> set -> set := fun m n => 2 ^ m * (2 * n + 1).

Axiom nat_pair_In_omega: forall m n :e omega, nat_pair m n :e omega.

