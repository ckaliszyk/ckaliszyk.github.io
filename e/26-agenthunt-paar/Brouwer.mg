}
claim H2 :
  continuous_map unit_interval unit_interval_topology X Tx f /\
  continuous_map unit_interval unit_interval_topology X Tx f' /\
  apply_fun f 0 = x0.
{
  exact (andEL
    (continuous_map unit_interval unit_interval_topology X Tx f /\
