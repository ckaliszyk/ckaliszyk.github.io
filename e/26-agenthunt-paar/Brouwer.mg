  { exact (fundamental_group_mult_apply X Tx x0 (cy, cz) HpairYZ). }
  claim HYZ0 : (cy, cz) 0 = cy. { exact (tuple_2_0_eq cy cz). }
  claim HYZ1 : (cy, cz) 1 = cz. { exact (tuple_2_1_eq cy cz). }
