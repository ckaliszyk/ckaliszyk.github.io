        (path_concat
          (Eps_i (fun f:set => f :e u))
          (path_concat
            (Eps_i (fun g:set => g :e v))
            alpha))
        Hinner12
        HreplaceInner3).
    }
    claim HinnerFinal :
      path_homotopic
        X
        Tx
        x0
        x1
        (path_concat
          (path_concat
            (path_concat
              (Eps_i (fun f:set => f :e u))
              alpha)
            (reverse_path alpha))
          (path_concat
            (Eps_i (fun g:set => g :e v))
            alpha))
        (path_concat
          (path_concat
            (Eps_i (fun f:set => f :e u))
            (Eps_i (fun g:set => g :e v)))
          alpha).
    {
      exact (Lemma_51_1_path_homotopy_trans
        X
        Tx
        x0
        x1
