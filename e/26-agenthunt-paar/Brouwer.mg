        B2
        R
        R
        d0
        d1
        x
        HxB2).
      rewrite (add_of_pair_map_neg_apply
        B2
        f0
        x0
        x
        HxB2
        Hf0Rx
        Hx0Rx).
      rewrite (add_of_pair_map_neg_apply
        B2
        f1
        x1
        x
        HxB2
        Hf1Rx
        Hx1Rx).
      rewrite (compose_fun_apply
        B2
        f
        (projection_map1 R R)
        x
        HxB2).
      rewrite (compose_fun_apply
        B2
        f
        (projection_map2 R R)
        x
        HxB2).
      rewrite (projection1_apply
        R
        R
        (apply_fun f x)
        HfxR2).
      rewrite (projection2_apply
        R
        R
        (apply_fun f x)
        HfxR2).
      rewrite (compose_fun_apply
        B2
        (graph B2 (fun y:set => y))
        (projection_map1 R R)
        x
        HxB2).
      rewrite (compose_fun_apply
        B2
        (graph B2 (fun y:set => y))
        (projection_map2 R R)
        x
        HxB2).
      rewrite (apply_fun_graph
        B2
        (fun y:set => y)
        x
        HxB2).
      rewrite (projection1_apply
        R
        R
        x
        HxR2).
      rewrite (projection2_apply
        R
        R
        x
        HxR2).
      rewrite (apply_fun_graph
        B2
        (fun y:set =>
          (add_SNo (apply_fun f y 0) (minus_SNo (y 0)),
           add_SNo (apply_fun f y 1) (minus_SNo (y 1))))
        x
        HxB2).
      reflexivity.
    }
    exact (continuous_map_congr_on
      B2
      B2_topology
      (setprod R R)
      R2_topology
      w
      v
      HwCont
      HvFun
      HwEqV).
