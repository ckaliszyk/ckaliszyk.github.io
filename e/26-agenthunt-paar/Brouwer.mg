  { exact (tuple_2_setprod_by_pair_Sigma (fundamental_group X Tx x0) (fundamental_group X Tx x0) cx cy Hcx Hcy). }
  claim HmultXY_eq : apply_fun (fundamental_group_mult X Tx x0) (cx, cy)
