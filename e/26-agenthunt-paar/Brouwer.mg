}
claim H4 :
  continuous_map unit_interval unit_interval_topology X Tx f /\
  continuous_map unit_interval unit_interval_topology X Tx f' /\
  apply_fun f 0 = x0 /\ apply_fun f 1 = x1 /\
  apply_fun f' 0 = x0.
{
  exact (andEL
    (continuous_map unit_interval unit_interval_topology X Tx f /\
     continuous_map unit_interval unit_interval_topology X Tx f' /\
     apply_fun f 0 = x0 /\ apply_fun f 1 = x1 /\
     apply_fun f' 0 = x0)
    (apply_fun f' 1 = x1)
    H5).
}
claim H3 :
  continuous_map unit_interval unit_interval_topology X Tx f /\
  continuous_map unit_interval unit_interval_topology X Tx f' /\
  apply_fun f 0 = x0 /\ apply_fun f 1 = x1.
{
  exact (andEL
    (continuous_map unit_interval unit_interval_topology X Tx f /\
     continuous_map unit_interval unit_interval_topology X Tx f' /\
     apply_fun f 0 = x0 /\ apply_fun f 1 = x1)
    (apply_fun f' 0 = x0)
