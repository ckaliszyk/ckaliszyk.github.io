      rewrite (HF1 x Hx).
      rewrite (compose_fun_apply X h' k x Hx).
      reflexivity.
}
claim Hpre :
  homotopic_maps X Tx Z Tz
    (compose_fun X h' k)
    (compose_fun X h' k').
{
