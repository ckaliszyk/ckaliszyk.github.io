(** Proven Charlie **)
Theorem B2_scale_B2 : forall a z:set,
  a :e unit_interval ->
  z :e B2 ->
  (mul_SNo a (z 0), mul_SNo a (z 1)) :e B2.
let a z.
assume HaI HzB2.
claim HaR : a :e R.
{
  exact (SepE1
    R
    (fun t:set => ~ (Rlt t 0) /\ ~ (Rlt 1 t))
    a
    HaI).
}
claim HaS : SNo a.
{
  exact (real_SNo
    a
    HaR).
}
claim HaLe1R : Rle a 1.
{
  exact (unit_interval_Rle1
    a
    HaI).
}
claim HaLe1 : a <= 1.
{
  exact (SNoLe_of_Rle
    a
    1
    HaLe1R).
}
claim HaGe0R : Rle 0 a.
{
  exact (unit_interval_Rle0
    a
    HaI).
}
claim HaGe0 : 0 <= a.
{
  exact (SNoLe_of_Rle
    0
    a
    HaGe0R).
}
claim HzR2 : z :e setprod R R.
{
  exact (SepE1
    (setprod R R)
    (fun p:set =>
      ~(Rlt 1 (add_SNo (mul_SNo (p 0) (p 0))
        (mul_SNo (p 1) (p 1)))))
    z
    HzB2).
}
claim HzBound :
  ~(Rlt 1 (add_SNo (mul_SNo (z 0) (z 0))
    (mul_SNo (z 1) (z 1)))).
{
  exact (SepE2
    (setprod R R)
    (fun p:set =>
      ~(Rlt 1 (add_SNo (mul_SNo (p 0) (p 0))
        (mul_SNo (p 1) (p 1)))))
    z
    HzB2).
}
claim Hz0R : z 0 :e R.
{
  exact (EuclidPlane_xcoord_in_R
    z
