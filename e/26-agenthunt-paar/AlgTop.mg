Definition order_rel : set -> set -> set -> prop := fun X a b => (X = R /\ Rlt a b) \/ (X = rational_numbers /\ Rlt a b) \/ (X = omega /\ a :e b) \/ (X = omega :\: {0} /\ a :e b) \/ (X = setprod 2 omega /\ exists i m j n : set , (i :e 2 /\ m :e omega /\ j :e 2 /\ n :e omega /\ a = (i,m) /\ b = (j,n) /\ (i :e j \/ (i = j /\ m :e n)))) \/ (X = setprod R R /\ exists a1 a2 b1 b2 : set , a = (a1,a2) /\ b = (b1,b2) /\ (Rlt a1 b1 \/ (a1 = b1 /\ Rlt a2 b2))) \/ (ordinal X /\ X <> R /\ X <> rational_numbers /\ X <> setprod 2 omega /\ X <> setprod R R /\ a :e b).
Definition simply_ordered_set : set -> prop := fun X => X = R \/ X = rational_numbers \/ X = omega \/ X = omega :\: {0} \/ X = setprod 2 omega \/ X = setprod R R \/ ordinal X.
Axiom simply_ordered_set_R : simply_ordered_set R.
Axiom order_rel_setprod_2_omega_00_10 : order_rel (setprod 2 omega) (0,0) (1,0).
