Axiom ex49_diffquot_backward_abs_add_on_I_cancel : forall f g x h : set , function_on f unit_interval R -> function_on g unit_interval R -> x :e unit_interval -> add_SNo x (minus_SNo h) :e unit_interval -> h :e R -> apply_fun g (add_SNo x (minus_SNo h)) = apply_fun g x -> diffquot_backward_abs (ex49_add_on_I f g) x h = diffquot_backward_abs f x h.
