Axiom ex49_diffquot_forward_abs_zigzag_iter_S_right_raw : forall k x h : set , nat_p k -> x :e unit_interval_right_half -> Rlt (eps_ 1) x -> add_SNo x h :e unit_interval_right_half -> Rlt (eps_ 1) (add_SNo x h) -> h :e R -> 0 < h -> diffquot_forward_abs (ex49_zigzag_iter_fun (ordsucc k)) x h = mul_SNo 2 (diffquot_forward_abs (ex49_zigzag_iter_fun k) (add_SNo (mul_SNo 2 x) (minus_SNo 1)) (mul_SNo 2 h)).
Axiom ex49_diffquot_backward_abs_zigzag_iter_S_left_raw : forall k x h : set , nat_p k -> x :e unit_interval_left_half -> add_SNo x (minus_SNo h) :e unit_interval_left_half -> h :e R -> 0 < h -> diffquot_backward_abs (ex49_zigzag_iter_fun (ordsucc k)) x h = mul_SNo 2 (diffquot_backward_abs (ex49_zigzag_iter_fun k) (mul_SNo 2 x) (mul_SNo 2 h)).
Axiom ex49_diffquot_backward_abs_zigzag_iter_S_right_raw : forall k x h : set , nat_p k -> x :e unit_interval_right_half -> Rlt (eps_ 1) x -> add_SNo x (minus_SNo h) :e unit_interval_right_half -> Rlt (eps_ 1) (add_SNo x (minus_SNo h)) -> h :e R -> 0 < h -> diffquot_backward_abs (ex49_zigzag_iter_fun (ordsucc k)) x h = mul_SNo 2 (diffquot_backward_abs (ex49_zigzag_iter_fun k) (add_SNo (mul_SNo 2 x) (minus_SNo 1)) (mul_SNo 2 h)).
Axiom ex49_tent_fun_forward_diffquot_right_eq_2 : forall x h : set , x :e unit_interval_right_half -> add_SNo x h :e unit_interval_right_half -> h :e R -> 0 < h -> diffquot_forward_abs ex49_tent_fun x h = 2.
Axiom ex49_tent_fun_forward_diffquot_left_eq_2 : forall x h : set , x :e unit_interval_left_half -> add_SNo x h :e unit_interval_left_half -> h :e R -> 0 < h -> diffquot_forward_abs ex49_tent_fun x h = 2.
