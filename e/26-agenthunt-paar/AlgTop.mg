      exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e x n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv x) (ordsucc m))))
    HgenX).
