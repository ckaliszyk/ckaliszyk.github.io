claim Hhom0 :
  (continuous_map
    unit_interval
    unit_interval_topology
    unit_interval
    unit_interval_topology
    (graph unit_interval (fun x:set => x)) /\
   continuous_map
    unit_interval
    unit_interval_topology
    unit_interval
    unit_interval_topology
    (const_fun unit_interval 0)) /\
  exists G:set,
    continuous_map unit_square unit_square_topology
      unit_interval unit_interval_topology
      G /\
    (forall x:set, x :e unit_interval ->
      apply_fun G (x, 0) =
        apply_fun (graph unit_interval (fun x0:set => x0)) x) /\
    (forall x:set, x :e unit_interval ->
      apply_fun G (x, 1) =
        apply_fun (const_fun unit_interval 0) x).
{
  apply andI.
  - apply andI.
    + exact HidCont.
    + exact Hconst0Cont.
  - witness F.
    apply andI.
    + apply andI.
      * exact HFCont.
      * exact HFs0.
    + exact HFs1.
}
claim HnulI :
  exists y0:set,
    y0 :e unit_interval /\
    ((continuous_map
      unit_interval
      unit_interval_topology
      unit_interval
      unit_interval_topology
      (graph unit_interval (fun x:set => x)) /\
     continuous_map
      unit_interval
      unit_interval_topology
      unit_interval
      unit_interval_topology
      (const_fun unit_interval y0)) /\
    exists G:set,
      continuous_map unit_square unit_square_topology
        unit_interval unit_interval_topology
        G /\
      (forall x:set, x :e unit_interval ->
        apply_fun G (x, 0) =
          apply_fun (graph unit_interval (fun x0:set => x0)) x) /\
      (forall x:set, x :e unit_interval ->
        apply_fun G (x, 1) =
          apply_fun (const_fun unit_interval y0) x)).
{
  witness 0.
  apply andI.
  - exact zero_in_unit_interval.
  - exact Hhom0.
}
exact (andI
  (topology_on unit_interval unit_interval_topology)
  (nulhomotopic
    unit_interval
    unit_interval_topology
    unit_interval
    unit_interval_topology
    (graph unit_interval (fun x:set => x)))
  unit_interval_topology_on
  HnulI).
Qed.

