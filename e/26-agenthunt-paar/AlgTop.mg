  ~(forall cls1 cls2:set,
    cls1 :e fundamental_group T' TT' x0 ->
    cls2 :e fundamental_group T' TT' x0 ->
    apply_fun (fundamental_group_mult T' TT' x0) (cls1, cls2) =
    apply_fun (fundamental_group_mult T' TT' x0) (cls2, cls1)).
admit.
