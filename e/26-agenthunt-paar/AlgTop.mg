apply (SepI
  (setprod R R)
  (fun p:set => ~(p 0 = 0 /\ p 1 = 0))
  z
  HzR2).
assume HzZero.
claim Hz0 : z 0 = 0.
{
  exact (andEL
    (z 0 = 0)
    (z 1 = 0)
    HzZero).
}
claim Hz1 : z 1 = 0.
{
  exact (andER
    (z 0 = 0)
    (z 1 = 0)
    HzZero).
}
claim Hsum0 :
  add_SNo (mul_SNo (z 0) (z 0))
    (mul_SNo (z 1) (z 1)) = 0.
{
