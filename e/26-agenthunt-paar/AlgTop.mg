(** Proven Bob **)
(** Helper: group powers stay in the carrier of a group. **)
Theorem group_power_nat_closed_in_group :
  forall G mult e inv a n:set,
  group_structure G mult e inv ->
  a :e G ->
  n :e omega ->
  group_power_nat mult e a n :e G.
