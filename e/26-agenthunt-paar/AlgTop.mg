            unit_interval_left_half_sub unit_interval_right_half_sub v) HvI). }
      apply (binunionE unit_interval_left_half unit_interval_right_half v HvLHRH).
      + assume HvLH : v :e unit_interval_left_half.
        (** v <= eps_1, so 2v <= 1, so 4s <= 1, so 4s+1 <= 2 **)
        claim HRle_v_half : Rle v (eps_ 1).
        { exact (RleI v (eps_ 1) HvR eps_1_in_R
            (SepE2 unit_interval (fun t:set => ~ (Rlt (eps_ 1) t)) v HvLH)). }
        claim HSNoLe_v_half : v <= eps_ 1. { exact (SNoLe_of_Rle v (eps_ 1) HRle_v_half). }
        claim HSNoLe_2v_2half : mul_SNo 2 v <= mul_SNo 2 (eps_ 1).
        { exact (nonneg_mul_SNo_Le 2 v (eps_ 1) SNo_2 HSNoLe_0_2 HvSNo SNo_eps_1 HSNoLe_v_half). }
        claim HSNoLe_2v_1 : mul_SNo 2 v <= 1.
        { exact (eps_1_half_eq2 (fun a b => mul_SNo 2 v <= a) HSNoLe_2v_2half). }
        claim HSNoLe_4s_1 : mul_SNo s 4 <= 1.
        { exact (H2v_eq (fun a b => a <= 1) HSNoLe_2v_1). }
        (** 4s + 1 <= 1 + 1 = 2 **)
        claim HSNoLe_4s1_2 : add_SNo (mul_SNo s 4) 1 <= 2.
        { exact (H11_eq_2 (fun a b => add_SNo (mul_SNo s 4) 1 <= a)
            (add_SNo_Le1 (mul_SNo s 4) 1 1 HSNo_4s SNo_1 SNo_1 HSNoLe_4s_1)). }
        claim HRle_4s1_2 : Rle (add_SNo (mul_SNo s 4) 1) 2.
        { exact (Rle_of_SNoLe (add_SNo (mul_SNo s 4) 1) 2 (real_add_SNo (mul_SNo s 4) (real_mul_SNo s HsR 4 H4R) 1 real_1) H2R HSNoLe_4s1_2). }
        claim HRle_L_c2 : Rle (apply_fun L_fun (s, 1)) (apply_fun const2 (s, 1)).
        { rewrite HLval. rewrite Hcval2. exact HRle_4s1_2. }
        claim Hs1_AI : (s, 1) :e A_I.
        { exact (SepI unit_square (fun p:set => Rle (apply_fun L_fun p) (apply_fun const2 p)) (s, 1) Hs1_sq HRle_L_c2). }
        rewrite (HF_I_eq (s, 1) Hs1_AI).
        rewrite (HapplyF_I (s, 1) Hs1_AI).
        rewrite (tuple_2_0_eq s 1).
        rewrite (tuple_2_1_eq s 1).
        (** div_SNo (mul_SNo s 4) (add_SNo 2 (minus_SNo 1)) = div_SNo (mul_SNo s 4) 1 = mul_SNo s 4 **)
        rewrite H2m1_eq_1.
        claim Hdiv1 : div_SNo (mul_SNo s 4) 1 = mul_SNo s 4.
        { exact (mul_div_SNo_nonzero_eq (mul_SNo s 4) 1 (mul_SNo s 4) HSNo_4s SNo_1 HSNo_4s neq_1_0
            (fun Q => mul_SNo_oneL (mul_SNo s 4) HSNo_4s (fun x y => Q y x))). }
        rewrite Hdiv1.
        (** RHS: path_concat(path_concat(f,g), h)(s) with s in left half **)
        rewrite (path_concat_apply_left (path_concat f g) h s Hfg_h_compat HsLH).
        (** Now need: apply_fun f (mul_SNo s 4) = apply_fun (path_concat f g) (mul_SNo 2 s) **)
        (** Since v = 2s and v is in the left half, path_concat(f,g)(v) = f(2v) = f(4s) **)
        claim Hv_val_sym : mul_SNo 2 s = v.
        { symmetry. exact Hv_val. }
        rewrite Hv_val_sym.
        rewrite (path_concat_apply_left f g v Hfg_compat HvLH).
        (** mul_SNo s 4 = mul_SNo 2 v **)
        claim H4s_eq_2v : mul_SNo s 4 = mul_SNo 2 v.
        { symmetry. exact H2v_eq. }
        rewrite H4s_eq_2v.
        exact (fun Q H => H).
      + assume HvRH : v :e unit_interval_right_half.
        (** v >= eps_1, so 2v >= 1, so 4s >= 1, so 4s+1 >= 2 **)
        claim HRle_half_v : Rle (eps_ 1) v.
        { exact (RleI (eps_ 1) v eps_1_in_R HvR
            (SepE2 unit_interval (fun t:set => ~ (Rlt t (eps_ 1))) v HvRH)). }
        claim HSNoLe_half_v : eps_ 1 <= v. { exact (SNoLe_of_Rle (eps_ 1) v HRle_half_v). }
        claim HSNoLe_2half_2v : mul_SNo 2 (eps_ 1) <= mul_SNo 2 v.
        { exact (nonneg_mul_SNo_Le 2 (eps_ 1) v SNo_2 HSNoLe_0_2 SNo_eps_1 HvSNo HSNoLe_half_v). }
        claim HSNoLe_1_2v : 1 <= mul_SNo 2 v.
        { exact (eps_1_half_eq2 (fun a b => a <= mul_SNo 2 v) HSNoLe_2half_2v). }
        claim HSNoLe_1_4s : 1 <= mul_SNo s 4.
        { exact (H2v_eq (fun a b => 1 <= a) HSNoLe_1_2v). }
        (** 1 + 1 <= 4s + 1, so 2 <= 4s+1 **)
        claim HSNoLe_2_4s1 : 2 <= add_SNo (mul_SNo s 4) 1.
        { exact (H11_eq_2 (fun a b => a <= add_SNo (mul_SNo s 4) 1)
            (add_SNo_Le1 1 1 (mul_SNo s 4) SNo_1 SNo_1 HSNo_4s HSNoLe_1_4s)). }
        claim HRle_2_4s1 : Rle 2 (add_SNo (mul_SNo s 4) 1).
        { exact (Rle_of_SNoLe 2 (add_SNo (mul_SNo s 4) 1) H2R (real_add_SNo (mul_SNo s 4) (real_mul_SNo s HsR 4 H4R) 1 real_1) HSNoLe_2_4s1). }
        claim HRle_c2_L : Rle (apply_fun const2 (s, 1)) (apply_fun L_fun (s, 1)).
        { rewrite HLval. rewrite Hcval2. exact HRle_2_4s1. }
        claim Hs1_A23 : (s, 1) :e A_23.
        { exact (SepI unit_square (fun p:set => Rle (apply_fun const2 p) (apply_fun L_fun p)) (s, 1) Hs1_sq HRle_c2_L). }
        (** Also 4s+1 <= 3 from left-half parent **)
        claim HRle_L_c3 : Rle (apply_fun L_fun (s, 1)) (apply_fun const3 (s, 1)).
        { rewrite HLval. rewrite Hcval3. exact HRle_4s1_3. }
        claim Hs1_AII : (s, 1) :e A_II.
        { exact (binintersectI
            {p :e unit_square | Rle (apply_fun const2 p) (apply_fun L_fun p)}
            {p :e unit_square | Rle (apply_fun L_fun p) (apply_fun const3 p)}
            (s, 1)
            (SepI unit_square (fun p:set => Rle (apply_fun const2 p) (apply_fun L_fun p)) (s, 1) Hs1_sq HRle_c2_L)
            (SepI unit_square (fun p:set => Rle (apply_fun L_fun p) (apply_fun const3 p)) (s, 1) Hs1_sq HRle_L_c3)). }
        rewrite (HF_23_eq (s, 1) Hs1_A23).
        rewrite (HF_23_II (s, 1) Hs1_AII).
        rewrite (HapplyF_II (s, 1) Hs1_AII).
        rewrite (tuple_2_0_eq s 1).
        rewrite (tuple_2_1_eq s 1).
        (** g(add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 2)) = g(4s + 1 - 2) = g(4s - 1) **)
        (** RHS: path_concat(path_concat(f,g), h)(s) with s in left half **)
        rewrite (path_concat_apply_left (path_concat f g) h s Hfg_h_compat HsLH).
        (** path_concat(f,g)(2s) with 2s = v in right half: g(2v - 1) = g(2(2s)-1) = g(4s-1) **)
        claim Hv_val_sym : mul_SNo 2 s = v.
        { symmetry. exact Hv_val. }
        rewrite Hv_val_sym.
        rewrite (path_concat_apply_right f g v Hfg_compat HvRH).
        (** Need: add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 2) = add_SNo (mul_SNo 2 v) (minus_SNo 1) **)
        (** LHS: (4s + 1) + (-2) = 4s + (1 + (-2)) = 4s + (-1) **)
        claim HSNo_1m2 : SNo (add_SNo 1 (minus_SNo 2)). { exact (SNo_add_SNo 1 (minus_SNo 2) SNo_1 HSNo_m2). }
        claim H1m2_eq_m1 : add_SNo 1 (minus_SNo 2) = minus_SNo 1.
        { (** (1 + (-2)) + 2 = 1 + ((-2) + 2) = 1 + 0 = 1, and (-1) + 2 = 1, so cancel **)
          claim Hassoc_1m2 : add_SNo (add_SNo 1 (minus_SNo 2)) 2 = add_SNo 1 (add_SNo (minus_SNo 2) 2).
          { exact (fun Q => add_SNo_assoc 1 (minus_SNo 2) 2 SNo_1 HSNo_m2 SNo_2 (fun x y => Q y x)). }
          claim Hm22 : add_SNo (minus_SNo 2) 2 = 0.
          { exact (add_SNo_com (minus_SNo 2) 2 HSNo_m2 SNo_2 (fun x y => y = 0) (add_SNo_minus_SNo_rinv 2 SNo_2)). }
          claim H1m2_plus_2 : add_SNo (add_SNo 1 (minus_SNo 2)) 2 = 1.
          { rewrite Hassoc_1m2. rewrite Hm22. exact (add_SNo_0R 1 SNo_1). }
          claim Hm1_plus_2 : add_SNo (minus_SNo 1) 2 = 1.
          { exact (add_SNo_com (minus_SNo 1) 2 HSNo_m1 SNo_2 (fun x y => y = 1) H2m1_eq_1). }
          claim Hboth : add_SNo (add_SNo 1 (minus_SNo 2)) 2 = add_SNo (minus_SNo 1) 2.
          { rewrite H1m2_plus_2. symmetry. exact Hm1_plus_2. }
          exact (add_SNo_cancel_R (add_SNo 1 (minus_SNo 2)) 2 (minus_SNo 1) HSNo_1m2 SNo_2 HSNo_m1 Hboth). }
        claim Hassoc_4s1m2 : add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 2) = add_SNo (mul_SNo s 4) (add_SNo 1 (minus_SNo 2)).
        { exact (fun Q => add_SNo_assoc (mul_SNo s 4) 1 (minus_SNo 2) HSNo_4s SNo_1 HSNo_m2 (fun x y => Q y x)). }
        claim H4s1m2_eq_4sm1 : add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 2) = add_SNo (mul_SNo s 4) (minus_SNo 1).
        { rewrite Hassoc_4s1m2. rewrite H1m2_eq_m1. exact (fun Q H => H). }
        (** RHS: add_SNo (mul_SNo 2 v) (minus_SNo 1) = add_SNo (mul_SNo s 4) (minus_SNo 1) **)
        claim H4s_eq_2v : mul_SNo s 4 = mul_SNo 2 v.
        { symmetry. exact H2v_eq. }
        claim Heq_goal : add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 2) = add_SNo (mul_SNo 2 v) (minus_SNo 1).
        { rewrite H4s1m2_eq_4sm1.
          rewrite H4s_eq_2v.
          exact (fun Q H => H). }
        rewrite Heq_goal.
        exact (fun Q H => H).
    - assume HsRH : s :e unit_interval_right_half.
      (** Right half: s >= eps_1, so 4s >= 2, so 4s+1 >= 3 **)
      claim HRle_half_s : Rle (eps_ 1) s.
      { exact (RleI (eps_ 1) s eps_1_in_R HsR
          (SepE2 unit_interval (fun t:set => ~ (Rlt t (eps_ 1))) s HsRH)). }
      claim HSNoLe_half_s : eps_ 1 <= s. { exact (SNoLe_of_Rle (eps_ 1) s HRle_half_s). }
      claim HSNoLe_4half_4s : mul_SNo (eps_ 1) 4 <= mul_SNo s 4.
      { exact (nonneg_mul_SNo_Le' (eps_ 1) s 4 SNo_eps_1 HsSNo HSNo4 HSNoLe_0_4 HSNoLe_half_s). }
      claim HSNoLe_2_4s : 2 <= mul_SNo s 4.
      { exact (H4half_eq_2 (fun a b => a <= mul_SNo s 4) HSNoLe_4half_4s). }
      (** 2 + 1 = 3, so 4s + 1 >= 3 **)
      claim HSNoLe_3_4s1 : 3 <= add_SNo (mul_SNo s 4) 1.
      { exact (add_SNo_2_1_eq_3 (fun a b => a <= add_SNo (mul_SNo s 4) 1)
          (add_SNo_Le1 2 1 (mul_SNo s 4) SNo_2 SNo_1 HSNo_4s HSNoLe_2_4s)). }
      claim HRle_3_4s1 : Rle 3 (add_SNo (mul_SNo s 4) 1).
      { exact (Rle_of_SNoLe 3 (add_SNo (mul_SNo s 4) 1) H3R (real_add_SNo (mul_SNo s 4) (real_mul_SNo s HsR 4 H4R) 1 real_1) HSNoLe_3_4s1). }
      claim HRle_c3_L : Rle (apply_fun const3 (s, 1)) (apply_fun L_fun (s, 1)).
      { rewrite HLval. rewrite Hcval3. exact HRle_3_4s1. }
      claim Hs1_AIII : (s, 1) :e A_III.
      { exact (SepI unit_square (fun p:set => Rle (apply_fun const3 p) (apply_fun L_fun p)) (s, 1) Hs1_sq HRle_c3_L). }
      (** Also need (s,1) :e A_23 for HF_23_eq **)
      claim HSNoLe_2_4s1 : 2 <= add_SNo (mul_SNo s 4) 1.
      { exact (SNoLe_tra 2 3 (add_SNo (mul_SNo s 4) 1) SNo_2 HSNo3 HSNo_4s1
          (SNoLe_of_Rle 2 3 HRle23) HSNoLe_3_4s1). }
      claim HRle_2_4s1 : Rle 2 (add_SNo (mul_SNo s 4) 1).
      { exact (Rle_of_SNoLe 2 (add_SNo (mul_SNo s 4) 1) H2R (real_add_SNo (mul_SNo s 4) (real_mul_SNo s HsR 4 H4R) 1 real_1) HSNoLe_2_4s1). }
      claim HRle_c2_L : Rle (apply_fun const2 (s, 1)) (apply_fun L_fun (s, 1)).
      { rewrite HLval. rewrite Hcval2. exact HRle_2_4s1. }
      claim Hs1_A23 : (s, 1) :e A_23.
      { exact (SepI unit_square (fun p:set => Rle (apply_fun const2 p) (apply_fun L_fun p)) (s, 1) Hs1_sq HRle_c2_L). }
      rewrite (HF_23_eq (s, 1) Hs1_A23).
      rewrite (HF_23_III (s, 1) Hs1_AIII).
      rewrite (HapplyF_III (s, 1) Hs1_AIII).
      rewrite (tuple_2_0_eq s 1).
      rewrite (tuple_2_1_eq s 1).
      rewrite H11_eq_2.
      (** RHS: path_concat(path_concat(f,g), h)(s) with s in right half **)
      rewrite (path_concat_apply_right (path_concat f g) h s Hfg_h_compat HsRH).
      (** Goal: h(div_SNo (add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 3)) 2)
              = h(add_SNo (mul_SNo 2 s) (minus_SNo 1)) **)
      (** LHS numerator: (4s + 1) + (-3) = 4s + (1 + (-3)) = 4s + (-2) **)
      claim HSNo_1m3 : SNo (add_SNo 1 (minus_SNo 3)). { exact (SNo_add_SNo 1 (minus_SNo 3) SNo_1 HSNo_m3). }
      claim H1m3_eq_m2 : add_SNo 1 (minus_SNo 3) = minus_SNo 2.
      { (** (1+(-3))+3 = 1+((-3)+3) = 1+0 = 1, and (-2)+3 = 1, so cancel **)
        claim Hassoc_1m3 : add_SNo (add_SNo 1 (minus_SNo 3)) 3 = add_SNo 1 (add_SNo (minus_SNo 3) 3).
        { exact (fun Q => add_SNo_assoc 1 (minus_SNo 3) 3 SNo_1 HSNo_m3 HSNo3 (fun x y => Q y x)). }
        claim Hm33 : add_SNo (minus_SNo 3) 3 = 0.
        { exact (add_SNo_com (minus_SNo 3) 3 HSNo_m3 HSNo3 (fun x y => y = 0) (add_SNo_minus_SNo_rinv 3 HSNo3)). }
        claim H1m3_plus_3 : add_SNo (add_SNo 1 (minus_SNo 3)) 3 = 1.
        { rewrite Hassoc_1m3. rewrite Hm33. exact (add_SNo_0R 1 SNo_1). }
        claim Hm2_plus_3 : add_SNo (minus_SNo 2) 3 = 1.
        { exact (add_SNo_com (minus_SNo 2) 3 HSNo_m2 HSNo3 (fun x y => y = 1)
            (H12_eq_3 (fun x y => add_SNo x (minus_SNo 2) = 1) (add_SNo_minus_R2 1 2 SNo_1 SNo_2))). }
        claim Hboth : add_SNo (add_SNo 1 (minus_SNo 3)) 3 = add_SNo (minus_SNo 2) 3.
        { rewrite H1m3_plus_3. symmetry. exact Hm2_plus_3. }
        exact (add_SNo_cancel_R (add_SNo 1 (minus_SNo 3)) 3 (minus_SNo 2) HSNo_1m3 HSNo3 HSNo_m2 Hboth). }
      claim Hassoc_4s1m3 : add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 3) = add_SNo (mul_SNo s 4) (add_SNo 1 (minus_SNo 3)).
      { exact (fun Q => add_SNo_assoc (mul_SNo s 4) 1 (minus_SNo 3) HSNo_4s SNo_1 HSNo_m3 (fun x y => Q y x)). }
      claim H4s1m3_eq_4sm2 : add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 3) = add_SNo (mul_SNo s 4) (minus_SNo 2).
      { rewrite Hassoc_4s1m3. rewrite H1m3_eq_m2. exact (fun Q H => H). }
      (** div_SNo (4s + (-2)) 2 = 2s - 1, since 4s + (-2) = 2(2s-1) **)
      claim H4sm2_eq_2_2sm1 : add_SNo (mul_SNo s 4) (minus_SNo 2) = mul_SNo 2 (add_SNo (mul_SNo 2 s) (minus_SNo 1)).
      { symmetry. exact H2_2sm1_eq_4sm2. }
      claim Hdiv_eq : div_SNo (add_SNo (mul_SNo s 4) (minus_SNo 2)) 2 = add_SNo (mul_SNo 2 s) (minus_SNo 1).
      { exact (mul_div_SNo_nonzero_eq (add_SNo (mul_SNo s 4) (minus_SNo 2)) 2 (add_SNo (mul_SNo 2 s) (minus_SNo 1)) HSNo_4sm2 SNo_2
          (SNo_add_SNo (mul_SNo 2 s) (minus_SNo 1) HSNo_2s HSNo_m1) neq_2_0
          H4sm2_eq_2_2sm1). }
      (** Rewrite the numerator **)
      claim Hnum_rewrite : div_SNo (add_SNo (add_SNo (mul_SNo s 4) 1) (minus_SNo 3)) 2 = add_SNo (mul_SNo 2 s) (minus_SNo 1).
      { rewrite H4s1m3_eq_4sm2. exact Hdiv_eq. }
      rewrite Hnum_rewrite.
      exact (fun Q H => H).
  - (** F(0,t) = x0 **)
    let t. assume Ht : t :e unit_interval.
    claim HtR : t :e R. { exact (unit_interval_sub_R t Ht). }
    claim HtSNo : SNo t. { exact (real_SNo t HtR). }
    claim Hpt : (0, t) :e unit_square.
    { exact (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval 0 t zero_in_unit_interval Ht). }
    (** L(0,t) = t **)
    claim HLval : apply_fun L_fun (0, t) = t.
    { rewrite (HL_apply (0, t) Hpt).
      rewrite (tuple_2_0_eq 0 t).
      rewrite (tuple_2_1_eq 0 t).
      rewrite (mul_SNo_zeroL 4 (real_SNo 4 H4R)).
      rewrite (add_SNo_0L t HtSNo).
      exact (fun Q H => H). }
    claim Hcval_pt : apply_fun const2 (0, t) = 2. { exact (Hconst2_val (0, t) Hpt). }
    (** Rle t 2 **)
    claim HRle12 : Rle 1 2. { exact (Rlt_implies_Rle 1 2 (RltI 1 2 real_1 H2R SNoLt_1_2)). }
    claim HRlet2 : Rle t 2. { exact (Rle_tra t 1 2 (unit_interval_Rle1 t Ht) HRle12). }
    (** (0,t) :e A_I **)
    claim HRle_L_c2 : Rle (apply_fun L_fun (0, t)) (apply_fun const2 (0, t)).
    { rewrite HLval. rewrite Hcval_pt. exact HRlet2. }
    claim Hpt_AI : (0, t) :e A_I.
    { exact (SepI unit_square (fun p:set => Rle (apply_fun L_fun p) (apply_fun const2 p)) (0, t) Hpt HRle_L_c2). }
    (** F(0,t) = F_I(0,t) = f(0/(2-t)) = f(0) = x0 **)
    rewrite (HF_I_eq (0, t) Hpt_AI).
    rewrite (HapplyF_I (0, t) Hpt_AI).
    rewrite (tuple_2_0_eq 0 t).
    rewrite (tuple_2_1_eq 0 t).
    rewrite (mul_SNo_zeroL 4 (real_SNo 4 H4R)).
    rewrite (div_SNo_0_num (add_SNo 2 (minus_SNo t)) (SNo_add_SNo 2 (minus_SNo t) SNo_2 (SNo_minus_SNo t HtSNo))).
    exact Hf0.
  - (** F(1,t) = x3 **)
    let t. assume Ht : t :e unit_interval.
    claim HtR : t :e R. { exact (unit_interval_sub_R t Ht). }
    claim HtSNo : SNo t. { exact (real_SNo t HtR). }
    claim HSNo4 : SNo 4. { exact (real_SNo 4 H4R). }
    claim HSNo3 : SNo 3. { exact (real_SNo 3 H3R). }
    claim HSNo_m3 : SNo (minus_SNo 3). { exact (SNo_minus_SNo 3 HSNo3). }
    claim HSNo_1t : SNo (add_SNo 1 t). { exact (SNo_add_SNo 1 t SNo_1 HtSNo). }
    claim HSNo_4t : SNo (add_SNo 4 t). { exact (SNo_add_SNo 4 t HSNo4 HtSNo). }
    claim Hpt : (1, t) :e unit_square.
    { exact (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval 1 t one_in_unit_interval Ht). }
    (** L(1,t) = 4+t **)
    claim HLval : apply_fun L_fun (1, t) = add_SNo 4 t.
    { rewrite (HL_apply (1, t) Hpt).
      rewrite (tuple_2_0_eq 1 t).
      rewrite (tuple_2_1_eq 1 t).
      rewrite (mul_SNo_oneL 4 HSNo4).
      exact (fun Q H => H). }
    (** 3 < 4 via ordsucc chain **)
    claim H3omega : 3 :e omega.
    { exact (nat_p_omega 3 (nat_ordsucc 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0)))). }
    claim H3Lt4 : 3 < 4.
    { claim H31eq4 : add_SNo 3 1 = 4.
      { exact (add_SNo_1_ordsucc 3 H3omega). }
      claim H30lt31 : add_SNo 3 0 < add_SNo 3 1.
      { exact (add_SNo_Lt2 3 0 1 HSNo3 SNo_0 SNo_1 SNoLt_0_1). }
      claim H3lt31 : 3 < add_SNo 3 1.
      { exact (add_SNo_0R 3 HSNo3 (fun a b => a < add_SNo 3 1) H30lt31). }
      exact (H31eq4 (fun a b => 3 < a) H3lt31). }
    (** 3 <= 4+t **)
    claim HSNoLe_3_4 : 3 <= 4. { exact (SNoLtLe 3 4 H3Lt4). }
    claim HSNoLe_0_t : 0 <= t. { exact (SNoLe_of_Rle 0 t (unit_interval_Rle0 t Ht)). }
    claim HSNoLe_4_4t : 4 <= add_SNo 4 t.
    { exact (add_SNo_0R 4 HSNo4 (fun a b => a <= add_SNo 4 t)
        (add_SNo_Le2 4 0 t HSNo4 SNo_0 HtSNo HSNoLe_0_t)). }
    claim HSNoLe_3_4t : 3 <= add_SNo 4 t.
    { exact (SNoLe_tra 3 4 (add_SNo 4 t) HSNo3 HSNo4 HSNo_4t HSNoLe_3_4 HSNoLe_4_4t). }
    claim H4tR : add_SNo 4 t :e R. { exact (real_add_SNo 4 H4R t HtR). }
    claim HRle_3_4t : Rle 3 (add_SNo 4 t).
    { exact (Rle_of_SNoLe 3 (add_SNo 4 t) H3R H4tR HSNoLe_3_4t). }
    (** (1,t) :e A_III **)
    claim Hcval3_pt : apply_fun const3 (1, t) = 3. { exact (Hconst3_val (1, t) Hpt). }
    claim HRle_c3_L : Rle (apply_fun const3 (1, t)) (apply_fun L_fun (1, t)).
    { rewrite HLval. rewrite Hcval3_pt. exact HRle_3_4t. }
    claim Hpt_AIII : (1, t) :e A_III.
    { exact (SepI unit_square (fun p:set => Rle (apply_fun const3 p) (apply_fun L_fun p)) (1, t) Hpt HRle_c3_L). }
    (** (1,t) :e A_23 **)
    claim Hcval2_pt : apply_fun const2 (1, t) = 2. { exact (Hconst2_val (1, t) Hpt). }
    claim HRle_2_3 : Rle 2 3. { exact HRle23. }
    claim HRle_2_4t : Rle 2 (add_SNo 4 t).
    { exact (Rle_tra 2 3 (add_SNo 4 t) HRle23 HRle_3_4t). }
    claim HRle_c2_L : Rle (apply_fun const2 (1, t)) (apply_fun L_fun (1, t)).
    { rewrite HLval. rewrite Hcval2_pt. exact HRle_2_4t. }
    claim Hpt_A23 : (1, t) :e A_23.
    { exact (SepI unit_square (fun p:set => Rle (apply_fun const2 p) (apply_fun L_fun p)) (1, t) Hpt HRle_c2_L). }
    (** F(1,t) = F_23(1,t) = F_III(1,t) **)
    rewrite (HF_23_eq (1, t) Hpt_A23).
    rewrite (HF_23_III (1, t) Hpt_AIII).
    (** F_III(1,t) = h(div_SNo (4+t-3) (1+t)) **)
    rewrite (HapplyF_III (1, t) Hpt_AIII).
    rewrite (tuple_2_0_eq 1 t).
    rewrite (tuple_2_1_eq 1 t).
    rewrite (mul_SNo_oneL 4 HSNo4).
    (** Simplify numerator: (4+t)+(-3) = 1+t **)
    claim Hnum_eq : add_SNo (add_SNo 4 t) (minus_SNo 3) = add_SNo 1 t.
    { (** Chain: (4+t)+(-3) = 4+(t+(-3)) = 4+((-3)+t) = (4+(-3))+t = 1+t **)
      claim H31eq4 : add_SNo 3 1 = 4.
      { exact (add_SNo_1_ordsucc 3 H3omega). }
      claim H13eq4 : add_SNo 1 3 = 4.
      { exact (add_SNo_com 1 3 SNo_1 HSNo3 (fun x y:set => y = 4) H31eq4). }
      claim Heq_rev_assoc : add_SNo (add_SNo 4 t) (minus_SNo 3) = add_SNo 4 (add_SNo t (minus_SNo 3)).
      { exact (fun Q => (add_SNo_assoc 4 t (minus_SNo 3) HSNo4 HtSNo HSNo_m3) (fun x y => Q y x)). }
      claim Heq_com_inner : add_SNo t (minus_SNo 3) = add_SNo (minus_SNo 3) t.
      { exact (add_SNo_com t (minus_SNo 3) HtSNo HSNo_m3). }
      claim Heq_assoc : add_SNo 4 (add_SNo (minus_SNo 3) t) = add_SNo (add_SNo 4 (minus_SNo 3)) t.
      { exact (add_SNo_assoc 4 (minus_SNo 3) t HSNo4 HSNo_m3 HtSNo). }
      claim H4m3_eq_1 : add_SNo 4 (minus_SNo 3) = 1.
      { exact (H13eq4 (fun x y:set => add_SNo x (minus_SNo 3) = 1) (add_SNo_minus_R2 1 3 SNo_1 HSNo3)). }
      rewrite Heq_rev_assoc.
      rewrite Heq_com_inner.
      rewrite Heq_assoc.
      rewrite H4m3_eq_1.
      exact (fun Q H => H). }
    rewrite Hnum_eq.
    (** Simplify div_SNo (1+t) (1+t) = 1 **)
    claim H1t_ne_0 : add_SNo 1 t <> 0.
    { prove ~(add_SNo 1 t = 0). assume H_eq : add_SNo 1 t = 0.
      (** t < 1+t from 0 < 1 **)
      claim Ht_lt_1t : t < add_SNo 1 t.
      { exact (add_SNo_0L t HtSNo (fun a b:set => SNoLt a (add_SNo 1 t))
          (add_SNo_Lt1 0 t 1 SNo_0 HtSNo SNo_1 SNoLt_0_1)). }
      (** If 1+t = 0 then t < 0 **)
      claim Ht_lt_0 : t < 0.
      { exact (H_eq (fun a b:set => t < a) Ht_lt_1t). }
      (** Contradiction with Rle 0 t **)
      exact (RleE_nlt 0 t (unit_interval_Rle0 t Ht) (RltI t 0 HtR real_0 Ht_lt_0)). }
    claim Hdiv_eq : div_SNo (add_SNo 1 t) (add_SNo 1 t) = 1.
    { exact (recip_SNo_invR (add_SNo 1 t) HSNo_1t H1t_ne_0). }
    rewrite Hdiv_eq.
    exact Hh1.
Qed.

(** from S51 Thm 51.2 part (2) (line 232 in algtop.tex): right identity **)
(** EFFORT: 8 lines textbook, difficulty 6/10, USD 150 **)
(** Collected Alice 165 **)
(** Proven Alice **)
Theorem Theorem_51_2_right_identity : forall X Tx x0 x1 f:set,
  continuous_map unit_interval unit_interval_topology X Tx f ->
  apply_fun f 0 = x0 -> apply_fun f 1 = x1 ->
  x1 :e X ->
  path_homotopic X Tx x0 x1 (path_concat f (constant_path x1)) f.
let X Tx x0 x1 f.
assume Hcont : continuous_map unit_interval unit_interval_topology X Tx f.
assume Hf0 : apply_fun f 0 = x0.
assume Hf1 : apply_fun f 1 = x1.
assume Hx1X : x1 :e X.
claim HtopX : topology_on X Tx.
{ exact (continuous_map_topology_cod unit_interval unit_interval_topology X Tx f Hcont). }
claim Hfon : function_on f unit_interval X.
{ exact (continuous_map_function_on unit_interval unit_interval_topology X Tx f Hcont). }
(** Constant path continuous **)
claim Hce : continuous_map unit_interval unit_interval_topology X Tx (constant_path x1).
{ exact (constant_path_continuous X Tx x1 HtopX Hx1X). }
(** Endpoint compatibility **)
claim Hfg : apply_fun f 1 = apply_fun (constant_path x1) 0.
{ rewrite Hf1. rewrite (constant_path_at_zero x1). exact (fun Q H => H). }
(** path_concat continuous **)
claim Hconcat_cont : continuous_map unit_interval unit_interval_topology X Tx (path_concat f (constant_path x1)).
{ exact (path_concat_continuous X Tx x0 x1 x1 f (constant_path x1) Hcont Hce Hf0 Hf1
    (constant_path_at_zero x1) (constant_path_at_one x1)). }
(** Endpoint of path_concat at 0 **)
claim Hconcat_0 : apply_fun (path_concat f (constant_path x1)) 0 = x0.
{ rewrite (path_concat_apply_left f (constant_path x1) 0 Hfg zero_in_unit_interval_left_half).
  rewrite (mul_SNo_zeroR 2 SNo_2). exact Hf0. }
(** Endpoint of path_concat at 1 **)
claim H2m1 : add_SNo (mul_SNo 2 1) (minus_SNo 1) = 1.
{ exact (double_minus_one_map_apply 1 one_in_unit_interval_right_half
    (fun a b:set => a = 1) double_minus_one_map_at_1). }
claim Hconcat_1 : apply_fun (path_concat f (constant_path x1)) 1 = x1.
{ rewrite (path_concat_apply_right f (constant_path x1) 1 Hfg one_in_unit_interval_right_half).
  rewrite H2m1. exact (constant_path_at_one x1). }
(** Main construction via pasting lemma **)
prove continuous_map unit_interval unit_interval_topology X Tx (path_concat f (constant_path x1)) /\
  continuous_map unit_interval unit_interval_topology X Tx f /\
  apply_fun (path_concat f (constant_path x1)) 0 = x0 /\ apply_fun (path_concat f (constant_path x1)) 1 = x1 /\
  apply_fun f 0 = x0 /\ apply_fun f 1 = x1 /\
  exists F:set,
    continuous_map unit_square unit_square_topology X Tx F /\
    (forall s:set, s :e unit_interval ->
      apply_fun F (s, 0) = apply_fun (path_concat f (constant_path x1)) s) /\
    (forall s:set, s :e unit_interval ->
      apply_fun F (s, 1) = apply_fun f s) /\
    (forall t:set, t :e unit_interval ->
      apply_fun F (0, t) = x0) /\
    (forall t:set, t :e unit_interval ->
      apply_fun F (1, t) = x1).
apply and7I.
- exact Hconcat_cont.
- exact Hcont.
- exact Hconcat_0.
- exact Hconcat_1.
- exact Hf0.
- exact Hf1.
- set A : set := setprod unit_interval_left_half unit_interval.
  set B : set := setprod unit_interval_right_half unit_interval.
  set TALH : set := subspace_topology unit_interval unit_interval_topology unit_interval_left_half.
  set TARH : set := subspace_topology unit_interval unit_interval_topology unit_interval_right_half.
  claim HtopLH : topology_on unit_interval_left_half TALH.
  { exact (subspace_topology_is_topology unit_interval unit_interval_topology unit_interval_left_half
      unit_interval_topology_on unit_interval_left_half_sub). }
  claim HtopRH : topology_on unit_interval_right_half TARH.
  { exact (subspace_topology_is_topology unit_interval unit_interval_topology unit_interval_right_half
      unit_interval_topology_on unit_interval_right_half_sub). }
  set TA : set := product_topology unit_interval_left_half TALH unit_interval unit_interval_topology.
  set TB : set := product_topology unit_interval_right_half TARH unit_interval unit_interval_topology.
  claim HtopA : topology_on A TA.
  { exact (product_topology_is_topology unit_interval_left_half TALH unit_interval unit_interval_topology HtopLH unit_interval_topology_on). }
  claim HtopB : topology_on B TB.
  { exact (product_topology_is_topology unit_interval_right_half TARH unit_interval unit_interval_topology HtopRH unit_interval_topology_on). }
  (** Topology equalities **)
  claim Htop_eqA : TA = subspace_topology unit_square unit_square_topology A.
  { exact ((subspace_topology_whole unit_interval unit_interval_topology unit_interval_topology_on)
      (fun a b:set => product_topology unit_interval_left_half TALH unit_interval a = subspace_topology unit_square unit_square_topology A)
      (product_subspace_topology unit_interval unit_interval_topology unit_interval unit_interval_topology unit_interval_left_half unit_interval
        unit_interval_topology_on unit_interval_topology_on unit_interval_left_half_sub (Subq_ref unit_interval))). }
  claim Htop_eqA_sym : subspace_topology unit_square unit_square_topology A = TA.
  { exact (fun Q => Htop_eqA (fun x y:set => Q y x)). }
  claim Htop_eqB : TB = subspace_topology unit_square unit_square_topology B.
  { exact ((subspace_topology_whole unit_interval unit_interval_topology unit_interval_topology_on)
      (fun a b:set => product_topology unit_interval_right_half TARH unit_interval a = subspace_topology unit_square unit_square_topology B)
      (product_subspace_topology unit_interval unit_interval_topology unit_interval unit_interval_topology unit_interval_right_half unit_interval
        unit_interval_topology_on unit_interval_topology_on unit_interval_right_half_sub (Subq_ref unit_interval))). }
  claim Htop_eqB_sym : subspace_topology unit_square unit_square_topology B = TB.
  { exact (fun Q => Htop_eqB (fun x y:set => Q y x)). }
  (** A and B are closed and cover unit_square **)
  claim HclosedA : closed_in unit_square unit_square_topology A.
  { exact (ex17_3_product_of_closed_sets_closed unit_interval unit_interval_topology unit_interval unit_interval_topology
      unit_interval_left_half unit_interval
      (andEL (closed_in unit_interval unit_interval_topology unit_interval_left_half) (closed_in unit_interval unit_interval_topology unit_interval_right_half) unit_interval_halves_closed)
      (X_is_closed unit_interval unit_interval_topology unit_interval_topology_on)). }
  claim HclosedB : closed_in unit_square unit_square_topology B.
  { exact (ex17_3_product_of_closed_sets_closed unit_interval unit_interval_topology unit_interval unit_interval_topology
      unit_interval_right_half unit_interval
      (andER (closed_in unit_interval unit_interval_topology unit_interval_left_half) (closed_in unit_interval unit_interval_topology unit_interval_right_half) unit_interval_halves_closed)
      (X_is_closed unit_interval unit_interval_topology unit_interval_topology_on)). }
  claim Hcover : A :\/: B = unit_square.
  { apply set_ext.
    - exact (binunion_Subq_min A B unit_square
        (setprod_Subq unit_interval_left_half unit_interval unit_interval unit_interval unit_interval_left_half_sub (Subq_ref unit_interval))
        (setprod_Subq unit_interval_right_half unit_interval unit_interval unit_interval unit_interval_right_half_sub (Subq_ref unit_interval))).
    - let p. assume Hp.
      claim Hp0I : (p 0) :e unit_interval.
      { exact (ap0_Sigma unit_interval (fun _ : set => unit_interval) p Hp). }
      claim Hp1I : (p 1) :e unit_interval.
      { exact (ap1_Sigma unit_interval (fun _ : set => unit_interval) p Hp). }
      claim Hp0LHRH : (p 0) :e unit_interval_left_half :\/: unit_interval_right_half.
      { exact (unit_interval_halves_cover (fun a b:set => (p 0) :e a -> (p 0) :e b)
          (binunion_Subq_min unit_interval_left_half unit_interval_right_half unit_interval
            unit_interval_left_half_sub unit_interval_right_half_sub (p 0))
          Hp0I). }
      apply (setprod_eta unit_interval unit_interval p Hp (fun a b:set => b :e A :\/: B)).
      apply (binunionE unit_interval_left_half unit_interval_right_half (p 0) Hp0LHRH).
      + assume Hp0LH.
        exact (binunionI1 A B (p 0, p 1)
          (tuple_2_setprod_by_pair_Sigma unit_interval_left_half unit_interval (p 0) (p 1) Hp0LH Hp1I)).
      + assume Hp0RH.
        exact (binunionI2 A B (p 0, p 1)
          (tuple_2_setprod_by_pair_Sigma unit_interval_right_half unit_interval (p 0) (p 1) Hp0RH Hp1I)). }
  (** Build projections on A **)
  claim Hproj1A : continuous_map A TA unit_interval_left_half TALH (projection_map1 unit_interval_left_half unit_interval).
  { exact (andEL
      (continuous_map A TA unit_interval_left_half TALH (projection_map1 unit_interval_left_half unit_interval))
      (continuous_map A TA unit_interval unit_interval_topology (projection_map2 unit_interval_left_half unit_interval))
      (projections_are_continuous unit_interval_left_half TALH unit_interval unit_interval_topology HtopLH unit_interval_topology_on)). }
  claim Hproj2A : continuous_map A TA unit_interval unit_interval_topology (projection_map2 unit_interval_left_half unit_interval).
  { exact (andER
      (continuous_map A TA unit_interval_left_half TALH (projection_map1 unit_interval_left_half unit_interval))
      (continuous_map A TA unit_interval unit_interval_topology (projection_map2 unit_interval_left_half unit_interval))
      (projections_are_continuous unit_interval_left_half TALH unit_interval unit_interval_topology HtopLH unit_interval_topology_on)). }
  (** double_s: A -> I, maps (s,t) -> 2s **)
  claim Hdouble_s : continuous_map A TA unit_interval unit_interval_topology
    (compose_fun A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half).
  { exact (composition_continuous A TA unit_interval_left_half TALH unit_interval unit_interval_topology
      (projection_map1 unit_interval_left_half unit_interval) double_map_left_half Hproj1A double_map_continuous). }
  (** const_eps1: A -> I, constant function eps_1 **)
  claim Hconst_eps1A : continuous_map A TA unit_interval unit_interval_topology (const_fun A (eps_ 1)).
  { exact (const_fun_continuous A TA unit_interval unit_interval_topology (eps_ 1) HtopA unit_interval_topology_on eps_1_in_unit_interval). }
  (** t_eps1: A -> I, maps (s,t) -> t eps_1 **)
  set t_eps1A : set := compose_fun A (pair_map A (projection_map2 unit_interval_left_half unit_interval) (const_fun A (eps_ 1))) mul_fun_R.
  claim Ht_eps1A : continuous_map A TA unit_interval unit_interval_topology t_eps1A.
  { exact (mul_two_continuous_unit_interval A TA (projection_map2 unit_interval_left_half unit_interval) (const_fun A (eps_ 1))
      HtopA Hproj2A Hconst_eps1A). }
  (** flip_t_eps1: A -> I, maps (s,t) -> 1 - t eps_1 **)
  set flip_t_eps1A : set := compose_fun A t_eps1A flip_unit_interval.
  claim Hflip_t_eps1A : continuous_map A TA unit_interval unit_interval_topology flip_t_eps1A.
  { exact (composition_continuous A TA unit_interval unit_interval_topology unit_interval unit_interval_topology
      t_eps1A flip_unit_interval Ht_eps1A flip_unit_interval_continuous). }
  (** psi_A: A -> I, maps (s,t) -> (2s)(1 - t eps_1) **)
  set psi_A : set := compose_fun A (pair_map A (compose_fun A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half) flip_t_eps1A) mul_fun_R.
  claim Hpsi_A : continuous_map A TA unit_interval unit_interval_topology psi_A.
  { exact (mul_two_continuous_unit_interval A TA
      (compose_fun A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half) flip_t_eps1A
      HtopA Hdouble_s Hflip_t_eps1A). }
  (** F_A = f o psi_A: A -> X **)
  set fA : set := compose_fun A psi_A f.
  claim HcontfA : continuous_map A (subspace_topology unit_square unit_square_topology A) X Tx fA.
  { rewrite Htop_eqA_sym.
    exact (composition_continuous A TA unit_interval unit_interval_topology X Tx psi_A f Hpsi_A Hcont). }
  (** Build projections on B **)
  claim Hproj1B : continuous_map B TB unit_interval_right_half TARH (projection_map1 unit_interval_right_half unit_interval).
  { exact (andEL
      (continuous_map B TB unit_interval_right_half TARH (projection_map1 unit_interval_right_half unit_interval))
      (continuous_map B TB unit_interval unit_interval_topology (projection_map2 unit_interval_right_half unit_interval))
      (projections_are_continuous unit_interval_right_half TARH unit_interval unit_interval_topology HtopRH unit_interval_topology_on)). }
  claim Hproj2B : continuous_map B TB unit_interval unit_interval_topology (projection_map2 unit_interval_right_half unit_interval).
  { exact (andER
      (continuous_map B TB unit_interval_right_half TARH (projection_map1 unit_interval_right_half unit_interval))
      (continuous_map B TB unit_interval unit_interval_topology (projection_map2 unit_interval_right_half unit_interval))
      (projections_are_continuous unit_interval_right_half TARH unit_interval unit_interval_topology HtopRH unit_interval_topology_on)). }
  (** proj1_I_B: B -> I, expand codomain from RH to I **)
  claim Hproj1B_I : continuous_map B TB unit_interval unit_interval_topology (projection_map1 unit_interval_right_half unit_interval).
  { exact (continuous_map_range_expand B TB unit_interval_right_half TARH unit_interval unit_interval_topology
      (projection_map1 unit_interval_right_half unit_interval) Hproj1B unit_interval_right_half_sub unit_interval_topology_on
      (fun Q H => H)). }
  (** flip_s_B: B -> I, maps (s,t) -> 1-s **)
  set flip_s_B : set := compose_fun B (projection_map1 unit_interval_right_half unit_interval) flip_unit_interval.
  claim Hflip_s_B : continuous_map B TB unit_interval unit_interval_topology flip_s_B.
  { exact (composition_continuous B TB unit_interval unit_interval_topology unit_interval unit_interval_topology
      (projection_map1 unit_interval_right_half unit_interval) flip_unit_interval Hproj1B_I flip_unit_interval_continuous). }
  (** t_flip_s_B: B -> I, maps (s,t) -> t(1-s) **)
  set t_flip_s_B : set := compose_fun B (pair_map B (projection_map2 unit_interval_right_half unit_interval) flip_s_B) mul_fun_R.
  claim Ht_flip_s_B : continuous_map B TB unit_interval unit_interval_topology t_flip_s_B.
  { exact (mul_two_continuous_unit_interval B TB (projection_map2 unit_interval_right_half unit_interval) flip_s_B
      HtopB Hproj2B Hflip_s_B). }
  (** psi_B: B -> I, maps (s,t) -> 1 - t(1-s) **)
  set psi_B : set := compose_fun B t_flip_s_B flip_unit_interval.
  claim Hpsi_B : continuous_map B TB unit_interval unit_interval_topology psi_B.
  { exact (composition_continuous B TB unit_interval unit_interval_topology unit_interval unit_interval_topology
      t_flip_s_B flip_unit_interval Ht_flip_s_B flip_unit_interval_continuous). }
  (** F_B = f o psi_B: B -> X **)
  set gB : set := compose_fun B psi_B f.
  claim HcontgB : continuous_map B (subspace_topology unit_square unit_square_topology B) X Tx gB.
  { rewrite Htop_eqB_sym.
    exact (composition_continuous B TB unit_interval unit_interval_topology X Tx psi_B f Hpsi_B Hcont). }
  (** Helper: 1 - eps_1 = eps_1 **)
  claim Hflip_eps1 : add_SNo 1 (minus_SNo (eps_ 1)) = eps_ 1.
  { exact (fun Q H =>
      eps_1_half_eq1 (fun a b => Q (eps_ 1) (add_SNo a (minus_SNo (eps_ 1))))
        (add_SNo_minus_R2 (eps_ 1) (eps_ 1) SNo_eps_1 SNo_eps_1 Q
          (eps_1_half_eq1 (fun a b => Q (add_SNo b (minus_SNo (eps_ 1))) (eps_ 1)) H))). }
  claim Htop : topology_on unit_square unit_square_topology.
  { exact (product_topology_is_topology unit_interval unit_interval_topology unit_interval unit_interval_topology
      unit_interval_topology_on unit_interval_topology_on). }
  (** Unit_interval x unit_interval is subset of R x R **)
  claim HII_RR : setprod unit_interval unit_interval c= setprod R R.
  { exact (setprod_Subq unit_interval unit_interval R R unit_interval_sub_R unit_interval_sub_R). }
  (** Agreement on intersection A :/\: B **)
  claim Hagree : forall p:set, p :e A :/\: B -> apply_fun fA p = apply_fun gB p.
  { let p. assume Hp.
    claim HpA : p :e A. { exact (binintersectE1 A B p Hp). }
    claim HpB : p :e B. { exact (binintersectE2 A B p Hp). }
    claim Hp0LH : (p 0) :e unit_interval_left_half. { exact (ap0_Sigma unit_interval_left_half (fun _ : set => unit_interval) p HpA). }
    claim Hp0RH : (p 0) :e unit_interval_right_half. { exact (ap0_Sigma unit_interval_right_half (fun _ : set => unit_interval) p HpB). }
    claim Hp1I : (p 1) :e unit_interval. { exact (ap1_Sigma unit_interval_left_half (fun _ : set => unit_interval) p HpA). }
    claim Hp0_eq : (p 0) = eps_ 1.
    { exact (singleton_elem (p 0) (eps_ 1)
        (unit_interval_halves_intersection (fun a b:set => (p 0) :e b -> (p 0) :e a)
          (fun H:(p 0) :e {eps_ 1} =>
            (singleton_elem (p 0) (eps_ 1) H) (fun a b:set => b :e unit_interval_left_half :/\: unit_interval_right_half)
              (binintersectI unit_interval_left_half unit_interval_right_half (eps_ 1)
                eps_1_in_unit_interval_left_half eps_1_in_unit_interval_right_half))
          (binintersectI unit_interval_left_half unit_interval_right_half (p 0) Hp0LH Hp0RH))). }
    rewrite (compose_fun_apply A psi_A f p HpA).
    rewrite (compose_fun_apply B psi_B f p HpB).
    (** Need to show: apply_fun f (apply_fun psi_A p) = apply_fun f (apply_fun psi_B p) **)
    (** It suffices to show psi_A(p) = psi_B(p) **)
    claim HpsiA_eq : apply_fun psi_A p = add_SNo 1 (minus_SNo (mul_SNo (p 1) (eps_ 1))).
    { claim Hdbl_p : apply_fun (compose_fun A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half) p :e unit_interval.
      { exact (continuous_map_function_on A TA unit_interval unit_interval_topology
          (compose_fun A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half) Hdouble_s p HpA). }
      claim Hflip_p : apply_fun flip_t_eps1A p :e unit_interval.
      { exact (continuous_map_function_on A TA unit_interval unit_interval_topology
          flip_t_eps1A Hflip_t_eps1A p HpA). }
      rewrite (mul_of_pair_map_apply A
        (compose_fun A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half)
        flip_t_eps1A p HpA
        (unit_interval_sub_R (apply_fun (compose_fun A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half) p) Hdbl_p)
        (unit_interval_sub_R (apply_fun flip_t_eps1A p) Hflip_p)).
      rewrite (compose_fun_apply A (projection_map1 unit_interval_left_half unit_interval) double_map_left_half p HpA).
      rewrite (projection1_apply unit_interval_left_half unit_interval p HpA).
      rewrite Hp0_eq.
