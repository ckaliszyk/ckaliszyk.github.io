Axiom open_ray_upper_in_open_rays_subbasis : forall X a : set , a :e X -> open_ray_upper X a :e open_rays_subbasis X.
Axiom open_ray_lower_in_open_rays_subbasis : forall X b : set , b :e X -> open_ray_lower X b :e open_rays_subbasis X.
Axiom open_interval_eq_rays_intersection : forall X a b : set , {x :e X|order_rel X a x /\ order_rel X x b} = (open_ray_upper X a) :/\: (open_ray_lower X b).
Axiom order_topology_basis_sub_generated_from_open_rays : forall X : set , order_topology_basis X c= generated_topology_from_subbasis X (open_rays_subbasis X).
Axiom open_rays_subbasis_for_order_topology : forall X : set , simply_ordered_set X -> generated_topology_from_subbasis X (open_rays_subbasis X) = order_topology X.
Axiom R_standard_basis_is_basis : basis_on R R_standard_basis.
Axiom R_standard_topology_is_topology : topology_on R R_standard_topology.
Axiom open_interval_in_order_topology_basis_R : forall a b : set , a :e R -> b :e R -> open_interval a b :e order_topology_basis R.
