      {(t, apply_fun (reverse_path alpha) (mul_SNo 2 t)) | t :e unit_interval_left_half}
      {(t, apply_fun (path_concat eps alpha) (add_SNo (mul_SNo 2 t) (minus_SNo 1))) | t :e unit_interval_right_half}
      p
      Hp).
