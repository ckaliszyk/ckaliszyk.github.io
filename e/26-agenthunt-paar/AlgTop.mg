Axiom ex30_1b_AF_openI_avoids_p : forall U : set , U :e Power ex30_1b_AF_X -> ex30_1b_AF_p /:e U -> U :e ex30_1b_AF_Tx.
Axiom ex30_1b_AF_Un_open : forall n : set , n :e omega -> open_in ex30_1b_AF_X ex30_1b_AF_Tx ({ex30_1b_AF_p} :\/: {w :e ex30_1b_AF_X|n c= w 1}).
Axiom ex30_1b_AF_singleton_open : forall x : set , x :e ex30_1b_AF_X -> ~ (x = ex30_1b_AF_p) -> open_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing x).
Axiom ex30_1b_AF_singleton_Gdelta_not_p : forall x : set , x :e ex30_1b_AF_X -> ~ (x = ex30_1b_AF_p) -> Gdelta_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing x).
Axiom ex30_1b_AF_singleton_Gdelta_p : Gdelta_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing ex30_1b_AF_p).
Axiom ex30_1b_AF_all_singletons_Gdelta : forall x : set , x :e ex30_1b_AF_X -> Gdelta_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing x).
Axiom ex30_1b_AF_not_first_countable : ~ first_countable_space ex30_1b_AF_X ex30_1b_AF_Tx.
Axiom ex30_1b_Gdelta_not_firstcountable_exists : exists X : set , exists Tx : set , topology_on X Tx /\ (forall x : set , x :e X -> Gdelta_in X Tx (Sing x)) /\ ~ first_countable_space X Tx.
Axiom ex30_2_basis_contains_countable : forall X Tx : set , forall Basis : set , second_countable_space X Tx -> basis_generates X Basis Tx -> exists CountableSub : set , CountableSub c= Basis /\ countable CountableSub /\ basis_generates X CountableSub Tx.
Axiom ex30_3_uncountably_many_limit_points : forall X Tx A : set , second_countable_space X Tx -> A c= X -> ~ countable A -> ~ countable {x :e A|limit_point_of X Tx A x}.
Axiom ex30_4_compact_metrizable_second_countable : forall X Tx d : set , compact_space X Tx -> metrizable X Tx -> metric_on X d -> Tx = metric_topology X d -> second_countable_space X Tx.
Axiom ex30_5a_metrizable_countable_dense_second_countable : forall X Tx : set , metrizable X Tx -> (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) -> second_countable_space X Tx.
Axiom ex30_5b_metrizable_Lindelof_second_countable : forall X Tx : set , metrizable X Tx -> Lindelof_space X Tx -> second_countable_space X Tx.
Axiom ex30_6a_Rl_not_metrizable : ~ metrizable R R_lower_limit_topology.
Axiom ex30_6b_ordered_square_not_metrizable : ~ metrizable ordered_square ordered_square_topology.
Axiom ex30_7_SOmega_Sbar_Omega_countability : (first_countable_space S_Omega SOmega_topology /\ ~ second_countable_space S_Omega SOmega_topology /\ ~ Lindelof_space S_Omega SOmega_topology /\ ~ (exists D : set , D c= S_Omega /\ countable D /\ dense_in D S_Omega SOmega_topology)) /\ (~ first_countable_space Sbar_Omega SbarOmega_topology /\ ~ second_countable_space Sbar_Omega SbarOmega_topology /\ Lindelof_space Sbar_Omega SbarOmega_topology /\ ~ (exists D : set , D c= Sbar_Omega /\ countable D /\ dense_in D Sbar_Omega SbarOmega_topology)).
Axiom ex30_8_Romega_uniform_countability : first_countable_space real_sequences uniform_topology /\ ~ second_countable_space real_sequences uniform_topology /\ ~ Lindelof_space real_sequences uniform_topology /\ ~ (exists D : set , D c= real_sequences /\ countable D /\ dense_in D real_sequences uniform_topology).
Axiom ex30_9a_closed_Lindelof : forall X Tx A : set , Lindelof_space X Tx -> closed_in X Tx A -> Lindelof_space A (subspace_topology X Tx A).
Axiom ex30_9b_dense_not_countable_dense : exists X : set , exists Tx : set , exists A : set , (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) /\ closed_in X Tx A /\ ~ (exists DA : set , DA c= A /\ countable DA /\ dense_in DA A (subspace_topology X Tx A)).
Axiom ex30_10_product_countable_dense : forall Idx : set , forall Fam : set , countable Idx -> (forall i : set , i :e Idx -> exists Xi : set , exists Txi : set , exists Di : set , apply_fun Fam i = (Xi,Txi) /\ topology_on Xi Txi /\ Di c= Xi /\ countable Di /\ dense_in Di Xi Txi) -> exists D : set , D c= product_space Idx Fam /\ countable D /\ dense_in D (product_space Idx Fam) (product_topology_full Idx Fam).
Axiom ex30_11a_image_Lindelof : forall X Tx Y Ty f : set , Lindelof_space X Tx -> continuous_map X Tx Y Ty f -> Lindelof_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_11b_image_countable_dense : forall X Tx Y Ty f : set , (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) -> continuous_map X Tx Y Ty f -> exists Df : set , Df c= (image_of f X) /\ countable Df /\ dense_in Df (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom continuous_image_countable_dense_subset : forall X Tx Y Ty f : set , countable_dense_subset X Tx -> continuous_map X Tx Y Ty f -> countable_dense_subset (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom continuous_image_separable_space : forall X Tx Y Ty f : set , separable_space X Tx -> continuous_map X Tx Y Ty f -> separable_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_12a_open_map_first_countable : forall X Tx Y Ty f : set , first_countable_space X Tx -> continuous_map X Tx Y Ty f -> open_map X Tx Y Ty f -> first_countable_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_12b_open_map_second_countable : forall X Tx Y Ty f : set , second_countable_space X Tx -> continuous_map X Tx Y Ty f -> open_map X Tx Y Ty f -> second_countable_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_13_disjoint_open_sets_countable : forall X Tx : set , (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) -> forall Fam : set , (forall U : set , U :e Fam -> open_in X Tx U) -> (forall U V : set , U :e Fam -> V :e Fam -> U <> V -> U :/\: V = Empty) -> countable Fam.
Axiom ex30_14_product_Lindelof_compact : forall X Tx Y Ty : set , Lindelof_space X Tx -> compact_space Y Ty -> Lindelof_space (setprod X Y) (product_topology X Tx Y Ty).
Definition graphify_on : set -> set -> set := fun X f => graph X (fun x : set => apply_fun f x).
Axiom graphify_on_apply : forall X f x : set , x :e X -> apply_fun (graphify_on X f) x = apply_fun f x.
Axiom graphify_on_idem : forall X f : set , graphify_on X (graphify_on X f) = graphify_on X f.
Axiom graphify_on_unit_interval_in_power_real : forall f : set , function_on f unit_interval R -> graphify_on unit_interval f :e power_real unit_interval.
Axiom graphify_on_unit_interval_in_function_space : forall f : set , function_on f unit_interval R -> graphify_on unit_interval f :e function_space unit_interval R.
Axiom graphify_on_unit_interval_in_C_I_R : forall f : set , f :e C_I_R -> graphify_on unit_interval f :e C_I_R.
Definition uniform_metric_C_I_R : set := graph (setprod C_I_R C_I_R) (fun p : set => power_real_uniform_metric_value unit_interval (graphify_on unit_interval (p 0)) (graphify_on unit_interval (p 1))).
