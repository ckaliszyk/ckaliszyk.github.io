claim Hhome :
  homeomorphism Ux (subspace_topology E Te Ux) Ue (subspace_topology B Tb Ue)
    (graph Ux (fun z:set => apply_fun p z)).
{
  exact (andER
    ((Ux :e Te /\ apply_fun ft1 t0 :e Ux) /\ Ue :e Tb)
    (homeomorphism Ux (subspace_topology E Te Ux) Ue (subspace_topology B Tb Ue)
      (graph Ux (fun z:set => apply_fun p z)))
