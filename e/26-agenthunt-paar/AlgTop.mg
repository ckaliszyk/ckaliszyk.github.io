    R
    R
    0
    0
    real_0
    real_0).
- rewrite tuple_2_0_eq at 1.
  rewrite tuple_2_0_eq at 1.
  rewrite tuple_2_1_eq at 1.
  rewrite tuple_2_1_eq at 1.
  rewrite (mul_SNo_zeroR 0 SNo_0) at 1.
  rewrite (mul_SNo_zeroR 0 SNo_0) at 1.
  rewrite (add_SNo_0R 0 SNo_0).
  exact (not_Rlt_sym
    0
    1
    Rlt_0_1).
Qed.

