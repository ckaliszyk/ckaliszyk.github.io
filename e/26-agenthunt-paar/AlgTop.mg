Axiom uniform_metric_C_I_R_function_on : function_on uniform_metric_C_I_R (setprod C_I_R C_I_R) R.
Axiom uniform_metric_C_I_R_apply : forall f g : set , f :e C_I_R -> g :e C_I_R -> apply_fun uniform_metric_C_I_R (f,g) = power_real_uniform_metric_value unit_interval (graphify_on unit_interval f) (graphify_on unit_interval g).
Axiom uniform_metric_C_I_R_sym : forall f g : set , f :e C_I_R -> g :e C_I_R -> apply_fun uniform_metric_C_I_R (f,g) = apply_fun uniform_metric_C_I_R (g,f).
Axiom uniform_metric_C_I_R_triangle : forall f g h : set , f :e C_I_R -> g :e C_I_R -> h :e C_I_R -> ~ (Rlt (add_SNo (apply_fun uniform_metric_C_I_R (f,g)) (apply_fun uniform_metric_C_I_R (g,h))) (apply_fun uniform_metric_C_I_R (f,h))).
Axiom uniform_metric_C_I_R_self_zero : forall f : set , f :e C_I_R -> apply_fun uniform_metric_C_I_R (f,f) = 0.
Axiom uniform_metric_C_I_R_nonneg : forall f g : set , f :e C_I_R -> g :e C_I_R -> ~ (Rlt (apply_fun uniform_metric_C_I_R (f,g)) 0).
Axiom power_real_uniform_metric_value_le_1 : forall J f g : set , J <> Empty -> f :e power_real J -> g :e power_real J -> Rle (power_real_uniform_metric_value J f g) 1.
Axiom uniform_metric_C_I_R_le_1 : forall f g : set , f :e C_I_R -> g :e C_I_R -> Rle (apply_fun uniform_metric_C_I_R (f,g)) 1.
Axiom open_ball_C_I_R_of_pointwise_bd_le : forall f g eps eps0 : set , f :e C_I_R -> g :e C_I_R -> eps :e R -> eps0 :e R -> Rlt eps0 eps -> (forall x : set , x :e unit_interval -> Rle (R_bounded_distance (apply_fun f x) (apply_fun g x)) eps0) -> g :e open_ball C_I_R uniform_metric_C_I_R f eps.
Axiom open_ball_C_I_R_of_pointwise_abs_le_lt1 : forall f g eps eps0 : set , f :e C_I_R -> g :e C_I_R -> eps :e R -> eps0 :e R -> Rlt eps0 1 -> Rlt eps0 eps -> (forall x : set , x :e unit_interval -> Rle (abs_SNo (add_SNo (apply_fun f x) (minus_SNo (apply_fun g x)))) eps0) -> g :e open_ball C_I_R uniform_metric_C_I_R f eps.
Axiom open_ball_C_I_R_radius_gt1_whole : forall f eps : set , f :e C_I_R -> eps :e R -> Rlt 1 eps -> open_ball C_I_R uniform_metric_C_I_R f eps = C_I_R.
Axiom uniform_metric_C_I_R_is_pseudometric_on : pseudometric_on C_I_R uniform_metric_C_I_R.
Axiom uniform_metric_C_I_R_eq0_pointwise : forall f g x : set , f :e C_I_R -> g :e C_I_R -> x :e unit_interval -> apply_fun uniform_metric_C_I_R (f,g) = 0 -> apply_fun f x = apply_fun g x.
Axiom uniform_metric_C_I_R_eq0_pointwise_all : forall f g : set , f :e C_I_R -> g :e C_I_R -> apply_fun uniform_metric_C_I_R (f,g) = 0 -> forall x : set , x :e unit_interval -> apply_fun f x = apply_fun g x.
Definition C_I_R_graph : set := {graphify_on unit_interval f|f :e C_I_R}.
Definition U_n_graph : set -> set := fun n => {g :e C_I_R_graph|n :e omega /\ 2 c= n /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ exists r : set , r :e R /\ Rlt n r /\ forall x : set , x :e unit_interval -> Delta_gt g x h r}.
