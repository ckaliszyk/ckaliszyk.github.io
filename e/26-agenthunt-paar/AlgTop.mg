claim H2m1 : add_SNo 2 (minus_SNo 1) = 1.
{ claim H2eq : 2 = add_SNo 1 1.
  { exact (fun Q HQ => add_SNo_1_1_2 (fun a b:set => Q b a) HQ). }
  rewrite H2eq.
  exact (add_SNo_minus_R2 1 1 SNo_1 SNo_1). }
rewrite H2m1.
