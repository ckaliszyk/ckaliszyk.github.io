          x
          HxUV).
        rewrite (apply_fun_graph
          (U :/\: V)
          (fun z:set => z)
          x
          HxUV).
        rewrite (apply_fun_graph
          V
          (fun z:set => z)
          x
          (HUVsubV x HxUV)).
        reflexivity.
