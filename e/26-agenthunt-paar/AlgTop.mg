        claim HUsubB : U c= B.
        {
          exact (topology_elem_subset B Tb U HtopB HUtb).
        }
        claim HU'subB' : U' c= B'.
        {
          exact (topology_elem_subset B' Tb' U' HtopB' HU'tb).
        }
        claim HdomEq :
          product_topology
            (w 0) (subspace_topology E Te (w 0))
            (w 1) (subspace_topology E' Te' (w 1)) =
          subspace_topology
            (setprod E E')
            (product_topology E Te E' Te')
            (setprod (w 0) (w 1)).
        {
