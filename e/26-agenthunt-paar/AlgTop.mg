    }
    rewrite HphiEqX.
    rewrite HzeroMulR.
    reflexivity.
  }
  claim HphiEq : apply_fun phi x = apply_fun phi eG.
  {
    rewrite HphiX0.
    rewrite HphiE0.
    reflexivity.
  }
  claim HxEqE : x = eG.
  {
    exact (bijection_inj
      G
      int
      phi
      x
      eG
