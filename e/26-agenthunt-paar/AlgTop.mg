  apply_fun covering_map_R_S1 e1 = S1_basepoint ->
  e1 <> e0 ->
  ~(nulhomotopic S1 S1_topology S1 S1_topology (graph S1 (fun x:set => x))).
let e0 e1.
assume He0R He1R He0Base He1Base He1Ne0.
assume Hnul.
claim Hnontriv :
  exists cls:set,
    cls :e fundamental_group S1 S1_topology S1_basepoint /\
