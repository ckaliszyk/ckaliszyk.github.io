    rewrite <- HleftIdInvE.
    exact HleftInvE.
  }
  rewrite HgInvPow.
  rewrite Hxe.
  rewrite HinvE.
  exact (group_power_nat_identity_cyclic_helper
    G
    mult
    e
    inv
    (ordsucc m)
    Hgrp
    (omega_ordsucc m HmO)).
