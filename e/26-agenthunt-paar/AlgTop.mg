        H
        multH
        eH
        invH
        (apply_fun invH y)
        HgrpH
        HyInv).
    }
    apply Hpsi1Ex.
    let psi.
    assume HpsiPack.
    claim HpsiHom : group_homomorphism int integers_group_mult H multH psi.
    {
