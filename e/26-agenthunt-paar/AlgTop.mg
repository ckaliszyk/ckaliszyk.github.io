        exact (HinvFn b HbH).
      }
      claim HinvaH : apply_fun invH a :e H.
      {
        exact (HinvFn a HaH).
      }
      claim HinvbinvaH : apply_fun multH (apply_fun invH b, apply_fun invH a) :e H.
      {
        exact (HmultFn
          (apply_fun invH b, apply_fun invH a)
