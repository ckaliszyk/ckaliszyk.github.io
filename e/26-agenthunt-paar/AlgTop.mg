  }
  claim HyS : SNo y.
  {
    exact (int_SNo y Hy).
  }
  claim HmultDef :
    integers_group_mult =
    graph (setprod int int) (fun p:set => add_SNo (p 0) (p 1)).
  {
    reflexivity.
  }
  rewrite HmultDef.
  rewrite (apply_fun_graph
    (setprod int int)
    (fun p:set => add_SNo (p 0) (p 1))
    (x, y)
    (tuple_2_setprod_by_pair_Sigma
      int
      int
      x
      y
      Hx
      Hy)).
  rewrite (tuple_2_0_eq x y).
  rewrite (tuple_2_1_eq x y).
  rewrite (apply_fun_graph
    (setprod int int)
    (fun p:set => add_SNo (p 0) (p 1))
    (y, x)
    (tuple_2_setprod_by_pair_Sigma
      int
      int
      y
      x
      Hy
