    e0
    He0R).
}
claim HS1subR2 : S1 c= setprod R R.
{
  exact (Sep_Subq
    (setprod R R)
    (fun p:set =>
      add_SNo (mul_SNo (p 0) (p 0))
        (mul_SNo (p 1) (p 1)) = 1)).
}
