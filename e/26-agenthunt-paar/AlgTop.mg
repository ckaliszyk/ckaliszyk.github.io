}
claim HsubC : subgroup_of C G mult e inv.
{
  exact (andEL
    (subgroup_of C G mult e inv)
    (forall t g:set, t :e C -> g :e G ->
      apply_fun mult (apply_fun mult (g, t), apply_fun inv g) :e C)
