      HGFamFin
      HGFamElFinite).
  }
  claim HGFamElSubFam : forall A:set, A :e GFam -> A c= Fam.
  {
    let A.
    assume HAGFam.
    apply (ReplE
      U0
      (fun U:set => Eps_i (fun G:set => G c= Fam /\ finite G /\ preimage_of E p U c= Union G))
