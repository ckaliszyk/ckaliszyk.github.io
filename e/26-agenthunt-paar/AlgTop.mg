assume Halpha : alpha :e J.
assume Hbad :
  exists n:set, n :e omega /\ n <> 0 /\
    group_power_nat mult e (apply_fun gens alpha) n = e.
apply Hbad.
let n.
assume HnPack :
  n :e omega /\ n <> 0 /\
    group_power_nat mult e (apply_fun gens alpha) n = e.
apply (and3E
  (n :e omega)
  (n <> 0)
  (group_power_nat mult e (apply_fun gens alpha) n = e)
  HnPack).
assume HnO HnNZ HpowEqE.
