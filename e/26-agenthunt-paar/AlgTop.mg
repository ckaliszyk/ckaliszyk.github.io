Axiom Tietze_extension_real : forall X Tx A f : set , normal_space X Tx -> closed_in X Tx A -> continuous_map A (subspace_topology X Tx A) R R_standard_topology f -> exists g : set , continuous_map X Tx R R_standard_topology g /\ (forall x : set , x :e A -> apply_fun g x = apply_fun f x).
Definition m_manifold : set -> set -> set -> prop := fun X Tx m => Hausdorff_space X Tx /\ second_countable_space X Tx /\ m :e omega /\ forall x : set , x :e X -> exists U : set , U :e Tx /\ x :e U /\ exists V : set , V :e (euclidean_topology m) /\ exists f : set , homeomorphism U (subspace_topology X Tx U) V (subspace_topology (euclidean_space m) (euclidean_topology m) V) f.
Definition support_of : set -> set -> set -> set := fun X Tx phi => closure_of X Tx {x :e X|apply_fun phi x <> 0}.
Axiom support_of_sub_X : forall X Tx phi : set , topology_on X Tx -> support_of X Tx phi c= X.
Axiom support_of_closed_in : forall X Tx phi : set , topology_on X Tx -> closed_in X Tx (support_of X Tx phi).
Axiom support_of_contains_nonzero : forall X Tx phi x : set , topology_on X Tx -> x :e X -> apply_fun phi x <> 0 -> x :e support_of X Tx phi.
Axiom support_of_disjoint_open_implies_value_zero : forall X Tx phi N x : set , topology_on X Tx -> N :e Tx -> x :e N -> support_of X Tx phi :/\: N = Empty -> apply_fun phi x = 0.
Axiom support_of_mul_two_Subq_support_left : forall X Tx f g : set , topology_on X Tx -> (forall x : set , x :e X -> apply_fun f x :e R) -> (forall x : set , x :e X -> apply_fun g x :e R) -> support_of X Tx (compose_fun X (pair_map X f g) mul_fun_R) c= support_of X Tx f.
Axiom support_of_mul_two_Subq_support_right : forall X Tx f g : set , topology_on X Tx -> (forall x : set , x :e X -> apply_fun f x :e R) -> (forall x : set , x :e X -> apply_fun g x :e R) -> support_of X Tx (compose_fun X (pair_map X f g) mul_fun_R) c= support_of X Tx g.
Axiom open_intersects_closure_implies_intersects : forall X Tx A N : set , topology_on X Tx -> N :e Tx -> N :/\: closure_of X Tx A <> Empty -> N :/\: A <> Empty.
Axiom support_of_sub_closure_of : forall X Tx phi U : set , topology_on X Tx -> U c= X -> (forall x : set , x :e X -> apply_fun phi x <> 0 -> x :e U) -> support_of X Tx phi c= closure_of X Tx U.
Axiom Urysohn_bump_closed_in_open : forall X Tx A V : set , normal_space X Tx -> closed_in X Tx A -> V :e Tx -> A c= V -> exists f : set , continuous_map X Tx R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 1) /\ (forall x : set , x :e (X :\: V) -> apply_fun f x = 0) /\ (forall x : set , x :e X -> apply_fun f x :e unit_interval).
Axiom support_of_zero_outside_open_sub_closure : forall X Tx f V : set , topology_on X Tx -> V :e Tx -> (forall x : set , x :e (X :\: V) -> apply_fun f x = 0) -> support_of X Tx f c= closure_of X Tx V.
Axiom Urysohn_bump_support_sub_closure : forall X Tx A V : set , normal_space X Tx -> closed_in X Tx A -> V :e Tx -> A c= V -> exists f : set , continuous_map X Tx R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 1) /\ (forall x : set , x :e (X :\: V) -> apply_fun f x = 0) /\ (forall x : set , x :e X -> apply_fun f x :e unit_interval) /\ support_of X Tx f c= closure_of X Tx V.
Definition partition_of_unity_dominated : set -> set -> set -> prop := fun X Tx U => topology_on X Tx /\ open_cover X Tx U /\ exists P : set , P c= function_space X R /\ (forall f : set , f :e P -> continuous_map X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) /\ (forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)) /\ apply_fun p n = 1).
Definition partition_of_unity_family : set -> set -> set -> set -> prop := fun X Tx U P => P c= function_space X R /\ (forall f : set , f :e P -> continuous_map X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) /\ (forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)) /\ apply_fun p n = 1).
Definition partition_of_unity_dominated_total : set -> set -> set -> prop := fun X Tx U => topology_on X Tx /\ open_cover X Tx U /\ exists P : set , P c= total_function_space X R /\ (forall f : set , f :e P -> continuous_map_total X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) /\ (forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)) /\ apply_fun p n = 1).
Definition partition_of_unity_family_total : set -> set -> set -> set -> prop := fun X Tx U P => P c= total_function_space X R /\ (forall f : set , f :e P -> continuous_map_total X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) /\ (forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)) /\ apply_fun p n = 1).
Axiom total_function_space_sub_function_space : forall X Y : set , total_function_space X Y c= function_space X Y.
Axiom partition_of_unity_family_total_imp : forall X Tx U P : set , partition_of_unity_family_total X Tx U P -> partition_of_unity_family X Tx U P.
Axiom partition_of_unity_dominated_total_imp : forall X Tx U : set , partition_of_unity_dominated_total X Tx U -> partition_of_unity_dominated X Tx U.
Axiom partition_of_unity_family_sub_function_space : forall X Tx U P : set , partition_of_unity_family X Tx U P -> P c= function_space X R.
Axiom partition_of_unity_family_continuous : forall X Tx U P : set , partition_of_unity_family X Tx U P -> forall f : set , f :e P -> continuous_map X Tx R R_standard_topology f.
Axiom partition_of_unity_family_unit_interval : forall X Tx U P : set , partition_of_unity_family X Tx U P -> forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval.
Axiom partition_of_unity_family_support_dominated : forall X Tx U P : set , partition_of_unity_family X Tx U P -> forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u.
Axiom partition_of_unity_family_supports_locally_finite : forall X Tx U P : set , partition_of_unity_family X Tx U P -> forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0.
Axiom pointwise_finite_from_local_support_finite : forall X Tx P x N F0 : set , topology_on X Tx -> x :e X -> N :e Tx -> x :e N -> finite F0 -> F0 c= P -> (forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) -> (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F0).
Axiom support_disjoint_open_implies_zero_on_open : forall X Tx f N : set , topology_on X Tx -> N :e Tx -> support_of X Tx f :/\: N = Empty -> forall x : set , x :e N -> apply_fun f x = 0.
Axiom local_support_finite_outside_F0_zero_on_open : forall X Tx P N F0 f : set , topology_on X Tx -> N :e Tx -> F0 c= P -> (forall g : set , g :e P -> support_of X Tx g :/\: N <> Empty -> g :e F0) -> f :e P -> ~ (f :e F0) -> forall x : set , x :e N -> apply_fun f x = 0.
Axiom support_of_monotone_nonzero : forall X Tx f g : set , topology_on X Tx -> (forall x : set , x :e X -> apply_fun g x <> 0 -> apply_fun f x <> 0) -> support_of X Tx g c= support_of X Tx f.
Axiom pointwise_finite_on_neighborhood_from_local_support_finite : forall X Tx P N F0 : set , topology_on X Tx -> N :e Tx -> finite F0 -> F0 c= P -> (forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) -> forall y : set , y :e N -> forall f : set , f :e P -> apply_fun f y <> 0 -> f :e F0.
Axiom enumerated_finite_sum_continuous : forall X Tx F n e : set , topology_on X Tx -> n :e omega -> bijection n F e -> (forall f : set , f :e F -> continuous_map X Tx R R_standard_topology f) -> continuous_map X Tx R R_standard_topology (graph X (fun x : set => nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n)).
Axiom nat_primrec_add_mul_const_right : forall X n e x r : set , n :e omega -> x :e X -> (forall k : set , k :e n -> apply_fun (apply_fun e k) x :e R) -> r :e R -> mul_SNo (nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n) r = nat_primrec 0 (fun k acc : set => add_SNo acc (mul_SNo (apply_fun (apply_fun e k) x) r)) n.
Axiom nat_primrec_sum_times_recip_pos_eq_1 : forall X n e x : set , n :e omega -> x :e X -> (forall k : set , k :e n -> apply_fun (apply_fun e k) x :e R) -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n :e R -> Rlt 0 (nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n) -> nat_primrec 0 (fun k acc : set => add_SNo acc (mul_SNo (apply_fun (apply_fun e k) x) (recip_SNo_pos (nat_primrec 0 (fun j b : set => add_SNo b (apply_fun (apply_fun e j) x)) n)))) n = 1.
Axiom Rle_increase_by_nonneg_left : forall x y : set , x :e R -> y :e R -> Rle 0 x -> Rle y (add_SNo x y).
Axiom nat_primrec_sum_Rle0_of_Rle0_terms : forall X n e x : set , n :e omega -> x :e X -> (forall k : set , k :e n -> apply_fun (apply_fun e k) x :e R) -> (forall k : set , k :e n -> Rle 0 (apply_fun (apply_fun e k) x)) -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n :e R /\ Rle 0 (nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n).
Axiom nat_primrec_sum_Rle_succ_of_Rle0_term : forall X n e x k : set , n :e omega -> k :e n -> x :e X -> (forall j : set , j :e n -> apply_fun (apply_fun e j) x :e R) -> (forall j : set , j :e n -> Rle 0 (apply_fun (apply_fun e j) x)) -> nat_primrec 0 (fun j acc : set => add_SNo acc (apply_fun (apply_fun e j) x)) k :e R -> Rle (nat_primrec 0 (fun j acc : set => add_SNo acc (apply_fun (apply_fun e j) x)) k) (nat_primrec 0 (fun j acc : set => add_SNo acc (apply_fun (apply_fun e j) x)) (ordsucc k)).
Axiom partition_of_unity_family_pointwise_finite_sum : forall X Tx U P : set , partition_of_unity_family X Tx U P -> forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)) /\ apply_fun p n = 1.
Axiom nat_primrec_sum_continuous_map : forall X Tx n F e : set , topology_on X Tx -> n :e omega -> bijection n F e -> (forall f : set , f :e F -> continuous_map X Tx R R_standard_topology f) -> continuous_map X Tx R R_standard_topology (graph X (fun x : set => nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n)).
Axiom finite_ex_bijection_from_omega : forall F : set , finite F -> exists n e : set , n :e omega /\ bijection n F e.
Axiom locally_finite_supports_pointwise_sum_witness : forall X Tx P : set , topology_on X Tx -> P c= function_space X R -> (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) -> (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) -> forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)).
Axiom partition_of_unity_dominated_ex_family_pred : forall X Tx U : set , partition_of_unity_dominated X Tx U -> exists P : set , partition_of_unity_family X Tx U P.
Axiom partition_of_unity_dominated_topology_open_cover : forall X Tx U : set , partition_of_unity_dominated X Tx U -> topology_on X Tx /\ open_cover X Tx U.
Axiom partition_of_unity_dominated_topology : forall X Tx U : set , partition_of_unity_dominated X Tx U -> topology_on X Tx.
Axiom partition_of_unity_dominated_open_cover : forall X Tx U : set , partition_of_unity_dominated X Tx U -> open_cover X Tx U.
Axiom partition_of_unity_dominated_ex_family : forall X Tx U : set , partition_of_unity_dominated X Tx U -> exists P : set , P c= function_space X R /\ (forall f : set , f :e P -> continuous_map X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) /\ (forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)) /\ apply_fun p n = 1).
Axiom partition_of_unity_dominated_cover_sub_Power : forall X Tx U : set , partition_of_unity_dominated X Tx U -> U c= Power X.
Axiom partition_of_unity_dominated_covers : forall X Tx U : set , partition_of_unity_dominated X Tx U -> covers X U.
Axiom nat_primrec_sum_congr_on : forall X n e1 e2 x : set , nat_p n -> x :e X -> (forall k : set , k :e n -> apply_fun e1 k = apply_fun e2 k) -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e1 k) x)) n = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e2 k) x)) n.
Definition swap_last_two : set -> set -> set := fun e m => graph (ordsucc (ordsucc m)) (fun i : set => if i = m then apply_fun e (ordsucc m) else if i = ordsucc m then apply_fun e m else apply_fun e i).
Axiom swap_last_two_apply : forall e m i : set , i :e ordsucc (ordsucc m) -> apply_fun (swap_last_two e m) i = if i = m then apply_fun e (ordsucc m) else if i = ordsucc m then apply_fun e m else apply_fun e i.
Axiom swap_last_two_at_m : forall e m : set , nat_p m -> apply_fun (swap_last_two e m) m = apply_fun e (ordsucc m).
Axiom swap_last_two_at_sm : forall e m : set , nat_p m -> apply_fun (swap_last_two e m) (ordsucc m) = apply_fun e m.
Axiom function_on_swap_last_two : forall F e m : set , nat_p m -> function_on e (ordsucc (ordsucc m)) F -> function_on (swap_last_two e m) (ordsucc (ordsucc m)) F.
Axiom bijection_swap_last_two : forall F e m : set , nat_p m -> bijection (ordsucc (ordsucc m)) F e -> bijection (ordsucc (ordsucc m)) F (swap_last_two e m).
Axiom nat_primrec_sum_swap_last_two_unit_interval : forall X m e x : set , m :e omega -> x :e X -> (forall k : set , k :e ordsucc (ordsucc m) -> apply_fun (apply_fun e k) x :e unit_interval) -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun (swap_last_two e m) k) x)) (ordsucc (ordsucc m)) = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) (ordsucc (ordsucc m)).
Axiom nat_primrec_sum_S_drop_zero_unit_interval : forall X n e x : set , n :e omega -> x :e X -> (forall k : set , k :e ordsucc n -> apply_fun (apply_fun e k) x :e unit_interval) -> apply_fun (apply_fun e n) x = 0 -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) (ordsucc n) = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n.
Axiom nat_primrec_sum_drop_last_zero_bijection_unit_interval : forall X n F e x : set , n :e omega -> x :e X -> (forall k : set , k :e ordsucc n -> apply_fun (apply_fun e k) x :e unit_interval) -> apply_fun (apply_fun e n) x = 0 -> bijection (ordsucc n) F e -> bijection n (F :\: {apply_fun e n}) e /\ nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) (ordsucc n) = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n.
Definition swap_adjacent : set -> set -> set -> set := fun e i n => graph n (fun j : set => if j = i then apply_fun e (ordsucc i) else if j = ordsucc i then apply_fun e i else apply_fun e j).
Axiom swap_adjacent_apply : forall e i n j : set , j :e n -> apply_fun (swap_adjacent e i n) j = if j = i then apply_fun e (ordsucc i) else if j = ordsucc i then apply_fun e i else apply_fun e j.
Axiom swap_adjacent_at_succ : forall e i n : set , ordsucc i :e n -> apply_fun (swap_adjacent e i n) (ordsucc i) = apply_fun e i.
Axiom swap_adjacent_at_i : forall e i n : set , i :e n -> apply_fun (swap_adjacent e i n) i = apply_fun e (ordsucc i).
Axiom function_on_swap_adjacent : forall F e i n : set , i :e n -> ordsucc i :e n -> function_on e n F -> function_on (swap_adjacent e i n) n F.
Axiom bijection_swap_adjacent : forall F e i n : set , i :e n -> ordsucc i :e n -> bijection n F e -> bijection n F (swap_adjacent e i n).
Axiom nat_primrec_sum_swap_adjacent_unit_interval : forall X n e i x : set , n :e omega -> i :e n -> ordsucc i :e n -> x :e X -> (forall k : set , k :e n -> apply_fun (apply_fun e k) x :e unit_interval) -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun (swap_adjacent e i n) k) x)) n = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n.
Axiom nat_primrec_sum_swap_adjacent_bijection_unit_interval : forall X n F e i x : set , n :e omega -> i :e n -> ordsucc i :e n -> x :e X -> bijection n F e -> (forall k : set , k :e n -> apply_fun (apply_fun e k) x :e unit_interval) -> bijection n F (swap_adjacent e i n) /\ nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun (swap_adjacent e i n) k) x)) n = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n.
Axiom nat_primrec_sum_bubble_zero_right_unit_interval : forall X n F e i x : set , n :e omega -> i :e n -> ordsucc i :e n -> x :e X -> bijection n F e -> (forall k : set , k :e n -> apply_fun (apply_fun e k) x :e unit_interval) -> apply_fun (apply_fun e i) x = 0 -> exists e' : set , e' = swap_adjacent e i n /\ bijection n F e' /\ nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e' k) x)) n = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n /\ apply_fun (apply_fun e' (ordsucc i)) x = 0.
Axiom nat_primrec_sum_bijection_move_value_to_last_unit_interval : forall X m F e flast x : set , m :e omega -> x :e X -> bijection (ordsucc m) F e -> flast :e F -> (forall f : set , f :e F -> apply_fun f x :e unit_interval) -> exists e' : set , bijection (ordsucc m) F e' /\ nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) (ordsucc m) = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e' k) x)) (ordsucc m) /\ apply_fun e' m = flast.
Axiom nat_primrec_sum_bijection_Rle1_if_some_term_eq1_unit_interval : forall X x m F e f1 : set , m :e omega -> x :e X -> bijection (ordsucc m) F e -> f1 :e F -> (forall f : set , f :e F -> apply_fun f x :e unit_interval) -> apply_fun f1 x = 1 -> Rle 1 (nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) (ordsucc m)).
Axiom nat_primrec_sum_bijection_Rlt0_if_some_term_eq1_unit_interval : forall X x m F e f1 : set , m :e omega -> x :e X -> bijection (ordsucc m) F e -> f1 :e F -> (forall f : set , f :e F -> apply_fun f x :e unit_interval) -> apply_fun f1 x = 1 -> Rlt 0 (nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) (ordsucc m)).
Axiom nat_primrec_sum_bijection_independent_unit_interval : forall X m F e1 e2 x : set , m :e omega -> x :e X -> bijection (ordsucc m) F e1 -> bijection (ordsucc m) F e2 -> (forall f : set , f :e F -> apply_fun f x :e unit_interval) -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e1 k) x)) (ordsucc m) = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e2 k) x)) (ordsucc m).
Axiom nat_primrec_sum_bijection_drop_zero_element_unit_interval : forall X m F e f0 x : set , m :e omega -> x :e X -> bijection (ordsucc m) F e -> f0 :e F -> (forall f : set , f :e F -> apply_fun f x :e unit_interval) -> apply_fun f0 x = 0 -> exists e' : set , bijection m (F :\: {f0}) e' /\ nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) (ordsucc m) = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e' k) x)) m.
Axiom equip_omega_eq : forall n m : set , n :e omega -> m :e omega -> equip n m -> n = m.
Axiom nat_primrec_sum_bijection_zero_outside_unit_interval : forall X x n0 F0 e0 n F e : set , x :e X -> n0 :e omega -> finite F -> F0 c= F -> (exists f : set , f :e F0) -> (forall f : set , f :e F0 -> apply_fun f x :e unit_interval) -> (forall f : set , f :e F -> ~ (f :e F0) -> apply_fun f x = 0) -> bijection n0 F0 e0 -> n :e omega -> bijection n F e -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e0 k) x)) n0 = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e k) x)) n.
Axiom nat_primrec_sum_bijection_equal_of_two_control_sets_unit_interval : forall X x n0 F0 e0 n1 F1 e1 n F e : set , x :e X -> n0 :e omega -> n1 :e omega -> n :e omega -> finite F -> F0 c= F -> F1 c= F -> (exists f : set , f :e F0) -> (exists f : set , f :e F1) -> (forall f : set , f :e F0 -> apply_fun f x :e unit_interval) -> (forall f : set , f :e F1 -> apply_fun f x :e unit_interval) -> (forall f : set , f :e F -> ~ (f :e F0) -> apply_fun f x = 0) -> (forall f : set , f :e F -> ~ (f :e F1) -> apply_fun f x = 0) -> bijection n0 F0 e0 -> bijection n1 F1 e1 -> bijection n F e -> nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e0 k) x)) n0 = nat_primrec 0 (fun k acc : set => add_SNo acc (apply_fun (apply_fun e1 k) x)) n1.
Axiom partition_of_unity_dominated_supports_locally_finite : forall X Tx U : set , partition_of_unity_dominated X Tx U -> exists P : set , P c= function_space X R /\ (forall f : set , f :e P -> continuous_map X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0).
Axiom partition_of_unity_dominated_pointwise_finite_sum : forall X Tx U : set , partition_of_unity_dominated X Tx U -> exists P : set , forall x : set , x :e X -> exists F : set , finite F /\ F c= P /\ (forall f : set , f :e P -> apply_fun f x <> 0 -> f :e F) /\ exists n : set , n :e omega /\ exists e : set , bijection n F e /\ exists p : set , function_on p (ordsucc n) R /\ apply_fun p Empty = 0 /\ (forall k : set , k :e n -> apply_fun p (ordsucc k) = add_SNo (apply_fun p k) (apply_fun (apply_fun e k) x)) /\ apply_fun p n = 1.
Definition locally_finite_family : set -> set -> set -> prop := fun X Tx F => topology_on X Tx /\ forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists S : set , finite S /\ S c= F /\ forall A : set , A :e F -> A :/\: N <> Empty -> A :e S.
Axiom locally_finite_family_topology : forall X Tx F : set , locally_finite_family X Tx F -> topology_on X Tx.
Axiom locally_finite_family_property : forall X Tx F : set , locally_finite_family X Tx F -> forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists S : set , finite S /\ S c= F /\ forall A : set , A :e F -> A :/\: N <> Empty -> A :e S.
Axiom locally_finite_open_cover_neighborhood_finite_subunion : forall X Tx W x : set , open_cover X Tx W -> locally_finite_family X Tx W -> x :e X -> exists N S : set , N :e Tx /\ x :e N /\ finite S /\ S c= W /\ N c= Union S.
Axiom locally_finite_open_cover_closure_point_finite : forall X Tx W x : set , open_cover X Tx W -> locally_finite_family X Tx W -> x :e X -> exists S : set , finite S /\ S c= W /\ forall w : set , w :e W -> x :e closure_of X Tx w -> w :e S.
Axiom locally_finite_subfamily : forall X Tx F G : set , locally_finite_family X Tx F -> G c= F -> locally_finite_family X Tx G.
Axiom locally_finite_family_Repl_subsets : forall X Tx W : set , forall f : set -> set , locally_finite_family X Tx W -> (forall w : set , w :e W -> f w c= w) -> locally_finite_family X Tx {f w|w :e W}.
Axiom locally_finite_family_point_finite_ex : forall X Tx F : set , locally_finite_family X Tx F -> forall x : set , x :e X -> exists S : set , finite S /\ S c= F /\ forall A : set , A :e F -> x :e A -> A :e S.
Axiom finite_family_locally_finite : forall X Tx F : set , topology_on X Tx -> finite F -> F c= Power X -> locally_finite_family X Tx F.
Axiom finite_open_cover_locally_finite : forall X Tx U : set , topology_on X Tx -> open_cover X Tx U -> finite U -> locally_finite_family X Tx U.
Axiom finite_open_cover_of_locally_finite : forall X Tx Fam : set , open_cover_of X Tx Fam -> finite Fam -> locally_finite_family X Tx Fam.
Axiom locally_finite_family_closures : forall X Tx Fam : set , locally_finite_family X Tx Fam -> locally_finite_family X Tx {closure_of X Tx A|A :e Fam}.
Axiom Union_locally_finite_closed_is_closed : forall X Tx Fam : set , locally_finite_family X Tx Fam -> (forall A : set , A :e Fam -> closed_in X Tx A) -> closed_in X Tx (Union Fam).
Axiom locally_finite_open_cover_closures_closed_cover : forall X Tx W : set , open_cover X Tx W -> locally_finite_family X Tx W -> exists ClW : set , ClW = {closure_of X Tx w|w :e W} /\ ((forall C : set , C :e ClW -> closed_in X Tx C) /\ covers X ClW) /\ locally_finite_family X Tx ClW /\ (forall C : set , C :e ClW -> exists w : set , w :e W /\ C = closure_of X Tx w).
Axiom normal_space_finite_open_cover_shrinking : forall X Tx W : set , normal_space X Tx -> open_cover X Tx W -> finite W -> exists V : set , open_cover X Tx V /\ finite V /\ (forall v : set , v :e V -> exists w : set , w :e W /\ v c= w) /\ forall v : set , v :e V -> exists w : set , w :e W /\ closure_of X Tx v c= w.
Axiom normal_space_finite_open_cover_shrinking_closed : forall X Tx A F : set , normal_space X Tx -> closed_in X Tx A -> finite F -> (forall w : set , w :e F -> w :e Tx) -> A c= Union F -> exists V : set , finite V /\ (forall v : set , v :e V -> v :e Tx) /\ A c= Union V /\ forall v : set , v :e V -> exists w : set , w :e F /\ closure_of X Tx v c= w.
Axiom locally_finite_open_cover_core_open_set : forall X Tx W w : set , topology_on X Tx -> open_cover X Tx W -> locally_finite_family X Tx W -> w :e W -> exists Bw : set , Bw :e Tx /\ Bw c= w /\ closure_of X Tx Bw c= w.
Axiom locally_finite_open_cover_core_family : forall X Tx W : set , topology_on X Tx -> open_cover X Tx W -> locally_finite_family X Tx W -> exists B : set , (forall b : set , b :e B -> b :e Tx) /\ locally_finite_family X Tx B /\ (forall b : set , b :e B -> exists w : set , w :e W /\ b c= w) /\ forall b : set , b :e B -> exists w : set , w :e W /\ closure_of X Tx b c= w.
Axiom nonempty_subset_of_ordinal_has_least : forall I S : set , ordinal I -> S c= I -> S <> Empty -> exists m : set , m :e S /\ forall s : set , s :e S -> m c= s.
Axiom ordinal_subset_least_unique : forall I S m1 m2 : set , ordinal I -> S c= I -> m1 :e S -> (forall s : set , s :e S -> m1 c= s) -> m2 :e S -> (forall s : set , s :e S -> m2 c= s) -> m1 = m2.
Axiom finite_nonempty_subset_of_ordinal_has_max : forall I S : set , ordinal I -> finite S -> S c= I -> S <> Empty -> exists m : set , m :e S /\ forall s : set , s :e S -> s c= m.
Axiom point_finite_cover_has_max_index : forall X W I : set , forall idx pickW : set -> set , ordinal I -> covers X W -> (forall x : set , x :e X -> exists S : set , finite S /\ S c= W /\ forall A : set , A :e W -> x :e A -> A :e S) -> (forall w : set , w :e W -> idx w :e I) -> (forall i : set , i :e I -> pickW i :e W /\ idx (pickW i) = i) -> (forall w : set , w :e W -> pickW (idx w) = w) -> forall x : set , x :e X -> exists imax : set , imax :e I /\ x :e pickW imax /\ forall j : set , j :e I -> imax :e j -> x /:e pickW j.
Axiom normal_locally_finite_open_cover_shrinking_rec : forall X Tx W : set , normal_space X Tx -> open_cover X Tx W -> locally_finite_family X Tx W -> exists V : set , open_cover X Tx V /\ locally_finite_family X Tx V /\ (forall v : set , v :e V -> exists w : set , w :e W /\ v c= w) /\ forall v : set , v :e V -> exists w : set , w :e W /\ closure_of X Tx v c= w.
Axiom normal_locally_finite_open_cover_shrinking : forall X Tx W : set , normal_space X Tx -> open_cover X Tx W -> locally_finite_family X Tx W -> exists V : set , open_cover X Tx V /\ locally_finite_family X Tx V /\ (forall v : set , v :e V -> exists w : set , w :e W /\ v c= w) /\ forall v : set , v :e V -> exists w : set , w :e W /\ closure_of X Tx v c= w.
Definition refine_of : set -> set -> prop := fun V U => forall v : set , v :e V -> exists u : set , u :e U /\ v c= u.
Axiom function_space_extensional : forall X Y f g : set , f :e function_space X Y -> g :e function_space X Y -> total_function_on f X Y -> total_function_on g X Y -> functional_graph f -> functional_graph g -> (forall x : set , x :e X -> apply_fun f x = apply_fun g x) -> f = g.
Axiom locally_finite_bump_cover_normalizes_to_partition_of_unity_dominated_total : forall X Tx U V P : set , topology_on X Tx -> open_cover X Tx U -> open_cover X Tx V -> locally_finite_family X Tx V -> refine_of V U -> P c= total_function_space X R /\ (forall f : set , f :e P -> continuous_map_total X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists f : set , f :e P /\ apply_fun f x = 1) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) -> partition_of_unity_dominated_total X Tx U.
Axiom locally_finite_bump_cover_normalizes_to_partition_of_unity_dominated : forall X Tx U V P : set , topology_on X Tx -> open_cover X Tx U -> open_cover X Tx V -> locally_finite_family X Tx V -> refine_of V U -> P c= function_space X R /\ (forall f : set , f :e P -> continuous_map X Tx R R_standard_topology f) /\ (forall f x : set , f :e P -> x :e X -> apply_fun f x :e unit_interval) /\ (forall f : set , f :e P -> exists u : set , u :e U /\ support_of X Tx f c= u) /\ (forall x : set , x :e X -> exists f : set , f :e P /\ apply_fun f x = 1) /\ (forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists F0 : set , finite F0 /\ F0 c= P /\ forall f : set , f :e P -> support_of X Tx f :/\: N <> Empty -> f :e F0) -> partition_of_unity_dominated X Tx U.
Axiom normal_locally_finite_partition_of_unity_family_rec : forall X Tx W : set , normal_space X Tx -> open_cover X Tx W -> locally_finite_family X Tx W -> exists P : set , partition_of_unity_family X Tx W P.
Axiom normal_locally_finite_partition_of_unity_family : forall X Tx W : set , normal_space X Tx -> open_cover X Tx W -> locally_finite_family X Tx W -> exists P : set , partition_of_unity_family X Tx W P.
Axiom finite_open_cover_has_partition_of_unity_family : forall X Tx U : set , normal_space X Tx -> finite U -> open_cover X Tx U -> exists P : set , partition_of_unity_family X Tx U P.
Axiom finite_partition_of_unity_exists : forall X Tx U : set , normal_space X Tx -> finite U -> open_cover X Tx U -> partition_of_unity_dominated X Tx U.
Axiom net_pack_coord_projection_in_space : forall I Xi N i : set , net_pack_in_space (product_space I Xi) N -> i :e I -> exists Ni : set , net_pack_in_space (space_family_set Xi i) Ni /\ net_pack_index Ni = net_pack_index N /\ net_pack_le Ni = net_pack_le N /\ Ni = net_pack (net_pack_index N) (net_pack_le N) (graph (net_pack_index N) (fun j : set => apply_fun (apply_fun (net_pack_fun N) j) i)).
Definition finite_intersection_property : set -> set -> prop := fun X A => A c= Power X /\ forall F : set , finite F -> F c= A -> intersection_of_family X F <> Empty.
Definition maximal_finite_intersection_property : set -> set -> prop := fun X D => finite_intersection_property X D /\ forall E : set , D c= E -> finite_intersection_property X E -> E c= D.
