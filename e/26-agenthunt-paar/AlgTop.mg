     (forall s:set, s :e unit_interval ->
        apply_fun Fh (s, 1) = apply_fun g s)) /\
    (forall t:set, t :e unit_interval ->
      apply_fun Fh (0, t) = b0))
    (forall t:set, t :e unit_interval ->
      apply_fun Fh (1, t) = b1)
    HFhPack).
}
claim HFh2 :
  (continuous_map unit_square unit_square_topology B Tb Fh /\
