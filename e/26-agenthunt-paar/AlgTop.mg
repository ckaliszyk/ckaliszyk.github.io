    simply_connected V (subspace_topology (Sn n) (Sn_topology n) V) /\
    (U :/\: V) <> Empty /\
    path_connected_space (U :/\: V)
      (subspace_topology (Sn n) (Sn_topology n) (U :/\: V)).
