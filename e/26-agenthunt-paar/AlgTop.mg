{
  reflexivity.
}
claim HinvDef :
  integers_group_inv =
  graph int (fun n:set => minus_SNo n).
{
  reflexivity.
}
prove
  function_on integers_group_mult (setprod int int) int /\
  function_on integers_group_inv int int /\
