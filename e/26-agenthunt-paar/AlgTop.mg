  rewrite (apply_fun_graph unit_interval (fun t:set => t) 0 zero_in_unit_interval).
  rewrite (const_fun_apply unit_interval 0 0 zero_in_unit_interval).
  reflexivity.
}
claim Hstart_g0_54 : apply_fun p e0 = apply_fun g0_54 0.
{
