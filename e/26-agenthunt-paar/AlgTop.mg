  assume Hxs_red : reduced_word J Gfam efam (n_of x0) (xs_of x0).
  assume Hn_of_ne0 : (n_of x0) <> 0.
  assume Hwp_xs_of : word_product multG eG (xs_of x0) (n_of x0) = x0.
  assume Huniq_xs : forall n' xs':set,
