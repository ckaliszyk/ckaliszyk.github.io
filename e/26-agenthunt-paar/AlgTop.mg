}
claim Hconst1 : apply_fun (constant_path x0) 1 = x0.
{
  exact (constant_path_at_one x0).
}
claim HuniqAtx0 :
  forall cls:set, cls :e fundamental_group X Tx x0 ->
    apply_fun (basepoint_change_map X Tx x0 x0 alpha_loop) cls
    = apply_fun (basepoint_change_map X Tx x0 x0 (constant_path x0)) cls.
{
  let cls.
  assume Hcls.
  exact (Huniq
    x0
    alpha_loop
    (constant_path x0)
    Hx0
    HalphaCont
    HconstCont
    Halpha0
    Halpha1
    Hconst0
    Hconst1
    cls
    Hcls).
}
set bc0 := basepoint_change_map X Tx x0 x0 (constant_path x0).
claim HconstConcatCont :
  continuous_map unit_interval unit_interval_topology X Tx
