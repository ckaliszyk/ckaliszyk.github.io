{
  exact (path_concat_continuous
    X
    Tx
    x0
    x0
    x0
    (constant_path x0)
    (constant_path x0)
    HconstCont
    HconstCont
    Hconst0
    Hconst1
    Hconst0
    Hconst1).
}
