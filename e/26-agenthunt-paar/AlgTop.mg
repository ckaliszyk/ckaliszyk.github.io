}
set f := compose_fun unit_interval alpha p.
set c := constant_path b.
claim HfCont : continuous_map unit_interval unit_interval_topology B Tb f.
{
  exact (composition_continuous
    unit_interval
    unit_interval_topology
    E
    Te
    B
    Tb
    alpha
    p
