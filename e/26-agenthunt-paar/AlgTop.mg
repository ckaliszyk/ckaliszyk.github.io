        (apply_fun f 0 = (0, 0))
        (apply_fun f 1 = (0, 0))
        (apply_fun (constant_path (0, 0)) 0 = (0, 0))
        (apply_fun (constant_path (0, 0)) 1 = (0, 0))
        (exists F:set,
          continuous_map unit_square unit_square_topology X TX F /\
          (forall s:set, s :e unit_interval ->
