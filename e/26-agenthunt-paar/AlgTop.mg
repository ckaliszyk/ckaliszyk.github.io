Axiom Tietze_stepII_real_extension : forall X Tx A f : set , normal_space X Tx -> closed_in X Tx A -> continuous_map A (subspace_topology X Tx A) (closed_interval (minus_SNo 1) 1) (closed_interval_topology (minus_SNo 1) 1) f -> exists gR : set , continuous_map X Tx R R_standard_topology gR /\ (forall x : set , x :e A -> apply_fun gR x = apply_fun f x) /\ (forall x : set , x :e X -> apply_fun gR x :e closed_interval (minus_SNo 1) 1).
Axiom Tietze_extension_minus1_1 : forall X Tx A f : set , normal_space X Tx -> closed_in X Tx A -> continuous_map A (subspace_topology X Tx A) (closed_interval (minus_SNo 1) 1) (closed_interval_topology (minus_SNo 1) 1) f -> exists g : set , continuous_map X Tx (closed_interval (minus_SNo 1) 1) (closed_interval_topology (minus_SNo 1) 1) g /\ (forall x : set , x :e A -> apply_fun g x = apply_fun f x).
