      claim HprodEqE :
        apply_fun multH (apply_fun multH (a, b), apply_fun multH (apply_fun invH b, apply_fun invH a)) = eH.
      {
        rewrite (HassocH
          a
          b
          (apply_fun multH (apply_fun invH b, apply_fun invH a))
