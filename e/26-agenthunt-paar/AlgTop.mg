Postfix ' 100 := tag_topology.
Axiom Sing1_not_SNo : ~ SNo {1}.
Axiom Inj1_0_eq_1 : Inj1 0 = 1.
Axiom tuple_0_1_eq_Sing1 : (0,1) = {1}.
