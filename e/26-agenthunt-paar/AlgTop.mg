Axiom bounded_transform_phi_preimage_open_ray_upper_mid : forall a : set , a :e R -> ~ (Rlt a (minus_SNo 1)) -> Rlt a 1 -> preimage_of R bounded_transform_phi (open_ray_upper R a) :e R_standard_topology.
Axiom bounded_transform_phi_preimage_open_ray_upper : forall a : set , a :e R -> preimage_of R bounded_transform_phi (open_ray_upper R a) :e R_standard_topology.
Axiom bounded_transform_phi_preimage_open_ray_lower_neg_case_eq : forall b : set , b :e R -> Rlt b 0 -> Rlt (minus_SNo 1) b -> preimage_of R bounded_transform_phi (open_ray_lower R b) = open_ray_lower R (div_SNo b (add_SNo 1 b)).
Axiom bounded_transform_phi_preimage_open_ray_lower_pos_case_eq : forall b : set , b :e R -> Rlt 0 b -> Rlt b 1 -> preimage_of R bounded_transform_phi (open_ray_lower R b) = open_ray_lower R (div_SNo b (add_SNo 1 (minus_SNo b))).
