    (setprod R R)
    sq0
    sq1
    x
    HxR2
    Hsq0xR
    Hsq1xR).
  rewrite (mul_of_pair_map_apply
    (setprod R R)
    p0
    p0
    x
    HxR2
    Hp0xR
    Hp0xR) at 1.
  rewrite (mul_of_pair_map_apply
    (setprod R R)
    p1
    p1
    x
    HxR2
    Hp1xR
    Hp1xR) at 1.
  rewrite (projection1_apply
    R
    R
    x
    HxR2) at 1.
  rewrite (projection1_apply
    R
    R
    x
    HxR2) at 1.
  rewrite (projection2_apply
    R
    R
    x
    HxR2) at 1.
  rewrite (projection2_apply
    R
    R
    x
