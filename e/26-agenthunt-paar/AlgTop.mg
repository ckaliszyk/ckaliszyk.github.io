      apply_fun p (apply_fun ft2 x) = apply_fun f x)
    Hlift2Pack).
}
claim Hcomm1 :
  forall x:set, x :e unit_interval ->
    apply_fun p (apply_fun ft1 x) = apply_fun f x.
{
  exact (andER
    (continuous_map unit_interval unit_interval_topology E Te ft1)
    (forall x:set, x :e unit_interval ->
      apply_fun p (apply_fun ft1 x) = apply_fun f x)
    Hlift1Pack).
