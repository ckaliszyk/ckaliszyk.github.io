  claim HsCont :
    continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology)
      (setprod Y unit_interval)
      (product_topology Y Ty unit_interval unit_interval_topology)
      s.
  {
    exact (maps_into_products
      (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology)
      Y
      Ty
      unit_interval
      unit_interval_topology
      p1
      p2
      Hp1Cont
      Hp2Cont).
  }
  set Fpre := compose_fun (setprod X unit_interval) s G.
  claim Hh'Fun : function_on h' X Y.
  {
    exact (continuous_map_function_on
      X
      Tx
      Y
      Ty
      h'
      Hh').
  }
  prove continuous_map X Tx Z Tz (compose_fun X h' k) /\
    continuous_map X Tx Z Tz (compose_fun X h' k') /\
    exists F0:set,
      continuous_map (setprod X unit_interval)
        (product_topology X Tx unit_interval unit_interval_topology)
        Z Tz F0 /\
      (forall x:set, x :e X ->
        apply_fun F0 (x, 0) = apply_fun (compose_fun X h' k) x) /\
      (forall x:set, x :e X ->
        apply_fun F0 (x, 1) = apply_fun (compose_fun X h' k') x).
  apply andI.
  - apply andI.
    + exact (composition_continuous
        X
        Tx
        Y
        Ty
        Z
        Tz
        h'
        k
        Hh'
        Hk).
    + exact (composition_continuous
        X
        Tx
        Y
        Ty
        Z
        Tz
        h'
        k'
        Hh'
        Hk').
  - witness Fpre.
    apply andI.
    + apply andI.
      - exact (composition_continuous
          (setprod X unit_interval)
          (product_topology X Tx unit_interval unit_interval_topology)
          (setprod Y unit_interval)
          (product_topology Y Ty unit_interval unit_interval_topology)
          Z
          Tz
          s
          G
          HsCont
          HGcont).
      - let x.
        assume Hx.
        claim Hx0 : (x, 0) :e setprod X unit_interval.
        {
          exact (tuple_2_setprod_by_pair_Sigma
            X
            unit_interval
            x
            0
            Hx
            zero_in_unit_interval).
        }
        claim HhxY : apply_fun h' x :e Y.
        {
          exact (Hh'Fun x Hx).
        }
        rewrite (compose_fun_apply
          (setprod X unit_interval)
          s
          G
          (x, 0)
          Hx0).
        rewrite (pair_map_apply
          (setprod X unit_interval)
          Y
          unit_interval
          p1
          p2
          (x, 0)
          Hx0).
        rewrite (compose_fun_apply
          (setprod X unit_interval)
          (projection_map1 X unit_interval)
          h'
          (x, 0)
          Hx0).
        rewrite (projection1_apply
          X
          unit_interval
          (x, 0)
          Hx0).
        rewrite tuple_2_0_eq.
        rewrite (projection2_apply
          X
          unit_interval
          (x, 0)
          Hx0).
        rewrite tuple_2_1_eq.
        rewrite (HG0 (apply_fun h' x) HhxY).
        rewrite (compose_fun_apply X h' k x Hx).
        reflexivity.
    + let x.
      assume Hx.
      claim Hx1 : (x, 1) :e setprod X unit_interval.
      {
        exact (tuple_2_setprod_by_pair_Sigma
          X
          unit_interval
          x
          1
          Hx
          one_in_unit_interval).
      }
      claim HhxY : apply_fun h' x :e Y.
      {
        exact (Hh'Fun x Hx).
      }
      rewrite (compose_fun_apply
        (setprod X unit_interval)
        s
        G
        (x, 1)
        Hx1).
      rewrite (pair_map_apply
        (setprod X unit_interval)
        Y
        unit_interval
        p1
        p2
        (x, 1)
        Hx1).
      rewrite (compose_fun_apply
        (setprod X unit_interval)
        (projection_map1 X unit_interval)
        h'
        (x, 1)
        Hx1).
      rewrite (projection1_apply
        X
        unit_interval
        (x, 1)
        Hx1).
      rewrite tuple_2_0_eq.
      rewrite (projection2_apply
        X
        unit_interval
        (x, 1)
        Hx1).
      rewrite tuple_2_1_eq.
      rewrite (HG1 (apply_fun h' x) HhxY).
      rewrite (compose_fun_apply X h' k' x Hx).
      reflexivity.
}
exact (Lemma_51_1_homotopy_trans
  X
  Tx
  Z
  Tz
  (compose_fun X h k)
  (compose_fun X h' k)
  (compose_fun X h' k')
  Hpost
  Hpre).
Qed.

(** S51 helper: every map X -> I is homotopic to the zero constant map **)
(** Proven Bob **)
Theorem s51_maps_to_I_homotopic_to_zero : forall X Tx u:set,
  continuous_map X Tx unit_interval unit_interval_topology u ->
  homotopic_maps X Tx unit_interval unit_interval_topology u (const_fun X 0).
let X Tx u.
assume Hu.
claim HtopX : topology_on X Tx.
{
  exact (continuous_map_topology_dom
    X
    Tx
    unit_interval
    unit_interval_topology
    u
    Hu).
}
claim HprojPair :
  continuous_map
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    X
    Tx
    (projection_map1 X unit_interval)
  /\
  continuous_map
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    (projection_map2 X unit_interval).
{
  exact (projection_maps_continuous
    X
    Tx
    unit_interval
    unit_interval_topology
    HtopX
    unit_interval_topology_on).
}
claim Hproj1 :
  continuous_map
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    X
    Tx
    (projection_map1 X unit_interval).
{
  exact (andEL
    (continuous_map
      (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology)
      X
      Tx
      (projection_map1 X unit_interval))
    (continuous_map
      (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology)
      unit_interval
      unit_interval_topology
      (projection_map2 X unit_interval))
    HprojPair).
}
claim Hproj2 :
  continuous_map
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    (projection_map2 X unit_interval).
{
  exact (andER
    (continuous_map
      (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology)
      X
      Tx
      (projection_map1 X unit_interval))
    (continuous_map
      (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology)
      unit_interval
      unit_interval_topology
      (projection_map2 X unit_interval))
    HprojPair).
}
set u_on_prod := compose_fun
  (setprod X unit_interval)
  (projection_map1 X unit_interval)
  u.
claim HuOnProdCont :
  continuous_map
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    u_on_prod.
{
  exact (composition_continuous
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    X
    Tx
    unit_interval
    unit_interval_topology
    (projection_map1 X unit_interval)
    u
    Hproj1
    Hu).
}
set one_minus_t := compose_fun
  (setprod X unit_interval)
  (projection_map2 X unit_interval)
  flip_unit_interval.
claim HoneMinusTCont :
  continuous_map
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    one_minus_t.
{
  exact (composition_continuous
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    unit_interval
    unit_interval_topology
    (projection_map2 X unit_interval)
    flip_unit_interval
    Hproj2
    flip_unit_interval_continuous).
}
set F := compose_fun
  (setprod X unit_interval)
  (pair_map (setprod X unit_interval) u_on_prod one_minus_t)
  mul_fun_R.
claim HFCont :
  continuous_map
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    F.
{
  exact (mul_two_continuous_unit_interval
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    u_on_prod
    one_minus_t
    (product_topology_is_topology
      X
      Tx
      unit_interval
      unit_interval_topology
      HtopX
      unit_interval_topology_on)
    HuOnProdCont
    HoneMinusTCont).
}
claim Hconst0Cont :
  continuous_map
    X
    Tx
    unit_interval
    unit_interval_topology
    (const_fun X 0).
{
  exact (const_fun_continuous
    X
    Tx
    unit_interval
    unit_interval_topology
    0
    HtopX
    unit_interval_topology_on
    zero_in_unit_interval).
}
claim HuOnProdFun :
  function_on u_on_prod (setprod X unit_interval) unit_interval.
{
  exact (continuous_map_function_on
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    u_on_prod
    HuOnProdCont).
}
claim HoneMinusTFun :
  function_on one_minus_t (setprod X unit_interval) unit_interval.
{
  exact (continuous_map_function_on
    (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology)
    unit_interval
    unit_interval_topology
    one_minus_t
    HoneMinusTCont).
}
prove continuous_map
  X
  Tx
  unit_interval
  unit_interval_topology
  u
  /\
  continuous_map
    X
    Tx
    unit_interval
    unit_interval_topology
    (const_fun X 0)
  /\
  exists F0:set,
    continuous_map
      (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology)
      unit_interval
      unit_interval_topology
      F0
    /\
    (forall x:set, x :e X ->
      apply_fun F0 (x, 0) = apply_fun u x)
    /\
    (forall x:set, x :e X ->
      apply_fun F0 (x, 1) = apply_fun (const_fun X 0) x).
apply andI.
- apply andI.
  + exact Hu.
  + exact Hconst0Cont.
- witness F.
  apply andI.
  * apply andI.
    { exact HFCont. }
    { let x.
        assume Hx.
        claim Hx0 :
          (x, 0) :e setprod X unit_interval.
        {
          exact (tuple_2_setprod_by_pair_Sigma
            X
            unit_interval
            x
            0
            Hx
            zero_in_unit_interval).
        }
        claim HuValI :
          apply_fun u_on_prod (x, 0) :e unit_interval.
        {
          exact (HuOnProdFun
            (x, 0)
            Hx0).
        }
        claim HOneValI :
          apply_fun one_minus_t (x, 0) :e unit_interval.
        {
          exact (HoneMinusTFun
            (x, 0)
            Hx0).
        }
        claim HuValR :
          apply_fun u_on_prod (x, 0) :e R.
        {
          exact (unit_interval_sub_R
            (apply_fun u_on_prod (x, 0))
            HuValI).
        }
        claim HOneValR :
          apply_fun one_minus_t (x, 0) :e R.
        {
          exact (unit_interval_sub_R
            (apply_fun one_minus_t (x, 0))
            HOneValI).
        }
        rewrite (mul_of_pair_map_apply
          (setprod X unit_interval)
          u_on_prod
          one_minus_t
          (x, 0)
          Hx0
          HuValR
          HOneValR).
        rewrite (compose_fun_apply
          (setprod X unit_interval)
          (projection_map1 X unit_interval)
          u
          (x, 0)
          Hx0).
        rewrite (projection1_apply
          X
          unit_interval
          (x, 0)
          Hx0).
        rewrite tuple_2_0_eq.
        rewrite (compose_fun_apply
          (setprod X unit_interval)
          (projection_map2 X unit_interval)
          flip_unit_interval
          (x, 0)
          Hx0).
        rewrite (projection2_apply
          X
          unit_interval
          (x, 0)
          Hx0).
        rewrite tuple_2_1_eq.
        rewrite flip_unit_interval_at_0.
        rewrite (mul_SNo_oneR
          (apply_fun u x)
          (real_SNo
            (apply_fun u x)
            (unit_interval_sub_R
              (apply_fun u x)
              (continuous_map_function_on
                X
                Tx
                unit_interval
                unit_interval_topology
                u
                Hu
                x
                Hx)))).
        reflexivity.
      }
  * let x.
    assume Hx.
    claim Hx1 :
      (x, 1) :e setprod X unit_interval.
    {
      exact (tuple_2_setprod_by_pair_Sigma
        X
        unit_interval
        x
        1
        Hx
        one_in_unit_interval).
    }
    claim HuValI :
      apply_fun u_on_prod (x, 1) :e unit_interval.
    {
      exact (HuOnProdFun
        (x, 1)
        Hx1).
    }
    claim HOneValI :
      apply_fun one_minus_t (x, 1) :e unit_interval.
    {
      exact (HoneMinusTFun
        (x, 1)
        Hx1).
    }
    claim HuValR :
      apply_fun u_on_prod (x, 1) :e R.
    {
      exact (unit_interval_sub_R
        (apply_fun u_on_prod (x, 1))
        HuValI).
    }
    claim HOneValR :
      apply_fun one_minus_t (x, 1) :e R.
    {
      exact (unit_interval_sub_R
        (apply_fun one_minus_t (x, 1))
        HOneValI).
    }
    rewrite (mul_of_pair_map_apply
      (setprod X unit_interval)
      u_on_prod
      one_minus_t
      (x, 1)
      Hx1
      HuValR
      HOneValR).
    rewrite (compose_fun_apply
      (setprod X unit_interval)
      (projection_map2 X unit_interval)
      flip_unit_interval
      (x, 1)
      Hx1).
    rewrite (projection2_apply
      X
      unit_interval
      (x, 1)
      Hx1).
    rewrite tuple_2_1_eq.
    rewrite flip_unit_interval_at_1.
    rewrite (mul_SNo_zeroR
      (apply_fun u_on_prod (x, 1))
      (real_SNo
        (apply_fun u_on_prod (x, 1))
        HuValR)).
    rewrite (const_fun_apply
      X
      0
      x
      Hx).
    reflexivity.
Qed.

(** from S51 Exercise 2a (line 331 in algtop.tex) **)
(** LATEX VERSION: For any X, the set [X, I] has a single element. **)
(** EFFORT: 3 lines textbook, difficulty 3/10, USD 40 **)
(** Collected Bob 44 **)
(** Proven Bob **)
Theorem ex51_2a_maps_to_I : forall X Tx f g:set,
  continuous_map X Tx unit_interval unit_interval_topology f ->
  continuous_map X Tx unit_interval unit_interval_topology g ->
  homotopic_maps X Tx unit_interval unit_interval_topology f g.
let X Tx f g.
assume Hf Hg.
claim HfToZero :
  homotopic_maps
    X
    Tx
    unit_interval
    unit_interval_topology
    f
    (const_fun X 0).
{
  exact (s51_maps_to_I_homotopic_to_zero
    X
    Tx
    f
    Hf).
}
claim HgToZero :
  homotopic_maps
    X
    Tx
    unit_interval
    unit_interval_topology
    g
    (const_fun X 0).
{
  exact (s51_maps_to_I_homotopic_to_zero
    X
    Tx
    g
    Hg).
}
claim HzeroToG :
  homotopic_maps
    X
    Tx
    unit_interval
    unit_interval_topology
    (const_fun X 0)
    g.
{
  exact (Lemma_51_1_homotopy_sym
    X
    Tx
    unit_interval
    unit_interval_topology
    g
    (const_fun X 0)
    HgToZero).
}
exact (Lemma_51_1_homotopy_trans
  X
  Tx
  unit_interval
  unit_interval_topology
  f
  (const_fun X 0)
  g
  HfToZero
  HzeroToG).
Qed.

