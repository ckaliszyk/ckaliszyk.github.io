claim Hbc0Idem :
  forall cls:set, cls :e fundamental_group X Tx x0 ->
    apply_fun bc0 cls
    = apply_fun
        (compose_fun
          (fundamental_group X Tx x0)
          bc0
          bc0)
        cls.
{
  let cls.
  assume Hcls.
  claim HuniqConst :
    apply_fun
      (basepoint_change_map
        X
        Tx
        x0
        x0
        (path_concat (constant_path x0) (constant_path x0)))
      cls
    =
