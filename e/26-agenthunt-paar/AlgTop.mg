          }
          claim HSNo1mt : SNo (add_SNo 1 (minus_SNo t)).
          {
            exact (SNo_add_SNo
              1
              (minus_SNo t)
              SNo_1
              (SNo_minus_SNo t HSNot)).
          }
          rewrite (mul_SNo_zeroR
            (add_SNo 1 (minus_SNo t))
