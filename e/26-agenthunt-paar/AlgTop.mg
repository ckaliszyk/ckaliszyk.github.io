Axiom setmul_byI : forall U V mult u v : set , u :e U -> v :e V -> apply_fun mult (u,v) :e setmul_by mult U V.
Axiom mul_SNo_2_eq_add : forall x : set , SNo x -> mul_SNo 2 x = add_SNo x x.
Axiom eps_ordsucc_half_mul2 : forall n : set , nat_p n -> mul_SNo 2 (eps_ (ordsucc n)) = eps_ n.
Axiom setmul_byE : forall U V mult y : set , y :e setmul_by mult U V -> exists u : set , u :e U /\ exists v : set , v :e V /\ y = apply_fun mult (u,v).
Axiom setmul_by_sub_of_pointwise : forall mult U V W : set , (forall u v : set , u :e U -> v :e V -> apply_fun mult (u,v) :e W) -> setmul_by mult U V c= W.
Axiom setmul_by_Empty_right : forall mult U : set , setmul_by mult U Empty = Empty.
Axiom setmul_by_Empty_left : forall mult V : set , setmul_by mult Empty V = Empty.
Axiom setmul_by_mono_L : forall mult U1 U2 V : set , U1 c= U2 -> setmul_by mult U1 V c= setmul_by mult U2 V.
Axiom setmul_by_mono_R : forall mult U V1 V2 : set , V1 c= V2 -> setmul_by mult U V1 c= setmul_by mult U V2.
Axiom setmul_by_assoc_sub : forall G mult U V W : set , function_on mult (setprod G G) G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> U c= G -> V c= G -> W c= G -> setmul_by mult (setmul_by mult U V) W c= setmul_by mult U (setmul_by mult V W).
Axiom setmul_by_assoc_sub_rev : forall G mult U V W : set , function_on mult (setprod G G) G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> U c= G -> V c= G -> W c= G -> setmul_by mult U (setmul_by mult V W) c= setmul_by mult (setmul_by mult U V) W.
Axiom setmul_by_assoc_eq : forall G mult U V W : set , function_on mult (setprod G G) G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> U c= G -> V c= G -> W c= G -> setmul_by mult (setmul_by mult U V) W = setmul_by mult U (setmul_by mult V W).
Axiom eps_in_R_omega : forall n : set , n :e omega -> eps_ n :e R.
Axiom dyadic_value_in_R : forall n k : set , n :e omega -> k :e omega -> dyadic_value n k :e R.
Axiom dyadic_value_in_dyadic01 : forall n k : set , n :e omega -> k :e omega -> dyadic_value n k :e dyadic01.
Axiom dyadic01E : forall p : set , p :e dyadic01 -> exists n :e omega , exists k :e omega , p = dyadic_value n k.
Axiom dyadic01_unitE : forall p : set , p :e dyadic01_unit -> (exists n :e omega , exists k :e omega , p = dyadic_value n k) /\ p :e unit_interval.
Definition dyadic_index_set : set -> set := fun p : set => {n :e omega|exists k :e omega , p = dyadic_value n k}.
Axiom dyadic_index_set_Subq_omega : forall p : set , dyadic_index_set p c= omega.
Axiom dyadic_index_set_nonempty : forall p : set , p :e dyadic01 -> dyadic_index_set p <> Empty.
Axiom omega_nonempty_subset_has_least : forall A : set , A c= omega -> A <> Empty -> exists m : set , m :e A /\ forall n : set , n :e A -> (m :e n \/ m = n).
Axiom dyadic_index_set_has_least : forall p : set , p :e dyadic01 -> exists m : set , m :e dyadic_index_set p /\ forall n : set , n :e dyadic_index_set p -> (m :e n \/ m = n).
Definition dyadic_least_exp : set -> set := fun p : set => Eps_i (fun m : set => m :e dyadic_index_set p /\ forall n : set , n :e dyadic_index_set p -> (m :e n \/ m = n)).
Axiom dyadic_least_exp_spec : forall p : set , p :e dyadic01 -> dyadic_least_exp p :e dyadic_index_set p /\ forall n : set , n :e dyadic_index_set p -> (dyadic_least_exp p :e n \/ dyadic_least_exp p = n).
Definition dyadic_least_k : set -> set := fun p : set => Eps_i (fun k : set => k :e omega /\ (p = dyadic_value (dyadic_least_exp p) k)).
Axiom dyadic_least_k_spec : forall p : set , p :e dyadic01 -> dyadic_least_k p :e omega /\ p = dyadic_value (dyadic_least_exp p) (dyadic_least_k p).
Axiom dyadic_least_exp_in_omega : forall p : set , p :e dyadic01 -> dyadic_least_exp p :e omega.
Axiom dyadic_least_rep_eq : forall p : set , p :e dyadic01 -> p = dyadic_value (dyadic_least_exp p) (dyadic_least_k p).
Axiom dyadic_least_k_in_omega : forall p : set , p :e dyadic01 -> dyadic_least_k p :e omega.
Section dyadic_nat_decomp.
Infix + 360 right  := add_nat.
Infix * 355 right  := mul_nat.
Axiom ordsucc_1_eq_2_nat : ordsucc 1 = 2.
Axiom ordsucc_0_eq_1_nat : ordsucc 0 = 1.
Axiom two_mem_cases : forall r : set , r :e 2 -> r = 0 \/ r = 1.
Axiom quotient_remainder_nat_2 : forall m : set , nat_p m -> exists q :e omega , exists r :e 2 , m = q * 2 + r.
Definition even_by2 : set -> prop := fun k : set => exists q :e omega , k = q * 2 + 0.
Definition odd_by2 : set -> prop := fun k : set => exists q :e omega , k = q * 2 + 1.
Axiom nat_even_or_odd_by2 : forall k : set , nat_p k -> even_by2 k \/ odd_by2 k.
Definition half_of_odd_by2 : set -> set := fun k : set => Eps_i (fun q : set => q :e omega /\ k = q * 2 + 1).
Axiom half_of_odd_by2_spec : forall k : set , odd_by2 k -> half_of_odd_by2 k :e omega /\ k = (half_of_odd_by2 k) * 2 + 1.
Definition div2_nat : set -> set := fun k : set => Eps_i (fun q : set => q :e omega /\ exists r :e 2 , k = q * 2 + r).
Definition mod2_nat : set -> set := fun k : set => Eps_i (fun r : set => r :e 2 /\ k = (div2_nat k) * 2 + r).
Axiom div2_mod2_spec : forall k : set , nat_p k -> div2_nat k :e omega /\ mod2_nat k :e 2 /\ k = (div2_nat k) * 2 + (mod2_nat k).
End dyadic_nat_decomp.
Section dyadic_nat_props.
Infix + 360 right  := add_nat.
Infix * 355 right  := mul_nat.
Axiom div2_nat_in_omega : forall k : set , nat_p k -> div2_nat k :e omega.
Axiom mod2_nat_in_2 : forall k : set , nat_p k -> mod2_nat k :e 2.
Axiom div2_mod2_eq : forall k : set , nat_p k -> k = (div2_nat k) * 2 + (mod2_nat k).
Axiom mod2_nat_cases : forall k : set , nat_p k -> mod2_nat k = 0 \/ mod2_nat k = 1.
Axiom div2_nat_2_eq_1 : div2_nat 2 = 1.
Axiom mod2_nat_2_eq_0 : mod2_nat 2 = 0.
Axiom mul_nat_2_inj_global : forall m n : set , nat_p m -> nat_p n -> m * 2 = n * 2 -> m = n.
Axiom mod2_nat_eq_1_imp_not_divides2 : forall m : set , nat_p m -> mod2_nat m = 1 -> ~ divides_nat 2 m.
Axiom mod2_nat_mul2_eq_0 : forall k : set , nat_p k -> mod2_nat (k * 2) = 0.
Axiom div2_nat_mul2_eq_self : forall k : set , nat_p k -> div2_nat (k * 2) = k.
Axiom mod2_nat_succ_even_ne0 : forall k : set , nat_p k -> mod2_nat k = 0 -> ~ (mod2_nat (ordsucc k) = 0).
Axiom div2_nat_succ_even_eq_div2 : forall k : set , nat_p k -> mod2_nat k = 0 -> div2_nat (ordsucc k) = div2_nat k.
Axiom mod2_nat_succ_odd_eq_0 : forall k : set , nat_p k -> ~ (mod2_nat k = 0) -> mod2_nat (ordsucc k) = 0.
Axiom div2_nat_succ_odd_eq_ordsucc_div2 : forall k : set , nat_p k -> ~ (mod2_nat k = 0) -> div2_nat (ordsucc k) = ordsucc (div2_nat k).
Axiom dyadic_value_shift_even : forall n k : set , nat_p n -> nat_p k -> mod2_nat k = 0 -> dyadic_value (ordsucc n) k = dyadic_value n (div2_nat k).
Axiom dyadic01_unit_shift_even : forall n k : set , nat_p n -> nat_p k -> mod2_nat k = 0 -> dyadic_value (ordsucc n) k :e dyadic01_unit -> dyadic_value n (div2_nat k) :e dyadic01_unit.
Axiom dyadic_value_shift_up : forall n k : set , n :e omega -> k :e omega -> dyadic_value n k = dyadic_value (ordsucc n) (mul_nat k 2).
End dyadic_nat_props.
Axiom dyadic_value_raise_exp : forall n k t : set , n :e omega -> k :e omega -> t :e omega -> exists k0 : set , k0 :e omega /\ dyadic_value n k = dyadic_value (add_nat n t) k0.
Axiom dyadic_value_num_inj : forall n k1 k2 : set , n :e omega -> k1 :e omega -> k2 :e omega -> dyadic_value n k1 = dyadic_value n k2 -> k1 = k2.
Axiom group_inv_inv : forall G mult inv e x : set , function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall a b c : set , a :e G -> b :e G -> c :e G -> apply_fun mult (apply_fun mult (a,b),c) = apply_fun mult (a,apply_fun mult (b,c))) -> (forall a : set , a :e G -> apply_fun mult (e,a) = a /\ apply_fun mult (a,e) = a) -> (forall a : set , a :e G -> apply_fun mult (a,apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a,a) = e) -> x :e G -> apply_fun inv (apply_fun inv x) = x.
Axiom group_left_inv_solve : forall G mult inv e x y : set , function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall a b c : set , a :e G -> b :e G -> c :e G -> apply_fun mult (apply_fun mult (a,b),c) = apply_fun mult (a,apply_fun mult (b,c))) -> (forall a : set , a :e G -> apply_fun mult (e,a) = a /\ apply_fun mult (a,e) = a) -> (forall a : set , a :e G -> apply_fun mult (a,apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a,a) = e) -> x :e G -> y :e G -> apply_fun mult (apply_fun inv x,y) = e -> y = x.
Axiom left_translation_continuous : forall G Tg mult a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> a :e G -> let id := {(x,x)|x :e G} in continuous_map G Tg G Tg (compose_fun G (pair_map G (const_fun G a) id) mult).
Axiom left_translation_homeomorphism : forall G Tg mult inv e a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> let id := {(x,x)|x :e G} in let La := (compose_fun G (pair_map G (const_fun G a) id) mult) in homeomorphism G Tg G Tg La.
Axiom left_translation_image_open : forall G Tg mult inv e a U : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> U :e Tg -> image_of (compose_fun G (pair_map G (const_fun G a) {(x,x)|x :e G}) mult) U :e Tg.
Axiom right_translation_continuous : forall G Tg mult a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> a :e G -> let id := {(x,x)|x :e G} in let Ra := (compose_fun G (pair_map G id (const_fun G a)) mult) in continuous_map G Tg G Tg Ra.
Axiom right_translation_homeomorphism : forall G Tg mult inv e a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> let id := {(x,x)|x :e G} in let Ra := (compose_fun G (pair_map G id (const_fun G a)) mult) in homeomorphism G Tg G Tg Ra.
Axiom right_translation_image_open : forall G Tg mult inv e a U : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> U :e Tg -> image_of (compose_fun G (pair_map G {(x,x)|x :e G} (const_fun G a)) mult) U :e Tg.
Axiom topological_group_mult_image_open : forall G Tg mult inv e U V : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> U :e Tg -> V :e Tg -> image_of mult (setprod U V) :e Tg.
Axiom topological_group_setmul_by_open : forall G Tg mult inv e U V : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> U :e Tg -> V :e Tg -> setmul_by mult U V :e Tg.
Axiom topological_group_closure_sub_of_square : forall G Tg mult inv e V U : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> V :e Tg -> e :e V -> (forall x : set , x :e V -> apply_fun inv x :e V) -> (forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) :e U) -> closure_of G Tg V c= U.
Axiom topological_group_mult_neighborhood_square : forall G Tg mult e U : set , topology_on G Tg -> function_on mult (setprod G G) G -> e :e G -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> U :e Tg -> e :e U -> exists V : set , V :e Tg /\ e :e V /\ forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) :e U.
Axiom topological_group_closure_sub_setmul_by : forall G Tg mult inv e V A : set , topology_on G Tg -> function_on mult (setprod G G) G -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> V :e Tg -> e :e V -> (forall x : set , x :e V -> apply_fun inv x :e V) -> A c= G -> closure_of G Tg A c= setmul_by mult V A.
Axiom topological_group_symmetric_neighborhood_square : forall G Tg mult inv e U : set , topology_on G Tg -> function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> continuous_map G Tg G Tg inv -> U :e Tg -> e :e U -> exists V : set , V :e Tg /\ e :e V /\ (forall x : set , x :e V -> apply_fun inv x :e V) /\ forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) :e U.
Axiom topological_group_neighborhood_square_avoids_closed : forall G Tg mult inv e F : set , topology_on G Tg -> function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> continuous_map G Tg G Tg inv -> closed_in G Tg F -> e /:e F -> exists V : set , V :e Tg /\ e :e V /\ (forall x : set , x :e V -> apply_fun inv x :e V) /\ forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) /:e F.
Axiom topological_group_identity_closed_separator : forall G Tg mult inv e F : set , topology_on G Tg -> function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> continuous_map G Tg G Tg inv -> closed_in G Tg F -> e /:e F -> exists h : set , continuous_map G Tg R R_standard_topology h /\ apply_fun h e = 0 /\ forall z : set , z :e F -> apply_fun h z = 1.
Axiom topological_group_T1 : forall G Tg : set , topological_group G Tg -> T1_space G Tg.
Axiom topological_group_is_topology : forall G Tg : set , topological_group G Tg -> topology_on G Tg.
Definition separated_subsets : set -> set -> set -> set -> prop := fun X Tx A B => A c= X /\ B c= X /\ closure_of X Tx A :/\: B = Empty /\ A :/\: closure_of X Tx B = Empty.
Definition completely_normal_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ (forall Y : set , Y c= X -> normal_space Y (subspace_topology X Tx Y)).
Definition linear_continuum : set -> set -> prop := fun X Tx => simply_ordered_set X /\ Tx = order_topology X /\ (exists x y : set , x :e X /\ y :e X /\ x <> y) /\ (forall x y : set , x :e X -> y :e X -> order_rel X x y -> exists z : set , z :e X /\ order_rel X x z /\ order_rel X z y) /\ (forall A : set , A c= X -> A <> Empty -> (exists upper : set , upper :e X /\ forall a : set , a :e A -> order_rel X a upper \/ a = upper) -> exists lub : set , lub :e X /\ (forall a : set , a :e A -> order_rel X a lub \/ a = lub) /\ (forall bound : set , bound :e X -> (forall a : set , a :e A -> order_rel X a bound \/ a = bound) -> order_rel X lub bound \/ lub = bound)).
Axiom linear_continuum_simply_ordered : forall X Tx : set , linear_continuum X Tx -> simply_ordered_set X.
Axiom linear_continuum_order_topology_eq : forall X Tx : set , linear_continuum X Tx -> Tx = order_topology X.
Axiom linear_continuum_topology_on : forall X Tx : set , linear_continuum X Tx -> topology_on X Tx.
Axiom linear_continuum_lub_property : forall X Tx : set , linear_continuum X Tx -> forall A : set , A c= X -> A <> Empty -> (exists upper : set , upper :e X /\ forall a : set , a :e A -> order_rel X a upper \/ a = upper) -> exists lub : set , lub :e X /\ (forall a : set , a :e A -> order_rel X a lub \/ a = lub) /\ (forall bound : set , bound :e X -> (forall a : set , a :e A -> order_rel X a bound \/ a = bound) -> order_rel X lub bound \/ lub = bound).
Axiom linear_continuum_glb_property : forall X Tx A : set , linear_continuum X Tx -> A c= X -> A <> Empty -> (exists lower : set , lower :e X /\ forall a : set , a :e A -> order_rel X lower a \/ lower = a) -> exists glb : set , glb :e X /\ (forall a : set , a :e A -> order_rel X glb a \/ glb = a) /\ (forall bound : set , bound :e X -> (forall a : set , a :e A -> order_rel X bound a \/ bound = a) -> order_rel X bound glb \/ bound = glb).
Axiom linear_continuum_closed_contains_glb : forall X Tx C : set , linear_continuum X Tx -> closed_in X Tx C -> C <> Empty -> (exists lower : set , lower :e X /\ forall c : set , c :e C -> order_rel X lower c \/ lower = c) -> exists c0 : set , c0 :e C /\ (forall c : set , c :e C -> order_rel X c0 c \/ c0 = c) /\ (forall bound : set , bound :e X -> (forall c : set , c :e C -> order_rel X bound c \/ bound = c) -> order_rel X bound c0 \/ bound = c0).
Axiom linear_continuum_closed_contains_lub : forall X Tx C : set , linear_continuum X Tx -> closed_in X Tx C -> C <> Empty -> (exists upper : set , upper :e X /\ forall c : set , c :e C -> order_rel X c upper \/ c = upper) -> exists c0 : set , c0 :e C /\ (forall c : set , c :e C -> order_rel X c c0 \/ c = c0) /\ (forall bound : set , bound :e X -> (forall c : set , c :e C -> order_rel X c bound \/ c = bound) -> order_rel X c0 bound \/ c0 = bound).
Axiom thm24_1_linear_continuum_connected : forall X Tx : set , linear_continuum X Tx -> connected_space X Tx.
Axiom thm24_1_linear_continuum_intervals_connected : forall X Tx a b : set , linear_continuum X Tx -> a :e X -> b :e X -> order_rel X a b -> connected_space (order_interval X a b) (subspace_topology X Tx (order_interval X a b)).
Axiom thm24_1_linear_continuum_rays_connected : forall X Tx a b : set , linear_continuum X Tx -> a :e X -> b :e X -> connected_space {x :e X|order_rel X a x} (subspace_topology X Tx {x :e X|order_rel X a x}) /\ connected_space {x :e X|order_rel X x b} (subspace_topology X Tx {x :e X|order_rel X x b}).
Axiom ex30_1a_onepoint_Gdelta_firstcountable_T1 : forall X Tx x : set , first_countable_space X Tx -> T1_space X Tx -> x :e X -> Gdelta_in X Tx (Sing x).
Definition ex30_1b_AF_X : set := setprod omega omega.
Definition ex30_1b_AF_p : set := (0,0).
Definition ex30_1b_AF_nbh_p : set -> prop := fun U => ex30_1b_AF_p :e U /\ forall m :e omega , exists N :e omega , forall n : set , n :e omega -> N c= n -> (m,n) :e U.
Definition ex30_1b_AF_Tx : set := {U :e Power ex30_1b_AF_X|(ex30_1b_AF_p /:e U) \/ ex30_1b_AF_nbh_p U}.
Axiom ordsucc_not_Subq_self : forall n : set , ~ (ordsucc n c= n).
Axiom ex30_1b_AF_open_contains_p_implies_nbh : forall U : set , U :e ex30_1b_AF_Tx -> ex30_1b_AF_p :e U -> ex30_1b_AF_nbh_p U.
