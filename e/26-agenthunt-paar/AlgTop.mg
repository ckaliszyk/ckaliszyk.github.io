  {
    rewrite Hz0 at 1.
    rewrite Hz0 at 1.
    exact (mul_SNo_zeroR 0 SNo_0).
  }
  claim Hz1Sq0 : mul_SNo (z 1) (z 1) = 0.
  {
    rewrite Hz1 at 1.
    rewrite Hz1 at 1.
    exact (mul_SNo_zeroR 0 SNo_0).
  }
  rewrite Hz0Sq0.
  rewrite Hz1Sq0.
