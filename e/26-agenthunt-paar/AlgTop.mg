  ~(a :e image_of f unit_interval) ->
  ~(a :e image_of f' unit_interval) ->
  free_homotopy_loops
    (setprod R R :\: Sing a)
    (subspace_topology (setprod R R) R2_topology (setprod R R :\: Sing a))
    f f' F ->
  winding_number f a = winding_number f' a.
