      (graph n (fun i:set =>
        fundamental_group_mult (apply_fun Xfam i)
          (subspace_topology X Tx (apply_fun Xfam i)) p))
      ifam /\
    exists phi:set,
      group_isomorphism FP multFP
        (fundamental_group X Tx p) (fundamental_group_mult X Tx p) phi.
admit.
