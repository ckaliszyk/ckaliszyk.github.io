    continuous_map X Tx X Tx r /\
    (forall x:set, x :e X -> apply_fun r x :e A) /\
    (forall x:set, x :e A -> apply_fun r x = x).
{
  exact (andER
    (A c= X)
    (exists r:set,
      function_on r X X /\
      continuous_map X Tx X Tx r /\
