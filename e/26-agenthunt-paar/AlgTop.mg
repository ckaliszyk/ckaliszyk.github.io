            E Te
            E' Te'
            (w 0) (w 1)
            HtopE
            HtopE'
            Hw0subE
            Hw1subE').
        }
        claim HcodEq :
          product_topology
            U (subspace_topology B Tb U)
            U' (subspace_topology B' Tb' U') =
          subspace_topology
