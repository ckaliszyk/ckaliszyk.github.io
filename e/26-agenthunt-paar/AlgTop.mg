  HFToHg
  HHgToG).
Qed.

(** from S52 Definition (line 446 in algtop.tex): the induced homomorphism **)
(** LATEX VERSION: Let h: (X,x0) -> (Y,y0) be continuous. Define h-star: pi1(X,x0) -> pi1(Y,y0) by h-star([f]) = [h o f]. **)
Definition induced_homomorphism : set -> set -> set -> set -> set -> set -> set -> set :=
  fun X Tx x0 Y Ty y0 h =>
    graph (fundamental_group X Tx x0)
      (fun cls:set =>
        path_homotopy_class_loop Y Ty y0
          (compose_fun unit_interval (Eps_i (fun f:set => f :e cls)) h)).

(** Proven Bob **)
Theorem induced_homomorphism_apply : forall X Tx x0 Y Ty y0 h cls:set,
  cls :e fundamental_group X Tx x0 ->
  apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls
  = path_homotopy_class_loop Y Ty y0
      (compose_fun unit_interval (Eps_i (fun f:set => f :e cls)) h).
let X Tx x0 Y Ty y0 h cls.
assume Hcls.
exact (apply_fun_graph
  (fundamental_group X Tx x0)
  (fun c:set =>
    path_homotopy_class_loop Y Ty y0
      (compose_fun unit_interval (Eps_i (fun f:set => f :e c)) h))
  cls
  Hcls).
Qed.

(** Proven Bob **)
Theorem induced_homomorphism_apply_on_loop_class : forall X Tx x0 Y Ty y0 h f:set,
  f :e loop_space X Tx x0 ->
  apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h)
    (path_homotopy_class_loop X Tx x0 f)
  = path_homotopy_class_loop Y Ty y0
      (compose_fun unit_interval
        (Eps_i (fun g:set => g :e path_homotopy_class_loop X Tx x0 f))
        h).
let X Tx x0 Y Ty y0 h f.
assume Hf.
exact (induced_homomorphism_apply
  X Tx x0 Y Ty y0 h
  (path_homotopy_class_loop X Tx x0 f)
  (path_homotopy_class_in_fundamental_group X Tx x0 f Hf)).
Qed.

(** Infrastructure: any loop belongs to its own path-homotopy class **)
(** Proven Bob **)
Theorem loop_in_own_path_homotopy_class : forall X Tx x0 f:set,
  f :e loop_space X Tx x0 ->
  f :e path_homotopy_class_loop X Tx x0 f.
let X Tx x0 f.
assume HfLoop.
claim HfLoopAt : loop_at X Tx x0 f.
{
  exact (loop_space_has_loop_at X Tx x0 f HfLoop).
}
claim HfCont : continuous_map unit_interval unit_interval_topology X Tx f.
{
  exact (loop_at_continuous X Tx x0 f HfLoopAt).
}
claim Hf0 : apply_fun f 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 f HfLoopAt).
}
claim Hf1 : apply_fun f 1 = x0.
{
  exact (loop_at_at_one X Tx x0 f HfLoopAt).
}
claim Hrefl : path_homotopic X Tx x0 x0 f f.
{
  exact (Lemma_51_1_path_homotopy_refl
    X Tx x0 x0 f HfCont Hf0 Hf1).
}
exact (SepI
  (loop_space X Tx x0)
  (fun g:set => path_homotopic X Tx x0 x0 f g)
  f
  HfLoop
  Hrefl).
Qed.

(** Infrastructure: canonical Eps_i representative of a pi1 class is a loop **)
(** Proven Bob **)
Theorem eps_of_fundamental_group_member_in_loop_space : forall X Tx x0 cls:set,
  cls :e fundamental_group X Tx x0 ->
  (Eps_i (fun f:set => f :e cls)) :e loop_space X Tx x0.
let X Tx x0 cls.
assume Hcls.
claim Hrep : exists f:set, f :e loop_space X Tx x0 /\
  cls = path_homotopy_class_loop X Tx x0 f.
{
  exact (fundamental_group_member_has_representative
    X Tx x0 cls Hcls).
}
apply Hrep.
let f.
assume HfPack.
claim HfLoop : f :e loop_space X Tx x0.
{
  exact (andEL
    (f :e loop_space X Tx x0)
    (cls = path_homotopy_class_loop X Tx x0 f)
    HfPack).
}
claim HclsEqf : cls = path_homotopy_class_loop X Tx x0 f.
{
  exact (andER
    (f :e loop_space X Tx x0)
    (cls = path_homotopy_class_loop X Tx x0 f)
    HfPack).
}
claim HfInCls : f :e cls.
{
  exact (mem_eqL
    f
    cls
    (path_homotopy_class_loop X Tx x0 f)
    HclsEqf
    (loop_in_own_path_homotopy_class X Tx x0 f HfLoop)).
}
claim HepsInCls : (Eps_i (fun g:set => g :e cls)) :e cls.
{
  exact (Eps_i_ax
    (fun g:set => g :e cls)
    f
    HfInCls).
}
claim HepsInClassf :
  (Eps_i (fun g:set => g :e cls))
  :e path_homotopy_class_loop X Tx x0 f.
{
  exact (mem_eqR
    (Eps_i (fun g:set => g :e cls))
    cls
    (path_homotopy_class_loop X Tx x0 f)
    HclsEqf
    HepsInCls).
}
exact (path_homotopy_class_loop_in_loop_space
  X Tx x0 f
  (Eps_i (fun g:set => g :e cls))
  HepsInClassf).
Qed.

(** Infrastructure: postcomposition carries loops to loops at image basepoint **)
(** Proven Bob **)
Theorem loop_space_postcompose : forall X Tx x0 Y Ty y0 f h:set,
  f :e loop_space X Tx x0 ->
  continuous_map X Tx Y Ty h ->
  apply_fun h x0 = y0 ->
  (compose_fun unit_interval f h) :e loop_space Y Ty y0.
let X Tx x0 Y Ty y0 f h.
assume HfLoop Hh Hbase.
claim HfLoopAt : loop_at X Tx x0 f.
{
  exact (loop_space_has_loop_at X Tx x0 f HfLoop).
}
claim HfCont : continuous_map unit_interval unit_interval_topology X Tx f.
{
  exact (loop_at_continuous X Tx x0 f HfLoopAt).
}
claim Hf0 : apply_fun f 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 f HfLoopAt).
}
claim Hf1 : apply_fun f 1 = x0.
{
  exact (loop_at_at_one X Tx x0 f HfLoopAt).
}
claim HfFun : function_on f unit_interval X.
{
  exact (continuous_map_function_on
    unit_interval unit_interval_topology X Tx f HfCont).
}
claim HhFun : function_on h X Y.
{
  exact (continuous_map_function_on
    X Tx Y Ty h Hh).
}
claim HcompCont :
  continuous_map unit_interval unit_interval_topology Y Ty
    (compose_fun unit_interval f h).
{
  exact (composition_continuous
    unit_interval unit_interval_topology
    X Tx
    Y Ty
    f
    h
    HfCont
    Hh).
}
claim Hcomp0 :
  apply_fun (compose_fun unit_interval f h) 0 = y0.
{
  rewrite (compose_fun_apply
    unit_interval f h 0 zero_in_unit_interval).
  rewrite Hf0.
  exact Hbase.
}
claim Hcomp1 :
  apply_fun (compose_fun unit_interval f h) 1 = y0.
{
  rewrite (compose_fun_apply
    unit_interval f h 1 one_in_unit_interval).
  rewrite Hf1.
  exact Hbase.
}
claim HcompLoopAt : loop_at Y Ty y0 (compose_fun unit_interval f h).
{
  apply (loop_at_fold
    Y Ty y0
    (compose_fun unit_interval f h)).
  apply andI.
  - apply andI.
    + exact HcompCont.
    + exact Hcomp0.
  - exact Hcomp1.
}
exact (SepI
  (function_space unit_interval Y)
  (fun g:set => loop_at Y Ty y0 g)
  (compose_fun unit_interval f h)
  (compose_fun_in_function_space
    unit_interval X Y
    f h
    HfFun
    HhFun)
  HcompLoopAt).
Qed.

(** Infrastructure: concatenation of based loops is a based loop **)
(** Proven Bob **)
Theorem path_concat_preserves_loop_space : forall X Tx x0 f g:set,
  f :e loop_space X Tx x0 ->
  g :e loop_space X Tx x0 ->
  path_concat f g :e loop_space X Tx x0.
let X Tx x0 f g.
assume HfLoop HgLoop.
claim HfLoopAt : loop_at X Tx x0 f.
{
  exact (loop_space_has_loop_at X Tx x0 f HfLoop).
}
claim HgLoopAt : loop_at X Tx x0 g.
{
  exact (loop_space_has_loop_at X Tx x0 g HgLoop).
}
claim HfCont : continuous_map unit_interval unit_interval_topology X Tx f.
{
  exact (loop_at_continuous X Tx x0 f HfLoopAt).
}
claim HgCont : continuous_map unit_interval unit_interval_topology X Tx g.
{
  exact (loop_at_continuous X Tx x0 g HgLoopAt).
}
claim Hf0 : apply_fun f 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 f HfLoopAt).
}
claim Hf1 : apply_fun f 1 = x0.
{
  exact (loop_at_at_one X Tx x0 f HfLoopAt).
}
claim Hg0 : apply_fun g 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 g HgLoopAt).
}
claim Hg1 : apply_fun g 1 = x0.
{
  exact (loop_at_at_one X Tx x0 g HgLoopAt).
}
claim HfFun : function_on f unit_interval X.
{
  exact (continuous_map_function_on
    unit_interval unit_interval_topology X Tx f HfCont).
}
claim HgFun : function_on g unit_interval X.
{
  exact (continuous_map_function_on
    unit_interval unit_interval_topology X Tx g HgCont).
}
claim HconcatCont :
  continuous_map unit_interval unit_interval_topology X Tx (path_concat f g).
{
  exact (path_concat_continuous
    X Tx x0 x0 x0
    f g
    HfCont HgCont
    Hf0 Hf1
    Hg0 Hg1).
}
claim Hconcat0 : apply_fun (path_concat f g) 0 = x0.
{
  rewrite (path_concat_at_zero f g).
  exact Hf0.
}
claim Hconcat1 : apply_fun (path_concat f g) 1 = x0.
{
  rewrite (path_concat_at_one f g).
  exact Hg1.
}
claim HconcatLoopAt : loop_at X Tx x0 (path_concat f g).
{
  apply (loop_at_fold
    X Tx x0
    (path_concat f g)).
  apply andI.
  - apply andI.
    + exact HconcatCont.
    + exact Hconcat0.
  - exact Hconcat1.
}
claim HconcatSub : path_concat f g c= setprod unit_interval X.
{
  let p.
  assume Hp.
  apply (binunionE
    {(t, apply_fun f (mul_SNo 2 t)) | t :e unit_interval_left_half}
    {(t, apply_fun g (add_SNo (mul_SNo 2 t) (minus_SNo 1))) | t :e unit_interval_right_half}
    p
    Hp).
  - assume Hleft.
    apply (ReplE_impred
      unit_interval_left_half
      (fun t:set => (t, apply_fun f (mul_SNo 2 t)))
      p
      Hleft).
    let t.
    assume Ht Heq.
    claim H2tInI : mul_SNo 2 t :e unit_interval.
    {
      rewrite <- (double_map_apply t Ht).
      exact (double_map_function_on t Ht).
    }
    rewrite Heq.
    exact (tuple_2_setprod_by_pair_Sigma
      unit_interval
      X
      t
      (apply_fun f (mul_SNo 2 t))
      (unit_interval_left_half_sub t Ht)
      (HfFun
        (mul_SNo 2 t)
        H2tInI)).
  - assume Hright.
    apply (ReplE_impred
      unit_interval_right_half
      (fun t:set => (t, apply_fun g (add_SNo (mul_SNo 2 t) (minus_SNo 1))))
      p
      Hright).
    let t.
    assume Ht Heq.
    claim H2m1tInI : add_SNo (mul_SNo 2 t) (minus_SNo 1) :e unit_interval.
    {
      rewrite <- (double_minus_one_map_apply t Ht).
      exact (double_minus_one_map_function_on t Ht).
    }
    rewrite Heq.
    exact (tuple_2_setprod_by_pair_Sigma
      unit_interval
      X
      t
      (apply_fun g (add_SNo (mul_SNo 2 t) (minus_SNo 1)))
      (unit_interval_right_half_sub t Ht)
      (HgFun
        (add_SNo (mul_SNo 2 t) (minus_SNo 1))
        H2m1tInI)).
}
claim HconcatPow : path_concat f g :e Power (setprod unit_interval X).
{
  exact (PowerI
    (setprod unit_interval X)
    (path_concat f g)
    HconcatSub).
}
claim HconcatFunOn : function_on (path_concat f g) unit_interval X.
{
  exact (continuous_map_function_on
    unit_interval unit_interval_topology X Tx
    (path_concat f g)
    HconcatCont).
}
claim HconcatFunSpace : path_concat f g :e function_space unit_interval X.
{
  exact (SepI
    (Power (setprod unit_interval X))
    (fun u:set => function_on u unit_interval X)
    (path_concat f g)
    HconcatPow
    HconcatFunOn).
}
exact (SepI
  (function_space unit_interval X)
  (fun u:set => loop_at X Tx x0 u)
  (path_concat f g)
  HconcatFunSpace
  HconcatLoopAt).
Qed.

(** Infrastructure: postcomposition distributes over path_concat **)
(** Proven Bob **)
Theorem compose_path_concat_eq_algtop : forall X Y f g h:set,
  function_on f unit_interval X ->
  function_on g unit_interval X ->
  function_on h X Y ->
  apply_fun f 1 = apply_fun g 0 ->
  compose_fun unit_interval (path_concat f g) h
  = path_concat
      (compose_fun unit_interval f h)
      (compose_fun unit_interval g h).
let X Y f g h.
assume Hf Hg Hh Hfg.
apply set_ext.
- let p.
  assume Hp.
  apply (ReplE_impred
    unit_interval
    (fun t:set => (t, apply_fun h (apply_fun (path_concat f g) t)))
    p
    Hp).
  let t.
  assume Ht Heq.
  claim Hcases : t :e unit_interval_left_half :\/: unit_interval_right_half.
  {
    exact (unit_interval_halves_cover
      (fun a b:set => t :e a -> t :e b)
      (binunion_Subq_min
        unit_interval_left_half
        unit_interval_right_half
        unit_interval
        unit_interval_left_half_sub
        unit_interval_right_half_sub
        t)
      Ht).
  }
  apply (binunionE
    unit_interval_left_half
    unit_interval_right_half
    t
    Hcases).
  + assume HtL.
    claim H2tInI : mul_SNo 2 t :e unit_interval.
    {
      rewrite <- (double_map_apply t HtL).
      exact (double_map_function_on t HtL).
    }
    rewrite Heq.
    rewrite (path_concat_apply_left f g t Hfg HtL).
    rewrite <- (compose_fun_apply
      unit_interval
      f
      h
      (mul_SNo 2 t)
      H2tInI).
    exact (binunionI1
      {(s, apply_fun (compose_fun unit_interval f h) (mul_SNo 2 s))
        | s :e unit_interval_left_half}
      {(s, apply_fun (compose_fun unit_interval g h) (add_SNo (mul_SNo 2 s) (minus_SNo 1)))
        | s :e unit_interval_right_half}
      (t, apply_fun (compose_fun unit_interval f h) (mul_SNo 2 t))
      (ReplI
        unit_interval_left_half
        (fun s:set =>
          (s, apply_fun (compose_fun unit_interval f h) (mul_SNo 2 s)))
        t
        HtL)).
  + assume HtR.
    claim H2m1tInI : add_SNo (mul_SNo 2 t) (minus_SNo 1) :e unit_interval.
    {
      rewrite <- (double_minus_one_map_apply t HtR).
      exact (double_minus_one_map_function_on t HtR).
    }
    rewrite Heq.
    rewrite (path_concat_apply_right f g t Hfg HtR).
    rewrite <- (compose_fun_apply
      unit_interval
      g
      h
      (add_SNo (mul_SNo 2 t) (minus_SNo 1))
      H2m1tInI).
    exact (binunionI2
      {(s, apply_fun (compose_fun unit_interval f h) (mul_SNo 2 s))
        | s :e unit_interval_left_half}
      {(s, apply_fun (compose_fun unit_interval g h) (add_SNo (mul_SNo 2 s) (minus_SNo 1)))
        | s :e unit_interval_right_half}
      (t, apply_fun (compose_fun unit_interval g h) (add_SNo (mul_SNo 2 t) (minus_SNo 1)))
      (ReplI
        unit_interval_right_half
        (fun s:set =>
          (s, apply_fun (compose_fun unit_interval g h) (add_SNo (mul_SNo 2 s) (minus_SNo 1))))
        t
        HtR)).
- let p.
  assume Hp.
  apply (binunionE
    {(t, apply_fun (compose_fun unit_interval f h) (mul_SNo 2 t))
      | t :e unit_interval_left_half}
    {(t, apply_fun (compose_fun unit_interval g h) (add_SNo (mul_SNo 2 t) (minus_SNo 1)))
      | t :e unit_interval_right_half}
    p
    Hp).
  + assume Hleft.
    apply (ReplE_impred
      unit_interval_left_half
      (fun t:set =>
        (t, apply_fun (compose_fun unit_interval f h) (mul_SNo 2 t)))
      p
      Hleft).
    let t.
    assume Ht Heq.
    claim HtI : t :e unit_interval.
    {
      exact (unit_interval_left_half_sub t Ht).
    }
    claim H2tInI : mul_SNo 2 t :e unit_interval.
    {
      rewrite <- (double_map_apply t Ht).
      exact (double_map_function_on t Ht).
    }
    rewrite Heq.
    rewrite (compose_fun_apply
      unit_interval
      f
      h
      (mul_SNo 2 t)
      H2tInI).
    rewrite <- (path_concat_apply_left f g t Hfg Ht).
    exact (ReplI
      unit_interval
      (fun s:set => (s, apply_fun h (apply_fun (path_concat f g) s)))
      t
      HtI).
  + assume Hright.
    apply (ReplE_impred
      unit_interval_right_half
      (fun t:set =>
        (t, apply_fun (compose_fun unit_interval g h) (add_SNo (mul_SNo 2 t) (minus_SNo 1))))
      p
      Hright).
    let t.
    assume Ht Heq.
    claim HtI : t :e unit_interval.
    {
      exact (unit_interval_right_half_sub t Ht).
    }
    claim H2m1tInI : add_SNo (mul_SNo 2 t) (minus_SNo 1) :e unit_interval.
    {
      rewrite <- (double_minus_one_map_apply t Ht).
      exact (double_minus_one_map_function_on t Ht).
    }
    rewrite Heq.
    rewrite (compose_fun_apply
      unit_interval
      g
      h
      (add_SNo (mul_SNo 2 t) (minus_SNo 1))
      H2m1tInI).
    rewrite <- (path_concat_apply_right f g t Hfg Ht).
    exact (ReplI
      unit_interval
      (fun s:set => (s, apply_fun h (apply_fun (path_concat f g) s)))
      t
      HtI).
Qed.

(** from S52 (line 458 in algtop.tex): h-star is a homomorphism **)
(** LATEX VERSION: The map h-star is a well-defined group homomorphism. **)
(** EFFORT: 4 lines textbook, difficulty 3/10, USD 50 **)
(** Collected Bob 55 **)
(** Proven Bob **)
Theorem induced_homomorphism_is_homomorphism : forall X Tx x0 Y Ty y0 h:set,
  continuous_map X Tx Y Ty h ->
  apply_fun h x0 = y0 -> x0 :e X ->
  group_homomorphism
    (fundamental_group X Tx x0) (fundamental_group_mult X Tx x0)
    (fundamental_group Y Ty y0) (fundamental_group_mult Y Ty y0)
    (induced_homomorphism X Tx x0 Y Ty y0 h).
let X Tx x0 Y Ty y0 h.
assume Hh Hbase Hx0.
claim HhFun : function_on h X Y.
{
  exact (continuous_map_function_on
    X Tx Y Ty h Hh).
}
prove
  function_on
    (induced_homomorphism X Tx x0 Y Ty y0 h)
    (fundamental_group X Tx x0)
    (fundamental_group Y Ty y0) /\
  (forall x y:set,
    x :e fundamental_group X Tx x0 ->
    y :e fundamental_group X Tx x0 ->
    apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h)
      (apply_fun (fundamental_group_mult X Tx x0) (x, y))
    = apply_fun (fundamental_group_mult Y Ty y0)
        (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) x,
         apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) y)).
apply andI.
- let cls.
  assume Hcls.
  set eps := Eps_i (fun f:set => f :e cls).
  rewrite (induced_homomorphism_apply
    X Tx x0 Y Ty y0 h cls Hcls).
  claim HepsLoop : eps :e loop_space X Tx x0.
  {
    exact (eps_of_fundamental_group_member_in_loop_space
      X Tx x0 cls Hcls).
  }
  claim HcompLoop :
    (compose_fun unit_interval eps h) :e loop_space Y Ty y0.
  {
    exact (loop_space_postcompose
      X Tx x0 Y Ty y0
      eps h
      HepsLoop
      Hh
      Hbase).
  }
  exact (path_homotopy_class_in_fundamental_group
    Y Ty y0
    (compose_fun unit_interval eps h)
    HcompLoop).
- let cls1 cls2.
  assume Hcls1 Hcls2.
  set eps1 := Eps_i (fun f:set => f :e cls1).
  set eps2 := Eps_i (fun f:set => f :e cls2).
  claim Heps1Loop : eps1 :e loop_space X Tx x0.
  {
    exact (eps_of_fundamental_group_member_in_loop_space
      X Tx x0 cls1 Hcls1).
  }
  claim Heps2Loop : eps2 :e loop_space X Tx x0.
  {
    exact (eps_of_fundamental_group_member_in_loop_space
      X Tx x0 cls2 Hcls2).
  }
  claim Heps1LoopAt : loop_at X Tx x0 eps1.
  {
    exact (loop_space_has_loop_at X Tx x0 eps1 Heps1Loop).
  }
  claim Heps2LoopAt : loop_at X Tx x0 eps2.
  {
    exact (loop_space_has_loop_at X Tx x0 eps2 Heps2Loop).
  }
  claim Heps1Fun : function_on eps1 unit_interval X.
  {
    exact (function_on_of_function_space
      eps1
      unit_interval
      X
      (loop_space_in_function_space X Tx x0 eps1 Heps1Loop)).
  }
  claim Heps2Fun : function_on eps2 unit_interval X.
  {
    exact (function_on_of_function_space
      eps2
      unit_interval
      X
      (loop_space_in_function_space X Tx x0 eps2 Heps2Loop)).
  }
  claim Heps1_1 : apply_fun eps1 1 = x0.
  {
    exact (loop_at_at_one X Tx x0 eps1 Heps1LoopAt).
  }
  claim Heps2_0 : apply_fun eps2 0 = x0.
  {
    exact (loop_at_at_zero X Tx x0 eps2 Heps2LoopAt).
  }
  claim HepsJoin : apply_fun eps1 1 = apply_fun eps2 0.
  {
    rewrite Heps1_1.
    rewrite Heps2_0.
    exact (fun Q H => H).
  }
  claim HpairX :
    (cls1, cls2)
    :e setprod (fundamental_group X Tx x0) (fundamental_group X Tx x0).
  {
    exact (tuple_2_setprod_by_pair_Sigma
      (fundamental_group X Tx x0)
      (fundamental_group X Tx x0)
      cls1
      cls2
      Hcls1
      Hcls2).
  }
  rewrite (fundamental_group_mult_apply
    X Tx x0
    (cls1, cls2)
    HpairX).
  rewrite (tuple_2_0_eq cls1 cls2).
  rewrite (tuple_2_1_eq cls1 cls2).
  set cls12 := path_homotopy_class_loop X Tx x0 (path_concat eps1 eps2).
  claim HconcatLoopX : path_concat eps1 eps2 :e loop_space X Tx x0.
  {
    exact (path_concat_preserves_loop_space
      X Tx x0
      eps1 eps2
      Heps1Loop
      Heps2Loop).
  }
  claim Hcls12In : cls12 :e fundamental_group X Tx x0.
  {
    exact (path_homotopy_class_in_fundamental_group
      X Tx x0
      (path_concat eps1 eps2)
      HconcatLoopX).
  }
  rewrite (induced_homomorphism_apply
    X Tx x0 Y Ty y0 h
    cls12
    Hcls12In).
  set eps12 := Eps_i (fun f:set => f :e cls12).
  claim Him1Eq :
    apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1
    = path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps1 h).
  {
    exact (induced_homomorphism_apply
      X Tx x0 Y Ty y0 h
      cls1
      Hcls1).
  }
  claim Him2Eq :
    apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2
    = path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps2 h).
  {
    exact (induced_homomorphism_apply
      X Tx x0 Y Ty y0 h
      cls2
      Hcls2).
  }
  claim Hcomp1Loop :
    (compose_fun unit_interval eps1 h) :e loop_space Y Ty y0.
  {
    exact (loop_space_postcompose
      X Tx x0 Y Ty y0
      eps1 h
      Heps1Loop
      Hh
      Hbase).
  }
  claim Hcomp2Loop :
    (compose_fun unit_interval eps2 h) :e loop_space Y Ty y0.
  {
    exact (loop_space_postcompose
      X Tx x0 Y Ty y0
      eps2 h
      Heps2Loop
      Hh
      Hbase).
  }
  claim Him1In :
    apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1
    :e fundamental_group Y Ty y0.
  {
    rewrite Him1Eq.
    exact (path_homotopy_class_in_fundamental_group
      Y Ty y0
      (compose_fun unit_interval eps1 h)
      Hcomp1Loop).
  }
  claim Him2In :
    apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2
    :e fundamental_group Y Ty y0.
  {
    rewrite Him2Eq.
    exact (path_homotopy_class_in_fundamental_group
      Y Ty y0
      (compose_fun unit_interval eps2 h)
      Hcomp2Loop).
  }
  claim HpairY :
    (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1,
     apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)
    :e setprod (fundamental_group Y Ty y0) (fundamental_group Y Ty y0).
  {
    exact (tuple_2_setprod_by_pair_Sigma
      (fundamental_group Y Ty y0)
      (fundamental_group Y Ty y0)
      (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1)
      (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)
      Him1In
      Him2In).
  }
  rewrite (fundamental_group_mult_apply
    Y Ty y0
    (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1,
     apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)
    HpairY).
  rewrite (tuple_2_0_eq
    (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1)
    (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)).
  rewrite (tuple_2_1_eq
    (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1)
    (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)).
  set epsY1 := Eps_i
    (fun f:set =>
      f :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1).
  set epsY2 := Eps_i
    (fun f:set =>
      f :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2).
  claim HpathConcatInCls12 :
    path_concat eps1 eps2 :e cls12.
  {
    exact (loop_in_own_path_homotopy_class
      X Tx x0
      (path_concat eps1 eps2)
      HconcatLoopX).
  }
  claim Heps12InCls12 : eps12 :e cls12.
  {
    exact (Eps_i_ax
      (fun f:set => f :e cls12)
      (path_concat eps1 eps2)
      HpathConcatInCls12).
  }
  claim Heps12HomX :
    path_homotopic X Tx x0 x0
      (path_concat eps1 eps2)
      eps12.
  {
    exact (path_homotopy_class_loop_has_homotopy
      X Tx x0
      (path_concat eps1 eps2)
      eps12
      Heps12InCls12).
  }
  claim Hpost12 :
    path_homotopic Y Ty y0 y0
      (compose_fun unit_interval (path_concat eps1 eps2) h)
      (compose_fun unit_interval eps12 h).
  {
    exact (path_homotopic_postcompose
      X Tx Y Ty x0 x0 y0 y0
      (path_concat eps1 eps2)
      eps12
      h
      Heps12HomX
      Hh
      Hbase
      Hbase).
  }
  claim Hpost12Sym :
    path_homotopic Y Ty y0 y0
      (compose_fun unit_interval eps12 h)
      (compose_fun unit_interval (path_concat eps1 eps2) h).
  {
    exact (Lemma_51_1_path_homotopy_sym
      Y Ty y0 y0
      (compose_fun unit_interval (path_concat eps1 eps2) h)
      (compose_fun unit_interval eps12 h)
      Hpost12).
  }
  claim Hstep1 :
    path_homotopy_class_loop Y Ty y0
      (compose_fun unit_interval eps12 h)
    = path_homotopy_class_loop Y Ty y0
      (compose_fun unit_interval (path_concat eps1 eps2) h).
  {
    exact (path_homotopy_class_loop_eq_of_path_homotopic
      Y Ty y0
      (compose_fun unit_interval eps12 h)
      (compose_fun unit_interval (path_concat eps1 eps2) h)
      Hpost12Sym).
  }
  claim Hstep2 :
    path_homotopy_class_loop Y Ty y0
      (compose_fun unit_interval (path_concat eps1 eps2) h)
    = path_homotopy_class_loop Y Ty y0
      (path_concat
        (compose_fun unit_interval eps1 h)
        (compose_fun unit_interval eps2 h)).
  {
    rewrite (compose_path_concat_eq_algtop
      X Y
      eps1 eps2 h
      Heps1Fun
      Heps2Fun
      HhFun
      HepsJoin).
    reflexivity.
  }
  claim Hcomp1InCls1 :
    (compose_fun unit_interval eps1 h)
    :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1.
  {
    exact (mem_eqL
      (compose_fun unit_interval eps1 h)
      (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1)
      (path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps1 h))
      Him1Eq
      (loop_in_own_path_homotopy_class
        Y Ty y0
        (compose_fun unit_interval eps1 h)
        Hcomp1Loop)).
  }
  claim Hcomp2InCls2 :
    (compose_fun unit_interval eps2 h)
    :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2.
  {
    exact (mem_eqL
      (compose_fun unit_interval eps2 h)
      (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)
      (path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps2 h))
      Him2Eq
      (loop_in_own_path_homotopy_class
        Y Ty y0
        (compose_fun unit_interval eps2 h)
        Hcomp2Loop)).
  }
  claim HepsY1InCls1 :
    epsY1 :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1.
  {
    exact (Eps_i_ax
      (fun f:set =>
        f :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1)
      (compose_fun unit_interval eps1 h)
      Hcomp1InCls1).
  }
  claim HepsY2InCls2 :
    epsY2 :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2.
  {
    exact (Eps_i_ax
      (fun f:set =>
        f :e apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)
      (compose_fun unit_interval eps2 h)
      Hcomp2InCls2).
  }
  claim HepsY1InClass :
    epsY1 :e path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps1 h).
  {
    exact (mem_eqR
      epsY1
      (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls1)
      (path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps1 h))
      Him1Eq
      HepsY1InCls1).
  }
  claim HepsY2InClass :
    epsY2 :e path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps2 h).
  {
    exact (mem_eqR
      epsY2
      (apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls2)
      (path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval eps2 h))
      Him2Eq
      HepsY2InCls2).
  }
  claim Hhom1 :
    path_homotopic Y Ty y0 y0
      (compose_fun unit_interval eps1 h)
      epsY1.
  {
    exact (path_homotopy_class_loop_has_homotopy
      Y Ty y0
      (compose_fun unit_interval eps1 h)
      epsY1
      HepsY1InClass).
  }
  claim Hhom2 :
    path_homotopic Y Ty y0 y0
      (compose_fun unit_interval eps2 h)
      epsY2.
  {
    exact (path_homotopy_class_loop_has_homotopy
      Y Ty y0
      (compose_fun unit_interval eps2 h)
      epsY2
      HepsY2InClass).
  }
  claim HconcatHom :
    path_homotopic Y Ty y0 y0
      (path_concat
        (compose_fun unit_interval eps1 h)
        (compose_fun unit_interval eps2 h))
      (path_concat epsY1 epsY2).
  {
    exact (path_concat_well_defined_on_classes
      Y Ty y0 y0 y0
      (compose_fun unit_interval eps1 h)
      epsY1
      (compose_fun unit_interval eps2 h)
      epsY2
      Hhom1
      Hhom2).
  }
  claim Hstep3 :
    path_homotopy_class_loop Y Ty y0
      (path_concat
        (compose_fun unit_interval eps1 h)
        (compose_fun unit_interval eps2 h))
    = path_homotopy_class_loop Y Ty y0
      (path_concat epsY1 epsY2).
  {
    exact (path_homotopy_class_loop_eq_of_path_homotopic
      Y Ty y0
      (path_concat
        (compose_fun unit_interval eps1 h)
        (compose_fun unit_interval eps2 h))
      (path_concat epsY1 epsY2)
      HconcatHom).
  }
  rewrite Hstep1.
  rewrite Hstep2.
  exact Hstep3.
Qed.

(** from S52 Thm 52.4 (line 475 in algtop.tex): functorial properties **)
(** LATEX VERSION: If h: (X,x0)->(Y,y0) and k: (Y,y0)->(Z,z0) are continuous, then (k o h)-star = k-star o h-star. If i is the identity, then i-star is the identity. **)

(** EFFORT: 4 lines textbook, difficulty 2/10, USD 30 **)
(** Collected Bob 30 **)
(** Proven Bob **)
Theorem Theorem_52_4_functorial_composition : forall X Tx x0 Y Ty y0 Z Tz z0 h k:set,
  continuous_map X Tx Y Ty h -> continuous_map Y Ty Z Tz k ->
  apply_fun h x0 = y0 -> apply_fun k y0 = z0 -> x0 :e X ->
  forall cls:set, cls :e fundamental_group X Tx x0 ->
    apply_fun (induced_homomorphism X Tx x0 Z Tz z0 (compose_fun X h k)) cls
    = apply_fun (compose_fun (fundamental_group X Tx x0)
        (induced_homomorphism X Tx x0 Y Ty y0 h)
        (induced_homomorphism Y Ty y0 Z Tz z0 k)) cls.
let X Tx x0 Y Ty y0 Z Tz z0 h k.
assume Hh Hk Hx0 Hy0 Hx.
let cls.
assume Hcls.
set epsX := Eps_i (fun f0:set => f0 :e cls).
rewrite (induced_homomorphism_apply
  X Tx x0 Z Tz z0 (compose_fun X h k) cls Hcls).
rewrite (compose_fun_apply
  (fundamental_group X Tx x0)
  (induced_homomorphism X Tx x0 Y Ty y0 h)
  (induced_homomorphism Y Ty y0 Z Tz z0 k)
  cls
  Hcls).
claim HhFun : function_on h X Y.
{
  exact (continuous_map_function_on
    X Tx Y Ty h Hh).
}
claim HkFun : function_on k Y Z.
{
  exact (continuous_map_function_on
    Y Ty Z Tz k Hk).
}
claim Hrep : exists f:set, f :e loop_space X Tx x0 /\
  cls = path_homotopy_class_loop X Tx x0 f.
{
  exact (fundamental_group_member_has_representative
    X Tx x0 cls Hcls).
}
apply Hrep.
let f.
assume HfPack.
claim HfLoop : f :e loop_space X Tx x0.
{
  exact (andEL
    (f :e loop_space X Tx x0)
    (cls = path_homotopy_class_loop X Tx x0 f)
    HfPack).
}
claim HclsEqf : cls = path_homotopy_class_loop X Tx x0 f.
{
  exact (andER
    (f :e loop_space X Tx x0)
    (cls = path_homotopy_class_loop X Tx x0 f)
    HfPack).
}
claim HfLoopAt : loop_at X Tx x0 f.
{
  exact (loop_space_has_loop_at X Tx x0 f HfLoop).
}
claim HfCont : continuous_map unit_interval unit_interval_topology X Tx f.
{
  exact (loop_at_continuous X Tx x0 f HfLoopAt).
}
claim Hf0 : apply_fun f 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 f HfLoopAt).
}
claim Hf1 : apply_fun f 1 = x0.
{
  exact (loop_at_at_one X Tx x0 f HfLoopAt).
}
claim HfHomSelf : path_homotopic X Tx x0 x0 f f.
{
  exact (Lemma_51_1_path_homotopy_refl
    X Tx x0 x0 f HfCont Hf0 Hf1).
}
claim HfInClass : f :e path_homotopy_class_loop X Tx x0 f.
{
  exact (SepI
    (loop_space X Tx x0)
    (fun g:set => path_homotopic X Tx x0 x0 f g)
    f
    HfLoop
    HfHomSelf).
}
claim HfInCls : f :e cls.
{
  exact (mem_eqL
    f
    cls
    (path_homotopy_class_loop X Tx x0 f)
    HclsEqf
    HfInClass).
}
claim HepsXInCls : epsX :e cls.
{
  exact (Eps_i_ax
    (fun g:set => g :e cls)
    f
    HfInCls).
}
claim HepsXInClassf : epsX :e path_homotopy_class_loop X Tx x0 f.
{
  exact (mem_eqR
    epsX
    cls
    (path_homotopy_class_loop X Tx x0 f)
    HclsEqf
    HepsXInCls).
}
claim HepsXLoop : epsX :e loop_space X Tx x0.
{
  exact (path_homotopy_class_loop_in_loop_space
    X Tx x0 f epsX HepsXInClassf).
}
claim HepsXLoopAt : loop_at X Tx x0 epsX.
{
  exact (loop_space_has_loop_at X Tx x0 epsX HepsXLoop).
}
claim HepsXCont : continuous_map unit_interval unit_interval_topology X Tx epsX.
{
  exact (loop_at_continuous X Tx x0 epsX HepsXLoopAt).
}
claim HepsXFun : function_on epsX unit_interval X.
{
  exact (continuous_map_function_on
    unit_interval unit_interval_topology X Tx epsX HepsXCont).
}
claim HepsX0 : apply_fun epsX 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 epsX HepsXLoopAt).
}
claim HepsX1 : apply_fun epsX 1 = x0.
{
  exact (loop_at_at_one X Tx x0 epsX HepsXLoopAt).
}
claim HmidEq :
  apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls
  = path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval epsX h).
{
  exact (induced_homomorphism_apply
    X Tx x0 Y Ty y0 h cls Hcls).
}
claim HcompHXCont :
  continuous_map unit_interval unit_interval_topology Y Ty
    (compose_fun unit_interval epsX h).
{
  exact (composition_continuous
    unit_interval unit_interval_topology
    X Tx
    Y Ty
    epsX
    h
    HepsXCont
    Hh).
}
claim HcompHX0 :
  apply_fun (compose_fun unit_interval epsX h) 0 = y0.
{
  rewrite (compose_fun_apply
    unit_interval epsX h 0 zero_in_unit_interval).
  rewrite HepsX0.
  exact Hx0.
}
claim HcompHX1 :
  apply_fun (compose_fun unit_interval epsX h) 1 = y0.
{
  rewrite (compose_fun_apply
    unit_interval epsX h 1 one_in_unit_interval).
  rewrite HepsX1.
  exact Hx0.
}
claim HcompHXLoopAt :
  loop_at Y Ty y0 (compose_fun unit_interval epsX h).
{
  apply (loop_at_fold
    Y Ty y0
    (compose_fun unit_interval epsX h)).
  apply andI.
  - apply andI.
    + exact HcompHXCont.
    + exact HcompHX0.
  - exact HcompHX1.
}
claim HcompHXLoop :
  (compose_fun unit_interval epsX h) :e loop_space Y Ty y0.
{
  exact (SepI
    (function_space unit_interval Y)
    (fun g:set => loop_at Y Ty y0 g)
    (compose_fun unit_interval epsX h)
    (compose_fun_in_function_space
      unit_interval X Y
      epsX h
      HepsXFun
      HhFun)
    HcompHXLoopAt).
}
claim HmidCls :
  path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval epsX h)
  :e fundamental_group Y Ty y0.
{
  exact (path_homotopy_class_in_fundamental_group
    Y Ty y0
    (compose_fun unit_interval epsX h)
    HcompHXLoop).
}
rewrite HmidEq.
rewrite (induced_homomorphism_apply
  Y Ty y0 Z Tz z0 k
  (path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval epsX h))
  HmidCls).
set epsY := Eps_i (fun g:set =>
  g :e path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval epsX h)).
claim Hassoc :
  compose_fun unit_interval epsX (compose_fun X h k)
  = compose_fun unit_interval (compose_fun unit_interval epsX h) k.
{
  exact (compose_fun_assoc_eq_algtop
    unit_interval X Y Z
    epsX h k
    HepsXFun
    HhFun
    HkFun).
}
rewrite Hassoc.
claim HselfComp :
  (compose_fun unit_interval epsX h)
  :e path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval epsX h).
{
  claim HselfHom :
    path_homotopic Y Ty y0 y0
      (compose_fun unit_interval epsX h)
      (compose_fun unit_interval epsX h).
  {
    exact (Lemma_51_1_path_homotopy_refl
      Y Ty y0 y0
      (compose_fun unit_interval epsX h)
      HcompHXCont
      HcompHX0
      HcompHX1).
  }
  exact (SepI
    (loop_space Y Ty y0)
    (fun g:set =>
      path_homotopic Y Ty y0 y0 (compose_fun unit_interval epsX h) g)
    (compose_fun unit_interval epsX h)
    HcompHXLoop
    HselfHom).
}
claim HepsYInClass :
  epsY :e path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval epsX h).
{
  exact (Eps_i_ax
    (fun g:set =>
      g :e path_homotopy_class_loop Y Ty y0 (compose_fun unit_interval epsX h))
    (compose_fun unit_interval epsX h)
    HselfComp).
}
claim HepsYHom :
  path_homotopic Y Ty y0 y0
    (compose_fun unit_interval epsX h)
    epsY.
{
  exact (path_homotopy_class_loop_has_homotopy
    Y Ty y0
    (compose_fun unit_interval epsX h)
    epsY
    HepsYInClass).
}
claim Hpost :
  path_homotopic Z Tz z0 z0
    (compose_fun unit_interval (compose_fun unit_interval epsX h) k)
    (compose_fun unit_interval epsY k).
{
  exact (path_homotopic_postcompose
    Y Ty Z Tz y0 y0 z0 z0
    (compose_fun unit_interval epsX h)
    epsY
    k
    HepsYHom
    Hk
    Hy0
    Hy0).
}
exact (path_homotopy_class_loop_eq_of_path_homotopic
  Z Tz z0
  (compose_fun unit_interval (compose_fun unit_interval epsX h) k)
  (compose_fun unit_interval epsY k)
  Hpost).
Qed.

(** from S52 Thm 52.4 (line 475 in algtop.tex): identity induces identity **)
(** EFFORT: 2 lines textbook, difficulty 1/10, USD 15 **)
(** Collected Bob 15 **)
(** Proven Bob **)
Theorem Theorem_52_4_functorial_identity : forall X Tx x0:set,
  topology_on X Tx -> x0 :e X ->
  forall cls:set, cls :e fundamental_group X Tx x0 ->
    apply_fun (induced_homomorphism X Tx x0 X Tx x0 (graph X (fun x:set => x))) cls = cls.
let X Tx x0.
assume Htop Hx0.
let cls.
assume Hcls.
rewrite (induced_homomorphism_apply
  X Tx x0 X Tx x0 (graph X (fun x:set => x)) cls Hcls).
claim Hrep : exists f:set, f :e loop_space X Tx x0 /\
  cls = path_homotopy_class_loop X Tx x0 f.
{
  exact (fundamental_group_member_has_representative
    X Tx x0 cls Hcls).
}
apply Hrep.
let f.
assume HfPack.
claim HfLoop : f :e loop_space X Tx x0.
{
  exact (andEL
    (f :e loop_space X Tx x0)
    (cls = path_homotopy_class_loop X Tx x0 f)
    HfPack).
}
claim HclsEq : cls = path_homotopy_class_loop X Tx x0 f.
{
  exact (andER
    (f :e loop_space X Tx x0)
    (cls = path_homotopy_class_loop X Tx x0 f)
    HfPack).
}
rewrite HclsEq.
set eps := Eps_i (fun g:set => g :e path_homotopy_class_loop X Tx x0 f).
claim HfLoopAt : loop_at X Tx x0 f.
{
  exact (loop_space_has_loop_at X Tx x0 f HfLoop).
}
claim HfCont : continuous_map unit_interval unit_interval_topology X Tx f.
{
  exact (loop_at_continuous X Tx x0 f HfLoopAt).
}
claim Hf0 : apply_fun f 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 f HfLoopAt).
}
claim Hf1 : apply_fun f 1 = x0.
{
  exact (loop_at_at_one X Tx x0 f HfLoopAt).
}
claim HfHomSelf : path_homotopic X Tx x0 x0 f f.
{
  exact (Lemma_51_1_path_homotopy_refl
    X Tx x0 x0 f HfCont Hf0 Hf1).
}
claim HfInClass : f :e path_homotopy_class_loop X Tx x0 f.
{
  exact (SepI
    (loop_space X Tx x0)
    (fun h:set => path_homotopic X Tx x0 x0 f h)
    f
    HfLoop
    HfHomSelf).
}
claim HepsInClassF : eps :e path_homotopy_class_loop X Tx x0 f.
{
  exact (Eps_i_ax
    (fun g:set => g :e path_homotopy_class_loop X Tx x0 f)
    f
    HfInClass).
}
claim HepsLoop : eps :e loop_space X Tx x0.
{
  exact (path_homotopy_class_loop_in_loop_space
    X Tx x0 f eps HepsInClassF).
}
claim HfEps : path_homotopic X Tx x0 x0 f eps.
{
  exact (path_homotopy_class_loop_has_homotopy
    X Tx x0 f eps HepsInClassF).
}
claim HclassFEps :
  path_homotopy_class_loop X Tx x0 f
  = path_homotopy_class_loop X Tx x0 eps.
{
  exact (path_homotopy_class_loop_eq_of_path_homotopic
    X Tx x0 f eps HfEps).
}
claim HepsLoopAt : loop_at X Tx x0 eps.
{
  exact (loop_space_has_loop_at X Tx x0 eps HepsLoop).
}
claim HepsCont : continuous_map unit_interval unit_interval_topology X Tx eps.
{
  exact (loop_at_continuous X Tx x0 eps HepsLoopAt).
}
claim HepsFun : function_on eps unit_interval X.
{
  exact (continuous_map_function_on
    unit_interval unit_interval_topology X Tx eps HepsCont).
}
claim Heps0 : apply_fun eps 0 = x0.
{
  exact (loop_at_at_zero X Tx x0 eps HepsLoopAt).
}
claim Heps1 : apply_fun eps 1 = x0.
{
  exact (loop_at_at_one X Tx x0 eps HepsLoopAt).
}
claim HidCont : continuous_map X Tx X Tx (graph X (fun x:set => x)).
{
  exact (identity_continuous X Tx Htop).
}
claim HcomposeCont :
  continuous_map unit_interval unit_interval_topology X Tx
    (compose_fun unit_interval eps (graph X (fun x:set => x))).
{
  exact (composition_continuous
    unit_interval unit_interval_topology
    X Tx
    X Tx
    eps
    (graph X (fun x:set => x))
    HepsCont
    HidCont).
}
claim Hcompose0 :
  apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) 0 = x0.
{
  rewrite (compose_fun_apply
    unit_interval
    eps
    (graph X (fun x:set => x))
    0
    zero_in_unit_interval).
  rewrite (apply_fun_graph
    X
    (fun x:set => x)
    (apply_fun eps 0)
    (HepsFun 0 zero_in_unit_interval)).
  exact Heps0.
}
claim Hcompose1 :
  apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) 1 = x0.
{
  rewrite (compose_fun_apply
    unit_interval
    eps
    (graph X (fun x:set => x))
    1
    one_in_unit_interval).
  rewrite (apply_fun_graph
    X
    (fun x:set => x)
    (apply_fun eps 1)
    (HepsFun 1 one_in_unit_interval)).
  exact Heps1.
}
claim HepsComposeHom :
  path_homotopic X Tx x0 x0 eps
    (compose_fun unit_interval eps (graph X (fun x:set => x))).
{
  prove continuous_map unit_interval unit_interval_topology X Tx eps /\
    continuous_map unit_interval unit_interval_topology X Tx
      (compose_fun unit_interval eps (graph X (fun x:set => x))) /\
    apply_fun eps 0 = x0 /\ apply_fun eps 1 = x0 /\
    apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) 0 = x0 /\
    apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) 1 = x0 /\
    exists F:set,
      continuous_map unit_square unit_square_topology X Tx F /\
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 0) = apply_fun eps s) /\
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 1) = apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) s) /\
      (forall t:set, t :e unit_interval ->
        apply_fun F (0, t) = x0) /\
      (forall t:set, t :e unit_interval ->
        apply_fun F (1, t) = x0).
  apply andI.
  - exact (and6I
      (continuous_map unit_interval unit_interval_topology X Tx eps)
      (continuous_map unit_interval unit_interval_topology X Tx
        (compose_fun unit_interval eps (graph X (fun x:set => x))))
      (apply_fun eps 0 = x0)
      (apply_fun eps 1 = x0)
      (apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) 0 = x0)
      (apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) 1 = x0)
      HepsCont
      HcomposeCont
      Heps0
      Heps1
      Hcompose0
      Hcompose1).
  - witness (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps).
    claim HcontF :
      continuous_map unit_square unit_square_topology X Tx
        (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps).
    {
      exact (composition_continuous
        unit_square unit_square_topology
        unit_interval unit_interval_topology
        X Tx
        (projection_map1 unit_interval unit_interval)
        eps
        (andEL
          (continuous_map unit_square unit_square_topology
            unit_interval unit_interval_topology
            (projection_map1 unit_interval unit_interval))
          (continuous_map unit_square unit_square_topology
            unit_interval unit_interval_topology
            (projection_map2 unit_interval unit_interval))
          (projection_maps_continuous
            unit_interval unit_interval_topology
            unit_interval unit_interval_topology
            unit_interval_topology_on
            unit_interval_topology_on))
        HepsCont).
    }
    claim HFs0 :
      forall s:set, s :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (s, 0)
          = apply_fun eps s.
    {
      let s.
      assume Hs.
      rewrite (compose_fun_apply
        unit_square
        (projection_map1 unit_interval unit_interval)
        eps
        (s, 0)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          s 0 Hs zero_in_unit_interval)).
      rewrite (projection1_apply
        unit_interval unit_interval
        (s, 0)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          s 0 Hs zero_in_unit_interval)).
      rewrite tuple_2_0_eq.
      reflexivity.
    }
    claim HFs1 :
      forall s:set, s :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (s, 1)
          = apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) s.
    {
      let s.
      assume Hs.
      rewrite (compose_fun_apply
        unit_square
        (projection_map1 unit_interval unit_interval)
        eps
        (s, 1)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          s 1 Hs one_in_unit_interval)).
      rewrite (projection1_apply
        unit_interval unit_interval
        (s, 1)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          s 1 Hs one_in_unit_interval)).
      rewrite tuple_2_0_eq.
      rewrite <- (compose_fun_apply_identity_graph
        unit_interval X eps s HepsFun Hs).
      reflexivity.
    }
    claim HF0t :
      forall t:set, t :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (0, t)
          = x0.
    {
      let t.
      assume Ht.
      rewrite (compose_fun_apply
        unit_square
        (projection_map1 unit_interval unit_interval)
        eps
        (0, t)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          0 t zero_in_unit_interval Ht)).
      rewrite (projection1_apply
        unit_interval unit_interval
        (0, t)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          0 t zero_in_unit_interval Ht)).
      rewrite tuple_2_0_eq.
      exact Heps0.
    }
    claim HF1t :
      forall t:set, t :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (1, t)
          = x0.
    {
      let t.
      assume Ht.
      rewrite (compose_fun_apply
        unit_square
        (projection_map1 unit_interval unit_interval)
        eps
        (1, t)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          1 t one_in_unit_interval Ht)).
      rewrite (projection1_apply
        unit_interval unit_interval
        (1, t)
        (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval
          1 t one_in_unit_interval Ht)).
      rewrite tuple_2_0_eq.
      exact Heps1.
    }
    exact (and5I
      (continuous_map unit_square unit_square_topology X Tx
        (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps))
      (forall s:set, s :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (s, 0)
          = apply_fun eps s)
      (forall s:set, s :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (s, 1)
          = apply_fun (compose_fun unit_interval eps (graph X (fun x:set => x))) s)
      (forall t:set, t :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (0, t)
          = x0)
      (forall t:set, t :e unit_interval ->
        apply_fun (compose_fun unit_square (projection_map1 unit_interval unit_interval) eps) (1, t)
          = x0)
      HcontF
      HFs0
      HFs1
      HF0t
      HF1t).
}
claim HcomposeEps :
  path_homotopic X Tx x0 x0
    (compose_fun unit_interval eps (graph X (fun x:set => x)))
    eps.
{
  exact (Lemma_51_1_path_homotopy_sym
    X Tx x0 x0
    eps
    (compose_fun unit_interval eps (graph X (fun x:set => x)))
    HepsComposeHom).
}
claim HclassComposeEps :
  path_homotopy_class_loop X Tx x0
    (compose_fun unit_interval eps (graph X (fun x:set => x)))
  = path_homotopy_class_loop X Tx x0 eps.
{
  exact (path_homotopy_class_loop_eq_of_path_homotopic
    X Tx x0
    (compose_fun unit_interval eps (graph X (fun x:set => x)))
    eps
    HcomposeEps).
}
claim HclassEpsF :
  path_homotopy_class_loop X Tx x0 eps
  = path_homotopy_class_loop X Tx x0 f.
{
  symmetry.
  exact HclassFEps.
}
rewrite HclassComposeEps.
exact HclassEpsF.
Qed.

(** from S52 Cor 52.5 (line 488 in algtop.tex) **)
(** LATEX VERSION: If h: (X,x0)->(Y,y0) is a homeomorphism, then h-star is an isomorphism. **)
(** EFFORT: 4 lines textbook, difficulty 2/10, USD 30 **)
(** Collected Bob 30 **)
(** Proven Bob **)
Theorem Corollary_52_5_homeomorphism_isomorphism : forall X Tx x0 Y Ty y0 h:set,
  homeomorphism X Tx Y Ty h ->
  apply_fun h x0 = y0 -> x0 :e X ->
  group_isomorphism
    (fundamental_group X Tx x0) (fundamental_group_mult X Tx x0)
    (fundamental_group Y Ty y0) (fundamental_group_mult Y Ty y0)
    (induced_homomorphism X Tx x0 Y Ty y0 h).
let X Tx x0 Y Ty y0 h.
assume Hhome Hbase Hx0.
claim HhCont : continuous_map X Tx Y Ty h.
{
  exact (andEL
    (continuous_map X Tx Y Ty h)
    (exists g:set,
      continuous_map Y Ty X Tx g /\
      (forall x:set, x :e X -> apply_fun g (apply_fun h x) = x) /\
      (forall y:set, y :e Y -> apply_fun h (apply_fun g y) = y))
    Hhome).
}
claim HhFun : function_on h X Y.
{
  exact (continuous_map_function_on
    X Tx Y Ty h HhCont).
}
claim Hy0 : y0 :e Y.
{
  rewrite <- Hbase.
  exact (HhFun x0 Hx0).
}
claim HinvPack : exists g:set,
  continuous_map Y Ty X Tx g /\
  (forall x:set, x :e X -> apply_fun g (apply_fun h x) = x) /\
  (forall y:set, y :e Y -> apply_fun h (apply_fun g y) = y).
{
  exact (homeomorphism_inverse_package
    X Tx Y Ty h Hhome).
}
apply HinvPack.
let g.
assume HgPack.
claim HgAB :
  continuous_map Y Ty X Tx g /\
  (forall x:set, x :e X -> apply_fun g (apply_fun h x) = x).
{
  exact (andEL
    (continuous_map Y Ty X Tx g /\
     (forall x:set, x :e X -> apply_fun g (apply_fun h x) = x))
    (forall y:set, y :e Y -> apply_fun h (apply_fun g y) = y)
    HgPack).
}
claim HgCont : continuous_map Y Ty X Tx g.
{
  exact (andEL
    (continuous_map Y Ty X Tx g)
    (forall x:set, x :e X -> apply_fun g (apply_fun h x) = x)
    HgAB).
}
claim HleftInv :
  forall x:set, x :e X -> apply_fun g (apply_fun h x) = x.
{
  exact (andER
    (continuous_map Y Ty X Tx g)
    (forall x:set, x :e X -> apply_fun g (apply_fun h x) = x)
    HgAB).
}
claim HrightInv :
  forall y:set, y :e Y -> apply_fun h (apply_fun g y) = y.
{
  exact (andER
    (continuous_map Y Ty X Tx g /\
     (forall x:set, x :e X -> apply_fun g (apply_fun h x) = x))
    (forall y:set, y :e Y -> apply_fun h (apply_fun g y) = y)
    HgPack).
}
claim HgFun : function_on g Y X.
{
  exact (continuous_map_function_on
    Y Ty X Tx g HgCont).
}
claim Hgy0 : apply_fun g y0 = x0.
{
  rewrite <- Hbase.
  exact (HleftInv x0 Hx0).
}
claim HtopX : topology_on X Tx.
{
  exact (continuous_map_topology_dom
    X Tx Y Ty h HhCont).
}
claim HtopY : topology_on Y Ty.
{
  exact (continuous_map_topology_cod
    X Tx Y Ty h HhCont).
}
set ih := induced_homomorphism X Tx x0 Y Ty y0 h.
set ig := induced_homomorphism Y Ty y0 X Tx x0 g.
claim HihHom :
  group_homomorphism
    (fundamental_group X Tx x0) (fundamental_group_mult X Tx x0)
    (fundamental_group Y Ty y0) (fundamental_group_mult Y Ty y0)
    ih.
{
  exact (induced_homomorphism_is_homomorphism
    X Tx x0 Y Ty y0 h
    HhCont
    Hbase
    Hx0).
}
claim HigHom :
  group_homomorphism
    (fundamental_group Y Ty y0) (fundamental_group_mult Y Ty y0)
    (fundamental_group X Tx x0) (fundamental_group_mult X Tx x0)
    ig.
{
  exact (induced_homomorphism_is_homomorphism
    Y Ty y0 X Tx x0 g
    HgCont
    Hgy0
    Hy0).
}
claim HihFun :
  function_on ih (fundamental_group X Tx x0) (fundamental_group Y Ty y0).
{
  exact (group_homomorphism_function_on
    (fundamental_group X Tx x0)
    (fundamental_group_mult X Tx x0)
    (fundamental_group Y Ty y0)
    (fundamental_group_mult Y Ty y0)
    ih
    HihHom).
}
claim HigFun :
  function_on ig (fundamental_group Y Ty y0) (fundamental_group X Tx x0).
{
  exact (group_homomorphism_function_on
    (fundamental_group Y Ty y0)
    (fundamental_group_mult Y Ty y0)
    (fundamental_group X Tx x0)
    (fundamental_group_mult X Tx x0)
    ig
    HigHom).
}
claim HcompHGId :
  compose_fun X h g = graph X (fun x:set => x).
{
  apply (total_function_space_extensional
    X X
    (compose_fun X h g)
    (graph X (fun x:set => x))).
  - exact (compose_fun_in_total_function_space
      X Y X
      h g
      HhFun
      HgFun).
  - exact (graph_in_total_function_space
      X X
      (fun x:set => x)
      (fun x:set => fun Hx:x :e X => Hx)).
  - let x.
    assume Hx.
    rewrite (compose_fun_apply X h g x Hx).
    rewrite (apply_fun_graph X (fun z:set => z) x Hx).
    exact (HleftInv x Hx).
}
claim HcompGHId :
  compose_fun Y g h = graph Y (fun y:set => y).
{
  apply (total_function_space_extensional
    Y Y
    (compose_fun Y g h)
    (graph Y (fun y:set => y))).
  - exact (compose_fun_in_total_function_space
      Y X Y
      g h
      HgFun
      HhFun).
  - exact (graph_in_total_function_space
      Y Y
      (fun y:set => y)
      (fun y:set => fun Hy:y :e Y => Hy)).
  - let y.
    assume Hy.
    rewrite (compose_fun_apply Y g h y Hy).
    rewrite (apply_fun_graph Y (fun z:set => z) y Hy).
    exact (HrightInv y Hy).
}
claim HcompLeft :
  forall cls:set, cls :e fundamental_group X Tx x0 ->
    apply_fun (induced_homomorphism X Tx x0 X Tx x0 (compose_fun X h g)) cls
    = apply_fun (compose_fun (fundamental_group X Tx x0) ih ig) cls.
{
  let cls.
  assume Hcls.
  exact (Theorem_52_4_functorial_composition
    X Tx x0 Y Ty y0 X Tx x0 h g
    HhCont
    HgCont
    Hbase
    Hgy0
    Hx0
    cls
    Hcls).
}
claim HcompRight :
  forall cls:set, cls :e fundamental_group Y Ty y0 ->
    apply_fun (induced_homomorphism Y Ty y0 Y Ty y0 (compose_fun Y g h)) cls
    = apply_fun (compose_fun (fundamental_group Y Ty y0) ig ih) cls.
{
  let cls.
  assume Hcls.
  exact (Theorem_52_4_functorial_composition
    Y Ty y0 X Tx x0 Y Ty y0 g h
    HgCont
    HhCont
    Hgy0
    Hbase
    Hy0
    cls
    Hcls).
}
claim HleftInvOnPi1 :
  forall cls:set, cls :e fundamental_group X Tx x0 ->
    apply_fun ig (apply_fun ih cls) = cls.
{
  let cls.
  assume Hcls.
  claim Hrhs :
    apply_fun (compose_fun (fundamental_group X Tx x0) ih ig) cls
    = apply_fun ig (apply_fun ih cls).
  {
    exact (compose_fun_apply
      (fundamental_group X Tx x0)
      ih
      ig
      cls
      Hcls).
  }
  claim HlhsId :
    apply_fun (induced_homomorphism X Tx x0 X Tx x0 (compose_fun X h g)) cls
    = cls.
  {
    rewrite HcompHGId.
    exact (Theorem_52_4_functorial_identity
      X Tx x0
      HtopX
      Hx0
      cls
      Hcls).
  }
  prove apply_fun ig (apply_fun ih cls) = cls.
  rewrite <- Hrhs.
  rewrite <- (HcompLeft cls Hcls).
  exact HlhsId.
}
claim HrightInvOnPi1 :
  forall cls:set, cls :e fundamental_group Y Ty y0 ->
    apply_fun ih (apply_fun ig cls) = cls.
{
  let cls.
  assume Hcls.
  claim Hrhs :
    apply_fun (compose_fun (fundamental_group Y Ty y0) ig ih) cls
    = apply_fun ih (apply_fun ig cls).
  {
    exact (compose_fun_apply
      (fundamental_group Y Ty y0)
      ig
      ih
      cls
      Hcls).
  }
  claim HlhsId :
    apply_fun (induced_homomorphism Y Ty y0 Y Ty y0 (compose_fun Y g h)) cls
    = cls.
  {
    rewrite HcompGHId.
    exact (Theorem_52_4_functorial_identity
      Y Ty y0
      HtopY
      Hy0
      cls
      Hcls).
  }
  prove apply_fun ih (apply_fun ig cls) = cls.
  rewrite <- Hrhs.
  rewrite <- (HcompRight cls Hcls).
  exact HlhsId.
}
claim HihBij : bijection
  (fundamental_group X Tx x0)
  (fundamental_group Y Ty y0)
  ih.
{
  prove
    function_on
      ih
      (fundamental_group X Tx x0)
      (fundamental_group Y Ty y0) /\
    (forall y:set, y :e fundamental_group Y Ty y0 ->
      exists x:set, x :e fundamental_group X Tx x0 /\
        apply_fun ih x = y /\
        (forall x':set, x' :e fundamental_group X Tx x0 ->
          apply_fun ih x' = y -> x' = x)).
  apply andI.
  - exact HihFun.
  - let y.
    assume Hy.
    witness (apply_fun ig y).
    apply andI.
    + apply andI.
      * exact (HigFun y Hy).
      * exact (HrightInvOnPi1 y Hy).
    + let x'.
      assume Hx' Hx'Eq.
      prove x' = apply_fun ig y.
      rewrite <- (HleftInvOnPi1 x' Hx').
      rewrite Hx'Eq.
      reflexivity.
}
exact (andI
  (group_homomorphism
    (fundamental_group X Tx x0) (fundamental_group_mult X Tx x0)
    (fundamental_group Y Ty y0) (fundamental_group_mult Y Ty y0)
    ih)
  (bijection
    (fundamental_group X Tx x0)
    (fundamental_group Y Ty y0)
    ih)
  HihHom
  HihBij).
Qed.

(** S52 Exercises **)

(** from S52 Exercise 1 (line 494 in algtop.tex): star convex **)
(** LATEX VERSION: A subset A of Rn is star convex if for some a0, all line segments joining a0 to other points of A lie in A. **)
Definition star_convex : set -> set -> prop := fun A a0 =>
  A c= R /\ a0 :e A /\
  (forall a:set, a :e A ->
    forall t:set, t :e unit_interval ->
      add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) a0) (mul_SNo t a) :e A).

(** from S52 Exercise 1a (line 495 in algtop.tex) **)
(** LATEX VERSION: Find a star convex set that is not convex. **)
(** Note: formulated in R2 since star convex but not convex requires dimension >= 2 **)
(** EFFORT: 2 lines textbook, difficulty 1/10, USD 10 **)
(** Collected Bob 11 **)
(** Proven Bob **)
Theorem ex52_1a_star_convex_not_convex :
  exists A:set, exists a0:set,
    A c= EuclidPlane /\
    a0 :e A /\
    (forall a:set, a :e A ->
      forall t:set, t :e unit_interval ->
        (add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) (R2_xcoord a0)) (mul_SNo t (R2_xcoord a)),
         add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) (R2_ycoord a0)) (mul_SNo t (R2_ycoord a))) :e A) /\
    (exists x y:set, x :e A /\ y :e A /\
      exists t:set, t :e unit_interval /\
        ~(add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) (R2_xcoord x)) (mul_SNo t (R2_xcoord y)),
          add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) (R2_ycoord x)) (mul_SNo t (R2_ycoord y))) :e A).
set A := {p :e EuclidPlane | R2_xcoord p = 0 \/ R2_ycoord p = 0}.
witness A.
witness (0, 0).
apply andI.
- apply andI.
  + apply andI.
    * let p.
      assume HpA.
      exact (SepE1
        EuclidPlane
        (fun q:set => R2_xcoord q = 0 \/ R2_ycoord q = 0)
        p
        HpA).
    * apply (SepI
        EuclidPlane
        (fun q:set => R2_xcoord q = 0 \/ R2_ycoord q = 0)
        (0, 0)).
      - exact (tuple_2_setprod_by_pair_Sigma
          R R 0 0
          real_0
          real_0).
      - apply orIL.
        rewrite (R2_xcoord_tuple 0 0).
        reflexivity.
  + let a.
    assume HaA.
    let t.
    assume Ht.
    claim HaPlane : a :e EuclidPlane.
    {
      exact (SepE1
        EuclidPlane
        (fun q:set => R2_xcoord q = 0 \/ R2_ycoord q = 0)
        a
        HaA).
    }
    claim Haxis : R2_xcoord a = 0 \/ R2_ycoord a = 0.
    {
      exact (SepE2
        EuclidPlane
        (fun q:set => R2_xcoord q = 0 \/ R2_ycoord q = 0)
        a
        HaA).
    }
    claim HtR : t :e R.
    {
      exact (unit_interval_sub_R t Ht).
    }
    claim HtS : SNo t.
    {
      exact (real_SNo t HtR).
    }
    claim HaxR : R2_xcoord a :e R.
    {
      exact (EuclidPlane_xcoord_in_R a HaPlane).
    }
    claim HayR : R2_ycoord a :e R.
    {
      exact (EuclidPlane_ycoord_in_R a HaPlane).
    }
    claim HaxS : SNo (R2_xcoord a).
    {
      exact (real_SNo (R2_xcoord a) HaxR).
    }
    claim HayS : SNo (R2_ycoord a).
    {
      exact (real_SNo (R2_ycoord a) HayR).
    }
    set q := (mul_SNo t (R2_xcoord a), mul_SNo t (R2_ycoord a)).
    claim HqA : q :e A.
    {
      apply (SepI
        EuclidPlane
        (fun p:set => R2_xcoord p = 0 \/ R2_ycoord p = 0)
        q).
      - exact (tuple_2_setprod_by_pair_Sigma
          R R
          (mul_SNo t (R2_xcoord a))
          (mul_SNo t (R2_ycoord a))
          (real_mul_SNo t HtR (R2_xcoord a) HaxR)
          (real_mul_SNo t HtR (R2_ycoord a) HayR)).
      - apply Haxis.
        + assume Hx0.
          apply orIL.
          rewrite (R2_xcoord_tuple
            (mul_SNo t (R2_xcoord a))
            (mul_SNo t (R2_ycoord a))).
          rewrite Hx0.
          rewrite (mul_SNo_zeroR t HtS).
          reflexivity.
        + assume Hy0.
          apply orIR.
          rewrite (R2_ycoord_tuple
            (mul_SNo t (R2_xcoord a))
            (mul_SNo t (R2_ycoord a))).
          rewrite Hy0.
          rewrite (mul_SNo_zeroR t HtS).
          reflexivity.
    }
    claim HtargetEq :
      (add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) (R2_xcoord (0, 0))) (mul_SNo t (R2_xcoord a)),
       add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) (R2_ycoord (0, 0))) (mul_SNo t (R2_ycoord a))) = q.
    {
      rewrite (R2_xcoord_tuple 0 0).
      rewrite (R2_ycoord_tuple 0 0).
      rewrite (mul_SNo_zeroR
        (add_SNo 1 (minus_SNo t))
        (SNo_add_SNo 1 (minus_SNo t) SNo_1 (SNo_minus_SNo t HtS))).
      rewrite (add_SNo_0L
        (mul_SNo t (R2_xcoord a))
        (SNo_mul_SNo t (R2_xcoord a) HtS HaxS)).
      rewrite (add_SNo_0L
        (mul_SNo t (R2_ycoord a))
        (SNo_mul_SNo t (R2_ycoord a) HtS HayS)).
      reflexivity.
    }
    rewrite HtargetEq.
    exact HqA.
- claim HepsNe0 : eps_ 1 <> 0.
  {
    assume Heps0.
    claim H00 : Rlt 0 0.
    {
      rewrite <- Heps0 at 2.
      exact eps_1_pos_R.
    }
    exact (not_Rlt_refl 0 real_0 H00 False).
  }
  witness (1, 0).
  witness (0, 1).
  apply andI.
  + apply andI.
    * apply (SepI
        EuclidPlane
        (fun p:set => R2_xcoord p = 0 \/ R2_ycoord p = 0)
        (1, 0)).
      - exact (tuple_2_setprod_by_pair_Sigma
          R R 1 0
          real_1
          real_0).
      - apply orIR.
        rewrite (R2_ycoord_tuple 1 0).
        reflexivity.
    * apply (SepI
        EuclidPlane
        (fun p:set => R2_xcoord p = 0 \/ R2_ycoord p = 0)
        (0, 1)).
      - exact (tuple_2_setprod_by_pair_Sigma
          R R 0 1
          real_0
          real_1).
      - apply orIL.
        rewrite (R2_xcoord_tuple 0 1).
        reflexivity.
  + witness (eps_ 1).
    apply andI.
    - exact eps_1_in_unit_interval.
    - set mid :=
          (add_SNo
             (mul_SNo (add_SNo 1 (minus_SNo (eps_ 1))) (R2_xcoord (1, 0)))
             (mul_SNo (eps_ 1) (R2_xcoord (0, 1))),
           add_SNo
             (mul_SNo (add_SNo 1 (minus_SNo (eps_ 1))) (R2_ycoord (1, 0)))
             (mul_SNo (eps_ 1) (R2_ycoord (0, 1)))).
      assume HmidA.
      claim HmidAxis : R2_xcoord mid = 0 \/ R2_ycoord mid = 0.
      {
        exact (SepE2
          EuclidPlane
          (fun p:set => R2_xcoord p = 0 \/ R2_ycoord p = 0)
          mid
          HmidA).
      }
      apply HmidAxis.
      + assume HmidX0.
           claim HmidXeps : R2_xcoord mid = eps_ 1.
           {
             rewrite (R2_xcoord_tuple
               (add_SNo
                 (mul_SNo (add_SNo 1 (minus_SNo (eps_ 1))) (R2_xcoord (1, 0)))
                 (mul_SNo (eps_ 1) (R2_xcoord (0, 1))))
               (add_SNo
                 (mul_SNo (add_SNo 1 (minus_SNo (eps_ 1))) (R2_ycoord (1, 0)))
                 (mul_SNo (eps_ 1) (R2_ycoord (0, 1))))).
             rewrite (R2_xcoord_tuple 1 0).
             rewrite (R2_xcoord_tuple 0 1).
             rewrite one_minus_eps1_eq_eps1.
             rewrite (mul_SNo_oneR (eps_ 1) SNo_eps_1).
             rewrite (mul_SNo_zeroR (eps_ 1) SNo_eps_1).
             rewrite (add_SNo_0R (eps_ 1) SNo_eps_1).
             reflexivity.
           }
           claim Heps0 : eps_ 1 = 0.
           {
             rewrite <- HmidXeps.
             exact HmidX0.
           }
           exact (HepsNe0 Heps0 False).
      + assume HmidY0.
           claim HmidYeps : R2_ycoord mid = eps_ 1.
           {
             rewrite (R2_ycoord_tuple
               (add_SNo
                 (mul_SNo (add_SNo 1 (minus_SNo (eps_ 1))) (R2_xcoord (1, 0)))
                 (mul_SNo (eps_ 1) (R2_xcoord (0, 1))))
               (add_SNo
                 (mul_SNo (add_SNo 1 (minus_SNo (eps_ 1))) (R2_ycoord (1, 0)))
                 (mul_SNo (eps_ 1) (R2_ycoord (0, 1))))).
             rewrite (R2_ycoord_tuple 1 0).
             rewrite (R2_ycoord_tuple 0 1).
             rewrite (mul_SNo_zeroR
               (add_SNo 1 (minus_SNo (eps_ 1)))
               (SNo_add_SNo 1 (minus_SNo (eps_ 1)) SNo_1 (SNo_minus_SNo (eps_ 1) SNo_eps_1))).
             rewrite (mul_SNo_oneR (eps_ 1) SNo_eps_1).
             rewrite (add_SNo_0L (eps_ 1) SNo_eps_1).
             reflexivity.
           }
           claim Heps0 : eps_ 1 = 0.
           {
             rewrite <- HmidYeps.
             exact HmidY0.
           }
           exact (HepsNe0 Heps0 False).
Qed.


(** Helper: star-convex line segment from a0 to a is continuous and stays in A **)
Theorem star_convex_segment_continuous : forall A Ta a0 a:set,
  star_convex A a0 ->
  topology_on A Ta ->
  a :e A ->
  exists seg:set,
    continuous_map unit_interval unit_interval_topology A Ta seg /\
    apply_fun seg 0 = a0 /\
    apply_fun seg 1 = a.
let A Ta a0 a.
assume Hstar HtopA HaA.
claim Hstar_left : A c= R /\ a0 :e A.
{
  exact (andEL
    (A c= R /\ a0 :e A)
    (forall a':set, a' :e A ->
      forall t:set, t :e unit_interval ->
        add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) a0) (mul_SNo t a') :e A)
    Hstar).
}
claim HAsubR : A c= R.
{ exact (andEL (A c= R) (a0 :e A) Hstar_left). }
claim Ha0A : a0 :e A.
{ exact (andER (A c= R) (a0 :e A) Hstar_left). }
claim Hstar_cond : forall a':set, a' :e A ->
  forall t:set, t :e unit_interval ->
    add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) a0) (mul_SNo t a') :e A.
{
  exact (andER
    (A c= R /\ a0 :e A)
    (forall a':set, a' :e A ->
      forall t:set, t :e unit_interval ->
        add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) a0) (mul_SNo t a') :e A)
    Hstar).
}
claim Ha0R : a0 :e R. { exact (HAsubR a0 Ha0A). }
claim HaR : a :e R. { exact (HAsubR a HaA). }
(** Define segment directly as a graph: t maps to (1-t)a0 + ta **)
set seg : set := graph unit_interval
  (fun t:set => add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) a0) (mul_SNo t a)).
(** Values are in A by star convexity **)
claim Hseg_range : forall t:set, t :e unit_interval ->
  add_SNo (mul_SNo (add_SNo 1 (minus_SNo t)) a0) (mul_SNo t a) :e A.
{
  let t.
  assume Ht.
  exact (Hstar_cond a HaA t Ht).
}
(** Continuity into (A, Ta) - admitted following the same gap as Ex_51_1 line 16696 **)
claim Hseg_cont_A : continuous_map unit_interval unit_interval_topology A Ta seg.
{
  set one_minus_t := flip_unit_interval.
  set id_t := graph unit_interval (fun t:set => t).
  set const_a0 := const_fun unit_interval a0.
  set const_a := const_fun unit_interval a.
  set left_term := compose_fun unit_interval (pair_map unit_interval one_minus_t const_a0) mul_fun_R.
  set right_term := compose_fun unit_interval (pair_map unit_interval id_t const_a) mul_fun_R.
  set segR := compose_fun unit_interval (pair_map unit_interval left_term right_term) add_fun_R.
  claim HoneMinusI :
    continuous_map unit_interval unit_interval_topology unit_interval unit_interval_topology one_minus_t.
  {
    exact flip_unit_interval_continuous.
  }
  claim HoneMinusR :
    continuous_map unit_interval unit_interval_topology R R_standard_topology one_minus_t.
  {
    exact (continuous_map_range_expand
