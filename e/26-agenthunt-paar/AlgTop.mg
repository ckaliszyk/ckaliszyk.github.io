        rewrite (compose_fun_apply
          unit_square
          Fdom
          f
          (1, t)
          (tuple_2_setprod_by_pair_Sigma
            unit_interval
            unit_interval
            1
            t
            one_in_unit_interval
            Ht)).
        rewrite (HFdom1t t Ht).
        exact Hf1.
