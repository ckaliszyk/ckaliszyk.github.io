    exact HbiN_times_e_e. }
  apply (andER ((apply_fun basis (apply_fun alphas i0) :e G /\
      forall n1:set, n1 :e omega -> group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n1 :e G) /\
