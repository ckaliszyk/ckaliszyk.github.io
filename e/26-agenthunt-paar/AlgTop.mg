{
  exact (andER
    (continuous_map unit_interval unit_interval_topology E Te
      (path_lift E Te B Tb p x1 f) /\
     apply_fun (path_lift E Te B Tb p x1 f) 0 = x1)
    (forall t:set, t :e unit_interval ->
