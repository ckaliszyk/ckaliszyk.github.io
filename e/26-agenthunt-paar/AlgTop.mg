Definition general_position_RN : set -> set -> prop := fun N A => N :e omega /\ A c= euclidean_space N /\ forall S : set , S c= A -> (forall Np1 : set , Np1 = N :\/: (Sing N) -> (exists f : set -> set , inj S Np1 f) -> geometrically_independent S).
