  }
  claim HEpsP0 : Eps_i P0 = eH.
  {
    exact (Eps_i_unique
      P0
      eH
      HP0e
      HP0uniq).
  }
  claim H0Int : 0 :e int.
  {
    exact (Subq_omega_int
      0
      (nat_p_omega 0 nat_0)).
  }
  rewrite (apply_fun_graph
