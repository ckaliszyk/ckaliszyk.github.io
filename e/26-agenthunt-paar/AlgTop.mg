    claim Hnpr0 : nat_primrec eH fH 0 = eH.
    { exact (nat_primrec_0 eH fH). }
    claim Hstep : fH 0 (nat_primrec eH fH 0) =
      apply_fun multH (eH, h_single (apply_fun (xs_of x0) 0)).
    { prove fH 0 (nat_primrec eH fH 0) =
