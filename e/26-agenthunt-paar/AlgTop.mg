exact (Sing_finite e).
Qed.

(** Proven Bob **)
(** Infrastructure helper: every nonzero integer is a positive successor or a negative successor. **)
Theorem int_nonzero_cases_cyclic_helper :
  forall n:set, n :e int -> n <> 0 ->
    (exists m:set, m :e omega /\ n = ordsucc m) \/
