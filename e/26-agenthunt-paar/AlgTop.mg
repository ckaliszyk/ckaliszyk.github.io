  claim HtopX : topology_on X Tx.
  { exact (continuous_map_topology_dom X Tx Y Ty h Hh). }
  claim HtopY : topology_on Y Ty.
  { exact (continuous_map_topology_cod X Tx Y Ty h Hh). }
  claim HepsLoop : loop_at X Tx x0 eps.
