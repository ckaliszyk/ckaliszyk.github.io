  exists ft:set,
    continuous_map unit_interval unit_interval_topology E Te ft /\
    apply_fun ft 0 = e0 /\
    (forall t:set, t :e unit_interval ->
      apply_fun p (apply_fun ft t) = apply_fun f t).
