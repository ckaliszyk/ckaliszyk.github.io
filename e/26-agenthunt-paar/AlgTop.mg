    (graph B2 (fun x:set => x))
    (const_fun B2 y0).
{
  exact (andER
    (y0 :e B2)
    (homotopic_maps B2 B2_topology B2 B2_topology
      (graph B2 (fun x:set => x))
      (const_fun B2 y0))
    Hy0Pack).
}
set i := graph S1 (fun x:set => x).
claim HiCont :
  continuous_map S1 S1_topology B2 B2_topology i.
{
  exact inclusion_S1_B2_continuous.
}
claim HreflI :
