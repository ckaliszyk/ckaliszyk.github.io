      cls.
  {
    exact (ex52_2_basepoint_composition
      X
      Tx
      x0
      x0
      x0
      (constant_path x0)
      (constant_path x0)
      HtopX
      HconstCont
      HconstCont
      Hconst0
      Hconst1
      Hconst0
      Hconst1
      cls
      Hcls).
  }
  rewrite <- HuniqConst.
  exact HcompConst.
}
