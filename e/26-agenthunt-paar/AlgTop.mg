            gprod.
        {
          exact (maps_into_products
            W
            (product_topology U (subspace_topology B Tb U) U' (subspace_topology B' Tb' U'))
            (w 0)
            (subspace_topology E Te (w 0))
            (w 1)
            (subspace_topology E' Te' (w 1))
