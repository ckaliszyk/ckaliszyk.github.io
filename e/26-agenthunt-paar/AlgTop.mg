    G
    mult
    e
    inv
    C
    g
    Hgrp
    HsubC
    HgG
    HcosEq).
- assume HgC : g :e C.
  exact (subgroup_member_implies_left_coset_eq_subgroup
    G
    mult
    e
    inv
    C
    g
