Axiom completely_regular_space_one_point_sets_closed : forall X Tx : set , completely_regular_space X Tx -> one_point_sets_closed X Tx.
Axiom completely_regular_space_separation : forall X Tx x F : set , completely_regular_space X Tx -> x :e X -> closed_in X Tx F -> x /:e F -> exists f : set , continuous_map X Tx R R_standard_topology f /\ apply_fun f x = 0 /\ forall y : set , y :e F -> apply_fun f y = 1.
Axiom completely_regular_space_implies_regular : forall X Tx : set , completely_regular_space X Tx -> regular_space X Tx.
Axiom completely_regular_space_implies_Hausdorff : forall X Tx : set , completely_regular_space X Tx -> Hausdorff_space X Tx.
Definition completely_regular_spaces_family : set -> set -> prop := fun I Xi => forall i : set , i :e I -> completely_regular_space (product_component Xi i) (product_component_topology Xi i).
Axiom continuous_from_discrete : forall X Y Ty f : set , topology_on Y Ty -> function_on f X Y -> continuous_map X (discrete_topology X) Y Ty f.
Axiom tuple_2_0_congr : forall a b c d : set , (a,b) = (c,d) -> a = c.
Axiom tuple_2_1_congr : forall a b c d : set , (a,b) = (c,d) -> b = d.
Axiom const_fun_pair_first : forall A x a y : set , (a,y) :e const_fun A x -> a :e A.
Axiom const_fun_pair_second : forall A x a y : set , (a,y) :e const_fun A x -> y = x.
Axiom discrete_completely_regular_space : forall X : set , completely_regular_space X (discrete_topology X).
Axiom discrete_Hausdorff_space : forall X : set , Hausdorff_space X (discrete_topology X).
Definition Tychonoff_space : set -> set -> prop := fun X Tx => completely_regular_space X Tx /\ Hausdorff_space X Tx.
Axiom generated_topology_from_subbasis_local_basis : forall X S U x : set , U :e generated_topology_from_subbasis X S -> x :e U -> exists b : set , b :e basis_of_subbasis X S /\ x :e b /\ b c= U.
