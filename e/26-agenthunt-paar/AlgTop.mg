                   claim HeEqPowSucc0 :
                     e = group_power_nat mult e (apply_fun inv x) (ordsucc 0).
                   {
                     rewrite <- Hm0.
                     exact HeNegRep.
                   }
                   claim HpowSucc0EqE :
