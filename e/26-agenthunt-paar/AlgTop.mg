  (** Extract n_of, xs_of properties for x0 **)
  claim Hn_of_prop : exists xs:set,
    reduced_word J Gfam efam (n_of x0) xs /\ (n_of x0) <> 0 /\
    word_product multG eG xs (n_of x0) = x0 /\
