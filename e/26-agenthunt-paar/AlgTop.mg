{
  apply set_ext.
  - let z.
    assume HzInt.
    claim HzN0 : z :e A :/\: U0.
    {
      exact (binintersectE1
        (A :/\: U0)
        (B :/\: Ut)
        z
        HzInt).
    }
    claim HzNt : z :e B :/\: Ut.
    {
      exact (binintersectE2
        (A :/\: U0)
        (B :/\: Ut)
        z
        HzInt).
    }
    claim HzA : z :e A.
    {
      exact (binintersectE1
        A
        U0
        z
        HzN0).
    }
    claim HzB : z :e B.
    {
      exact (binintersectE1
        B
        Ut
        z
        HzNt).
    }
    claim HzAB : z :e A :/\: B.
    {
      exact (binintersectI
        A
        B
        z
        HzA
        HzB).
    }
