          int
          integers_group_mult
          0
          integers_group_inv
          H
          multH
          eH
          invH
          psi
          HgrpZ
          HgrpH
          HpsiHom
          1
          HoneInt).
      }
      rewrite <- (apply_fun_graph
        int
        (fun n:set => minus_SNo n)
        1
        HoneInt).
      rewrite <- HinvDef.
