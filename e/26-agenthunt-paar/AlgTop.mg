Axiom diffquot_backward_abs_lin_fun_I_pos : forall c x h : set , c :e R -> 0 < c -> h :e R -> Rlt 0 h -> x :e unit_interval -> add_SNo x (minus_SNo h) :e unit_interval -> diffquot_backward_abs (lin_fun_I c) x h = c.
Axiom Delta_gt_lin_fun_I_pos : forall c r x h : set , c :e R -> 0 < c -> r :e R -> Rlt r c -> x :e unit_interval -> h :e R -> Rlt 0 h -> Rle h (inv_nat 2) -> Delta_gt (lin_fun_I c) x h r.
Axiom Delta_gt_affine_fun_I_pos : forall b c r x h : set , b :e R -> c :e R -> 0 < c -> r :e R -> Rlt r c -> x :e unit_interval -> h :e R -> Rlt 0 h -> Rle h (inv_nat 2) -> Delta_gt (affine_fun_I b c) x h r.
Axiom ex49_choose_eps0_lt_eps_lt1 : forall eps : set , eps :e R -> Rlt 0 eps -> ~ (Rlt 1 eps) -> exists eps0 : set , eps0 :e R /\ Rlt 0 eps0 /\ Rlt eps0 eps /\ Rlt eps0 1.
Axiom ex49_density_construction_eps_le_1_zigzag_ge1 : forall n f eps0 r : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps0 :e R -> Rlt 0 eps0 -> ~ (Rlt eps0 1) -> r :e R -> Rlt n r -> exists g : set , g :e C_I_R /\ (forall x : set , x :e unit_interval -> Rle (R_bounded_distance (apply_fun f x) (apply_fun g x)) eps0) /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
