        unit_interval
        unit_interval_topology
        X
        Tx
        Fdom
        f
        HFdomCont
        Hfcont).
    }
    claim HfphiContLocal :
      continuous_map unit_interval unit_interval_topology X Tx fphi.
    {
      exact (composition_continuous
        unit_interval
        unit_interval_topology
        unit_interval
        unit_interval_topology
        X
        Tx
        phi
        f
        HphiCont
        Hfcont).
