claim HalphaCont :
  continuous_map unit_interval unit_interval_topology X Tx alpha_loop.
{
  exact (loop_at_continuous
    X
    Tx
    x0
    alpha_loop
    HalphaLoopAt).
}
claim Halpha0 : apply_fun alpha_loop 0 = x0.
{
  exact (loop_at_at_zero
    X
