claim HtoConstAt : forall h:set,
  continuous_map X Tx Y Ty h ->
  homotopic_maps X Tx Y Ty h (const_fun X (apply_fun h x0)).
{
  let h.
  assume Hh.
  claim HhOn : function_on h X Y.
  {
    exact (continuous_map_function_on X Tx Y Ty h Hh).
