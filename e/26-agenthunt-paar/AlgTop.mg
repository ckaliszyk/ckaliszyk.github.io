    {
      witness F.
      exact (and5I
        (continuous_map unit_square unit_square_topology A Ta F)
        (forall s:set, s :e unit_interval ->
          apply_fun F (s, 0) = apply_fun f s)
        (forall s:set, s :e unit_interval ->
