        (apply_fun lx 0 = e0)
        HliftFxLeft).
    }
    claim HliftFcCont :
      continuous_map unit_interval unit_interval_topology E Te lc0.
    {
      exact (andEL
        (continuous_map unit_interval unit_interval_topology E Te lc0)
        (apply_fun lc0 0 = e0)
        HliftFcLeft).
    }
    claim HliftFx0 : apply_fun lx 0 = e0.
    {
      exact (andER
        (continuous_map unit_interval unit_interval_topology E Te lx)
        (apply_fun lx 0 = e0)
        HliftFxLeft).
