  Ut :e unit_interval_topology ->
  t :e Ut ->
  exists N0 Nt:set,
    N0 :e unit_interval_topology /\
    Nt :e unit_interval_topology /\
    0 :e N0 /\
    t :e Nt /\
    N0 c= U0 /\
    Nt c= Ut /\
    N0 :/\: Nt = Empty.
let t U0 Ut.
assume HtUnit HtNe0 HU0Open H0U0 HUtOpen HtUt.
