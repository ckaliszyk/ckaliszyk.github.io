      (** Case m = 0 (nw=1) vs m <> 0 (nw>=2) **)
      apply (xm (m = 0)).
      + (** m = 0, so nw = 1 **)
        assume Hm0 : m = 0.
        (** word_product(xsw, nw) = word_product(xsw, 1) = xsw(0) **)
        claim Hxs0_x0 : apply_fun xsw 0 = x0.
        { claim Hnw_1 : nw = ordsucc 0. { rewrite Hnw_eq. rewrite Hm0. reflexivity. }
