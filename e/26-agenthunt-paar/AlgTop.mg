    claim Hchain : nat_primrec eH fH (ordsucc 0) =
      apply_fun multH (eH, h_single (apply_fun (xs_of x0) 0)).
    { exact (eq_i_tra (nat_primrec eH fH (ordsucc 0))
        (fH 0 (nat_primrec eH fH 0))
        (apply_fun multH (eH, h_single (apply_fun (xs_of x0) 0)))
        HnprS Hstep). }
    prove nat_primrec eH fH 1 =
      apply_fun multH (eH, h_single (apply_fun (xs_of x0) 0)).
    rewrite <- ordsucc_0_eq_1_nat. exact Hchain. }
  (** h(x0) = multH(eH, h_single(x0)) **)
  claim Hh_x0_step : apply_fun h x0 = apply_fun multH (eH, h_single x0).
  { rewrite Hh_x0_nid.
    rewrite Hn_of_1.
    rewrite Hnpr_1.
    rewrite Hxs_of_0.
    reflexivity. }
  (** h_single(x0) is in H **)
  claim Hhs_x0_H : h_single x0 :e H.
  { claim Hao_valid : alpha_of x0 :e J /\ x0 :e apply_fun Gfam (alpha_of x0).
    { exact (Halpha_of_valid alpha0 Hal0 x0 Hx0Gal). }
    claim Hao_J : alpha_of x0 :e J.
    { exact (andEL (alpha_of x0 :e J) (x0 :e apply_fun Gfam (alpha_of x0)) Hao_valid). }
    claim Hx0_ao : x0 :e apply_fun Gfam (alpha_of x0).
    { exact (andER (alpha_of x0 :e J) (x0 :e apply_fun Gfam (alpha_of x0)) Hao_valid). }
    exact (Hhfam_in_H (alpha_of x0) Hao_J x0 Hx0_ao). }
  (** multH(eH, h_single(x0)) = h_single(x0) **)
  claim HidH_hs : apply_fun multH (eH, h_single x0) = h_single x0.
  { exact (andEL
      (apply_fun multH (eH, h_single x0) = h_single x0)
      (apply_fun multH (h_single x0, eH) = h_single x0)
      (HidH (h_single x0) Hhs_x0_H)). }
  (** h(x0) = h_single(x0) **)
  claim Hh_x0_hs : apply_fun h x0 = h_single x0.
  { exact (eq_i_tra (apply_fun h x0) (apply_fun multH (eH, h_single x0)) (h_single x0)
      Hh_x0_step HidH_hs). }
  (** h_single(x0) = hfam(alpha0)(x0) from Hhfam_alpha_of **)
  claim Hhs_eq : h_single x0 = apply_fun (apply_fun hfam alpha0) x0.
  { exact (Hhfam_alpha_of alpha0 Hal0 x0 Hx0Gal). }
  exact (eq_i_tra (apply_fun h x0) (h_single x0) (apply_fun (apply_fun hfam alpha0) x0)
    Hh_x0_hs Hhs_eq).
(** Part 3: uniqueness - any extending homomorphism agrees with h **)
(** Strategy: any h' extending hfam maps word products to H-word-products **)
(** by induction. Then h must do the same (from Parts 1+2). **)
(** So h'(x) = h(x) for all x in G. **)
- let h'. assume Hh'hom : group_homomorphism G multG H multH h'.
assume Hh'ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun h' x = apply_fun (apply_fun hfam alpha) x.
let x. assume HxG : x :e G.
(** h' maps eG to eH **)
claim Hh'_id : apply_fun h' eG = eH.
{ exact (group_hom_maps_id_to_id G multG eG invG H multH eH invH h' Hgrp HgrpH Hh'hom). }
(** From subgroups_generate, decompose x **)
claim Hgen_third : forall z:set, z :e G ->
  z = eG \/
  exists n:set, n :e omega /\ n <> 0 /\
  exists xs:set, function_on xs n G /\
    (forall i:set, i :e n ->
      exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
    z = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun xs i)) n.
{ exact (andER
    (group_structure G multG eG invG /\
     (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G multG eG invG))
    (forall z:set, z :e G ->
      z = eG \/
      exists n:set, n :e omega /\ n <> 0 /\
      exists xs:set, function_on xs n G /\
        (forall i:set, i :e n ->
          exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
        z = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun xs i)) n)
    Hgen). }
(** h' maps word products correctly by induction **)
claim Hh'_wp : forall k:set, nat_p k ->
  forall ys:set,
  (forall i:set, i :e k -> apply_fun ys i :e G) ->
  (forall i:set, i :e k ->
    exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) ->
  apply_fun h' (word_product multG eG ys k) =
    nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) k.
{ apply (nat_ind (fun k:set =>
    forall ys:set,
    (forall i:set, i :e k -> apply_fun ys i :e G) ->
    (forall i:set, i :e k ->
      exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) ->
    apply_fun h' (word_product multG eG ys k) =
      nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) k)).
  (** Base: k = 0 **)
  - let ys. assume Hys_G Hys_al.
    claim Hlhs : apply_fun h' (word_product multG eG ys 0) = eH.
    { claim Hwp0 : word_product multG eG ys 0 = eG.
      { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun ys i))). }
      rewrite Hwp0. exact Hh'_id. }
    claim Hrhs : eH = nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) 0.
    { claim Hnp0 : nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) 0 = eH.
      { exact (nat_primrec_0 eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i)))). }
      symmetry. exact Hnp0. }
    exact (eq_i_tra
      (apply_fun h' (word_product multG eG ys 0))
      eH
      (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) 0)
      Hlhs Hrhs).
  (** Step: k = ordsucc j **)
  - let j. assume Hj : nat_p j. assume IH.
    let ys. assume Hys_G Hys_al.
    claim Hysj_al : exists alpha:set, alpha :e J /\ apply_fun ys j :e apply_fun Gfam alpha.
    { exact (Hys_al j (ordsuccI2 j)). }
    apply (exandE_i
      (fun alpha:set => alpha :e J)
      (fun alpha:set => apply_fun ys j :e apply_fun Gfam alpha)
      Hysj_al).
    let alpha_j. assume Hal_j_raw : alpha_j :e J. assume Hysj_Gal_raw : apply_fun ys j :e apply_fun Gfam alpha_j.
    claim Hal_j : alpha_j :e J. { exact Hal_j_raw. }
    claim Hysj_Gal : apply_fun ys j :e apply_fun Gfam alpha_j. { exact Hysj_Gal_raw. }
    claim Hysj_G : apply_fun ys j :e G.
    { exact (Hsub_in_G alpha_j Hal_j (apply_fun ys j) Hysj_Gal). }
    claim Hwp_j_G : word_product multG eG ys j :e G.
    { exact (Hwp_in_G j (nat_p_omega j Hj) ys
        (fun i Hi => Hys_G i (ordsuccI1 j i Hi))). }
    (** Compute LHS **)
    claim Hlhs : apply_fun h' (word_product multG eG ys (ordsucc j)) =
      apply_fun multH
        (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j,
         h_single (apply_fun ys j)).
    { claim HwpS : word_product multG eG ys (ordsucc j) =
        apply_fun multG (word_product multG eG ys j, apply_fun ys j).
      { exact (nat_primrec_S eG (fun i r => apply_fun multG (r, apply_fun ys i)) j Hj). }
      claim Hh'_wp_S : apply_fun h' (word_product multG eG ys (ordsucc j)) =
        apply_fun h' (apply_fun multG (word_product multG eG ys j, apply_fun ys j)).
      { rewrite HwpS. reflexivity. }
      claim Hh'_mult : apply_fun h' (apply_fun multG (word_product multG eG ys j, apply_fun ys j)) =
        apply_fun multH (apply_fun h' (word_product multG eG ys j), apply_fun h' (apply_fun ys j)).
      { exact (group_homomorphism_mult_rule G multG H multH h'
          (word_product multG eG ys j) (apply_fun ys j) Hh'hom Hwp_j_G Hysj_G). }
      claim Hih : apply_fun h' (word_product multG eG ys j) =
        nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j.
      { exact (IH ys (fun i Hi => Hys_G i (ordsuccI1 j i Hi))
          (fun i Hi => Hys_al i (ordsuccI1 j i Hi))). }
      claim Hh'_j : apply_fun h' (apply_fun ys j) = h_single (apply_fun ys j).
      { claim Hh'_j_al : apply_fun h' (apply_fun ys j) =
          apply_fun (apply_fun hfam alpha_j) (apply_fun ys j).
        { exact (Hh'ext alpha_j Hal_j (apply_fun ys j) Hysj_Gal). }
        claim Hao_eq : h_single (apply_fun ys j) =
          apply_fun (apply_fun hfam alpha_j) (apply_fun ys j).
        { exact (Hhfam_alpha_of alpha_j Hal_j (apply_fun ys j) Hysj_Gal). }
        claim Hao_eq_sym : apply_fun (apply_fun hfam alpha_j) (apply_fun ys j) =
          h_single (apply_fun ys j).
        { symmetry. exact Hao_eq. }
        exact (eq_i_tra
          (apply_fun h' (apply_fun ys j))
          (apply_fun (apply_fun hfam alpha_j) (apply_fun ys j))
          (h_single (apply_fun ys j))
          Hh'_j_al Hao_eq_sym). }
      claim Hrew : apply_fun multH (apply_fun h' (word_product multG eG ys j), apply_fun h' (apply_fun ys j)) =
        apply_fun multH
          (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j,
           h_single (apply_fun ys j)).
      { rewrite Hih. rewrite Hh'_j. reflexivity. }
      exact (eq_i_tra
        (apply_fun h' (word_product multG eG ys (ordsucc j)))
        (apply_fun h' (apply_fun multG (word_product multG eG ys j, apply_fun ys j)))
        (apply_fun multH
          (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j,
           h_single (apply_fun ys j)))
        Hh'_wp_S
        (eq_i_tra
          (apply_fun h' (apply_fun multG (word_product multG eG ys j, apply_fun ys j)))
          (apply_fun multH (apply_fun h' (word_product multG eG ys j), apply_fun h' (apply_fun ys j)))
          (apply_fun multH
            (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j,
             h_single (apply_fun ys j)))
          Hh'_mult Hrew)). }
    (** Compute RHS **)
    claim Hrhs : nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) (ordsucc j) =
      apply_fun multH
        (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j,
         h_single (apply_fun ys j)).
    { exact (nat_primrec_S eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j Hj). }
    (** Combine **)
    claim Hrhs_sym : apply_fun multH
      (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j,
       h_single (apply_fun ys j)) =
      nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) (ordsucc j).
    { symmetry. exact Hrhs. }
    exact (eq_i_tra
      (apply_fun h' (word_product multG eG ys (ordsucc j)))
      (apply_fun multH
        (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) j,
         h_single (apply_fun ys j)))
      (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun ys i))) (ordsucc j))
      Hlhs Hrhs_sym). }
(** Now conclude: h'(x) = h(x) using decomposition of x **)
claim Hgen_x : x = eG \/
  exists n:set, n :e omega /\ n <> 0 /\
  exists xs:set, function_on xs n G /\
    (forall i:set, i :e n ->
      exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
    x = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun xs i)) n.
{ exact (Hgen_third x HxG). }
apply Hgen_x.
(** Case x = eG **)
+ assume Hxe : x = eG.
  claim Hh_eG : apply_fun h eG = eH.
  { claim Heval : apply_fun h eG =
      If_i (eG = eG) eH
        (nat_primrec eH
          (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of eG) i)))
          (n_of eG)).
    { exact (apply_fun_graph G
        (fun z:set =>
          If_i (z = eG) eH
            (nat_primrec eH
              (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of z) i)))
              (n_of z)))
        eG HeGG). }
    rewrite Heval.
    claim HeG_refl : eG = eG. { reflexivity. }
    exact (If_i_1 (eG = eG) eH
      (nat_primrec eH
        (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of eG) i)))
        (n_of eG))
      HeG_refl). }
  rewrite Hxe. rewrite Hh_eG. exact Hh'_id.
(** Case x = word_product **)
+ assume Hex : exists n:set, n :e omega /\ n <> 0 /\
    exists xs:set, function_on xs n G /\
      (forall i:set, i :e n ->
        exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
      x = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun xs i)) n.
  (** h'(x) = H-word-product of h_single on the generators **)
  (** h(x) must also equal this (from Parts 1+2, which are admitted) **)
  apply (xm (x = eG)).
  * assume Hxe_case : x = eG.
    rewrite Hxe_case.
    rewrite Hh'_id.
    rewrite Hh_eG_shared.
    reflexivity.
  * assume Hx_ne_case : x <> eG.
    claim Hred_x :
      reduced_word J Gfam efam (n_of x) (xs_of x) /\ (n_of x) <> 0 /\
      word_product multG eG (xs_of x) (n_of x) = x /\
      (forall n' xs':set,
        reduced_word J Gfam efam n' xs' -> n' <> 0 ->
        word_product multG eG xs' n' = x ->
        (n_of x) = n' /\ (forall i:set, i :e (n_of x) -> apply_fun (xs_of x) i = apply_fun xs' i)).
    {
      exact (Hred_extract x HxG Hx_ne_case).
    }
    apply (and4E
      (reduced_word J Gfam efam (n_of x) (xs_of x))
      ((n_of x) <> 0)
      (word_product multG eG (xs_of x) (n_of x) = x)
      (forall n' xs':set,
        reduced_word J Gfam efam n' xs' -> n' <> 0 ->
        word_product multG eG xs' n' = x ->
        (n_of x) = n' /\ (forall i:set, i :e (n_of x) -> apply_fun (xs_of x) i = apply_fun xs' i))
      Hred_x).
    assume Hred_xrw Hn_of_ne0 Hwp_x_of Huniq_x.
    apply (and3E
      ((n_of x) :e omega)
      (forall i:set, i :e (n_of x) ->
        exists alpha:set, alpha :e J /\
          apply_fun (xs_of x) i :e apply_fun Gfam alpha /\
          apply_fun (xs_of x) i <> apply_fun efam alpha)
      (forall i:set, i :e (n_of x) -> ordsucc i :e (n_of x) ->
        forall alpha beta:set, alpha :e J -> beta :e J ->
          apply_fun (xs_of x) i :e apply_fun Gfam alpha ->
          apply_fun (xs_of x) (ordsucc i) :e apply_fun Gfam beta ->
          alpha <> beta)
      Hred_xrw).
    assume Hn_of_omega Helem_x_of Hadj_x_of.
    claim Hxsof_in_G : forall i:set, i :e (n_of x) -> apply_fun (xs_of x) i :e G.
    {
      let i.
      assume Hi_n.
      apply (Helem_x_of i Hi_n).
      let alpha.
      assume Halpha_pack.
      claim Halpha_J : alpha :e J.
      {
        exact (andEL
          (alpha :e J)
          (apply_fun (xs_of x) i :e apply_fun Gfam alpha)
          (andEL
            (alpha :e J /\ apply_fun (xs_of x) i :e apply_fun Gfam alpha)
            (apply_fun (xs_of x) i <> apply_fun efam alpha)
            Halpha_pack)).
      }
      claim Hxsi_Galpha : apply_fun (xs_of x) i :e apply_fun Gfam alpha.
      {
        exact (andER
          (alpha :e J)
          (apply_fun (xs_of x) i :e apply_fun Gfam alpha)
          (andEL
            (alpha :e J /\ apply_fun (xs_of x) i :e apply_fun Gfam alpha)
            (apply_fun (xs_of x) i <> apply_fun efam alpha)
            Halpha_pack)).
      }
      exact (Hsub_in_G alpha Halpha_J (apply_fun (xs_of x) i) Hxsi_Galpha).
    }
    claim Hxsof_in_fam :
      forall i:set, i :e (n_of x) ->
        exists alpha:set, alpha :e J /\ apply_fun (xs_of x) i :e apply_fun Gfam alpha.
    {
      let i.
      assume Hi_n.
      apply (Helem_x_of i Hi_n).
      let alpha.
      assume Halpha_pack.
      witness alpha.
      exact (andEL
        (alpha :e J /\ apply_fun (xs_of x) i :e apply_fun Gfam alpha)
        (apply_fun (xs_of x) i <> apply_fun efam alpha)
        Halpha_pack).
    }
    claim Hh'_x_word :
      apply_fun h' x =
      nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of x) i))) (n_of x).
    {
      claim Hh'_wp_xsof :
        apply_fun h' (word_product multG eG (xs_of x) (n_of x)) =
        nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of x) i))) (n_of x).
      {
        exact (Hh'_wp
          (n_of x)
          (omega_nat_p (n_of x) Hn_of_omega)
          (xs_of x)
          Hxsof_in_G
          Hxsof_in_fam).
      }
      rewrite <- Hwp_x_of at 1.
      exact Hh'_wp_xsof.
    }
    claim Hh_x_word :
      apply_fun h x =
      nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of x) i))) (n_of x).
    {
      exact (Hh_ne_shared x HxG Hx_ne_case).
    }
    claim Hh_x_word_sym :
      nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of x) i))) (n_of x) =
      apply_fun h x.
    {
      symmetry.
      exact Hh_x_word.
    }
    exact (eq_i_tra
      (apply_fun h' x)
      (nat_primrec eH (fun i r => apply_fun multH (r, h_single (apply_fun (xs_of x) i))) (n_of x))
      (apply_fun h x)
      Hh'_x_word
      Hh_x_word_sym).
Admitted.

(** from S68 Definition (line 2827 in algtop.tex): external free product **)
(** LATEX VERSION: G is the external free product of {G_alpha} relative to **)
(** monomorphisms i_alpha if G is the free product of the images i_alpha(G_alpha). **)
Definition external_free_product : set -> set -> set -> set -> set -> set -> set -> set -> prop :=
  fun G multG eG invG J Gfam multfam ifam =>
    group_structure G multG eG invG /\
    (forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)) /\
    free_product_of_subgroups G multG eG invG J
      (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)))
      (graph J (fun alpha:set => apply_fun (apply_fun ifam alpha) (Eps_i (fun ea:set =>
        exists ma ia:set, group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) ea ia)))).

(** from S68 Thm 68.2 (line 2831 in algtop.tex): existence of free products **)
(** LATEX VERSION: Given a family {G_alpha} of groups, there exists a group G and **)
(** monomorphisms i_alpha: G_alpha -> G such that G is the free product of i_alpha(G_alpha). **)
(** EFFORT: 50 lines textbook, difficulty 8/10, USD 800 **)
(** Bounty 880 **)
Theorem thm68_2_existence_free_product :
  forall J Gfam multfam efam invfam:set,
  (forall alpha:set, alpha :e J ->
    group_structure (apply_fun Gfam alpha)
      (apply_fun multfam alpha)
      (apply_fun efam alpha)
      (apply_fun invfam alpha)) ->
  exists G multG eG invG ifam:set,
    group_structure G multG eG invG /\
    (forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)) /\
    free_product_of_subgroups G multG eG invG J
      (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)))
      (graph J (fun alpha:set => apply_fun (apply_fun ifam alpha) (apply_fun efam alpha))).
admit.
Admitted.

(** from S68 Lem 68.3 (line 2940 in algtop.tex): extension condition for external free products **)
(** LATEX VERSION: If each i_alpha is a monomorphism and G is the free product of **)
(** i_alpha(G_alpha), then given any group H and homomorphisms h_alpha: G_alpha -> H, **)
(** there exists a unique h: G -> H with h o i_alpha = h_alpha. **)
(** EFFORT: 5 lines textbook, difficulty 3/10, USD 50 **)
(** Bounty 61 **)
(** Lock Alice 1771568868 **)
Theorem lemma68_3_extension_external_free_product :
  forall G multG eG invG J Gfam multfam ifam:set,
  external_free_product G multG eG invG J Gfam multfam ifam ->
  forall H multH eH invH:set,
    group_structure H multH eH invH ->
    forall hfam:set,
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha)) ->
      exists h:set,
        group_homomorphism G multG H multH h /\
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h (apply_fun (apply_fun ifam alpha) x) =
              apply_fun (apply_fun hfam alpha) x) /\
        (forall h':set, group_homomorphism G multG H multH h' ->
          (forall alpha:set, alpha :e J ->
            forall x:set, x :e apply_fun Gfam alpha ->
              apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
                apply_fun (apply_fun hfam alpha) x) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
let G multG eG invG J Gfam multfam ifam.
assume Hext : external_free_product G multG eG invG J Gfam multfam ifam.
let H multH eH invH.
assume HgrpH : group_structure H multH eH invH.
let hfam.
assume Hhfam : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha).
(** Unpack external_free_product: group_structure, monomorphisms, free_product **)
apply (and3E
  (group_structure G multG eG invG)
  (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y))
  (free_product_of_subgroups G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)))
    (graph J (fun alpha:set => apply_fun (apply_fun ifam alpha) (Eps_i (fun ea:set =>
      exists ma ia:set, group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) ea ia)))))
  Hext).
assume Hgrp : group_structure G multG eG invG.
assume Hmono : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
  (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
    apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y).
assume Hfp : free_product_of_subgroups G multG eG invG J
  (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)))
  (graph J (fun alpha:set => apply_fun (apply_fun ifam alpha) (Eps_i (fun ea:set =>
    exists ma ia:set, group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) ea ia)))).
(** Short names for the internal families **)
set ImageFam := graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)).
set efam_int := graph J (fun alpha:set => apply_fun (apply_fun ifam alpha) (Eps_i (fun ea:set =>
  exists ma ia:set, group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) ea ia))).
(** Helper: evaluate ImageFam at alpha **)
claim HIF_eval : forall alpha:set, alpha :e J ->
  apply_fun ImageFam alpha = homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
{ let alpha. assume Hal.
  exact (apply_fun_graph J
    (fun a:set => homomorphism_image (apply_fun Gfam a) (apply_fun ifam a))
    alpha Hal). }
(** Helper: ifam(alpha) is a homomorphism **)
claim Hifam_hom : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
{ let alpha. assume Hal.
  exact (andEL
    (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
    (Hmono alpha Hal)). }
(** Helper: ifam(alpha) maps Gfam(alpha) to G **)
claim Hifam_in_G : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun (apply_fun ifam alpha) x :e G.
{ let alpha. assume Hal. let x. assume Hx.
  exact (andEL
    (function_on (apply_fun ifam alpha) (apply_fun Gfam alpha) G)
    (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (u, v)) =
        apply_fun multG (apply_fun (apply_fun ifam alpha) u, apply_fun (apply_fun ifam alpha) v))
    (Hifam_hom alpha Hal) x Hx). }
(** Helper: ifam(alpha) is injective **)
claim Hifam_inj : forall alpha:set, alpha :e J ->
  forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
    apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y.
{ let alpha. assume Hal.
  exact (andER
    (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
    (Hmono alpha Hal)). }
(** Helper: ifam(alpha) multiplicativity **)
claim Hifam_mult : forall alpha:set, alpha :e J ->
  forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
    apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (x, y)) =
      apply_fun multG (apply_fun (apply_fun ifam alpha) x, apply_fun (apply_fun ifam alpha) y).
{ let alpha. assume Hal. let x y. assume Hx Hy.
  exact (group_homomorphism_mult_rule
    (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) x y
    (Hifam_hom alpha Hal) Hx Hy). }
(** Helper: ifam(alpha)(x) is in ImageFam(alpha) **)
claim Hifam_in_Image : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun (apply_fun ifam alpha) x :e apply_fun ImageFam alpha.
{ let alpha. assume Hal. let x. assume Hx.
  rewrite (HIF_eval alpha Hal).
  exact (ReplI (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) x Hx). }
(** Helper: for y in ImageFam(alpha), there exists x in Gfam(alpha) with ifam(alpha)(x) = y **)
claim HImage_preimage : forall alpha:set, alpha :e J ->
  forall y:set, y :e apply_fun ImageFam alpha ->
    exists x:set, x :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) x = y.
{ let alpha. assume Hal. let y. assume Hy.
  claim Hy2 : y :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
  { rewrite <- (HIF_eval alpha Hal). exact Hy. }
  apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) y Hy2).
  let x. assume Hx : x :e apply_fun Gfam alpha. assume Heq : y = apply_fun (apply_fun ifam alpha) x.
  witness x. apply andI. exact Hx. symmetry. exact Heq. }
(** Define kfam: transfer homomorphisms on images **)
set preimg := fun alpha y:set =>
  Eps_i (fun x:set => x :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) x = y).
set kfam := graph J (fun alpha:set =>
  graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
    (fun y:set => apply_fun (apply_fun hfam alpha) (preimg alpha y))).
(** Helper: kfam evaluation **)
claim Hkfam_eval : forall alpha:set, alpha :e J ->
  apply_fun kfam alpha =
    graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
      (fun y:set => apply_fun (apply_fun hfam alpha) (preimg alpha y)).
{ let alpha. assume Hal.
  exact (apply_fun_graph J
    (fun a:set => graph (homomorphism_image (apply_fun Gfam a) (apply_fun ifam a))
      (fun y:set => apply_fun (apply_fun hfam a) (preimg a y)))
    alpha Hal). }
(** Helper: preimage properties for y in ImageFam(alpha) **)
claim Hpreimg_props : forall alpha:set, alpha :e J ->
  forall y:set, y :e apply_fun ImageFam alpha ->
    preimg alpha y :e apply_fun Gfam alpha /\
    apply_fun (apply_fun ifam alpha) (preimg alpha y) = y.
{ let alpha. assume Hal. let y. assume Hy.
  exact (Eps_i_ex (fun x:set => x :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) x = y)
    (HImage_preimage alpha Hal y Hy)). }
(** Helper: evaluate kfam(alpha)(y) **)
claim Hkfam_val : forall alpha:set, alpha :e J ->
  forall y:set, y :e apply_fun ImageFam alpha ->
    apply_fun (apply_fun kfam alpha) y = apply_fun (apply_fun hfam alpha) (preimg alpha y).
{ let alpha. assume Hal. let y. assume Hy.
  claim Hy2 : y :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
  { rewrite <- (HIF_eval alpha Hal). exact Hy. }
  claim Hstep1 : apply_fun (apply_fun kfam alpha) y =
    apply_fun (graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
      (fun z:set => apply_fun (apply_fun hfam alpha) (preimg alpha z))) y.
  { claim Hkeq : apply_fun kfam alpha =
      graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
        (fun z:set => apply_fun (apply_fun hfam alpha) (preimg alpha z)).
    { exact (Hkfam_eval alpha Hal). }
    rewrite Hkeq. reflexivity. }
  claim Hstep2 : apply_fun (graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
    (fun z:set => apply_fun (apply_fun hfam alpha) (preimg alpha z))) y =
    apply_fun (apply_fun hfam alpha) (preimg alpha y).
  { exact (apply_fun_graph
      (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
      (fun z:set => apply_fun (apply_fun hfam alpha) (preimg alpha z))
      y Hy2). }
  exact (eq_i_tra
    (apply_fun (apply_fun kfam alpha) y)
    (apply_fun (graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
      (fun z:set => apply_fun (apply_fun hfam alpha) (preimg alpha z))) y)
    (apply_fun (apply_fun hfam alpha) (preimg alpha y))
    Hstep1 Hstep2). }
(** Helper: hfam(alpha) maps Gfam(alpha) to H **)
claim Hhfam_in_H : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun (apply_fun hfam alpha) x :e H.
{ let alpha. assume Hal. let x. assume Hx.
  exact (andEL
    (function_on (apply_fun hfam alpha) (apply_fun Gfam alpha) H)
    (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
      apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (u, v)) =
        apply_fun multH (apply_fun (apply_fun hfam alpha) u, apply_fun (apply_fun hfam alpha) v))
    (Hhfam alpha Hal) x Hx). }
(** Helper: hfam(alpha) multiplicativity **)
claim Hhfam_mult : forall alpha:set, alpha :e J ->
  forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
    apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (x, y)) =
      apply_fun multH (apply_fun (apply_fun hfam alpha) x, apply_fun (apply_fun hfam alpha) y).
{ let alpha. assume Hal. let x y. assume Hx Hy.
  exact (group_homomorphism_mult_rule
    (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha) x y
    (Hhfam alpha Hal) Hx Hy). }
(** Helper: Gfam(alpha) is closed under multfam(alpha) **)
claim HGfam_mult_cl : forall alpha:set, alpha :e J ->
  forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
    apply_fun (apply_fun multfam alpha) (x, y) :e apply_fun Gfam alpha.
{ let alpha. assume Hal. let x y. assume Hx Hy.
  admit. }
(** Prove kfam(alpha) is a group_homomorphism from ImageFam(alpha) with multG to H with multH **)
claim Hkfam_hom : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun ImageFam alpha) multG H multH (apply_fun kfam alpha).
{ let alpha. assume Hal.
  prove function_on (apply_fun kfam alpha) (apply_fun ImageFam alpha) H /\
    (forall u v:set, u :e apply_fun ImageFam alpha -> v :e apply_fun ImageFam alpha ->
      apply_fun (apply_fun kfam alpha) (apply_fun multG (u, v)) =
        apply_fun multH (apply_fun (apply_fun kfam alpha) u, apply_fun (apply_fun kfam alpha) v)).
  apply andI.
  (** function_on **)
  + prove forall y:set, y :e apply_fun ImageFam alpha -> apply_fun (apply_fun kfam alpha) y :e H.
    let y. assume Hy.
    claim Hpre_Gal : preimg alpha y :e apply_fun Gfam alpha.
    { exact (andEL
        (preimg alpha y :e apply_fun Gfam alpha)
        (apply_fun (apply_fun ifam alpha) (preimg alpha y) = y)
        (Hpreimg_props alpha Hal y Hy)). }
    claim Hval : apply_fun (apply_fun kfam alpha) y = apply_fun (apply_fun hfam alpha) (preimg alpha y).
    { exact (Hkfam_val alpha Hal y Hy). }
    rewrite Hval.
    exact (Hhfam_in_H alpha Hal (preimg alpha y) Hpre_Gal).
  (** multiplicativity **)
  + let u v. assume Hu : u :e apply_fun ImageFam alpha. assume Hv : v :e apply_fun ImageFam alpha.
    set pu := preimg alpha u.
    set pv := preimg alpha v.
    claim Hpu_Gal : pu :e apply_fun Gfam alpha.
    { exact (andEL (pu :e apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha) pu = u)
        (Hpreimg_props alpha Hal u Hu)). }
    claim Hpu_eq : apply_fun (apply_fun ifam alpha) pu = u.
    { exact (andER (pu :e apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha) pu = u)
        (Hpreimg_props alpha Hal u Hu)). }
    claim Hpv_Gal : pv :e apply_fun Gfam alpha.
    { exact (andEL (pv :e apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha) pv = v)
        (Hpreimg_props alpha Hal v Hv)). }
    claim Hpv_eq : apply_fun (apply_fun ifam alpha) pv = v.
    { exact (andER (pv :e apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha) pv = v)
        (Hpreimg_props alpha Hal v Hv)). }
    claim Hmultfam_cl : apply_fun (apply_fun multfam alpha) (pu, pv) :e apply_fun Gfam alpha.
    { exact (HGfam_mult_cl alpha Hal pu pv Hpu_Gal Hpv_Gal). }
    claim HmultG_uv_eq : apply_fun multG (u, v) =
      apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)).
    { claim Hstep1 : apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)) =
        apply_fun multG (apply_fun (apply_fun ifam alpha) pu, apply_fun (apply_fun ifam alpha) pv).
      { exact (Hifam_mult alpha Hal pu pv Hpu_Gal Hpv_Gal). }
      claim Hstep2 : apply_fun multG (apply_fun (apply_fun ifam alpha) pu, apply_fun (apply_fun ifam alpha) pv) =
        apply_fun multG (u, v).
      { rewrite Hpu_eq. rewrite Hpv_eq. reflexivity. }
      symmetry. exact (eq_i_tra
        (apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)))
        (apply_fun multG (apply_fun (apply_fun ifam alpha) pu, apply_fun (apply_fun ifam alpha) pv))
        (apply_fun multG (u, v))
        Hstep1 Hstep2). }
    claim Huv_Image : apply_fun multG (u, v) :e apply_fun ImageFam alpha.
    { rewrite HmultG_uv_eq. exact (Hifam_in_Image alpha Hal (apply_fun (apply_fun multfam alpha) (pu, pv)) Hmultfam_cl). }
    (** LHS: kfam(alpha)(multG(u,v)) = hfam(alpha)(preimg(multG(u,v))) **)
    claim Hlhs : apply_fun (apply_fun kfam alpha) (apply_fun multG (u, v)) =
      apply_fun (apply_fun hfam alpha) (preimg alpha (apply_fun multG (u, v))).
    { exact (Hkfam_val alpha Hal (apply_fun multG (u, v)) Huv_Image). }
    (** RHS: multH(kfam(alpha)(u), kfam(alpha)(v)) = multH(hfam(alpha)(pu), hfam(alpha)(pv)) **)
    claim Hku : apply_fun (apply_fun kfam alpha) u = apply_fun (apply_fun hfam alpha) pu.
    { exact (Hkfam_val alpha Hal u Hu). }
    claim Hkv : apply_fun (apply_fun kfam alpha) v = apply_fun (apply_fun hfam alpha) pv.
    { exact (Hkfam_val alpha Hal v Hv). }
    (** preimage(multG(u,v)) = multfam(pu, pv) by injectivity **)
    claim Hpre_uv_Gal : preimg alpha (apply_fun multG (u, v)) :e apply_fun Gfam alpha.
    { exact (andEL
        (preimg alpha (apply_fun multG (u, v)) :e apply_fun Gfam alpha)
        (apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun multG (u, v))) = apply_fun multG (u, v))
        (Hpreimg_props alpha Hal (apply_fun multG (u, v)) Huv_Image)). }
    claim Hpre_uv_eq : apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun multG (u, v))) = apply_fun multG (u, v).
    { exact (andER
        (preimg alpha (apply_fun multG (u, v)) :e apply_fun Gfam alpha)
        (apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun multG (u, v))) = apply_fun multG (u, v))
        (Hpreimg_props alpha Hal (apply_fun multG (u, v)) Huv_Image)). }
    claim Hifam_eq : apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun multG (u, v))) =
      apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)).
    { exact (eq_i_tra
        (apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun multG (u, v))))
        (apply_fun multG (u, v))
        (apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)))
        Hpre_uv_eq HmultG_uv_eq). }
    claim Hpre_eq_mult : preimg alpha (apply_fun multG (u, v)) = apply_fun (apply_fun multfam alpha) (pu, pv).
    { exact (Hifam_inj alpha Hal
        (preimg alpha (apply_fun multG (u, v)))
        (apply_fun (apply_fun multfam alpha) (pu, pv))
        Hpre_uv_Gal Hmultfam_cl Hifam_eq). }
    (** hfam(alpha)(preimg(multG(u,v))) = hfam(alpha)(multfam(pu,pv)) **)
    claim Hlhs2 : apply_fun (apply_fun hfam alpha) (preimg alpha (apply_fun multG (u, v))) =
      apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)).
    { rewrite Hpre_eq_mult. reflexivity. }
    (** hfam(alpha)(multfam(pu,pv)) = multH(hfam(alpha)(pu), hfam(alpha)(pv)) **)
    claim Hhfam_eq : apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)) =
      apply_fun multH (apply_fun (apply_fun hfam alpha) pu, apply_fun (apply_fun hfam alpha) pv).
    { exact (Hhfam_mult alpha Hal pu pv Hpu_Gal Hpv_Gal). }
    (** Chain: kfam(multG(u,v)) = hfam(preimg) = hfam(multfam(pu,pv)) = multH(hfam(pu), hfam(pv)) **)
    claim Hlhs3 : apply_fun (apply_fun kfam alpha) (apply_fun multG (u, v)) =
      apply_fun multH (apply_fun (apply_fun hfam alpha) pu, apply_fun (apply_fun hfam alpha) pv).
    { exact (eq_i_tra
        (apply_fun (apply_fun kfam alpha) (apply_fun multG (u, v)))
        (apply_fun (apply_fun hfam alpha) (preimg alpha (apply_fun multG (u, v))))
        (apply_fun multH (apply_fun (apply_fun hfam alpha) pu, apply_fun (apply_fun hfam alpha) pv))
        Hlhs (eq_i_tra
          (apply_fun (apply_fun hfam alpha) (preimg alpha (apply_fun multG (u, v))))
          (apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (pu, pv)))
          (apply_fun multH (apply_fun (apply_fun hfam alpha) pu, apply_fun (apply_fun hfam alpha) pv))
          Hlhs2 Hhfam_eq)). }
    (** multH(hfam(pu), hfam(pv)) = multH(kfam(u), kfam(v)) **)
    claim Hku_sym : apply_fun (apply_fun hfam alpha) pu = apply_fun (apply_fun kfam alpha) u.
    { symmetry. exact Hku. }
    claim Hkv_sym : apply_fun (apply_fun hfam alpha) pv = apply_fun (apply_fun kfam alpha) v.
    { symmetry. exact Hkv. }
    claim Hrhs : apply_fun multH (apply_fun (apply_fun hfam alpha) pu, apply_fun (apply_fun hfam alpha) pv) =
      apply_fun multH (apply_fun (apply_fun kfam alpha) u, apply_fun (apply_fun kfam alpha) v).
    { rewrite Hku_sym. rewrite Hkv_sym. reflexivity. }
    exact (eq_i_tra
      (apply_fun (apply_fun kfam alpha) (apply_fun multG (u, v)))
      (apply_fun multH (apply_fun (apply_fun hfam alpha) pu, apply_fun (apply_fun hfam alpha) pv))
      (apply_fun multH (apply_fun (apply_fun kfam alpha) u, apply_fun (apply_fun kfam alpha) v))
      Hlhs3 Hrhs). }
(** Apply lemma68_1 **)
claim Hlem68_1 : exists h:set,
  group_homomorphism G multG H multH h /\
  (forall alpha:set, alpha :e J ->
    forall y:set, y :e apply_fun ImageFam alpha ->
      apply_fun h y = apply_fun (apply_fun kfam alpha) y) /\
  (forall h':set, group_homomorphism G multG H multH h' ->
    (forall alpha:set, alpha :e J ->
      forall y:set, y :e apply_fun ImageFam alpha ->
        apply_fun h' y = apply_fun (apply_fun kfam alpha) y) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
{ exact (lemma68_1_extension_condition_free_product
    G multG eG invG J ImageFam efam_int Hfp
    H multH eH invH HgrpH kfam Hkfam_hom). }
apply Hlem68_1. let h. assume Hh_all.
apply (and3E
  (group_homomorphism G multG H multH h)
  (forall alpha:set, alpha :e J ->
    forall y:set, y :e apply_fun ImageFam alpha ->
      apply_fun h y = apply_fun (apply_fun kfam alpha) y)
  (forall h':set, group_homomorphism G multG H multH h' ->
    (forall alpha:set, alpha :e J ->
      forall y:set, y :e apply_fun ImageFam alpha ->
        apply_fun h' y = apply_fun (apply_fun kfam alpha) y) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x)
  Hh_all).
assume Hh_hom : group_homomorphism G multG H multH h.
assume Hh_restrict : forall alpha:set, alpha :e J ->
  forall y:set, y :e apply_fun ImageFam alpha ->
    apply_fun h y = apply_fun (apply_fun kfam alpha) y.
assume Hh_unique : forall h':set, group_homomorphism G multG H multH h' ->
  (forall alpha:set, alpha :e J ->
    forall y:set, y :e apply_fun ImageFam alpha ->
      apply_fun h' y = apply_fun (apply_fun kfam alpha) y) ->
  forall x:set, x :e G -> apply_fun h' x = apply_fun h x.
(** Helper: kfam(alpha)(ifam(alpha)(x)) = hfam(alpha)(x) **)
claim Hkfam_ifam : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) x) =
      apply_fun (apply_fun hfam alpha) x.
{ let alpha. assume Hal. let x. assume Hx.
  claim Hifx_Image : apply_fun (apply_fun ifam alpha) x :e apply_fun ImageFam alpha.
  { exact (Hifam_in_Image alpha Hal x Hx). }
  claim Hval : apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun hfam alpha) (preimg alpha (apply_fun (apply_fun ifam alpha) x)).
  { exact (Hkfam_val alpha Hal (apply_fun (apply_fun ifam alpha) x) Hifx_Image). }
  claim Hpre_Gal : preimg alpha (apply_fun (apply_fun ifam alpha) x) :e apply_fun Gfam alpha.
  { exact (andEL
      (preimg alpha (apply_fun (apply_fun ifam alpha) x) :e apply_fun Gfam alpha)
      (apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun (apply_fun ifam alpha) x)) = apply_fun (apply_fun ifam alpha) x)
      (Hpreimg_props alpha Hal (apply_fun (apply_fun ifam alpha) x) Hifx_Image)). }
  claim Hpre_eq_ifam : apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun (apply_fun ifam alpha) x)) =
    apply_fun (apply_fun ifam alpha) x.
  { exact (andER
      (preimg alpha (apply_fun (apply_fun ifam alpha) x) :e apply_fun Gfam alpha)
      (apply_fun (apply_fun ifam alpha) (preimg alpha (apply_fun (apply_fun ifam alpha) x)) = apply_fun (apply_fun ifam alpha) x)
      (Hpreimg_props alpha Hal (apply_fun (apply_fun ifam alpha) x) Hifx_Image)). }
  claim Hpre_eq_x : preimg alpha (apply_fun (apply_fun ifam alpha) x) = x.
  { exact (Hifam_inj alpha Hal
      (preimg alpha (apply_fun (apply_fun ifam alpha) x)) x
      Hpre_Gal Hx Hpre_eq_ifam). }
  rewrite Hval. rewrite Hpre_eq_x. reflexivity. }
(** Witness h **)
witness h. apply and3I.
(** Part 1: h is a group homomorphism **)
- exact Hh_hom.
(** Part 2: h(ifam(alpha)(x)) = hfam(alpha)(x) **)
- let alpha. assume Hal : alpha :e J.
  let x. assume Hx : x :e apply_fun Gfam alpha.
  claim Hifx_Image : apply_fun (apply_fun ifam alpha) x :e apply_fun ImageFam alpha.
  { exact (Hifam_in_Image alpha Hal x Hx). }
  claim Hstep1 : apply_fun h (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) x).
  { exact (Hh_restrict alpha Hal (apply_fun (apply_fun ifam alpha) x) Hifx_Image). }
  claim Hstep2 : apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun hfam alpha) x.
  { exact (Hkfam_ifam alpha Hal x Hx). }
  exact (eq_i_tra
    (apply_fun h (apply_fun (apply_fun ifam alpha) x))
    (apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) x))
    (apply_fun (apply_fun hfam alpha) x)
    Hstep1 Hstep2).
(** Part 3: uniqueness **)
- let h'. assume Hh'_hom : group_homomorphism G multG H multH h'.
  assume Hh'_comp : forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h' (apply_fun (apply_fun ifam alpha) x) = apply_fun (apply_fun hfam alpha) x.
  let x. assume HxG : x :e G.
  claim Hh'_kfam : forall alpha:set, alpha :e J ->
    forall y:set, y :e apply_fun ImageFam alpha ->
      apply_fun h' y = apply_fun (apply_fun kfam alpha) y.
  { let alpha. assume Hal. let y. assume Hy.
    claim Hy2 : y :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
    { claim Heq : apply_fun ImageFam alpha = homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
      { exact (HIF_eval alpha Hal). }
      rewrite <- Heq. exact Hy. }
    apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) y Hy2).
    let z. assume Hz : z :e apply_fun Gfam alpha. assume Heq : y = apply_fun (apply_fun ifam alpha) z.
      rewrite Heq.
      claim Hstep1 : apply_fun h' (apply_fun (apply_fun ifam alpha) z) = apply_fun (apply_fun hfam alpha) z.
      { exact (Hh'_comp alpha Hal z Hz). }
      claim Hstep2 : apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) z) =
        apply_fun (apply_fun hfam alpha) z.
      { exact (Hkfam_ifam alpha Hal z Hz). }
      claim Hstep2_sym : apply_fun (apply_fun hfam alpha) z =
        apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) z).
      { symmetry. exact Hstep2. }
      exact (eq_i_tra
        (apply_fun h' (apply_fun (apply_fun ifam alpha) z))
        (apply_fun (apply_fun hfam alpha) z)
        (apply_fun (apply_fun kfam alpha) (apply_fun (apply_fun ifam alpha) z))
        Hstep1 Hstep2_sym). }
  exact (Hh_unique h' Hh'_hom Hh'_kfam x HxG).
Admitted.

(** from S68 Thm 68.4 (line 2946 in algtop.tex): uniqueness of free products **)
(** LATEX VERSION: If G and G' are both external free products of {G_alpha} via **)
(** i_alpha and i'_alpha, then there is a unique isomorphism phi: G -> G' **)
(** with phi o i_alpha = i'_alpha. **)
(** EFFORT: 10 lines textbook, difficulty 4/10, USD 80 **)
(** Bounty 97 **)
(** Lock Alice 1771568868 **)
Theorem thm68_4_uniqueness_free_product :
  forall J Gfam multfam G multG eG invG ifam G' multG' eG' invG' ifam':set,
  external_free_product G multG eG invG J Gfam multfam ifam ->
  external_free_product G' multG' eG' invG' J Gfam multfam ifam' ->
  exists phi:set,
    group_isomorphism G multG G' multG' phi /\
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam' alpha) x) /\
    (forall phi':set, group_isomorphism G multG G' multG' phi' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun phi' (apply_fun (apply_fun ifam alpha) x) =
            apply_fun (apply_fun ifam' alpha) x) ->
      forall x:set, x :e G -> apply_fun phi' x = apply_fun phi x).
let J Gfam multfam G multG eG invG ifam G' multG' eG' invG' ifam'.
assume Hext1 : external_free_product G multG eG invG J Gfam multfam ifam.
assume Hext2 : external_free_product G' multG' eG' invG' J Gfam multfam ifam'.
claim Hgrp1 : group_structure G multG eG invG.
{ apply (and3E
    (group_structure G multG eG invG)
    (forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y))
    (free_product_of_subgroups G multG eG invG J
      (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)))
      (graph J (fun alpha:set => apply_fun (apply_fun ifam alpha) (Eps_i (fun ea:set =>
        exists ma ia:set, group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) ea ia)))))
    Hext1).
  assume H _ _. exact H. }
claim Hgrp2 : group_structure G' multG' eG' invG'.
{ apply (and3E
    (group_structure G' multG' eG' invG')
    (forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha) /\
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam' alpha) x = apply_fun (apply_fun ifam' alpha) y -> x = y))
    (free_product_of_subgroups G' multG' eG' invG' J
      (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam' alpha)))
      (graph J (fun alpha:set => apply_fun (apply_fun ifam' alpha) (Eps_i (fun ea:set =>
        exists ma ia:set, group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) ea ia)))))
    Hext2).
  assume H _ _. exact H. }
claim Hifam_hom : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
{ let alpha. assume Hal.
  apply (and3E
    (group_structure G multG eG invG)
    (forall alpha0:set, alpha0 :e J ->
      group_homomorphism (apply_fun Gfam alpha0) (apply_fun multfam alpha0) G multG (apply_fun ifam alpha0) /\
      (forall x y:set, x :e apply_fun Gfam alpha0 -> y :e apply_fun Gfam alpha0 ->
        apply_fun (apply_fun ifam alpha0) x = apply_fun (apply_fun ifam alpha0) y -> x = y))
    (free_product_of_subgroups G multG eG invG J
      (graph J (fun a:set => homomorphism_image (apply_fun Gfam a) (apply_fun ifam a)))
      (graph J (fun a:set => apply_fun (apply_fun ifam a) (Eps_i (fun ea:set =>
        exists ma ia:set, group_structure (apply_fun Gfam a) (apply_fun multfam a) ea ia)))))
    Hext1).
  assume _ Hmono _.
  exact (andEL
    (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
    (Hmono alpha Hal)). }
claim Hifam'_hom : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha).
{ let alpha. assume Hal.
  apply (and3E
    (group_structure G' multG' eG' invG')
    (forall alpha0:set, alpha0 :e J ->
      group_homomorphism (apply_fun Gfam alpha0) (apply_fun multfam alpha0) G' multG' (apply_fun ifam' alpha0) /\
      (forall x y:set, x :e apply_fun Gfam alpha0 -> y :e apply_fun Gfam alpha0 ->
        apply_fun (apply_fun ifam' alpha0) x = apply_fun (apply_fun ifam' alpha0) y -> x = y))
    (free_product_of_subgroups G' multG' eG' invG' J
      (graph J (fun a:set => homomorphism_image (apply_fun Gfam a) (apply_fun ifam' a)))
      (graph J (fun a:set => apply_fun (apply_fun ifam' a) (Eps_i (fun ea:set =>
        exists ma ia:set, group_structure (apply_fun Gfam a) (apply_fun multfam a) ea ia)))))
    Hext2).
  assume _ Hmono _.
  exact (andEL
    (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha))
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam' alpha) x = apply_fun (apply_fun ifam' alpha) y -> x = y)
    (Hmono alpha Hal)). }
claim Hphi_ex : exists h:set,
  group_homomorphism G multG G' multG' h /\
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun ifam' alpha) x) /\
  (forall h':set, group_homomorphism G multG G' multG' h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam' alpha) x) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
{ exact (lemma68_3_extension_external_free_product G multG eG invG J Gfam multfam ifam Hext1
    G' multG' eG' invG' Hgrp2 ifam' Hifam'_hom). }
apply Hphi_ex. let phi. assume Hphi_all.
apply (and3E
  (group_homomorphism G multG G' multG' phi)
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun ifam' alpha) x)
  (forall h':set, group_homomorphism G multG G' multG' h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam' alpha) x) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun phi x)
  Hphi_all).
assume Hphi_hom : group_homomorphism G multG G' multG' phi.
assume Hphi_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
      apply_fun (apply_fun ifam' alpha) x.
assume Hphi_uniq : forall h':set, group_homomorphism G multG G' multG' h' ->
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun ifam' alpha) x) ->
  forall x:set, x :e G -> apply_fun h' x = apply_fun phi x.
claim Hpsi_ex : exists h:set,
  group_homomorphism G' multG' G multG h /\
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h (apply_fun (apply_fun ifam' alpha) x) =
        apply_fun (apply_fun ifam alpha) x) /\
  (forall h':set, group_homomorphism G' multG' G multG h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam alpha) x) ->
    forall x:set, x :e G' -> apply_fun h' x = apply_fun h x).
{ exact (lemma68_3_extension_external_free_product G' multG' eG' invG' J Gfam multfam ifam' Hext2
    G multG eG invG Hgrp1 ifam Hifam_hom). }
apply Hpsi_ex. let psi. assume Hpsi_all.
apply (and3E
  (group_homomorphism G' multG' G multG psi)
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun psi (apply_fun (apply_fun ifam' alpha) x) =
        apply_fun (apply_fun ifam alpha) x)
  (forall h':set, group_homomorphism G' multG' G multG h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam alpha) x) ->
    forall x:set, x :e G' -> apply_fun h' x = apply_fun psi x)
  Hpsi_all).
assume Hpsi_hom : group_homomorphism G' multG' G multG psi.
assume Hpsi_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun psi (apply_fun (apply_fun ifam' alpha) x) =
      apply_fun (apply_fun ifam alpha) x.
assume Hpsi_uniq : forall h':set, group_homomorphism G' multG' G multG h' ->
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
        apply_fun (apply_fun ifam alpha) x) ->
  forall x:set, x :e G' -> apply_fun h' x = apply_fun psi x.
claim Hphi_fo : function_on phi G G'.
{ exact (group_homomorphism_function_on G multG G' multG' phi Hphi_hom). }
claim Hpsi_fo : function_on psi G' G.
{ exact (group_homomorphism_function_on G' multG' G multG psi Hpsi_hom). }
claim Hid_ex : exists h:set,
  group_homomorphism G multG G multG h /\
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun ifam alpha) x) /\
  (forall h':set, group_homomorphism G multG G multG h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam alpha) x) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
{ exact (lemma68_3_extension_external_free_product G multG eG invG J Gfam multfam ifam Hext1
    G multG eG invG Hgrp1 ifam Hifam_hom). }
apply Hid_ex. let h_id. assume Hid_all.
apply (and3E
  (group_homomorphism G multG G multG h_id)
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h_id (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun ifam alpha) x)
  (forall h':set, group_homomorphism G multG G multG h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam alpha) x) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h_id x)
  Hid_all).
assume Hid_hom : group_homomorphism G multG G multG h_id.
assume Hid_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun h_id (apply_fun (apply_fun ifam alpha) x) =
      apply_fun (apply_fun ifam alpha) x.
assume Hid_uniq : forall h':set, group_homomorphism G multG G multG h' ->
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun ifam alpha) x) ->
  forall x:set, x :e G -> apply_fun h' x = apply_fun h_id x.
set id_G := graph G (fun x:set => x).
claim Hid_G_hom : group_homomorphism G multG G multG id_G.
{ prove function_on id_G G G /\
    (forall x y:set, x :e G -> y :e G ->
      apply_fun id_G (apply_fun multG (x, y)) = apply_fun multG (apply_fun id_G x, apply_fun id_G y)).
  apply andI.
  - prove function_on id_G G G.
    let x. assume Hx : x :e G.
    prove apply_fun (graph G (fun z:set => z)) x :e G.
    rewrite (apply_fun_graph G (fun z:set => z) x Hx). exact Hx.
  - let x y. assume Hx : x :e G. assume Hy : y :e G.
    claim HxyG : apply_fun multG (x, y) :e G.
    { apply (and6E
        (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
        (forall x0 y0 z:set, x0 :e G -> y0 :e G -> z :e G ->
          apply_fun multG (apply_fun multG (x0, y0), z) = apply_fun multG (x0, apply_fun multG (y0, z)))
        (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
        (forall x0:set, x0 :e G ->
          apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
        Hgrp1).
      assume Hmult_fo _ _ _ _ _.
      exact (Hmult_fo (x, y) (tuple_2_setprod_by_pair_Sigma G G x y Hx Hy)). }
    prove apply_fun id_G (apply_fun multG (x, y)) =
      apply_fun multG (apply_fun id_G x, apply_fun id_G y).
    rewrite (apply_fun_graph G (fun z:set => z) (apply_fun multG (x, y)) HxyG).
    rewrite (apply_fun_graph G (fun z:set => z) x Hx).
    rewrite (apply_fun_graph G (fun z:set => z) y Hy).
    reflexivity. }
claim Hid_G_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun id_G (apply_fun (apply_fun ifam alpha) x) =
      apply_fun (apply_fun ifam alpha) x.
{ let alpha. assume Hal. let x. assume Hx.
  claim Hifx_G : apply_fun (apply_fun ifam alpha) x :e G.
  { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG
      (apply_fun ifam alpha) (Hifam_hom alpha Hal) x Hx). }
  exact (apply_fun_graph G (fun z:set => z) (apply_fun (apply_fun ifam alpha) x) Hifx_G). }
claim Hid_G_agrees : forall x:set, x :e G -> apply_fun h_id x = x.
{ let x. assume Hx.
  claim Hid_eq : apply_fun id_G x = apply_fun h_id x.
  { exact (Hid_uniq id_G Hid_G_hom Hid_G_ext x Hx). }
  claim Hid_eq_sym : apply_fun h_id x = apply_fun id_G x.
  { symmetry. exact Hid_eq. }
  claim Hid_val : apply_fun id_G x = x.
  { exact (apply_fun_graph G (fun z:set => z) x Hx). }
  exact (eq_i_tra (apply_fun h_id x) (apply_fun id_G x) x Hid_eq_sym Hid_val). }
set comp_psi_phi := graph G (fun x:set => apply_fun psi (apply_fun phi x)).
claim Hcomp_fo : function_on comp_psi_phi G G.
{ let x. assume Hx.
  claim HphixG' : apply_fun phi x :e G'. { exact (Hphi_fo x Hx). }
  claim Hval : apply_fun comp_psi_phi x = apply_fun psi (apply_fun phi x).
  { exact (apply_fun_graph G (fun z:set => apply_fun psi (apply_fun phi z)) x Hx). }
  rewrite Hval. exact (Hpsi_fo (apply_fun phi x) HphixG'). }
claim Hcomp_hom : group_homomorphism G multG G multG comp_psi_phi.
{ prove function_on comp_psi_phi G G /\
    (forall x y:set, x :e G -> y :e G ->
      apply_fun comp_psi_phi (apply_fun multG (x, y)) = apply_fun multG (apply_fun comp_psi_phi x, apply_fun comp_psi_phi y)).
  apply andI.
  - exact Hcomp_fo.
  - let x y. assume Hx : x :e G. assume Hy : y :e G.
    claim HxyG : apply_fun multG (x, y) :e G.
    { apply (and6E
        (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
        (forall x0 y0 z:set, x0 :e G -> y0 :e G -> z :e G ->
          apply_fun multG (apply_fun multG (x0, y0), z) = apply_fun multG (x0, apply_fun multG (y0, z)))
        (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
        (forall x0:set, x0 :e G ->
          apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
        Hgrp1).
      assume Hmult_fo _ _ _ _ _.
      exact (Hmult_fo (x, y) (tuple_2_setprod_by_pair_Sigma G G x y Hx Hy)). }
    claim HphixG' : apply_fun phi x :e G'. { exact (Hphi_fo x Hx). }
    claim HphiyG' : apply_fun phi y :e G'. { exact (Hphi_fo y Hy). }
    claim Hval_xy : apply_fun comp_psi_phi (apply_fun multG (x, y)) =
      apply_fun psi (apply_fun phi (apply_fun multG (x, y))).
    { exact (apply_fun_graph G (fun z:set => apply_fun psi (apply_fun phi z)) (apply_fun multG (x, y)) HxyG). }
    claim Hval_x : apply_fun comp_psi_phi x = apply_fun psi (apply_fun phi x).
    { exact (apply_fun_graph G (fun z:set => apply_fun psi (apply_fun phi z)) x Hx). }
    claim Hval_y : apply_fun comp_psi_phi y = apply_fun psi (apply_fun phi y).
    { exact (apply_fun_graph G (fun z:set => apply_fun psi (apply_fun phi z)) y Hy). }
    claim Hphi_mult : apply_fun phi (apply_fun multG (x, y)) = apply_fun multG' (apply_fun phi x, apply_fun phi y).
    { exact (group_homomorphism_mult_rule G multG G' multG' phi x y Hphi_hom Hx Hy). }
    claim Hpsi_mult : apply_fun psi (apply_fun multG' (apply_fun phi x, apply_fun phi y)) =
      apply_fun multG (apply_fun psi (apply_fun phi x), apply_fun psi (apply_fun phi y)).
    { exact (group_homomorphism_mult_rule G' multG' G multG psi (apply_fun phi x) (apply_fun phi y) Hpsi_hom HphixG' HphiyG'). }
    claim Hlhs : apply_fun comp_psi_phi (apply_fun multG (x, y)) =
      apply_fun multG (apply_fun psi (apply_fun phi x), apply_fun psi (apply_fun phi y)).
    { claim Hstep1 : apply_fun comp_psi_phi (apply_fun multG (x, y)) =
        apply_fun psi (apply_fun multG' (apply_fun phi x, apply_fun phi y)).
      { rewrite Hval_xy. rewrite Hphi_mult. reflexivity. }
      exact (eq_i_tra
        (apply_fun comp_psi_phi (apply_fun multG (x, y)))
        (apply_fun psi (apply_fun multG' (apply_fun phi x, apply_fun phi y)))
        (apply_fun multG (apply_fun psi (apply_fun phi x), apply_fun psi (apply_fun phi y)))
        Hstep1 Hpsi_mult). }
    claim Hrhs : apply_fun multG (apply_fun psi (apply_fun phi x), apply_fun psi (apply_fun phi y)) =
      apply_fun multG (apply_fun comp_psi_phi x, apply_fun comp_psi_phi y).
    { rewrite Hval_x. rewrite Hval_y. reflexivity. }
    exact (eq_i_tra
      (apply_fun comp_psi_phi (apply_fun multG (x, y)))
      (apply_fun multG (apply_fun psi (apply_fun phi x), apply_fun psi (apply_fun phi y)))
      (apply_fun multG (apply_fun comp_psi_phi x, apply_fun comp_psi_phi y))
      Hlhs Hrhs). }
claim Hcomp_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun comp_psi_phi (apply_fun (apply_fun ifam alpha) x) =
      apply_fun (apply_fun ifam alpha) x.
{ let alpha. assume Hal. let x. assume Hx.
  claim Hifx_G : apply_fun (apply_fun ifam alpha) x :e G.
  { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG
      (apply_fun ifam alpha) (Hifam_hom alpha Hal) x Hx). }
  claim Hval : apply_fun comp_psi_phi (apply_fun (apply_fun ifam alpha) x) =
    apply_fun psi (apply_fun phi (apply_fun (apply_fun ifam alpha) x)).
  { exact (apply_fun_graph G (fun z:set => apply_fun psi (apply_fun phi z))
      (apply_fun (apply_fun ifam alpha) x) Hifx_G). }
  claim Hphi_ifam : apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun ifam' alpha) x.
  { exact (Hphi_ext alpha Hal x Hx). }
  claim Hpsi_ifam' : apply_fun psi (apply_fun (apply_fun ifam' alpha) x) =
    apply_fun (apply_fun ifam alpha) x.
  { exact (Hpsi_ext alpha Hal x Hx). }
  rewrite Hval. rewrite Hphi_ifam. exact Hpsi_ifam'. }
claim Hpsi_phi_id : forall x:set, x :e G -> apply_fun psi (apply_fun phi x) = x.
{ let x. assume Hx.
  claim Hcomp_hid : apply_fun comp_psi_phi x = apply_fun h_id x.
  { exact (Hid_uniq comp_psi_phi Hcomp_hom Hcomp_ext x Hx). }
  claim Hcomp_val : apply_fun comp_psi_phi x = apply_fun psi (apply_fun phi x).
  { exact (apply_fun_graph G (fun z:set => apply_fun psi (apply_fun phi z)) x Hx). }
  claim Hcomp_val_sym : apply_fun psi (apply_fun phi x) = apply_fun comp_psi_phi x.
  { symmetry. exact Hcomp_val. }
  claim Hpsi_phi_eq_hid : apply_fun psi (apply_fun phi x) = apply_fun h_id x.
  { exact (eq_i_tra
      (apply_fun psi (apply_fun phi x))
      (apply_fun comp_psi_phi x)
      (apply_fun h_id x)
      Hcomp_val_sym
      Hcomp_hid). }
  exact (eq_i_tra
    (apply_fun psi (apply_fun phi x))
    (apply_fun h_id x) x
    Hpsi_phi_eq_hid (Hid_G_agrees x Hx)). }
claim Hid2_ex : exists h:set,
  group_homomorphism G' multG' G' multG' h /\
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h (apply_fun (apply_fun ifam' alpha) x) =
        apply_fun (apply_fun ifam' alpha) x) /\
  (forall h':set, group_homomorphism G' multG' G' multG' h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam' alpha) x) ->
    forall x:set, x :e G' -> apply_fun h' x = apply_fun h x).
{ exact (lemma68_3_extension_external_free_product G' multG' eG' invG' J Gfam multfam ifam' Hext2
    G' multG' eG' invG' Hgrp2 ifam' Hifam'_hom). }
apply Hid2_ex. let h_id2. assume Hid2_all.
apply (and3E
  (group_homomorphism G' multG' G' multG' h_id2)
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h_id2 (apply_fun (apply_fun ifam' alpha) x) =
        apply_fun (apply_fun ifam' alpha) x)
  (forall h':set, group_homomorphism G' multG' G' multG' h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam' alpha) x) ->
    forall x:set, x :e G' -> apply_fun h' x = apply_fun h_id2 x)
  Hid2_all).
assume Hid2_hom : group_homomorphism G' multG' G' multG' h_id2.
assume Hid2_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun h_id2 (apply_fun (apply_fun ifam' alpha) x) =
      apply_fun (apply_fun ifam' alpha) x.
assume Hid2_uniq : forall h':set, group_homomorphism G' multG' G' multG' h' ->
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
        apply_fun (apply_fun ifam' alpha) x) ->
  forall x:set, x :e G' -> apply_fun h' x = apply_fun h_id2 x.
set id_G' := graph G' (fun x:set => x).
claim Hid_G'_hom : group_homomorphism G' multG' G' multG' id_G'.
{ prove function_on id_G' G' G' /\
    (forall x y:set, x :e G' -> y :e G' ->
      apply_fun id_G' (apply_fun multG' (x, y)) = apply_fun multG' (apply_fun id_G' x, apply_fun id_G' y)).
  apply andI.
  - let x. assume Hx : x :e G'.
    rewrite (apply_fun_graph G' (fun z:set => z) x Hx). exact Hx.
  - let x y. assume Hx : x :e G'. assume Hy : y :e G'.
    claim HxyG' : apply_fun multG' (x, y) :e G'.
    { apply (and6E
        (function_on multG' (setprod G' G') G') (function_on invG' G' G') (eG' :e G')
        (forall x0 y0 z:set, x0 :e G' -> y0 :e G' -> z :e G' ->
          apply_fun multG' (apply_fun multG' (x0, y0), z) = apply_fun multG' (x0, apply_fun multG' (y0, z)))
        (forall x0:set, x0 :e G' -> apply_fun multG' (eG', x0) = x0 /\ apply_fun multG' (x0, eG') = x0)
        (forall x0:set, x0 :e G' ->
          apply_fun multG' (x0, apply_fun invG' x0) = eG' /\ apply_fun multG' (apply_fun invG' x0, x0) = eG')
        Hgrp2).
      assume Hmult_fo' _ _ _ _ _.
      exact (Hmult_fo' (x, y) (tuple_2_setprod_by_pair_Sigma G' G' x y Hx Hy)). }
    rewrite (apply_fun_graph G' (fun z:set => z) (apply_fun multG' (x, y)) HxyG').
    rewrite (apply_fun_graph G' (fun z:set => z) x Hx).
    rewrite (apply_fun_graph G' (fun z:set => z) y Hy).
    reflexivity. }
claim Hid_G'_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun id_G' (apply_fun (apply_fun ifam' alpha) x) =
      apply_fun (apply_fun ifam' alpha) x.
{ let alpha. assume Hal. let x. assume Hx.
  claim Hifx_G' : apply_fun (apply_fun ifam' alpha) x :e G'.
  { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG'
      (apply_fun ifam' alpha) (Hifam'_hom alpha Hal) x Hx). }
  exact (apply_fun_graph G' (fun z:set => z) (apply_fun (apply_fun ifam' alpha) x) Hifx_G'). }
claim Hid2_G'_agrees : forall x:set, x :e G' -> apply_fun h_id2 x = x.
{ let x. assume Hx.
  claim Hid2_eq : apply_fun id_G' x = apply_fun h_id2 x.
  { exact (Hid2_uniq id_G' Hid_G'_hom Hid_G'_ext x Hx). }
  claim Hid2_eq_sym : apply_fun h_id2 x = apply_fun id_G' x.
  { symmetry. exact Hid2_eq. }
  claim Hid2_val : apply_fun id_G' x = x.
  { exact (apply_fun_graph G' (fun z:set => z) x Hx). }
  exact (eq_i_tra (apply_fun h_id2 x) (apply_fun id_G' x) x Hid2_eq_sym Hid2_val). }
set comp_phi_psi := graph G' (fun y:set => apply_fun phi (apply_fun psi y)).
claim Hcomp2_hom : group_homomorphism G' multG' G' multG' comp_phi_psi.
{ prove function_on comp_phi_psi G' G' /\
    (forall x y:set, x :e G' -> y :e G' ->
      apply_fun comp_phi_psi (apply_fun multG' (x, y)) = apply_fun multG' (apply_fun comp_phi_psi x, apply_fun comp_phi_psi y)).
  apply andI.
  - let y. assume Hy : y :e G'.
    claim HpsiyG : apply_fun psi y :e G. { exact (Hpsi_fo y Hy). }
    claim Hval : apply_fun comp_phi_psi y = apply_fun phi (apply_fun psi y).
    { exact (apply_fun_graph G' (fun z:set => apply_fun phi (apply_fun psi z)) y Hy). }
    rewrite Hval. exact (Hphi_fo (apply_fun psi y) HpsiyG).
  - let x y. assume Hx : x :e G'. assume Hy : y :e G'.
    claim HxyG' : apply_fun multG' (x, y) :e G'.
    { apply (and6E
        (function_on multG' (setprod G' G') G') (function_on invG' G' G') (eG' :e G')
        (forall x0 y0 z:set, x0 :e G' -> y0 :e G' -> z :e G' ->
          apply_fun multG' (apply_fun multG' (x0, y0), z) = apply_fun multG' (x0, apply_fun multG' (y0, z)))
        (forall x0:set, x0 :e G' -> apply_fun multG' (eG', x0) = x0 /\ apply_fun multG' (x0, eG') = x0)
        (forall x0:set, x0 :e G' ->
          apply_fun multG' (x0, apply_fun invG' x0) = eG' /\ apply_fun multG' (apply_fun invG' x0, x0) = eG')
        Hgrp2).
      assume Hmult_fo' _ _ _ _ _.
      exact (Hmult_fo' (x, y) (tuple_2_setprod_by_pair_Sigma G' G' x y Hx Hy)). }
    claim HpsixG : apply_fun psi x :e G. { exact (Hpsi_fo x Hx). }
    claim HpsiyG : apply_fun psi y :e G. { exact (Hpsi_fo y Hy). }
    claim Hval_xy : apply_fun comp_phi_psi (apply_fun multG' (x, y)) =
      apply_fun phi (apply_fun psi (apply_fun multG' (x, y))).
    { exact (apply_fun_graph G' (fun z:set => apply_fun phi (apply_fun psi z)) (apply_fun multG' (x, y)) HxyG'). }
    claim Hval_x : apply_fun comp_phi_psi x = apply_fun phi (apply_fun psi x).
    { exact (apply_fun_graph G' (fun z:set => apply_fun phi (apply_fun psi z)) x Hx). }
    claim Hval_y : apply_fun comp_phi_psi y = apply_fun phi (apply_fun psi y).
    { exact (apply_fun_graph G' (fun z:set => apply_fun phi (apply_fun psi z)) y Hy). }
    claim Hpsi_m : apply_fun psi (apply_fun multG' (x, y)) =
      apply_fun multG (apply_fun psi x, apply_fun psi y).
    { exact (group_homomorphism_mult_rule G' multG' G multG psi x y Hpsi_hom Hx Hy). }
    claim Hphi_m : apply_fun phi (apply_fun multG (apply_fun psi x, apply_fun psi y)) =
      apply_fun multG' (apply_fun phi (apply_fun psi x), apply_fun phi (apply_fun psi y)).
    { exact (group_homomorphism_mult_rule G multG G' multG' phi (apply_fun psi x) (apply_fun psi y) Hphi_hom HpsixG HpsiyG). }
    claim Hlhs : apply_fun comp_phi_psi (apply_fun multG' (x, y)) =
      apply_fun multG' (apply_fun phi (apply_fun psi x), apply_fun phi (apply_fun psi y)).
    { claim Hstep1 : apply_fun comp_phi_psi (apply_fun multG' (x, y)) =
        apply_fun phi (apply_fun multG (apply_fun psi x, apply_fun psi y)).
      { rewrite Hval_xy. rewrite Hpsi_m. reflexivity. }
      exact (eq_i_tra
        (apply_fun comp_phi_psi (apply_fun multG' (x, y)))
        (apply_fun phi (apply_fun multG (apply_fun psi x, apply_fun psi y)))
        (apply_fun multG' (apply_fun phi (apply_fun psi x), apply_fun phi (apply_fun psi y)))
        Hstep1 Hphi_m). }
    claim Hrhs : apply_fun multG' (apply_fun phi (apply_fun psi x), apply_fun phi (apply_fun psi y)) =
      apply_fun multG' (apply_fun comp_phi_psi x, apply_fun comp_phi_psi y).
    { rewrite Hval_x. rewrite Hval_y. reflexivity. }
    exact (eq_i_tra
      (apply_fun comp_phi_psi (apply_fun multG' (x, y)))
      (apply_fun multG' (apply_fun phi (apply_fun psi x), apply_fun phi (apply_fun psi y)))
      (apply_fun multG' (apply_fun comp_phi_psi x, apply_fun comp_phi_psi y))
      Hlhs Hrhs). }
claim Hcomp2_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun comp_phi_psi (apply_fun (apply_fun ifam' alpha) x) =
      apply_fun (apply_fun ifam' alpha) x.
{ let alpha. assume Hal. let x. assume Hx.
  claim Hifx_G' : apply_fun (apply_fun ifam' alpha) x :e G'.
  { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG'
      (apply_fun ifam' alpha) (Hifam'_hom alpha Hal) x Hx). }
  claim Hval : apply_fun comp_phi_psi (apply_fun (apply_fun ifam' alpha) x) =
    apply_fun phi (apply_fun psi (apply_fun (apply_fun ifam' alpha) x)).
  { exact (apply_fun_graph G' (fun z:set => apply_fun phi (apply_fun psi z))
      (apply_fun (apply_fun ifam' alpha) x) Hifx_G'). }
  claim Hpsi_ifam' : apply_fun psi (apply_fun (apply_fun ifam' alpha) x) =
    apply_fun (apply_fun ifam alpha) x.
  { exact (Hpsi_ext alpha Hal x Hx). }
  claim Hphi_ifam : apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun ifam' alpha) x.
  { exact (Hphi_ext alpha Hal x Hx). }
  rewrite Hval. rewrite Hpsi_ifam'. exact Hphi_ifam. }
claim Hphi_psi_id : forall y:set, y :e G' -> apply_fun phi (apply_fun psi y) = y.
{ let y. assume Hy.
  claim Hcomp2_hid2 : apply_fun comp_phi_psi y = apply_fun h_id2 y.
  { exact (Hid2_uniq comp_phi_psi Hcomp2_hom Hcomp2_ext y Hy). }
  claim Hcomp2_val : apply_fun comp_phi_psi y = apply_fun phi (apply_fun psi y).
  { exact (apply_fun_graph G' (fun z:set => apply_fun phi (apply_fun psi z)) y Hy). }
  claim Hcomp2_val_sym : apply_fun phi (apply_fun psi y) = apply_fun comp_phi_psi y.
  { symmetry. exact Hcomp2_val. }
  claim Hphi_psi_eq_hid2 : apply_fun phi (apply_fun psi y) = apply_fun h_id2 y.
  { exact (eq_i_tra
      (apply_fun phi (apply_fun psi y))
      (apply_fun comp_phi_psi y)
      (apply_fun h_id2 y)
      Hcomp2_val_sym
      Hcomp2_hid2). }
  exact (eq_i_tra
    (apply_fun phi (apply_fun psi y))
    (apply_fun h_id2 y) y
    Hphi_psi_eq_hid2 (Hid2_G'_agrees y Hy)). }
claim Hphi_bij : bijection G G' phi.
{ prove function_on phi G G' /\
    (forall y:set, y :e G' ->
      exists x:set, x :e G /\ apply_fun phi x = y /\
        (forall x':set, x' :e G -> apply_fun phi x' = y -> x' = x)).
  apply andI.
  - exact Hphi_fo.
  - let y. assume Hy : y :e G'.
    set x := apply_fun psi y.
    claim HxG : x :e G. { exact (Hpsi_fo y Hy). }
    witness x. apply and3I.
    + exact HxG.
    + prove apply_fun phi x = y. exact (Hphi_psi_id y Hy).
    + let x'. assume Hx'G : x' :e G. assume Heq : apply_fun phi x' = y.
      prove x' = x.
      claim Hstep : apply_fun psi (apply_fun phi x') = apply_fun psi y.
      { rewrite Heq. reflexivity. }
      claim Hx'_eq : x' = apply_fun psi (apply_fun phi x').
      { symmetry. exact (Hpsi_phi_id x' Hx'G). }
      exact (eq_i_tra x' (apply_fun psi (apply_fun phi x')) x Hx'_eq Hstep). }
witness phi. apply and3I.
- prove group_homomorphism G multG G' multG' phi /\ bijection G G' phi.
  apply andI. exact Hphi_hom. exact Hphi_bij.
- exact Hphi_ext.
- let phi'. assume Hphi'_iso : group_isomorphism G multG G' multG' phi'.
  assume Hphi'_ext : forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun phi' (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun ifam' alpha) x.
  claim Hphi'_hom : group_homomorphism G multG G' multG' phi'.
  { exact (group_isomorphism_homomorphism G multG G' multG' phi' Hphi'_iso). }
  exact (Hphi_uniq phi' Hphi'_hom Hphi'_ext).
Admitted.

(** from S68 Lem 68.5 (line 2950 in algtop.tex): extension condition characterizes free products **)
(** LATEX VERSION: If the extension condition of Lem 68.3 holds, then each i_alpha **)
(** is a monomorphism and G is the free product of i_alpha(G_alpha). **)
(** EFFORT: 15 lines textbook, difficulty 6/10, USD 200 **)
(** Bounty 220 **)
Theorem lemma68_5_extension_characterizes_free_product :
  forall G multG eG invG J Gfam multfam efam invfam ifam:set,
  group_structure G multG eG invG ->
  (forall alpha:set, alpha :e J ->
    group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha)
      (apply_fun efam alpha) (apply_fun invfam alpha)) ->
  (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha)) ->
  (forall H multH eH invH:set,
    group_structure H multH eH invH ->
    forall hfam:set,
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha)) ->
      exists h:set,
        group_homomorphism G multG H multH h /\
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h (apply_fun (apply_fun ifam alpha) x) =
              apply_fun (apply_fun hfam alpha) x)) ->
  external_free_product G multG eG invG J Gfam multfam ifam.
admit.
Admitted.

(** from S68 Cor 68.6 (line 2958 in algtop.tex): associativity of free products **)
(** LATEX VERSION: If G = G1 free-prod G2, G1 = free product of H_alpha for alpha in J, **)
(** G2 = free product of H_beta for beta in K, with J,K disjoint, **)
(** then G = free product of H_gamma for gamma in J union K. **)
(** EFFORT: 5 lines textbook, difficulty 3/10, USD 50 **)
(** Bounty 55 **)
Theorem cor68_6_associativity_free_product :
  forall G multG eG invG G1 G2 J K Hfam efamH:set,
  group_structure G multG eG invG ->
  subgroup_of G1 G multG eG invG ->
  subgroup_of G2 G multG eG invG ->
  free_product_of_subgroups G multG eG invG (UPair 0 1)
    (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
    (graph (UPair 0 1) (fun i:set => eG)) ->
  J :/\: K = Empty ->
  free_product_of_subgroups G1 multG eG invG J
    (graph J (fun alpha:set => apply_fun Hfam alpha))
    (graph J (fun alpha:set => apply_fun efamH alpha)) ->
  free_product_of_subgroups G2 multG eG invG K
    (graph K (fun beta:set => apply_fun Hfam beta))
    (graph K (fun beta:set => apply_fun efamH beta)) ->
  free_product_of_subgroups G multG eG invG (J :\/: K) Hfam efamH.
admit.
Admitted.

(** from S68 Thm 68.7 (line 2972 in algtop.tex): quotient of free product **)
(** LATEX VERSION: Let G = G1 free-prod G2. Let N_i be normal in G_i. If N is the least **)
(** normal subgroup of G containing N1 and N2, then G/N iso (G1/N1) free-prod (G2/N2). **)
(** EFFORT: 20 lines textbook, difficulty 6/10, USD 250 **)
(** Bounty 275 **)
Theorem thm68_7_quotient_free_product :
  forall G multG eG invG G1 G2 N1 N2:set,
  free_product_of_subgroups G multG eG invG (UPair 0 1)
    (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
    (graph (UPair 0 1) (fun i:set => eG)) ->
  normal_subgroup N1 G1 multG eG invG ->
  normal_subgroup N2 G2 multG eG invG ->
  let N := least_normal_subgroup G multG eG invG (N1 :\/: N2) in
  exists FP multFP eFP invFP ifam:set,
    external_free_product FP multFP eFP invFP (UPair 0 1)
      (graph (UPair 0 1) (fun i:set =>
        if i = 0 then quotient_group_set G1 multG N1
        else quotient_group_set G2 multG N2))
      (graph (UPair 0 1) (fun i:set =>
        if i = 0 then quotient_group_mult G1 multG N1
        else quotient_group_mult G2 multG N2))
      ifam /\
    exists phi:set,
      group_isomorphism
        (quotient_group_set G multG N) (quotient_group_mult G multG N)
        FP multFP phi.
admit.
Admitted.

(** from S68 Cor 68.8 (line 3006 in algtop.tex): quotient by factor **)
(** LATEX VERSION: If N is the least normal subgroup of G1 free-prod G2 containing G1, **)
(** then (G1 free-prod G2)/N is isomorphic to G2. **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 30 **)
(** Bounty 33 **)
Theorem cor68_8_quotient_by_factor :
  forall G multG eG invG G1 G2:set,
  free_product_of_subgroups G multG eG invG (UPair 0 1)
    (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
    (graph (UPair 0 1) (fun i:set => eG)) ->
  let N := least_normal_subgroup G multG eG invG G1 in
  exists phi:set,
    group_isomorphism
      (quotient_group_set G multG N) (quotient_group_mult G multG N)
      G2 multG phi.
admit.
Admitted.

(** from S68 Lem 68.9 (line 3010 in algtop.tex): generators of least normal subgroup **)
(** LATEX VERSION: If N is the least normal subgroup of G containing S, then N is **)
(** generated by all conjugates of elements of S. **)
(** EFFORT: 8 lines textbook, difficulty 4/10, USD 80 **)
(** Bounty 88 **)
Theorem lemma68_9_least_normal_generated_by_conjugates :
  forall G mult e inv S:set,
  group_structure G mult e inv ->
  S c= G ->
  let N := least_normal_subgroup G mult e inv S in
  let conjugates := Union (Repl G (fun c:set =>
    Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c)))) in
  subgroups_generate N mult e inv
    (Sing conjugates)
    (graph (Sing conjugates) (fun q:set => conjugates)).
admit.
Admitted.

(** Helper: in a free product, mult(a,b) <> e when a in G1\{e} and b in G2\{e} **)
Lemma ex68_2a_ab_ne_e : forall G mult e inv G1 G2 a b:set,
  group_structure G mult e inv ->
  G1 c= G -> G2 c= G ->
  (forall x:set, x :e G1 -> apply_fun inv x :e G1) ->
  (forall x:set, x :e G1 -> x :e G2 -> x = e) ->
  a :e G1 -> a <> e -> b :e G2 -> b <> e ->
  apply_fun mult (a, b) <> e.
let G mult e inv G1 G2 a b.
assume Hgrp HG1sub HG2sub HG1inv Hinter HaG1 Hane HbG2 Hbne.
assume Hab_eq_e : apply_fun mult (a, b) = e.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HaG : a :e G. { exact (HG1sub a HaG1). }
claim HbG : b :e G. { exact (HG2sub b HbG2). }
claim HinvaG1 : apply_fun inv a :e G1. { exact (HG1inv a HaG1). }
claim HinvaG : apply_fun inv a :e G. { exact (HG1sub (apply_fun inv a) HinvaG1). }
claim Hinva_a : apply_fun mult (apply_fun inv a, a) = e.
{ exact (andER
    (apply_fun mult (a, apply_fun inv a) = e)
    (apply_fun mult (apply_fun inv a, a) = e)
    (Hinverse a HaG)). }
claim HidL_b : apply_fun mult (e, b) = b.
{ exact (andEL
    (apply_fun mult (e, b) = b)
    (apply_fun mult (b, e) = b)
    (Hid b HbG)). }
claim HidR_inva : apply_fun mult (apply_fun inv a, e) = apply_fun inv a.
{ exact (andER
    (apply_fun mult (e, apply_fun inv a) = apply_fun inv a)
    (apply_fun mult (apply_fun inv a, e) = apply_fun inv a)
    (Hid (apply_fun inv a) HinvaG)). }
claim Hassoc_step : apply_fun mult (apply_fun mult (apply_fun inv a, a), b)
  = apply_fun mult (apply_fun inv a, apply_fun mult (a, b)).
{ exact (Hassoc (apply_fun inv a) a b HinvaG HaG HbG). }
claim Hlhs : apply_fun mult (apply_fun inv a, apply_fun mult (a, b)) = b.
{ rewrite <- Hassoc_step. rewrite Hinva_a. exact HidL_b. }
claim Hrhs : apply_fun mult (apply_fun inv a, apply_fun mult (a, b))
  = apply_fun inv a.
{ rewrite Hab_eq_e. exact HidR_inva. }
claim Hbeq : b = apply_fun inv a.
{ rewrite <- Hlhs. exact Hrhs. }
claim Hb_in_G1 : b :e G1. { rewrite Hbeq. exact HinvaG1. }
exact (Hbne (Hinter b Hb_in_G1 HbG2)).
Qed.

(** Helper: construct a 2-element reduced word [x,y] and compute its product **)
Lemma ex68_2a_word_helper : forall G mult e inv G1 G2 x y:set,
  group_structure G mult e inv ->
  G1 c= G -> G2 c= G ->
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) alpha ->
      z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) beta ->
      z = e) ->
  x :e G1 -> x <> e -> y :e G2 -> y <> e ->
  let Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2) in
  let efam := graph 2 (fun _:set => e) in
  let xs := graph 2 (fun i:set => If_i (i = 0) x y) in
  reduced_word 2 Gfam efam 2 xs /\
  word_product mult e xs 2 = apply_fun mult (x, y).
let G mult e inv G1 G2 x y.
assume Hgrp HG1sub HG2sub Hinter HxG1 Hxne HyG2 Hyne.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
set xs := graph 2 (fun i:set => If_i (i = 0) x y).
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall u v w:set, u :e G -> v :e G -> w :e G ->
    apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
  (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
  (forall u:set, u :e G ->
    apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim H00 : 0 = 0. { reflexivity. }
claim Hn00 : ~(1 = 0). { exact neq_1_0. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 Hn00). }
claim Hefam0 : apply_fun efam 0 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). }
claim Hefam1 : apply_fun efam 1 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). }
claim Hxs0 : apply_fun xs 0 = x.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) x y) 0 In_0_2).
  exact (If_i_1 (0 = 0) x y H00). }
claim Hxs1 : apply_fun xs 1 = y.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) x y) 1 In_1_2).
  exact (If_i_0 (1 = 0) x y Hn00). }
claim H2omega : 2 :e omega. { exact (nat_p_omega 2 nat_2). }
(** Prove reduced_word **)
claim Hreduced : reduced_word 2 Gfam efam 2 xs.
{
  prove 2 :e omega /\
    (forall i:set, i :e 2 ->
      exists alpha:set, alpha :e 2 /\
        apply_fun xs i :e apply_fun Gfam alpha /\ apply_fun xs i <> apply_fun efam alpha) /\
    (forall i:set, i :e 2 -> ordsucc i :e 2 ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun xs i :e apply_fun Gfam alpha ->
        apply_fun xs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
  apply and3I.
  - exact H2omega.
  - let i. assume Hi : i :e 2.
    apply (cases_2 i Hi
      (fun j:set => exists alpha:set, alpha :e 2 /\
        apply_fun xs j :e apply_fun Gfam alpha /\ apply_fun xs j <> apply_fun efam alpha)).
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun xs 0 :e apply_fun Gfam alpha /\ apply_fun xs 0 <> apply_fun efam alpha.
      witness 0. apply and3I.
      * exact In_0_2.
      * { rewrite Hxs0. rewrite HGfam0. exact HxG1. }
      * { rewrite Hxs0. rewrite Hefam0. exact Hxne. }
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun xs 1 :e apply_fun Gfam alpha /\ apply_fun xs 1 <> apply_fun efam alpha.
      witness 1. apply and3I.
      * exact In_1_2.
      * { rewrite Hxs1. rewrite HGfam1. exact HyG2. }
      * { rewrite Hxs1. rewrite Hefam1. exact Hyne. }
  - let i. assume Hi : i :e 2. assume Hsi : ordsucc i :e 2.
    let alpha beta. assume Halpha : alpha :e 2. assume Hbeta : beta :e 2.
    assume Hxi : apply_fun xs i :e apply_fun Gfam alpha.
    assume Hxsi : apply_fun xs (ordsucc i) :e apply_fun Gfam beta.
    claim Hcase_i0 : ordsucc 0 :e 2 ->
      apply_fun xs 0 :e apply_fun Gfam alpha ->
      apply_fun xs (ordsucc 0) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs0 : ordsucc 0 :e 2.
      assume Hx0a : apply_fun xs 0 :e apply_fun Gfam alpha.
      assume Hx1b : apply_fun xs (ordsucc 0) :e apply_fun Gfam beta.
      claim HxInAlpha : x :e apply_fun Gfam alpha. { rewrite <- Hxs0. exact Hx0a. }
      claim Hx1b_eq : apply_fun xs 1 :e apply_fun Gfam beta.
      { rewrite <- ordsucc_0_eq_1_nat. exact Hx1b. }
      claim HyInBeta : y :e apply_fun Gfam beta. { rewrite <- Hxs1. exact Hx1b_eq. }
      assume Heq : alpha = beta.
      prove False.
      claim HyInAlpha : y :e apply_fun Gfam alpha. { rewrite Heq. exact HyInBeta. }
      claim Hca0 : x :e apply_fun Gfam 0 -> y :e apply_fun Gfam 0 -> False.
      {
        assume HxG10 : x :e apply_fun Gfam 0.
        assume HyG10 : y :e apply_fun Gfam 0.
        claim HyGfam1 : y :e apply_fun Gfam 1. { rewrite HGfam1. exact HyG2. }
        exact (Hyne (Hinter 1 0 In_1_2 In_0_2 neq_1_0 y HyGfam1 HyG10)).
      }
      claim Hca1 : x :e apply_fun Gfam 1 -> y :e apply_fun Gfam 1 -> False.
      {
        assume HxG11 : x :e apply_fun Gfam 1.
        assume HyG11 : y :e apply_fun Gfam 1.
        claim HxGfam0 : x :e apply_fun Gfam 0. { rewrite HGfam0. exact HxG1. }
        exact (Hxne (Hinter 0 1 In_0_2 In_1_2 neq_0_1 x HxGfam0 HxG11)).
      }
      exact (cases_2 alpha Halpha
        (fun a:set => x :e apply_fun Gfam a -> y :e apply_fun Gfam a -> False)
        Hca0 Hca1 HxInAlpha HyInAlpha).
    }
    claim Hcase_i1 : ordsucc 1 :e 2 ->
      apply_fun xs 1 :e apply_fun Gfam alpha ->
      apply_fun xs (ordsucc 1) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs1 : ordsucc 1 :e 2.
      assume Hx1a : apply_fun xs 1 :e apply_fun Gfam alpha.
      assume Hx2b : apply_fun xs (ordsucc 1) :e apply_fun Gfam beta.
      assume Heq : alpha = beta.
      prove False.
      claim H2in2 : 2 :e 2.
      { rewrite <- ordsucc_1_eq_2_nat. exact Hs1. }
      exact (In_irref 2 H2in2).
    }
    exact (cases_2 i Hi
      (fun j:set => ordsucc j :e 2 ->
        apply_fun xs j :e apply_fun Gfam alpha ->
        apply_fun xs (ordsucc j) :e apply_fun Gfam beta -> alpha <> beta)
      Hcase_i0 Hcase_i1 Hsi Hxi Hxsi).
}
(** Prove word_product **)
claim Hprod : word_product mult e xs 2 = apply_fun mult (x, y).
{
  prove nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 2 = apply_fun mult (x, y).
  claim Hstep0 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 0 = e.
  { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs i))). }
  claim Hstep1 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 1
    = apply_fun mult (e, x).
  { rewrite <- ordsucc_0_eq_1_nat.
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xs i)) 0 nat_0).
    rewrite Hstep0. rewrite Hxs0. reflexivity. }
  claim HidLx : apply_fun mult (e, x) = x.
  { exact (andEL (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
  claim Hstep1eq : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 1 = x.
  { rewrite Hstep1. exact HidLx. }
  rewrite <- ordsucc_1_eq_2_nat.
  rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xs i)) 1 nat_1).
  rewrite Hstep1eq. rewrite Hxs1. reflexivity.
}
exact (andI
  (reduced_word 2 Gfam efam 2 xs)
  (word_product mult e xs 2 = apply_fun mult (x, y))
  Hreduced
  Hprod).
Qed.

(** Helper: construct reduced word [y,x] (reversed: G2 element first, G1 element second) **)
Lemma ex68_2a_word_helper_rev : forall G mult e inv G1 G2 x y:set,
  group_structure G mult e inv ->
  G1 c= G -> G2 c= G ->
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) alpha ->
      z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) beta ->
      z = e) ->
  x :e G1 -> x <> e -> y :e G2 -> y <> e ->
  let Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2) in
  let efam := graph 2 (fun _:set => e) in
  let ys := graph 2 (fun i:set => If_i (i = 0) y x) in
  reduced_word 2 Gfam efam 2 ys /\
  word_product mult e ys 2 = apply_fun mult (y, x).
let G mult e inv G1 G2 x y.
assume Hgrp HG1sub HG2sub Hinter HxG1 Hxne HyG2 Hyne.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
set ys := graph 2 (fun i:set => If_i (i = 0) y x).
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall u v w:set, u :e G -> v :e G -> w :e G ->
    apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
  (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
  (forall u:set, u :e G ->
    apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim H00 : 0 = 0. { reflexivity. }
claim Hn00 : ~(1 = 0). { exact neq_1_0. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 Hn00). }
claim Hefam0 : apply_fun efam 0 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). }
claim Hefam1 : apply_fun efam 1 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). }
claim Hys0 : apply_fun ys 0 = y.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) y x) 0 In_0_2).
  exact (If_i_1 (0 = 0) y x H00). }
claim Hys1 : apply_fun ys 1 = x.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) y x) 1 In_1_2).
  exact (If_i_0 (1 = 0) y x Hn00). }
claim H2omega : 2 :e omega. { exact (nat_p_omega 2 nat_2). }
(** Prove reduced_word for [y,x] **)
claim Hreduced : reduced_word 2 Gfam efam 2 ys.
{
  prove 2 :e omega /\
    (forall i:set, i :e 2 ->
      exists alpha:set, alpha :e 2 /\
        apply_fun ys i :e apply_fun Gfam alpha /\ apply_fun ys i <> apply_fun efam alpha) /\
    (forall i:set, i :e 2 -> ordsucc i :e 2 ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun ys i :e apply_fun Gfam alpha ->
        apply_fun ys (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
  apply and3I.
  - exact H2omega.
  - let i. assume Hi : i :e 2.
    apply (cases_2 i Hi
      (fun j:set => exists alpha:set, alpha :e 2 /\
        apply_fun ys j :e apply_fun Gfam alpha /\ apply_fun ys j <> apply_fun efam alpha)).
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun ys 0 :e apply_fun Gfam alpha /\ apply_fun ys 0 <> apply_fun efam alpha.
      witness 1. apply and3I.
      * exact In_1_2.
      * { rewrite Hys0. rewrite HGfam1. exact HyG2. }
      * { rewrite Hys0. rewrite Hefam1. exact Hyne. }
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun ys 1 :e apply_fun Gfam alpha /\ apply_fun ys 1 <> apply_fun efam alpha.
      witness 0. apply and3I.
      * exact In_0_2.
      * { rewrite Hys1. rewrite HGfam0. exact HxG1. }
      * { rewrite Hys1. rewrite Hefam0. exact Hxne. }
  - let i. assume Hi : i :e 2. assume Hsi : ordsucc i :e 2.
    let alpha beta. assume Halpha : alpha :e 2. assume Hbeta : beta :e 2.
    assume Hyi : apply_fun ys i :e apply_fun Gfam alpha.
    assume Hysi : apply_fun ys (ordsucc i) :e apply_fun Gfam beta.
    claim Hcase_i0 : ordsucc 0 :e 2 ->
      apply_fun ys 0 :e apply_fun Gfam alpha ->
      apply_fun ys (ordsucc 0) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs0 : ordsucc 0 :e 2.
      assume Hy0a : apply_fun ys 0 :e apply_fun Gfam alpha.
      assume Hy1b : apply_fun ys (ordsucc 0) :e apply_fun Gfam beta.
      claim HyInAlpha : y :e apply_fun Gfam alpha. { rewrite <- Hys0. exact Hy0a. }
      claim Hy1b_eq : apply_fun ys 1 :e apply_fun Gfam beta.
      { rewrite <- ordsucc_0_eq_1_nat. exact Hy1b. }
      claim HxInBeta : x :e apply_fun Gfam beta. { rewrite <- Hys1. exact Hy1b_eq. }
      assume Heq : alpha = beta.
      prove False.
      claim HxInAlpha : x :e apply_fun Gfam alpha. { rewrite Heq. exact HxInBeta. }
      claim Hca0 : y :e apply_fun Gfam 0 -> x :e apply_fun Gfam 0 -> False.
      {
        assume HyG10 : y :e apply_fun Gfam 0.
        assume HxG10 : x :e apply_fun Gfam 0.
        claim HyGfam1 : y :e apply_fun Gfam 1. { rewrite HGfam1. exact HyG2. }
        exact (Hyne (Hinter 1 0 In_1_2 In_0_2 neq_1_0 y HyGfam1 HyG10)).
      }
      claim Hca1 : y :e apply_fun Gfam 1 -> x :e apply_fun Gfam 1 -> False.
      {
        assume HyG11 : y :e apply_fun Gfam 1.
        assume HxG11 : x :e apply_fun Gfam 1.
        claim HxGfam0 : x :e apply_fun Gfam 0. { rewrite HGfam0. exact HxG1. }
        exact (Hxne (Hinter 0 1 In_0_2 In_1_2 neq_0_1 x HxGfam0 HxG11)).
      }
      exact (cases_2 alpha Halpha
        (fun a:set => y :e apply_fun Gfam a -> x :e apply_fun Gfam a -> False)
        Hca0 Hca1 HyInAlpha HxInAlpha).
    }
    claim Hcase_i1 : ordsucc 1 :e 2 ->
      apply_fun ys 1 :e apply_fun Gfam alpha ->
      apply_fun ys (ordsucc 1) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs1 : ordsucc 1 :e 2.
      assume Hy1a : apply_fun ys 1 :e apply_fun Gfam alpha.
      assume Hy2b : apply_fun ys (ordsucc 1) :e apply_fun Gfam beta.
      assume Heq : alpha = beta.
      prove False.
      claim H2in2 : 2 :e 2.
      { rewrite <- ordsucc_1_eq_2_nat. exact Hs1. }
      exact (In_irref 2 H2in2).
    }
    exact (cases_2 i Hi
      (fun j:set => ordsucc j :e 2 ->
        apply_fun ys j :e apply_fun Gfam alpha ->
        apply_fun ys (ordsucc j) :e apply_fun Gfam beta -> alpha <> beta)
      Hcase_i0 Hcase_i1 Hsi Hyi Hysi).
}
(** Prove word_product for [y,x] **)
claim Hprod : word_product mult e ys 2 = apply_fun mult (y, x).
{
  prove nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 2 = apply_fun mult (y, x).
  claim Hstep0 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 0 = e.
  { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun ys i))). }
  claim Hstep1 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 1
    = apply_fun mult (e, y).
  { rewrite <- ordsucc_0_eq_1_nat.
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun ys i)) 0 nat_0).
    rewrite Hstep0. rewrite Hys0. reflexivity. }
  claim HidLy : apply_fun mult (e, y) = y.
  { exact (andEL (apply_fun mult (e, y) = y) (apply_fun mult (y, e) = y) (Hid y HyG)). }
  claim Hstep1eq : nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 1 = y.
  { rewrite Hstep1. exact HidLy. }
  rewrite <- ordsucc_1_eq_2_nat.
  rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun ys i)) 1 nat_1).
  rewrite Hstep1eq. rewrite Hys1. reflexivity.
}
exact (andI
  (reduced_word 2 Gfam efam 2 ys)
  (word_product mult e ys 2 = apply_fun mult (y, x))
  Hreduced
  Hprod).
Qed.

(** from S68 Exercise 2(a) (line 3025 in algtop.tex) **)
(** LATEX VERSION: Let G = G1 free-product G2 where G1, G2 nontrivial. Then G is not abelian. **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 30 **)
(** Collected Alice 33 **)
(** Proven Alice **)
Theorem ex68_2a_free_product_not_abelian :
  forall G mult e inv G1 G2:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i => if i = 0 then G1 else G2))
    (graph 2 (fun _ => e)) ->
  (exists a:set, a :e G1 /\ a <> e) ->
  (exists b:set, b :e G2 /\ b <> e) ->
  ~(abelian_group G mult e inv).
let G mult e inv G1 G2.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume Hexa : exists a:set, a :e G1 /\ a <> e.
assume Hexb : exists b:set, b :e G2 /\ b <> e.
assume Habel : abelian_group G mult e inv.
prove False.
(** Extract free product components **)
apply (and5E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall x:set, x :e apply_fun Gfam alpha -> x :e apply_fun Gfam beta -> x = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall x:set, x :e G -> x <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = x /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = x ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique.
(** Extract commutativity from abelian **)
claim Hcomm : forall x y:set, x :e G -> y :e G ->
  apply_fun mult (x, y) = apply_fun mult (y, x).
{ exact (andER
    (group_structure G mult e inv)
    (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x))
    Habel). }
(** Extract witnesses a, b **)
apply (exandE_i (fun a:set => a :e G1) (fun a:set => a <> e) Hexa).
let a. assume HaG1 : a :e G1. assume Hane : a <> e.
apply (exandE_i (fun b:set => b :e G2) (fun b:set => b <> e) Hexb).
let b. assume HbG2 : b :e G2. assume Hbne : b <> e.
(** Compute Gfam evaluations **)
claim H00 : 0 = 0. { reflexivity. }
claim Hn00 : ~(1 = 0). { exact neq_1_0. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 Hn00). }
(** Get subgroup properties **)
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E
  (G1 c= G) (e :e G1)
  (forall x y:set, x :e G1 -> y :e G1 -> apply_fun mult (x, y) :e G1)
  (forall x:set, x :e G1 -> apply_fun inv x :e G1)
  HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E
  (G2 c= G) (e :e G2)
  (forall x y:set, x :e G2 -> y :e G2 -> apply_fun mult (x, y) :e G2)
  (forall x:set, x :e G2 -> apply_fun inv x :e G2)
  HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
(** Derive simple intersection property for ab_ne_e helper **)
claim Hinter_simple : forall x:set, x :e G1 -> x :e G2 -> x = e.
{
  let x. assume HxG1 : x :e G1. assume HxG2 : x :e G2.
  claim HxGfam0 : x :e apply_fun Gfam 0. { rewrite HGfam0. exact HxG1. }
  claim HxGfam1 : x :e apply_fun Gfam 1. { rewrite HGfam1. exact HxG2. }
  exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 x HxGfam0 HxGfam1).
}
claim HaG : a :e G. { exact (HG1sub a HaG1). }
claim HbG : b :e G. { exact (HG2sub b HbG2). }
(** mult(a,b) <> e **)
claim Hab_ne_e : apply_fun mult (a, b) <> e.
{ exact (ex68_2a_ab_ne_e G mult e inv G1 G2 a b
    Hgrp HG1sub HG2sub HG1inv Hinter_simple HaG1 Hane HbG2 Hbne). }
(** mult(a,b) :e G **)
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinv.
claim Hab_pair : (a, b) :e setprod G G.
{ exact (tuple_2_setprod_by_pair_Sigma G G a b HaG HbG). }
claim Hab_G : apply_fun mult (a, b) :e G.
{ exact (HmultF (a, b) Hab_pair). }
(** Apply word helpers **)
set xs_ab := graph 2 (fun i:set => If_i (i = 0) a b).
set ys_ba := graph 2 (fun i:set => If_i (i = 0) b a).
claim Hword_ab : reduced_word 2 Gfam efam 2 xs_ab /\
  word_product mult e xs_ab 2 = apply_fun mult (a, b).
{ exact (ex68_2a_word_helper G mult e inv G1 G2 a b
    Hgrp HG1sub HG2sub Hinter HaG1 Hane HbG2 Hbne). }
claim Hred_ab : reduced_word 2 Gfam efam 2 xs_ab.
{ exact (andEL
    (reduced_word 2 Gfam efam 2 xs_ab)
    (word_product mult e xs_ab 2 = apply_fun mult (a, b))
    Hword_ab). }
claim Hprod_ab : word_product mult e xs_ab 2 = apply_fun mult (a, b).
{ exact (andER
    (reduced_word 2 Gfam efam 2 xs_ab)
    (word_product mult e xs_ab 2 = apply_fun mult (a, b))
    Hword_ab). }
claim Hword_ba : reduced_word 2 Gfam efam 2 ys_ba /\
  word_product mult e ys_ba 2 = apply_fun mult (b, a).
{ exact (ex68_2a_word_helper_rev G mult e inv G1 G2 a b
    Hgrp HG1sub HG2sub Hinter HaG1 Hane HbG2 Hbne). }
claim Hred_ba : reduced_word 2 Gfam efam 2 ys_ba.
{ exact (andEL
    (reduced_word 2 Gfam efam 2 ys_ba)
    (word_product mult e ys_ba 2 = apply_fun mult (b, a))
    Hword_ba). }
claim Hprod_ba : word_product mult e ys_ba 2 = apply_fun mult (b, a).
{ exact (andER
    (reduced_word 2 Gfam efam 2 ys_ba)
    (word_product mult e ys_ba 2 = apply_fun mult (b, a))
    Hword_ba). }
(** By commutativity: mult(b,a) = mult(a,b), so word_product ys_ba = mult(a,b) **)
claim Hcomm_ba : apply_fun mult (b, a) = apply_fun mult (a, b).
{ exact (Hcomm b a HbG HaG). }
claim Hprod_ba_eq : word_product mult e ys_ba 2 = apply_fun mult (a, b).
{ rewrite Hprod_ba. exact Hcomm_ba. }
(** Apply uniqueness: extract canonical word and uniqueness clause **)
apply (Hunique (apply_fun mult (a, b)) Hab_G Hab_ne_e).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (a, b) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (a, b) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxs_c_conj :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (a, b) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (a, b) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply (and4E
  (reduced_word 2 Gfam efam n_c xs_c)
  (n_c <> 0)
  (word_product mult e xs_c n_c = apply_fun mult (a, b))
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (a, b) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
  Hxs_c_conj).
assume Hred_c Hnc_ne0 Hprod_c Huniq_clause.
(** Apply uniqueness to [a,b] and [b,a] **)
claim Huniq_ab : n_c = 2 /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i).
{ exact (Huniq_clause 2 xs_ab Hred_ab neq_2_0 Hprod_ab). }
claim Hnc_eq_2 : n_c = 2.
{ exact (andEL (n_c = 2) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i)
    Huniq_ab). }
claim Hxsc_eq_ab : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i.
{ exact (andER (n_c = 2) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i)
    Huniq_ab). }
claim Huniq_ba : n_c = 2 /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ys_ba i).
{ exact (Huniq_clause 2 ys_ba Hred_ba neq_2_0 Hprod_ba_eq). }
claim Hxsc_eq_ba : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ys_ba i.
{ exact (andER (n_c = 2) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ys_ba i)
    Huniq_ba). }
(** Evaluate xs_ab(0) = a and ys_ba(0) = b **)
claim H0_in_nc : 0 :e n_c. { rewrite Hnc_eq_2. exact In_0_2. }
claim Hxsc0_eq_xsab0 : apply_fun xs_c 0 = apply_fun xs_ab 0.
{ exact (Hxsc_eq_ab 0 H0_in_nc). }
claim Hxs_ab_0 : apply_fun xs_ab 0 = a.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) a b) 0 In_0_2).
  exact (If_i_1 (0 = 0) a b H00). }
claim Hxsc0_eq_a : apply_fun xs_c 0 = a.
{ rewrite Hxsc0_eq_xsab0. exact Hxs_ab_0. }
claim Hxsc0_eq_ysba0 : apply_fun xs_c 0 = apply_fun ys_ba 0.
{ exact (Hxsc_eq_ba 0 H0_in_nc). }
claim Hys_ba_0 : apply_fun ys_ba 0 = b.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) b a) 0 In_0_2).
  exact (If_i_1 (0 = 0) b a H00). }
claim Hxsc0_eq_b : apply_fun xs_c 0 = b.
{ rewrite Hxsc0_eq_ysba0. exact Hys_ba_0. }
(** Conclude a = b, then a :e G1 /\ a :e G2, so a = e, contradiction **)
claim Haeqb : a = b.
{ rewrite <- Hxsc0_eq_a. exact Hxsc0_eq_b. }
claim HaG2 : a :e G2.
{ rewrite Haeqb. exact HbG2. }
exact (Hane (Hinter_simple a HaG1 HaG2)).
Qed.

(** from S68 Exercise 2(c) (line 3028 in algtop.tex) **)
(** LATEX VERSION: The only elements of G that have finite order are elements **)
(** of G1 and G2 that have finite order, and their conjugates. **)
(** EFFORT: 8 lines textbook, difficulty 5/10, USD 100 **)
(** Bounty 110 **)
Theorem ex68_2c_finite_order_elements :
  forall G mult e inv G1 G2:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i => if i = 0 then G1 else G2))
    (graph 2 (fun _ => e)) ->
  forall x:set, x :e G ->
    (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e x m = e) ->
    exists c y:set, c :e G /\ (y :e G1 \/ y :e G2) /\
      (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e y m = e) /\
      x = apply_fun mult (apply_fun mult (c, y), apply_fun inv c).
admit.
Admitted.

(** Helper: word_product agrees when sequences agree on indices **)
Theorem word_product_agree : forall mult e xs1 xs2 n:set,
  n :e omega ->
  (forall j:set, j :e n -> apply_fun xs1 j = apply_fun xs2 j) ->
  word_product mult e xs1 n = word_product mult e xs2 n.
let mult e xs1 xs2.
claim Hnat : forall n:set, nat_p n ->
  (forall j:set, j :e n -> apply_fun xs1 j = apply_fun xs2 j) ->
  word_product mult e xs1 n = word_product mult e xs2 n.
{
  apply nat_ind.
  - prove (forall j:set, j :e 0 -> apply_fun xs1 j = apply_fun xs2 j) ->
      word_product mult e xs1 0 = word_product mult e xs2 0.
    assume Hagree.
    claim H1 : word_product mult e xs1 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs1 j))). }
    claim H2 : word_product mult e xs2 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs2 j))). }
    rewrite H1. rewrite H2. reflexivity.
  - let k. assume Hk : nat_p k.
    assume IH : (forall j:set, j :e k -> apply_fun xs1 j = apply_fun xs2 j) ->
      word_product mult e xs1 k = word_product mult e xs2 k.
    prove (forall j:set, j :e ordsucc k -> apply_fun xs1 j = apply_fun xs2 j) ->
      word_product mult e xs1 (ordsucc k) = word_product mult e xs2 (ordsucc k).
    assume Hagree : forall j:set, j :e ordsucc k -> apply_fun xs1 j = apply_fun xs2 j.
    claim Hagree_k : forall j:set, j :e k -> apply_fun xs1 j = apply_fun xs2 j.
    { let j. assume Hjk : j :e k. exact (Hagree j (ordsuccI1 k j Hjk)). }
    claim Hwp_k : word_product mult e xs1 k = word_product mult e xs2 k.
    { exact (IH Hagree_k). }
    claim Hxs_k : apply_fun xs1 k = apply_fun xs2 k.
    { exact (Hagree k (ordsuccI2 k)). }
    claim HS1 : word_product mult e xs1 (ordsucc k) =
      apply_fun mult (word_product mult e xs1 k, apply_fun xs1 k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs1 j)) k Hk). }
    claim HS2 : word_product mult e xs2 (ordsucc k) =
      apply_fun mult (word_product mult e xs2 k, apply_fun xs2 k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs2 j)) k Hk). }
    rewrite HS1. rewrite HS2. rewrite Hwp_k. rewrite Hxs_k. reflexivity.
}
let n. assume Hn : n :e omega.
exact (Hnat n (omega_nat_p n Hn)).
Qed.

(** Helper: word_product of elements in G stays in G **)
Lemma word_product_in_G : forall mult e G n xs:set,
  e :e G ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  n :e omega ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  word_product mult e xs n :e G.
let mult e G.
claim Hnat : forall n:set, nat_p n ->
  forall xs:set,
  e :e G ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  word_product mult e xs n :e G.
{
  apply nat_ind.
  - let xs. assume HeG : e :e G.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hxs : forall i:set, i :e 0 -> apply_fun xs i :e G.
    claim H0 : word_product mult e xs 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs j))). }
    rewrite H0. exact HeG.
  - let k. assume Hk : nat_p k.
    assume IH : forall xs:set,
      e :e G ->
      (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
      (forall i:set, i :e k -> apply_fun xs i :e G) ->
      word_product mult e xs k :e G.
    let xs. assume HeG : e :e G.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hxs : forall i:set, i :e ordsucc k -> apply_fun xs i :e G.
    claim Hxs_k : forall i:set, i :e k -> apply_fun xs i :e G.
    { let i. assume Hik : i :e k. exact (Hxs i (ordsuccI1 k i Hik)). }
    claim Hwp_k : word_product mult e xs k :e G.
    { exact (IH xs HeG Hmcl Hxs_k). }
    claim Hxsk : apply_fun xs k :e G.
    { exact (Hxs k (ordsuccI2 k)). }
    claim HS : word_product mult e xs (ordsucc k) =
      apply_fun mult (word_product mult e xs k, apply_fun xs k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs j)) k Hk). }
    rewrite HS. exact (Hmcl (word_product mult e xs k) (apply_fun xs k) Hwp_k Hxsk).
}
let n xs. assume HeG Hmcl. assume Hn : n :e omega. assume Hxs.
exact (Hnat n (omega_nat_p n Hn) xs HeG Hmcl Hxs).
Qed.

(** Helper: prepending an element g to a word product **)
(** word_product [g, xs(0), ..., xs(n-1)] (ordsucc n) = mult(g, word_product xs n) **)
Lemma word_product_prepend : forall mult e G n xs vs:set,
  e :e G ->
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x) ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z))) ->
  apply_fun vs 0 :e G ->
  n :e omega ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  (forall i:set, i :e n -> apply_fun vs (ordsucc i) = apply_fun xs i) ->
  word_product mult e vs (ordsucc n) = apply_fun mult (apply_fun vs 0, word_product mult e xs n).
let mult e G.
claim Hnat : forall n:set, nat_p n ->
  forall xs vs:set,
  e :e G ->
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x) ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z))) ->
  apply_fun vs 0 :e G ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  (forall i:set, i :e n -> apply_fun vs (ordsucc i) = apply_fun xs i) ->
  word_product mult e vs (ordsucc n) = apply_fun mult (apply_fun vs 0, word_product mult e xs n).
{
  apply nat_ind.
  - (** Base: n = 0 **)
    let xs vs.
    assume HeG : e :e G.
    assume Hid : forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hassoc : forall x y z:set, x :e G -> y :e G -> z :e G ->
      apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)).
    assume Hvs0G : apply_fun vs 0 :e G.
    assume Hxs_mem : forall i:set, i :e 0 -> apply_fun xs i :e G.
    assume Hvs_shift : forall i:set, i :e 0 -> apply_fun vs (ordsucc i) = apply_fun xs i.
    claim Hwp_vs_1 : word_product mult e vs (ordsucc 0) =
      apply_fun mult (word_product mult e vs 0, apply_fun vs 0).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun vs j)) 0 nat_0). }
    claim Hwp_vs_0 : word_product mult e vs 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun vs j))). }
    claim Hwp_xs_0 : word_product mult e xs 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs j))). }
    claim LHS_eq : word_product mult e vs 1 = apply_fun mult (e, apply_fun vs 0).
    { rewrite Hwp_vs_1. rewrite Hwp_vs_0. reflexivity. }
    claim LHS_simp : apply_fun mult (e, apply_fun vs 0) = apply_fun vs 0.
    { exact (andEL
        (apply_fun mult (e, apply_fun vs 0) = apply_fun vs 0)
        (apply_fun mult (apply_fun vs 0, e) = apply_fun vs 0)
        (Hid (apply_fun vs 0) Hvs0G)). }
    claim RHS_simp : apply_fun mult (apply_fun vs 0, e) = apply_fun vs 0.
    { exact (andER
        (apply_fun mult (e, apply_fun vs 0) = apply_fun vs 0)
        (apply_fun mult (apply_fun vs 0, e) = apply_fun vs 0)
        (Hid (apply_fun vs 0) Hvs0G)). }
    rewrite LHS_eq. rewrite LHS_simp. rewrite Hwp_xs_0. rewrite RHS_simp. reflexivity.
  - (** Step: n = ordsucc k, assuming for k **)
    let k. assume Hk : nat_p k.
    assume IH : forall xs vs:set,
      e :e G ->
      (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x) ->
      (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
      (forall x y z:set, x :e G -> y :e G -> z :e G ->
        apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z))) ->
      apply_fun vs 0 :e G ->
      (forall i:set, i :e k -> apply_fun xs i :e G) ->
      (forall i:set, i :e k -> apply_fun vs (ordsucc i) = apply_fun xs i) ->
      word_product mult e vs (ordsucc k) = apply_fun mult (apply_fun vs 0, word_product mult e xs k).
    let xs vs.
    assume HeG : e :e G.
    assume Hid : forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hassoc : forall x y z:set, x :e G -> y :e G -> z :e G ->
      apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)).
    assume Hvs0G : apply_fun vs 0 :e G.
    assume Hxs_mem : forall i:set, i :e ordsucc k -> apply_fun xs i :e G.
    assume Hvs_shift : forall i:set, i :e ordsucc k -> apply_fun vs (ordsucc i) = apply_fun xs i.
    claim Hxs_k : forall i:set, i :e k -> apply_fun xs i :e G.
    { let i. assume Hik : i :e k. exact (Hxs_mem i (ordsuccI1 k i Hik)). }
    claim Hvs_k : forall i:set, i :e k -> apply_fun vs (ordsucc i) = apply_fun xs i.
    { let i. assume Hik : i :e k. exact (Hvs_shift i (ordsuccI1 k i Hik)). }
    claim Hwp_vs_sk : word_product mult e vs (ordsucc k) =
      apply_fun mult (apply_fun vs 0, word_product mult e xs k).
    { exact (IH xs vs HeG Hid Hmcl Hassoc Hvs0G Hxs_k Hvs_k). }
    claim Hwp_vs_ssk_step : word_product mult e vs (ordsucc (ordsucc k)) =
      apply_fun mult (word_product mult e vs (ordsucc k), apply_fun vs (ordsucc k)).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun vs j))
        (ordsucc k) (nat_ordsucc k Hk)). }
    claim Hvs_sk_eq : apply_fun vs (ordsucc k) = apply_fun xs k.
    { exact (Hvs_shift k (ordsuccI2 k)). }
    claim Hxsk_G : apply_fun xs k :e G.
    { exact (Hxs_mem k (ordsuccI2 k)). }
    claim Hwp_xs_k_G : word_product mult e xs k :e G.
    { exact (word_product_in_G mult e G k xs HeG Hmcl (nat_p_omega k Hk) Hxs_k). }
    claim Hvs0_wp_G : apply_fun mult (apply_fun vs 0, word_product mult e xs k) :e G.
    { exact (Hmcl (apply_fun vs 0) (word_product mult e xs k) Hvs0G Hwp_xs_k_G). }
    claim Hassoc_step :
      apply_fun mult (apply_fun mult (apply_fun vs 0, word_product mult e xs k), apply_fun xs k) =
      apply_fun mult (apply_fun vs 0, apply_fun mult (word_product mult e xs k, apply_fun xs k)).
    { exact (Hassoc (apply_fun vs 0) (word_product mult e xs k) (apply_fun xs k)
        Hvs0G Hwp_xs_k_G Hxsk_G). }
    claim Hwp_xs_sk_step : word_product mult e xs (ordsucc k) =
      apply_fun mult (word_product mult e xs k, apply_fun xs k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs j)) k Hk). }
    rewrite Hwp_vs_ssk_step. rewrite Hvs_sk_eq. rewrite Hwp_vs_sk.
    rewrite Hassoc_step. rewrite Hwp_xs_sk_step. reflexivity.
}
let n xs vs. assume HeG Hid Hmcl Hassoc Hvs0G. assume Hn : n :e omega.
assume Hxs_mem Hvs_shift.
exact (Hnat n (omega_nat_p n Hn) xs vs HeG Hid Hmcl Hassoc Hvs0G Hxs_mem Hvs_shift).
Qed.

(** Sub-sub-helper: Case last entry G2, first entry G1 **)
(** Strategy: Build vs = [y, cs(0), ..., cs(k)] for yc = cx.
    Uniqueness: entry 0 of canonical = cs(0) (from ws) = y (from vs).
    cs(0) in G1 cap G2 = e, contradiction. **)
Lemma ex68_3_case_G2_first_G1 : forall G mult e inv G1 G2 c x m cs k ws:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G2 ->
  apply_fun cs 0 :e G1 -> apply_fun cs 0 <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) (ordsucc m) ws ->
  word_product mult e ws (ordsucc m) = apply_fun mult (c, x) ->
  apply_fun ws 0 = apply_fun cs 0 ->
  False.
let G mult e inv G1 G2 c x m cs k ws.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
assume HyG2 : y :e G2. assume Hyne : y <> e.
assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G2 : apply_fun cs k :e G2.
assume Hcs0_G1 : apply_fun cs 0 :e G1.
assume Hcs0_ne_e : apply_fun cs 0 <> e.
assume Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
assume Hwp_cx : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
assume Hws0 : apply_fun ws 0 = apply_fun cs 0.
(** Extract free product components **)
apply (and5E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim Hinter_simple : forall z:set, z :e G1 -> z :e G2 -> z = e.
{ let z. assume HzG1 : z :e G1. assume HzG2 : z :e G2.
  claim HzGfam0 : z :e apply_fun Gfam 0. { rewrite HGfam0. exact HzG1. }
  claim HzGfam1 : z :e apply_fun Gfam 1. { rewrite HGfam1. exact HzG2. }
  exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 z HzGfam0 HzGfam1). }
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
(** Extract reduced word components early (need Hm_omega for Hm_nat) **)
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
(** Key memberships **)
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (HmultF (c, x) (tuple_2_setprod_by_pair_Sigma G G c x HcG HxG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hmult_cl : forall a1 b1:set, a1 :e G -> b1 :e G -> apply_fun mult (a1, b1) :e G.
{ let a1 b1. assume Ha1 : a1 :e G. assume Hb1 : b1 :e G.
  exact (HmultF (a1, b1) (tuple_2_setprod_by_pair_Sigma G G a1 b1 Ha1 Hb1)). }
(** Derive cx = yc **)
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e)
    (Hinverse c HcG)). }
claim Hcx_e : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_e. }
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
(** Construct vs = [y, cs(0), ..., cs(k)] using Union trick for predecessor **)
set vs := graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Union i))).
claim Hvs_0 : apply_fun vs 0 = y.
{ claim H0_sm : 0 :e ordsucc m. { exact (nat_0_in_ordsucc m Hm_nat). }
  rewrite (apply_fun_graph (ordsucc m)
    (fun i:set => If_i (i = 0) y (apply_fun cs (Union i))) 0 H0_sm).
  exact (If_i_1 (0 = 0) y (apply_fun cs (Union 0)) H00). }
claim Hvs_shift : forall j:set, j :e m -> apply_fun vs (ordsucc j) = apply_fun cs j.
{ let j. assume Hjm : j :e m.
  claim Hj_nat : nat_p j.
  { exact (omega_nat_p j (omega_TransSet m Hm_omega j Hjm)). }
  claim Hsj_sm : ordsucc j :e ordsucc m.
  { exact (nat_ordsucc_in_ordsucc m Hm_nat j Hjm). }
  rewrite (apply_fun_graph (ordsucc m)
    (fun i:set => If_i (i = 0) y (apply_fun cs (Union i))) (ordsucc j) Hsj_sm).
  claim Hsj_ne0 : ordsucc j <> 0. { exact (neq_ordsucc_0 j). }
  rewrite (If_i_0 (ordsucc j = 0) y (apply_fun cs (Union (ordsucc j))) Hsj_ne0).
  claim Hunion_sj : Union (ordsucc j) = j.
  { exact (Union_ordsucc_eq j Hj_nat). }
  rewrite Hunion_sj. reflexivity. }
(** Show vs is reduced: membership **)
claim Hvs_mem : forall i:set, i :e ordsucc m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun vs i :e apply_fun Gfam alpha /\
    apply_fun vs i <> apply_fun efam alpha.
{ let i. assume Hi : i :e ordsucc m.
  apply (xm (i = 0)).
  - assume Hi0 : i = 0.
    rewrite Hi0. rewrite Hvs_0.
    witness 1. apply and3I.
    + exact In_1_2.
    + rewrite HGfam1. exact HyG2.
    + rewrite Hefam1. exact Hyne.
  - assume Hi_ne0 : i <> 0.
    claim Hi_nat : nat_p i.
    { exact (omega_nat_p i (omega_TransSet (ordsucc m) Hsm_omega i Hi)). }
    apply (nat_inv i Hi_nat).
    + assume Habs : i = 0. exact (Hi_ne0 Habs (exists alpha:set, alpha :e 2 /\
        apply_fun vs i :e apply_fun Gfam alpha /\
        apply_fun vs i <> apply_fun efam alpha)).
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hjconj : nat_p j /\ i = ordsucc j.
      claim Hi_eq_sj : i = ordsucc j.
      { exact (andER (nat_p j) (i = ordsucc j) Hjconj). }
      claim Hsj_sm : ordsucc j :e ordsucc m. { rewrite <- Hi_eq_sj. exact Hi. }
      claim Hjm : j :e m.
      { apply (ordsuccE m (ordsucc j) Hsj_sm).
        * assume Hsjm : ordsucc j :e m.
          exact (nat_trans m Hm_nat (ordsucc j) Hsjm j (ordsuccI2 j)).
        * assume Hsjeqm : ordsucc j = m.
          claim Hsj_sk : ordsucc j = ordsucc k. { rewrite Hsjeqm. exact Hm_eq. }
          claim Hjeqk : j = k. { exact (ordsucc_inj j k Hsj_sk). }
          rewrite Hjeqk. rewrite Hm_eq. exact (ordsuccI2 k). }
      claim Hvsi_eq : apply_fun vs i = apply_fun cs j.
      { rewrite Hi_eq_sj. exact (Hvs_shift j Hjm). }
      rewrite Hvsi_eq. exact (Hcs_mem j Hjm). }
(** Show vs is reduced: adjacency **)
claim Hvs_adj : forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun vs i :e apply_fun Gfam alpha ->
    apply_fun vs (ordsucc i) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let i. assume Hi : i :e ordsucc m. assume Hsi : ordsucc i :e ordsucc m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hvsi_al : apply_fun vs i :e apply_fun Gfam alpha.
  assume Hvssi_be : apply_fun vs (ordsucc i) :e apply_fun Gfam beta.
  apply (xm (i = 0)).
  - assume Hi0 : i = 0.
    (** vs(0) = y in G2 (factor 1), vs(1) = cs(0) in G1 (factor 0) **)
    claim Hvsi_eq_y : apply_fun vs i = y.
    { rewrite Hi0. exact Hvs_0. }
    claim Hvs0_al : y :e apply_fun Gfam alpha.
    { rewrite <- Hvsi_eq_y. exact Hvsi_al. }
    claim Hvssi_eq_cs0 : apply_fun vs (ordsucc i) = apply_fun cs 0.
    { rewrite Hi0. exact (Hvs_shift 0 H0_in_m). }
    claim Hvs1_be : apply_fun cs 0 :e apply_fun Gfam beta.
    { rewrite <- Hvssi_eq_cs0. exact Hvssi_be. }
    assume Haleqbe : alpha = beta.
    apply (xm (alpha = 1)).
    + assume Hal1 : alpha = 1.
      claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
      claim HGfam_be : apply_fun Gfam beta = G2. { rewrite Hbe1. exact HGfam1. }
      claim Hcs0_G2' : apply_fun cs 0 :e G2. { rewrite <- HGfam_be. exact Hvs1_be. }
      exact (Hcs0_ne_e (Hinter_simple (apply_fun cs 0) Hcs0_G1 Hcs0_G2')).
    + assume Hal_ne1 : alpha <> 1.
      claim Hal0 : alpha = 0.
      { apply (ordsuccE 1 alpha Hal2).
        * assume H : alpha :e 1. apply (ordsuccE 0 alpha H).
          { assume H2 : alpha :e 0. exact (EmptyE alpha H2 (alpha = 0)). }
          assume H2 : alpha = 0. exact H2.
        * assume H : alpha = 1. exact (Hal_ne1 H (alpha = 0)). }
      claim HGfam_al : apply_fun Gfam alpha = G1. { rewrite Hal0. exact HGfam0. }
      claim Hy_G1 : y :e G1. { rewrite <- HGfam_al. exact Hvs0_al. }
      exact (Hyne (Hinter_simple y Hy_G1 HyG2)).
  - assume Hi_ne0 : i <> 0.
    (** Both i and ordsucc i correspond to cs entries **)
    claim Hi_nat : nat_p i.
    { exact (omega_nat_p i (omega_TransSet (ordsucc m) Hsm_omega i Hi)). }
    apply (nat_inv i Hi_nat).
    + assume Habs : i = 0. exact (Hi_ne0 Habs (alpha <> beta)).
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hjconj : nat_p j /\ i = ordsucc j.
      claim Hi_eq_sj : i = ordsucc j.
      { exact (andER (nat_p j) (i = ordsucc j) Hjconj). }
      claim Hsj_sm : ordsucc j :e ordsucc m. { rewrite <- Hi_eq_sj. exact Hi. }
      claim Hjm : j :e m.
      { apply (ordsuccE m (ordsucc j) Hsj_sm).
        * assume Hsjm : ordsucc j :e m.
          exact (nat_trans m Hm_nat (ordsucc j) Hsjm j (ordsuccI2 j)).
        * assume Hsjeqm : ordsucc j = m.
          claim Hsj_sk : ordsucc j = ordsucc k. { rewrite Hsjeqm. exact Hm_eq. }
          claim Hjeqk : j = k. { exact (ordsucc_inj j k Hsj_sk). }
          rewrite Hjeqk. rewrite Hm_eq. exact (ordsuccI2 k). }
      claim Hssj_sm : ordsucc (ordsucc j) :e ordsucc m. { rewrite <- Hi_eq_sj. exact Hsi. }
      claim Hsjm : ordsucc j :e m.
      { apply (ordsuccE m (ordsucc (ordsucc j)) Hssj_sm).
        * assume H : ordsucc (ordsucc j) :e m.
          exact (nat_trans m Hm_nat (ordsucc (ordsucc j)) H (ordsucc j) (ordsuccI2 (ordsucc j))).
        * assume H : ordsucc (ordsucc j) = m.
          claim Hssj_sk : ordsucc (ordsucc j) = ordsucc k. { rewrite H. exact Hm_eq. }
          claim Hsjk : ordsucc j = k. { exact (ordsucc_inj (ordsucc j) k Hssj_sk). }
          rewrite Hsjk. rewrite Hm_eq. exact (ordsuccI2 k). }
      claim Hvsi_csj : apply_fun vs i = apply_fun cs j.
      { rewrite Hi_eq_sj. exact (Hvs_shift j Hjm). }
      claim Hvssi_cssj : apply_fun vs (ordsucc i) = apply_fun cs (ordsucc j).
      { rewrite Hi_eq_sj. exact (Hvs_shift (ordsucc j) Hsjm). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { rewrite <- Hvsi_csj. exact Hvsi_al. }
      claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      { rewrite <- Hvssi_cssj. exact Hvssi_be. }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
claim Hvs_red : reduced_word 2 Gfam efam (ordsucc m) vs.
{ prove (ordsucc m :e omega /\
    (forall i:set, i :e ordsucc m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun vs i :e apply_fun Gfam alpha /\
        apply_fun vs i <> apply_fun efam alpha)) /\
    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun vs i :e apply_fun Gfam alpha ->
        apply_fun vs (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hsm_omega.
    + exact Hvs_mem.
  - exact Hvs_adj. }
(** Word product of vs = mult(y, c) = yc = cx **)
claim Hvs_all_G : forall i:set, i :e m -> apply_fun cs i :e G.
{ let i. assume Him : i :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs i :e apply_fun Gfam al)
    (fun al:set => apply_fun cs i <> apply_fun efam al) (Hcs_mem i Him)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs i :e apply_fun Gfam al.
  assume Hne : apply_fun cs i <> apply_fun efam al.
  claim Hal2' : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs i :e apply_fun Gfam al) Hal_conj). }
  claim Hcsi_fam : apply_fun cs i :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs i :e apply_fun Gfam al) Hal_conj). }
  apply (xm (al = 0)).
  - assume Hal0 : al = 0.
    claim Hcsi_G1 : apply_fun cs i :e G1.
    { claim Hfam0 : apply_fun Gfam al = G1. { rewrite Hal0. exact HGfam0. }
      rewrite <- Hfam0. exact Hcsi_fam. }
    exact (HG1sub (apply_fun cs i) Hcsi_G1).
  - assume Hal_ne0 : al <> 0.
    claim Hal1 : al = 1.
    { apply (ordsuccE 1 al Hal2').
      * assume H : al :e 1. apply (ordsuccE 0 al H).
        { assume H2 : al :e 0. exact (EmptyE al H2 (al = 1)). }
        assume H2 : al = 0. exact (Hal_ne0 H2 (al = 1)).
      * assume H : al = 1. exact H. }
    claim Hcsi_G2 : apply_fun cs i :e G2.
    { claim Hfam1 : apply_fun Gfam al = G2. { rewrite Hal1. exact HGfam1. }
      rewrite <- Hfam1. exact Hcsi_fam. }
    exact (HG2sub (apply_fun cs i) Hcsi_G2). }
claim Hvs0_G : apply_fun vs 0 :e G.
{ rewrite Hvs_0. exact HyG. }
claim Hwp_vs : word_product mult e vs (ordsucc m) =
  apply_fun mult (apply_fun vs 0, word_product mult e cs m).
{ exact (word_product_prepend mult e G m cs vs HeG Hid Hmult_cl Hassoc
    Hvs0_G Hm_omega Hvs_all_G Hvs_shift). }
claim Hwp_vs_eq : word_product mult e vs (ordsucc m) = apply_fun mult (y, c).
{ rewrite Hwp_vs. rewrite Hvs_0. rewrite Hprod. reflexivity. }
claim Hwp_vs_cx : word_product mult e vs (ordsucc m) = apply_fun mult (c, x).
{ rewrite Hwp_vs_eq. symmetry. exact Hcx_eq_yc. }
(** Apply uniqueness to cx **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxsc_all :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
claim Huniq_clause : forall n' xs':set,
  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
  word_product mult e xs' n' = apply_fun mult (c, x) ->
  n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i).
{ exact (andER
    ((reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0) /\ word_product mult e xs_c n_c = apply_fun mult (c, x))
    (forall n' xs':set,
      reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = apply_fun mult (c, x) ->
      n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
    Hxsc_all). }
claim Hsm_ne0 : ordsucc m <> 0. { exact (neq_ordsucc_0 m). }
claim Huniq_ws : n_c = ordsucc m /\
  (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i).
{ exact (Huniq_clause (ordsucc m) ws Hws_red Hsm_ne0 Hwp_cx). }
claim Huniq_vs : n_c = ordsucc m /\
  (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun vs i).
{ exact (Huniq_clause (ordsucc m) vs Hvs_red Hsm_ne0 Hwp_vs_cx). }
claim Hnc_sm : n_c = ordsucc m.
{ exact (andEL (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i) Huniq_ws). }
claim H0_in_nc : 0 :e n_c. { rewrite Hnc_sm. exact (nat_0_in_ordsucc m Hm_nat). }
claim Hxsc0_ws : apply_fun xs_c 0 = apply_fun ws 0.
{ exact ((andER (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i) Huniq_ws) 0 H0_in_nc). }
claim Hxsc0_vs : apply_fun xs_c 0 = apply_fun vs 0.
{ exact ((andER (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun vs i) Huniq_vs) 0 H0_in_nc). }
claim Hcs0_eq_y : apply_fun cs 0 = y.
{ rewrite <- Hws0. rewrite <- Hxsc0_ws. rewrite Hxsc0_vs. exact Hvs_0. }
claim Hcs0_G2' : apply_fun cs 0 :e G2.
{ rewrite Hcs0_eq_y. exact HyG2. }
exact (Hcs0_ne_e (Hinter_simple (apply_fun cs 0) Hcs0_G1 Hcs0_G2')).
Qed.

(** Sub-sub-helper: Case last G2, first G2 (merge argument) **)
(** Strategy: Merge y and cs(0) since both in G2. Get reduced word for cx
    of length m (or less), contradicting ws of length ordsucc m via uniqueness. **)
Lemma ex68_3_case_G2_first_G2 : forall G mult e inv G1 G2 c x m cs k ws:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G2 ->
  apply_fun cs 0 :e G2 ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) (ordsucc m) ws ->
  word_product mult e ws (ordsucc m) = apply_fun mult (c, x) ->
  False.
let G mult e inv G1 G2 c x m cs k ws.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G2 : apply_fun cs k :e G2.
assume Hcs0_G2 : apply_fun cs 0 :e G2.
assume Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
assume Hwp_cx : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
prove False.
(** Extract free product components **)
apply (and5E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim Hmult_cl : forall x1 y1:set, x1 :e G -> y1 :e G -> apply_fun mult (x1, y1) :e G.
{ let x1 y1. assume Hx1 : x1 :e G. assume Hy1 : y1 :e G.
  exact (HmultF (x1, y1) (tuple_2_setprod_by_pair_Sigma G G x1 y1 Hx1 Hy1)). }
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HcxG : apply_fun mult (c, x) :e G. { exact (Hmult_cl c x HcG HxG). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
claim Hcs0_G : apply_fun cs 0 :e G. { exact (HG2sub (apply_fun cs 0) Hcs0_G2). }
(** Derive cx = yc **)
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ claim H1 : apply_fun mult (apply_fun inv c, c) = e.
  { exact (andER (apply_fun mult (c, apply_fun inv c) = e)
      (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
  claim H2 : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
  { exact (andER (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
      (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
      (Hid (apply_fun mult (c, x)) HcxG)). }
  rewrite (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG).
  rewrite H1. symmetry. exact H2. }
(** Define ycs0 and tail **)
set ycs0 := apply_fun mult (y, (apply_fun cs 0)).
claim Hycs0_G2 : ycs0 :e G2. { exact (HG2mult y (apply_fun cs 0) HyG2 Hcs0_G2). }
claim Hycs0_G : ycs0 :e G. { exact (HG2sub ycs0 Hycs0_G2). }
set tail_cs := graph k (fun i:set => apply_fun cs (ordsucc i)).
claim Htail_shift : forall i:set, i :e k ->
  apply_fun tail_cs i = apply_fun cs (ordsucc i).
{ let i. assume Hik : i :e k.
  exact (apply_fun_graph k (fun i:set => apply_fun cs (ordsucc i)) i Hik). }
claim Hcs_to_tail : forall i:set, i :e k ->
  apply_fun cs (ordsucc i) = apply_fun tail_cs i.
{ let i. assume Hik. symmetry. exact (Htail_shift i Hik). }
claim Htail_G : forall i:set, i :e k -> apply_fun tail_cs i :e G.
{ let i. assume Hik : i :e k.
  rewrite (Htail_shift i Hik).
  claim Hsi_m : ordsucc i :e m. { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs (ordsucc i) :e apply_fun Gfam al)
    (fun al:set => apply_fun cs (ordsucc i) <> apply_fun efam al)
    (Hcs_mem (ordsucc i) Hsi_m)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs (ordsucc i) :e apply_fun Gfam al.
  assume Hne_efam : apply_fun cs (ordsucc i) <> apply_fun efam al.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs (ordsucc i) :e apply_fun Gfam al) Hal_conj). }
  claim Hcsi_fam : apply_fun cs (ordsucc i) :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs (ordsucc i) :e apply_fun Gfam al) Hal_conj). }
  apply (xm (al = 0)).
  - assume Hal0 : al = 0.
    claim Hcsi_G1 : apply_fun cs (ordsucc i) :e G1.
    { claim Hfam0 : apply_fun Gfam al = G1. { rewrite Hal0. exact HGfam0. }
      rewrite <- Hfam0. exact Hcsi_fam. }
    exact (HG1sub (apply_fun cs (ordsucc i)) Hcsi_G1).
  - assume Hal_ne0 : al <> 0.
    claim Hal1 : al = 1.
    { apply (ordsuccE 1 al Hal2).
      { assume H : al :e 1. apply (ordsuccE 0 al H).
        { assume H2 : al :e 0. exact (EmptyE al H2 (al = 1)). }
        assume H2 : al = 0. exact (Hal_ne0 H2 (al = 1)). }
      assume H : al = 1. exact H. }
    claim Hcsi_G2 : apply_fun cs (ordsucc i) :e G2.
    { claim Hfam1 : apply_fun Gfam al = G2. { rewrite Hal1. exact HGfam1. }
      rewrite <- Hfam1. exact Hcsi_fam. }
    exact (HG2sub (apply_fun cs (ordsucc i)) Hcsi_G2). }
(** Decompose c = mult(cs(0), word_product tail_cs k) via word_product_prepend **)
claim Hwp_prepend : word_product mult e cs (ordsucc k) =
  apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k).
{ exact (word_product_prepend mult e G k tail_cs cs HeG Hid Hmult_cl Hassoc
    Hcs0_G (nat_p_omega k Hk_nat) Htail_G Hcs_to_tail). }
claim Hwp_tail_G : word_product mult e tail_cs k :e G.
{ exact (word_product_in_G mult e G k tail_cs HeG Hmult_cl (nat_p_omega k Hk_nat) Htail_G). }
(** Forward chain: cx = yc = mult(y, c) = mult(y, mult(cs0, wpt))
    = mult(mult(y,cs0), wpt) = mult(ycs0, wpt) **)
(** Step: c = mult(cs0, wpt) via c = wp cs m = wp cs (ordsucc k) = mult(cs0, wpt) **)
claim Hc_eq_wp : c = word_product mult e cs m. { symmetry. exact Hprod. }
claim Hwp_m_sk : word_product mult e cs m = word_product mult e cs (ordsucc k).
{ rewrite Hm_eq. reflexivity. }
claim Hc_eq_wpsk : c = word_product mult e cs (ordsucc k).
{ exact (eq_i_tra c (word_product mult e cs m) (word_product mult e cs (ordsucc k))
    Hc_eq_wp Hwp_m_sk). }
claim Hc_eq_decomp : c = apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k).
{ exact (eq_i_tra c (word_product mult e cs (ordsucc k))
    (apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k))
    Hc_eq_wpsk Hwp_prepend). }
(** Step: mult(y,c) = mult(y, mult(cs0, wpt)) **)
claim Hyc_step : apply_fun mult (y, c) =
  apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)).
{ rewrite <- Hc_eq_decomp. reflexivity. }
(** Step: mult(y, mult(cs0, wpt)) = mult(mult(y,cs0), wpt) via assoc reversed **)
claim Hassoc_sym :
  apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)) =
  apply_fun mult (apply_fun mult (y, apply_fun cs 0), word_product mult e tail_cs k).
{ symmetry. exact (Hassoc y (apply_fun cs 0) (word_product mult e tail_cs k)
    HyG Hcs0_G Hwp_tail_G). }
(** Chain: mult(y,c) = mult(mult(y,cs0), wpt) = mult(ycs0, wpt) **)
claim Hyc_merge : apply_fun mult (y, c) = apply_fun mult (ycs0, word_product mult e tail_cs k).
{ exact (eq_i_tra
    (apply_fun mult (y, c))
    (apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)))
    (apply_fun mult (apply_fun mult (y, apply_fun cs 0), word_product mult e tail_cs k))
    Hyc_step Hassoc_sym). }
(** Chain: cx = yc = mult(ycs0, wpt) **)
claim Hcx_merge : apply_fun mult (c, x) = apply_fun mult (ycs0, word_product mult e tail_cs k).
{ exact (eq_i_tra (apply_fun mult (c, x)) (apply_fun mult (y, c))
    (apply_fun mult (ycs0, word_product mult e tail_cs k))
    Hcx_eq_yc Hyc_merge). }
(** Apply uniqueness to cx, derive n_c = ordsucc m from ws **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxsc_all :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
claim Huniq_clause : forall n' xs':set,
  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
  word_product mult e xs' n' = apply_fun mult (c, x) ->
  n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i).
{ exact (andER
    ((reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0) /\ word_product mult e xs_c n_c = apply_fun mult (c, x))
    (forall n' xs':set,
      reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = apply_fun mult (c, x) ->
      n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
    Hxsc_all). }
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
claim Hnc_sm : n_c = ordsucc m.
{ exact (andEL (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i)
    (Huniq_clause (ordsucc m) ws Hws_red (neq_ordsucc_0 m) Hwp_cx)). }
(** Case split on ycs0 = e **)
apply (xm (ycs0 = e)).
- assume Hycs0_e : ycs0 = e.
  (** cx = mult(ycs0, wpt) = mult(e, wpt) = wpt **)
  claim Hcx_ycs0_wpt : apply_fun mult (c, x) =
    apply_fun mult (ycs0, word_product mult e tail_cs k).
  { exact Hcx_merge. }
  claim Hycs0_e_merge : apply_fun mult (ycs0, word_product mult e tail_cs k) =
    apply_fun mult (e, word_product mult e tail_cs k).
  { rewrite Hycs0_e. reflexivity. }
  claim Hid_wpt : apply_fun mult (e, word_product mult e tail_cs k) =
    word_product mult e tail_cs k.
  { exact (andEL
      (apply_fun mult (e, word_product mult e tail_cs k) = word_product mult e tail_cs k)
      (apply_fun mult (word_product mult e tail_cs k, e) = word_product mult e tail_cs k)
      (Hid (word_product mult e tail_cs k) Hwp_tail_G)). }
  claim Hcx_tail : apply_fun mult (c, x) = word_product mult e tail_cs k.
  { exact (eq_i_tra (apply_fun mult (c, x))
      (apply_fun mult (ycs0, word_product mult e tail_cs k))
      (word_product mult e tail_cs k)
      Hcx_ycs0_wpt
      (eq_i_tra
        (apply_fun mult (ycs0, word_product mult e tail_cs k))
        (apply_fun mult (e, word_product mult e tail_cs k))
        (word_product mult e tail_cs k)
        Hycs0_e_merge Hid_wpt)). }
  apply (xm (k = 0)).
  + assume Hk0 : k = 0.
    (** cx = word_product tail_cs k = word_product tail_cs 0 = e **)
    claim Hwpt_k0 : word_product mult e tail_cs k = word_product mult e tail_cs 0.
    { rewrite Hk0. reflexivity. }
    claim Hwpt_0_e : word_product mult e tail_cs 0 = e.
    { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun tail_cs i))). }
    claim Hwpt_ke : word_product mult e tail_cs k = e.
    { exact (eq_i_tra (word_product mult e tail_cs k) (word_product mult e tail_cs 0) e
        Hwpt_k0 Hwpt_0_e). }
    claim Hcx_e : apply_fun mult (c, x) = e.
    { exact (eq_i_tra (apply_fun mult (c, x)) (word_product mult e tail_cs k) e
        Hcx_tail Hwpt_ke). }
    exact (Hcxne Hcx_e).
  + assume Hk_ne0 : k <> 0.
    (** tail_cs is reduced of length k **)
    claim Htail_mem : forall i:set, i :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun tail_cs i :e apply_fun Gfam alpha /\
        apply_fun tail_cs i <> apply_fun efam alpha.
    { let i. assume Hik : i :e k.
      rewrite (Htail_shift i Hik).
      claim Hsi_m : ordsucc i :e m.
      { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
      exact (Hcs_mem (ordsucc i) Hsi_m). }
    claim Htail_adj : forall i:set, i :e k -> ordsucc i :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun tail_cs i :e apply_fun Gfam alpha ->
        apply_fun tail_cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta.
    { let i. assume Hik : i :e k. assume Hsik : ordsucc i :e k.
      let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
      rewrite (Htail_shift i Hik). rewrite (Htail_shift (ordsucc i) Hsik).
      assume Hcsi_al : apply_fun cs (ordsucc i) :e apply_fun Gfam alpha.
      assume Hcssi_be : apply_fun cs (ordsucc (ordsucc i)) :e apply_fun Gfam beta.
      claim Hsi_m : ordsucc i :e m.
      { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
      claim Hssi_m : ordsucc (ordsucc i) :e m.
      { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat (ordsucc i) Hsik). }
      exact (Hcs_adj (ordsucc i) Hsi_m Hssi_m alpha beta Hal2 Hbe2 Hcsi_al Hcssi_be). }
    claim Htail_red : reduced_word 2 Gfam efam k tail_cs.
    { prove (k :e omega /\
        (forall i:set, i :e k ->
          exists alpha:set, alpha :e 2 /\
            apply_fun tail_cs i :e apply_fun Gfam alpha /\
            apply_fun tail_cs i <> apply_fun efam alpha)) /\
        (forall i:set, i :e k -> ordsucc i :e k ->
          forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
            apply_fun tail_cs i :e apply_fun Gfam alpha ->
            apply_fun tail_cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
      apply andI.
      - apply andI.
        + exact (nat_p_omega k Hk_nat).
        + exact Htail_mem.
      - exact Htail_adj. }
    (** Length contradiction: n_c = ordsucc m and n_c = k **)
    claim Hcx_tail_rev : word_product mult e tail_cs k = apply_fun mult (c, x).
    { symmetry. exact Hcx_tail. }
    claim Hnc_k : n_c = k.
    { exact (andEL (n_c = k)
        (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun tail_cs i)
        (Huniq_clause k tail_cs Htail_red Hk_ne0 Hcx_tail_rev)). }
    claim Hnc_sm_rev : ordsucc m = n_c. { symmetry. exact Hnc_sm. }
    claim Hsm_eq_k : ordsucc m = k.
    { exact (eq_i_tra (ordsucc m) n_c k Hnc_sm_rev Hnc_k). }
    claim Hsk_eq_k : ordsucc (ordsucc k) = k.
    { claim Hord_sm : ordsucc (ordsucc k) = ordsucc m.
      { rewrite Hm_eq. reflexivity. }
      exact (eq_i_tra (ordsucc (ordsucc k)) (ordsucc m) k
        Hord_sm Hsm_eq_k). }
    claim Hsk_in_ssk : ordsucc k :e ordsucc (ordsucc k). { exact (ordsuccI2 (ordsucc k)). }
    claim Hsk_in_k : ordsucc k :e k.
    { exact (Hsk_eq_k (fun a _:set => ordsucc k :e a) Hsk_in_ssk). }
    exact (In_irref k (nat_trans k Hk_nat (ordsucc k) Hsk_in_k k (ordsuccI2 k))).
- assume Hycs0_ne : ycs0 <> e.
  (** Construct merged word vs = [ycs0, cs(1), ..., cs(k)] of length m **)
  set vs := graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)).
  claim Hvs_0 : apply_fun vs 0 = ycs0.
  { rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) 0 H0_in_m).
    exact (If_i_1 (0 = 0) ycs0 (apply_fun cs 0) H00). }
  claim Hvs_shift : forall j:set, j :e k ->
    apply_fun vs (ordsucc j) = apply_fun cs (ordsucc j).
  { let j. assume Hjk : j :e k.
    claim Hsj_m : ordsucc j :e m.
    { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat j Hjk). }
    rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j))
      (ordsucc j) Hsj_m).
    exact (If_i_0 (ordsucc j = 0) ycs0 (apply_fun cs (ordsucc j)) (neq_ordsucc_0 j)). }
  claim Hvs_to_tail : forall j:set, j :e k ->
    apply_fun vs (ordsucc j) = apply_fun tail_cs j.
  { let j. assume Hjk : j :e k.
    rewrite (Hvs_shift j Hjk). symmetry. exact (Htail_shift j Hjk). }
  (** Word product: wp vs m = cx via forward chain **)
  claim Hvs0_G : apply_fun vs 0 :e G.
  { rewrite Hvs_0. exact Hycs0_G. }
  claim Hwp_vs_prepend : word_product mult e vs (ordsucc k) =
    apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k).
  { exact (word_product_prepend mult e G k tail_cs vs HeG Hid Hmult_cl Hassoc
      Hvs0_G (nat_p_omega k Hk_nat) Htail_G Hvs_to_tail). }
  (** Chain: wp vs m = wp vs (ordsucc k) = mult(vs(0), wpt) = mult(ycs0, wpt) = cx **)
  claim Hwp_m_sk2 : word_product mult e vs m = word_product mult e vs (ordsucc k).
  { rewrite Hm_eq. reflexivity. }
  claim Hwp_vs_step : word_product mult e vs m =
    apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k).
  { exact (eq_i_tra (word_product mult e vs m) (word_product mult e vs (ordsucc k))
      (apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k))
      Hwp_m_sk2 Hwp_vs_prepend). }
  claim Hvs0_to_ycs0 : apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k) =
    apply_fun mult (ycs0, word_product mult e tail_cs k).
  { rewrite Hvs_0. reflexivity. }
  claim Hwp_vs_ycs0 : word_product mult e vs m =
    apply_fun mult (ycs0, word_product mult e tail_cs k).
  { exact (eq_i_tra (word_product mult e vs m)
      (apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k))
      (apply_fun mult (ycs0, word_product mult e tail_cs k))
      Hwp_vs_step Hvs0_to_ycs0). }
  claim Hcx_merge_rev : apply_fun mult (ycs0, word_product mult e tail_cs k) =
    apply_fun mult (c, x).
  { symmetry. exact Hcx_merge. }
  claim Hwp_vs : word_product mult e vs m = apply_fun mult (c, x).
  { exact (eq_i_tra (word_product mult e vs m)
      (apply_fun mult (ycs0, word_product mult e tail_cs k))
      (apply_fun mult (c, x))
      Hwp_vs_ycs0 Hcx_merge_rev). }
  (** Prove vs is reduced **)
  claim Hvs_mem : forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun vs i :e apply_fun Gfam alpha /\
      apply_fun vs i <> apply_fun efam alpha.
  { let i. assume Him : i :e m.
    apply (xm (i = 0)).
    - assume Hi0 : i = 0.
      (** vs(0) = ycs0 in G2 = Gfam(1), ycs0 <> e = efam(1) **)
      witness 1. apply and3I.
      + exact In_1_2.
      + claim Hvsi_ycs0 : apply_fun vs i = ycs0. { rewrite Hi0. exact Hvs_0. }
        rewrite Hvsi_ycs0. rewrite HGfam1. exact Hycs0_G2.
      + claim Hvsi_ycs0 : apply_fun vs i = ycs0. { rewrite Hi0. exact Hvs_0. }
        rewrite Hvsi_ycs0.
        claim Hefam1 : apply_fun efam 1 = e.
        { rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
        rewrite Hefam1. exact Hycs0_ne.
    - assume Hi_ne0 : i <> 0.
      (** i = ordsucc j for some j, vs(i) = cs(i) **)
      claim Hi_nat : nat_p i. { exact (omega_nat_p i (omega_TransSet m Hm_omega i Him)). }
      apply (nat_inv i Hi_nat).
      + assume Habs : i = 0. exact (Hi_ne0 Habs (exists alpha:set, alpha :e 2 /\
          apply_fun vs i :e apply_fun Gfam alpha /\
          apply_fun vs i <> apply_fun efam alpha)).
      + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
        apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
        claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
        claim Hjk : j :e k.
        { claim Hi_in_sk : i :e ordsucc k. { rewrite <- Hm_eq. exact Him. }
          claim Hsj_in_sk : ordsucc j :e ordsucc k. { rewrite <- Hij. exact Hi_in_sk. }
          apply (ordsuccE k (ordsucc j) Hsj_in_sk).
          - assume Hsjk : ordsucc j :e k.
            claim Hj_nat : nat_p j. { exact (andEL (nat_p j) (i = ordsucc j) Hj_conj). }
            exact (nat_trans k Hk_nat (ordsucc j) Hsjk j (ordsuccI2 j)).
          - assume Hsjeqk : ordsucc j = k. rewrite <- Hsjeqk. exact (ordsuccI2 j). }
        claim Hvsi_cs : apply_fun vs i = apply_fun cs i.
        { rewrite Hij. exact (Hvs_shift j Hjk). }
        rewrite Hvsi_cs. exact (Hcs_mem i Him). }
  claim Hvs_adj : forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun vs i :e apply_fun Gfam alpha ->
      apply_fun vs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta.
  { let i. assume Him : i :e m. assume Hsim : ordsucc i :e m.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hvsi_al : apply_fun vs i :e apply_fun Gfam alpha.
    assume Hvssi_be : apply_fun vs (ordsucc i) :e apply_fun Gfam beta.
    apply (xm (i = 0)).
    - assume Hi0 : i = 0.
      (** vs(0) = ycs0 in G2 = Gfam(1), vs(1) = cs(1), and cs(0) in Gfam(1) **)
      assume Haleqbe : alpha = beta.
      (** Derive alpha = 1 **)
      claim Hvsi_ycs0 : apply_fun vs i = ycs0. { rewrite Hi0. exact Hvs_0. }
      claim Hycs0_al : ycs0 :e apply_fun Gfam alpha.
      { rewrite <- Hvsi_ycs0. exact Hvsi_al. }
      claim Hycs0_Gfam1 : ycs0 :e apply_fun Gfam 1.
      { rewrite HGfam1. exact Hycs0_G2. }
      apply (xm (alpha = 1)).
      + assume Hal1 : alpha = 1.
        (** beta = 1, so vs(1) in Gfam(1) = G2 **)
        claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
        (** vs(ordsucc 0) = cs(1). Need 0 in k for Hvs_shift. **)
        (** We know ordsucc i in m, and i=0, so ordsucc 0 = 1 in m. **)
        (** cs(0) in Gfam(1). cs(1) in Gfam(beta) = Gfam(1). **)
        (** Hcs_adj 0 gives contradiction 1 <> 1 **)
        claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1.
        { rewrite HGfam1. exact Hcs0_G2. }
        (** Derive cs(1) in Gfam(beta) **)
        claim Hi0_nat : nat_p 0. { exact nat_0. }
        claim H0k : 0 :e k.
        { claim Hsi_in_sk : ordsucc i :e ordsucc k. { rewrite <- Hm_eq. exact Hsim. }
          claim H1_in_sk : 1 :e ordsucc k. { rewrite <- Hi0. exact Hsi_in_sk. }
          apply (ordsuccE k 1 H1_in_sk).
          { assume H1k : 1 :e k. exact (nat_trans k Hk_nat 1 H1k 0 In_0_1). }
          assume H1eqk : 1 = k. rewrite <- H1eqk. exact In_0_1. }
        claim Hvs1_cs1 : apply_fun vs (ordsucc 0) = apply_fun cs (ordsucc 0).
        { exact (Hvs_shift 0 H0k). }
        claim Hvssi_cs1 : apply_fun vs (ordsucc i) = apply_fun cs (ordsucc 0).
        { rewrite Hi0. exact Hvs1_cs1. }
        claim Hcs1_be : apply_fun cs (ordsucc 0) :e apply_fun Gfam beta.
        { rewrite <- Hvssi_cs1. exact Hvssi_be. }
        claim Hcs1_Gfam1 : apply_fun cs (ordsucc 0) :e apply_fun Gfam 1.
        { exact (Hbe1 (fun a _:set => apply_fun cs (ordsucc 0) :e apply_fun Gfam a) Hcs1_be). }
        claim H1_in_m_deriv : ordsucc 0 :e m.
        { rewrite <- Hi0. exact Hsim. }
        claim H1_ne_1 : 1 <> 1.
        { exact (Hcs_adj 0 H0_in_m H1_in_m_deriv 1 1 In_1_2 In_1_2 Hcs0_Gfam1 Hcs1_Gfam1). }
        claim H11 : 1 = 1. { reflexivity. }
        exact (H1_ne_1 H11).
      + assume Hal_ne1 : alpha <> 1.
        (** ycs0 in Gfam(alpha) inter Gfam(1), alpha <> 1, so ycs0 = e **)
        exact (Hycs0_ne (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 ycs0
          Hycs0_al Hycs0_Gfam1)).
    - assume Hi_ne0 : i <> 0.
      (** i = ordsucc j, vs(i) = cs(i), vs(ordsucc i) = cs(ordsucc i) **)
      claim Hi_nat : nat_p i. { exact (omega_nat_p i (omega_TransSet m Hm_omega i Him)). }
      apply (nat_inv i Hi_nat).
      + assume Habs : i = 0.
        exact (Hi_ne0 Habs (alpha <> beta)).
      + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
        apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
        claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
        claim Hjk : j :e k.
        { claim Hi_in_sk : i :e ordsucc k. { rewrite <- Hm_eq. exact Him. }
          claim Hsj_in_sk : ordsucc j :e ordsucc k. { rewrite <- Hij. exact Hi_in_sk. }
          apply (ordsuccE k (ordsucc j) Hsj_in_sk).
          - assume Hsjk : ordsucc j :e k.
            exact (nat_trans k Hk_nat (ordsucc j) Hsjk j (ordsuccI2 j)).
          - assume Hsjeqk : ordsucc j = k. rewrite <- Hsjeqk. exact (ordsuccI2 j). }
        claim Hvsi_cs : apply_fun vs i = apply_fun cs i.
        { rewrite Hij. exact (Hvs_shift j Hjk). }
        claim Hcsi_al : apply_fun cs i :e apply_fun Gfam alpha.
        { rewrite <- Hvsi_cs. exact Hvsi_al. }
        (** For vs(ordsucc i) = cs(ordsucc i) **)
        claim Hsj_in_k : ordsucc j :e k.
        { claim Hsi_in_sk : ordsucc i :e ordsucc k. { rewrite <- Hm_eq. exact Hsim. }
          claim Hssj_in_sk : ordsucc (ordsucc j) :e ordsucc k. { rewrite <- Hij. exact Hsi_in_sk. }
          apply (ordsuccE k (ordsucc (ordsucc j)) Hssj_in_sk).
          - assume Hssjk : ordsucc (ordsucc j) :e k.
            exact (nat_trans k Hk_nat (ordsucc (ordsucc j)) Hssjk (ordsucc j) (ordsuccI2 (ordsucc j))).
          - assume Hssjeqk : ordsucc (ordsucc j) = k. rewrite <- Hssjeqk. exact (ordsuccI2 (ordsucc j)). }
        claim Hvssi_cs : apply_fun vs (ordsucc i) = apply_fun cs (ordsucc i).
        { rewrite Hij. exact (Hvs_shift (ordsucc j) Hsj_in_k). }
        claim Hcssi_be : apply_fun cs (ordsucc i) :e apply_fun Gfam beta.
        { rewrite <- Hvssi_cs. exact Hvssi_be. }
        exact (Hcs_adj i Him Hsim alpha beta Hal2 Hbe2 Hcsi_al Hcssi_be). }
  claim Hvs_red : reduced_word 2 Gfam efam m vs.
  { prove (m :e omega /\
      (forall i:set, i :e m ->
        exists alpha:set, alpha :e 2 /\
          apply_fun vs i :e apply_fun Gfam alpha /\
          apply_fun vs i <> apply_fun efam alpha)) /\
      (forall i:set, i :e m -> ordsucc i :e m ->
        forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
          apply_fun vs i :e apply_fun Gfam alpha ->
          apply_fun vs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
    apply andI.
    - apply andI.
      + exact Hm_omega.
      + exact Hvs_mem.
    - exact Hvs_adj. }
  (** Length contradiction: n_c = ordsucc m and n_c = m **)
  claim Hnc_m : n_c = m.
  { exact (andEL (n_c = m)
      (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun vs i)
      (Huniq_clause m vs Hvs_red Hmne Hwp_vs)). }
  claim Hnc_m_rev : m = n_c. { symmetry. exact Hnc_m. }
  claim Hm_eq_sm : m = ordsucc m.
  { exact (eq_i_tra m n_c (ordsucc m) Hnc_m_rev Hnc_sm). }
  claim Hm_in_sm : m :e ordsucc m. { exact (ordsuccI2 m). }
  claim Hm_in_m : m :e m.
  { exact (Hm_eq_sm (fun _ b:set => m :e b) Hm_in_sm). }
  exact (In_irref m Hm_in_m).
Qed.

(** Sub-helper: Case last entry of c's word in G2 **)
(** Strategy: cx = yc. Build reduced word for cx by appending x.
    Case split on cs(0) factor. Contradiction via uniqueness. **)
Lemma ex68_3_case_last_G2 : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G2 ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e.
assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G2 : apply_fun cs k :e G2.
(** Extract free product components **)
apply (and5E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim Hinter_simple : forall z:set, z :e G1 -> z :e G2 -> z = e.
{ let z. assume HzG1 : z :e G1. assume HzG2 : z :e G2.
  claim HzGfam0 : z :e apply_fun Gfam 0. { rewrite HGfam0. exact HzG1. }
  claim HzGfam1 : z :e apply_fun Gfam 1. { rewrite HGfam1. exact HzG2. }
  exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 z HzGfam0 HzGfam1). }
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
(** Extract reduced word components **)
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (HmultF (c, x) (tuple_2_setprod_by_pair_Sigma G G c x HcG HxG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
(** Derive cx = yc **)
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e)
    (Hinverse c HcG)). }
claim Hcx_e : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_e. }
(** Evaluate efam **)
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
(** Construct reduced word ws for cx = [cs(0),...,cs(k),x] of length ordsucc m **)
set ws := graph (ordsucc m) (fun i:set => If_i (i :e m) (apply_fun cs i) x).
claim Hm_notin_m : ~(m :e m). { exact (In_irref m). }
claim Hws_m : apply_fun ws m = x.
{ rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i :e m) (apply_fun cs i) x)
    m (ordsuccI2 m)).
  exact (If_i_0 (m :e m) (apply_fun cs m) x Hm_notin_m). }
claim Hws_agree : forall j:set, j :e m -> apply_fun ws j = apply_fun cs j.
{ let j. assume Hjm : j :e m.
  claim Hj_sm : j :e ordsucc m. { exact (ordsuccI1 m j Hjm). }
  rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i :e m) (apply_fun cs i) x)
    j Hj_sm).
  exact (If_i_1 (j :e m) (apply_fun cs j) x Hjm). }
(** Word product of ws at ordsucc m = mult(c, x) **)
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
claim Hwp_m : word_product mult e ws m = c.
{ claim Hagree : word_product mult e ws m = word_product mult e cs m.
  { exact (word_product_agree mult e ws cs m Hm_omega Hws_agree). }
  rewrite Hagree. exact Hprod. }
claim Hwp_sm_step : word_product mult e ws (ordsucc m) =
  apply_fun mult (word_product mult e ws m, apply_fun ws m).
{ exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun ws i)) m Hm_nat). }
claim Hwp_cx : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
{ rewrite Hwp_sm_step. rewrite Hwp_m. rewrite Hws_m. reflexivity. }
(** Show ws is reduced **)
claim Hcsk_ne_e : apply_fun cs k <> e.
{ apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs k :e apply_fun Gfam al)
    (fun al:set => apply_fun cs k <> apply_fun efam al)
    (Hcs_mem k Hk_in_m)).
  let al_k.
  assume Halk_conj : al_k :e 2 /\ apply_fun cs k :e apply_fun Gfam al_k.
  assume Hne_efam : apply_fun cs k <> apply_fun efam al_k.
  claim Halk2 : al_k :e 2.
  { exact (andEL (al_k :e 2) (apply_fun cs k :e apply_fun Gfam al_k) Halk_conj). }
  claim Hefam_al : apply_fun efam al_k = e.
  { rewrite (apply_fun_graph 2 (fun _:set => e) al_k Halk2). reflexivity. }
  assume Habs : apply_fun cs k = e.
  apply Hne_efam. rewrite Hefam_al. exact Habs. }
(** Prove ws is a reduced word of length ordsucc m **)
claim Hws_mem : forall i:set, i :e ordsucc m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun ws i :e apply_fun Gfam alpha /\
    apply_fun ws i <> apply_fun efam alpha.
{ let i. assume Hi : i :e ordsucc m.
  apply (ordsuccE m i Hi).
  - assume Him : i :e m.
    claim Hwsi_eq : apply_fun ws i = apply_fun cs i. { exact (Hws_agree i Him). }
    rewrite Hwsi_eq. exact (Hcs_mem i Him).
  - assume Hieqm : i = m.
    rewrite Hieqm. rewrite Hws_m.
    witness 0. apply and3I.
    + exact In_0_2.
    + rewrite HGfam0. exact HxG1.
    + rewrite Hefam0. exact Hxne. }
claim Hws_adj : forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun ws i :e apply_fun Gfam alpha ->
    apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let i. assume Hi : i :e ordsucc m. assume Hsi : ordsucc i :e ordsucc m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hwsi_al : apply_fun ws i :e apply_fun Gfam alpha.
  assume Hwssi_be : apply_fun ws (ordsucc i) :e apply_fun Gfam beta.
  (** ordsucc i :e ordsucc m means ordsucc i :e m or ordsucc i = m **)
  apply (ordsuccE m (ordsucc i) Hsi).
  - assume Hsim : ordsucc i :e m.
    (** Both i and ordsucc i are in m, so use Hcs_adj **)
    claim Him : i :e m. { exact (nat_trans m Hm_nat (ordsucc i) Hsim i (ordsuccI2 i)). }
    claim Hwsi_cs : apply_fun ws i = apply_fun cs i. { exact (Hws_agree i Him). }
    claim Hwssi_cs : apply_fun ws (ordsucc i) = apply_fun cs (ordsucc i).
    { exact (Hws_agree (ordsucc i) Hsim). }
    claim Hcsi_al : apply_fun cs i :e apply_fun Gfam alpha.
    { rewrite <- Hwsi_cs. exact Hwsi_al. }
    claim Hcssi_be : apply_fun cs (ordsucc i) :e apply_fun Gfam beta.
    { rewrite <- Hwssi_cs. exact Hwssi_be. }
    exact (Hcs_adj i Him Hsim alpha beta Hal2 Hbe2 Hcsi_al Hcssi_be).
  - assume Hsieqm : ordsucc i = m.
    (** ordsucc i = m means i = k (since m = ordsucc k) **)
    claim Hsi_sk : ordsucc i = ordsucc k. { rewrite Hsieqm. exact Hm_eq. }
    claim Hieqk : i = k. { exact (ordsucc_inj i k Hsi_sk). }
    claim Hwsi_csk : apply_fun ws i = apply_fun cs k.
    { rewrite Hieqk. exact (Hws_agree k Hk_in_m). }
    claim Hwssi_x : apply_fun ws (ordsucc i) = x.
    { rewrite Hsieqm. exact Hws_m. }
    claim Hcsk_Gal : apply_fun cs k :e apply_fun Gfam alpha.
    { rewrite <- Hwsi_csk. exact Hwsi_al. }
    claim Hx_Gbe : x :e apply_fun Gfam beta.
    { rewrite <- Hwssi_x. exact Hwssi_be. }
    (** If alpha = beta, contradiction via intersection **)
    assume Haleqbe : alpha = beta.
    apply (xm (alpha = 0)).
    + assume Hal0 : alpha = 0.
      (** cs(k) in Gfam(alpha)=Gfam(0)=G1 AND Gfam(1)=G2 **)
      claim Hal_ne1 : alpha <> 1. { rewrite Hal0. exact neq_0_1. }
      claim Hcsk_eq_e : apply_fun cs k = e.
      { claim Hcsk_G1fam : apply_fun cs k :e apply_fun Gfam 1.
        { rewrite HGfam1. exact Hcsk_G2. }
        exact (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 (apply_fun cs k) Hcsk_Gal Hcsk_G1fam). }
      exact (Hcsk_ne_e Hcsk_eq_e).
    + assume Hal_ne0 : alpha <> 0.
      (** alpha = 1, so beta = 1 too; x in Gfam(beta) = G2 and G1 **)
      claim Hbe_ne0 : beta <> 0.
      { assume Hbe0 : beta = 0. apply Hal_ne0. rewrite Haleqbe. exact Hbe0. }
      claim Hx_G0fam : x :e apply_fun Gfam 0.
      { rewrite HGfam0. exact HxG1. }
      claim Hx_eq_e : x = e.
      { exact (Hinter beta 0 Hbe2 In_0_2 Hbe_ne0 x Hx_Gbe Hx_G0fam). }
      exact (Hxne Hx_eq_e). }
claim Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
{ prove (ordsucc m :e omega /\
    (forall i:set, i :e ordsucc m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun ws i :e apply_fun Gfam alpha /\
        apply_fun ws i <> apply_fun efam alpha)) /\
    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun ws i :e apply_fun Gfam alpha ->
        apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hsm_omega.
    + exact Hws_mem.
  - exact Hws_adj. }
(** Now apply uniqueness to get cx's canonical representation **)
(** Delegate remaining case analysis to sub-sub-helpers **)
(** Get first entry's factor **)
apply (exandE_i
  (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
  (fun al:set => apply_fun cs 0 <> apply_fun efam al)
  (Hcs_mem 0 H0_in_m)).
let alpha_first.
assume Haf_conj : alpha_first :e 2 /\ apply_fun cs 0 :e apply_fun Gfam alpha_first.
assume Hcs0_ne_efam : apply_fun cs 0 <> apply_fun efam alpha_first.
claim Haf2 : alpha_first :e 2.
{ exact (andEL (alpha_first :e 2) (apply_fun cs 0 :e apply_fun Gfam alpha_first) Haf_conj). }
claim Hcs0_fam : apply_fun cs 0 :e apply_fun Gfam alpha_first.
{ exact (andER (alpha_first :e 2) (apply_fun cs 0 :e apply_fun Gfam alpha_first) Haf_conj). }
claim Hcs0_ne_e : apply_fun cs 0 <> e.
{ claim Hefam_af : apply_fun efam alpha_first = e.
  { rewrite (apply_fun_graph 2 (fun _:set => e) alpha_first Haf2). reflexivity. }
  assume H : apply_fun cs 0 = e. apply Hcs0_ne_efam. rewrite Hefam_af. exact H. }
(** Case split on alpha_first **)
apply (xm (alpha_first = 0)).
- assume Haf0 : alpha_first = 0.
  (** cs(0) in G1 (same factor as x): use prepend argument **)
  claim Hcs0_G1 : apply_fun cs 0 :e G1.
  { claim Hfam_af0 : apply_fun Gfam alpha_first = G1.
    { rewrite Haf0. exact HGfam0. }
    rewrite <- Hfam_af0. exact Hcs0_fam. }
  claim Hws0_cs0 : apply_fun ws 0 = apply_fun cs 0.
  { exact (Hws_agree 0 H0_in_m). }
  exact (ex68_3_case_G2_first_G1 G mult e inv G1 G2 c x m cs k ws
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G2
    Hcs0_G1 Hcs0_ne_e Hws_red Hwp_cx Hws0_cs0).
- assume Haf_ne0 : alpha_first <> 0.
  (** cs(0) in G2 (same factor as y): use merge argument **)
  claim Haf1 : alpha_first = 1.
  { apply (ordsuccE 1 alpha_first Haf2).
    + assume H : alpha_first :e 1. apply (ordsuccE 0 alpha_first H).
      * assume H2 : alpha_first :e 0. exact (EmptyE alpha_first H2 (alpha_first = 1)).
      * assume H2 : alpha_first = 0. exact (Haf_ne0 H2 (alpha_first = 1)).
    + assume H : alpha_first = 1. exact H. }
  claim Hcs0_G2 : apply_fun cs 0 :e G2.
  { claim Hfam_af1 : apply_fun Gfam alpha_first = G2.
    { rewrite Haf1. exact HGfam1. }
    rewrite <- Hfam_af1. exact Hcs0_fam. }
  exact (ex68_3_case_G2_first_G2 G mult e inv G1 G2 c x m cs k ws
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G2
    Hcs0_G2 Hws_red Hwp_cx).
Qed.

(** Sub-helper: Case last in G1, first in G1 - prepend y to build long word **)
Lemma ex68_3_case_G1_first_G1 : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G1 ->
  apply_fun cs 0 :e G1 ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G1 : apply_fun cs k :e G1.
assume Hcs0_G1 : apply_fun cs 0 :e G1.
prove False.
(** Extract free product components **)
apply (and5E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim Hmult_cl : forall x1 y1:set, x1 :e G -> y1 :e G -> apply_fun mult (x1, y1) :e G.
{ let x1 y1. assume Hx1 : x1 :e G. assume Hy1 : y1 :e G.
  exact (HmultF (x1, y1) (tuple_2_setprod_by_pair_Sigma G G x1 y1 Hx1 Hy1)). }
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HcxG : apply_fun mult (c, x) :e G. { exact (Hmult_cl c x HcG HxG). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
(** Derive cx = yc **)
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ claim H1 : apply_fun mult (apply_fun inv c, c) = e.
  { exact (andER (apply_fun mult (c, apply_fun inv c) = e)
      (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
  claim H2 : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
  { exact (andER (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
      (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
      (Hid (apply_fun mult (c, x)) HcxG)). }
  rewrite (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG).
  rewrite H1. symmetry. exact H2. }
(** Build ws = [y, cs(0), ..., cs(k)] of length ordsucc m **)
set ws := graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Eps_i (fun j:set => i = ordsucc j)))).
claim Hws_0 : apply_fun ws 0 = y.
{ rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Eps_i (fun j:set => i = ordsucc j))))
    0 (nat_0_in_ordsucc m Hm_nat)).
  exact (If_i_1 (0 = 0) y (apply_fun cs (Eps_i (fun j:set => 0 = ordsucc j))) H00). }
claim Hws_succ : forall j:set, j :e m -> apply_fun ws (ordsucc j) = apply_fun cs j.
{ let j. assume Hjm : j :e m.
  claim Hsj_sm : ordsucc j :e ordsucc m.
  { exact (nat_ordsucc_in_ordsucc m Hm_nat j Hjm). }
  rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Eps_i (fun j0:set => i = ordsucc j0))))
    (ordsucc j) Hsj_sm).
  rewrite (If_i_0 (ordsucc j = 0) y (apply_fun cs (Eps_i (fun j0:set => ordsucc j = ordsucc j0))) (neq_ordsucc_0 j)).
  claim Heps : Eps_i (fun j0:set => ordsucc j = ordsucc j0) = j.
  { claim Hpj : ordsucc j = ordsucc j. { reflexivity. }
    claim Huniq : forall j1:set, ordsucc j = ordsucc j1 -> j1 = j.
    { let j1. assume Hsjeqsj1 : ordsucc j = ordsucc j1.
      claim Hjeqj1 : j = j1. { exact (ordsucc_inj j j1 Hsjeqsj1). }
      symmetry. exact Hjeqj1. }
    exact (Eps_i_unique (fun j0:set => ordsucc j = ordsucc j0) j Hpj Huniq). }
  rewrite Heps. reflexivity. }
(** Word product ws (ordsucc m) = mult(y, c) = cx **)
claim Htail_agree : forall j:set, j :e m -> apply_fun ws (ordsucc j) = apply_fun cs j.
{ let j. assume Hjm : j :e m. exact (Hws_succ j Hjm). }
claim Hws0_G : apply_fun ws 0 :e G. { rewrite Hws_0. exact HyG. }
claim Hcs_G : forall j:set, j :e m -> apply_fun cs j :e G.
{ let j. assume Hjm : j :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
    (fun al:set => apply_fun cs j <> apply_fun efam al) (Hcs_mem j Hjm)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs j :e apply_fun Gfam al.
  assume Hne.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  apply (xm (al = 0)).
  - assume Hal0 : al = 0.
    claim Hcsj_G1 : apply_fun cs j :e G1.
    { claim Hfam_al : apply_fun Gfam al = G1. { rewrite Hal0. exact HGfam0. }
      rewrite <- Hfam_al. exact Hcsj_fam. }
    exact (HG1sub (apply_fun cs j) Hcsj_G1).
  - assume Hal_ne0 : al <> 0.
    claim Hal1 : al = 1.
    { apply (ordsuccE 1 al Hal2).
      { assume H : al :e 1. apply (ordsuccE 0 al H).
        { assume H2 : al :e 0. exact (EmptyE al H2 (al = 1)). }
        assume H2 : al = 0. exact (Hal_ne0 H2 (al = 1)). }
      assume H : al = 1. exact H. }
    claim Hcsj_G2 : apply_fun cs j :e G2.
    { claim Hfam_al : apply_fun Gfam al = G2. { rewrite Hal1. exact HGfam1. }
      rewrite <- Hfam_al. exact Hcsj_fam. }
    exact (HG2sub (apply_fun cs j) Hcsj_G2). }
claim Hwp_ws_prepend : word_product mult e ws (ordsucc m) =
  apply_fun mult (apply_fun ws 0, word_product mult e cs m).
{ exact (word_product_prepend mult e G m cs ws HeG Hid Hmult_cl Hassoc
    Hws0_G (nat_p_omega m Hm_nat) Hcs_G Htail_agree). }
claim Hwp_ws : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
{ rewrite Hwp_ws_prepend. rewrite Hws_0. rewrite Hprod.
  symmetry. exact Hcx_eq_yc. }
(** Show ws is reduced **)
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim Hws_mem : forall i:set, i :e ordsucc m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun ws i :e apply_fun Gfam alpha /\
    apply_fun ws i <> apply_fun efam alpha.
{ let i. assume Hi : i :e ordsucc m.
  apply (ordsuccE m i Hi).
  - assume Him : i :e m.
    (** i is a successor since i :e m = ordsucc k **)
    claim Hi_nat : nat_p i. { exact (omega_nat_p i (omega_TransSet m Hm_omega i Him)). }
    apply (nat_inv i Hi_nat).
    + assume Hi0 : i = 0.
      (** ws(0) = y in G2 = Gfam(1) **)
      witness 1. apply and3I.
      * exact In_1_2.
      * rewrite Hi0. rewrite Hws_0. rewrite HGfam1. exact HyG2.
      * rewrite Hi0. rewrite Hws_0. rewrite Hefam1. exact Hyne.
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
      claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
      claim Hjm : j :e m.
      { claim Hi_in_sk : i :e ordsucc k. { rewrite <- Hm_eq. exact Him. }
        claim Hsj_in_sk : ordsucc j :e ordsucc k. { rewrite <- Hij. exact Hi_in_sk. }
        apply (ordsuccE k (ordsucc j) Hsj_in_sk).
        - assume Hsjk : ordsucc j :e k.
          claim Hjk : j :e k. { exact (nat_trans k Hk_nat (ordsucc j) Hsjk j (ordsuccI2 j)). }
          rewrite Hm_eq. exact (ordsuccI1 k j Hjk).
        - assume Hsjeqk : ordsucc j = k.
          claim Hj_sj : j :e ordsucc j. { exact (ordsuccI2 j). }
          claim Hjk : j :e k. { rewrite <- Hsjeqk. exact Hj_sj. }
          rewrite Hm_eq. exact (ordsuccI1 k j Hjk). }
      claim Hwsi_cs : apply_fun ws i = apply_fun cs j. { rewrite Hij. exact (Hws_succ j Hjm). }
      rewrite Hwsi_cs. exact (Hcs_mem j Hjm).
  - assume Hieqm : i = m.
    (** ws(m) = cs(k) in G1 = Gfam(0) **)
    claim Hk_in_m2 : k :e m. { exact Hk_in_m. }
    claim Hwsm_csk : apply_fun ws m = apply_fun cs k.
    { exact (Hm_eq (fun _ b:set => apply_fun ws b = apply_fun cs k) (Hws_succ k Hk_in_m2)). }
    claim Hwsi_csk : apply_fun ws i = apply_fun cs k.
    { rewrite Hieqm. exact Hwsm_csk. }
    witness 0. apply and3I.
    + exact In_0_2.
    + rewrite Hwsi_csk. rewrite HGfam0. exact Hcsk_G1.
    + rewrite Hwsi_csk. rewrite Hefam0.
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs k :e apply_fun Gfam al)
        (fun al:set => apply_fun cs k <> apply_fun efam al) (Hcs_mem k Hk_in_m)).
      let al_k. assume Halk_conj : al_k :e 2 /\ apply_fun cs k :e apply_fun Gfam al_k.
      assume Hne_efam : apply_fun cs k <> apply_fun efam al_k.
      claim Halk2 : al_k :e 2.
      { exact (andEL (al_k :e 2) (apply_fun cs k :e apply_fun Gfam al_k) Halk_conj). }
      claim Hefam_al : apply_fun efam al_k = e.
      { rewrite (apply_fun_graph 2 (fun _:set => e) al_k Halk2). reflexivity. }
      assume Habs : apply_fun cs k = e.
      apply Hne_efam. rewrite Hefam_al. exact Habs. }
claim Hws_adj : forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun ws i :e apply_fun Gfam alpha ->
    apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let i. assume Hi : i :e ordsucc m. assume Hsi : ordsucc i :e ordsucc m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hwsi_al : apply_fun ws i :e apply_fun Gfam alpha.
  assume Hwssi_be : apply_fun ws (ordsucc i) :e apply_fun Gfam beta.
  (** ordsucc i :e ordsucc m means ordsucc i :e m or ordsucc i = m **)
  apply (xm (i = 0)).
  - assume Hi0 : i = 0.
    (** ws(0) = y in G2 = Gfam(1), ws(1) = cs(0) in G1 = Gfam(0) **)
    assume Haleqbe : alpha = beta.
    claim Hwsi_y : apply_fun ws i = y. { rewrite Hi0. exact Hws_0. }
    claim Hy_al : y :e apply_fun Gfam alpha. { rewrite <- Hwsi_y. exact Hwsi_al. }
    claim Hy_Gfam1 : y :e apply_fun Gfam 1. { rewrite HGfam1. exact HyG2. }
    apply (xm (alpha = 1)).
    + assume Hal1 : alpha = 1.
      claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
      claim Hwssi_cs0 : apply_fun ws (ordsucc i) = apply_fun cs 0.
      { rewrite Hi0. exact (Hws_succ 0 H0_in_m). }
      claim Hcs0_be : apply_fun cs 0 :e apply_fun Gfam beta.
      { rewrite <- Hwssi_cs0. exact Hwssi_be. }
      claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1.
      { exact (Hbe1 (fun a _:set => apply_fun cs 0 :e apply_fun Gfam a) Hcs0_be). }
      claim Hcs0_G2 : apply_fun cs 0 :e G2.
      { rewrite <- HGfam1. exact Hcs0_Gfam1. }
      claim Hcs0_eq_e : apply_fun cs 0 = e.
      { exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 (apply_fun cs 0)
          (HGfam0 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G1)
          Hcs0_Gfam1). }
      (** cs(0) = e contradicts cs(0) being in reduced word **)
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
        (fun al:set => apply_fun cs 0 <> apply_fun efam al) (Hcs_mem 0 H0_in_m)).
      let al0. assume Hal0_conj : al0 :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al0.
      assume Hne_efam0 : apply_fun cs 0 <> apply_fun efam al0.
      claim Hal0_2 : al0 :e 2.
      { exact (andEL (al0 :e 2) (apply_fun cs 0 :e apply_fun Gfam al0) Hal0_conj). }
      claim Hefam_al0 : apply_fun efam al0 = e.
      { rewrite (apply_fun_graph 2 (fun _:set => e) al0 Hal0_2). reflexivity. }
      claim Hefam_al0_rev : e = apply_fun efam al0. { symmetry. exact Hefam_al0. }
      exact (Hne_efam0 (eq_i_tra (apply_fun cs 0) e (apply_fun efam al0)
        Hcs0_eq_e Hefam_al0_rev)).
    + assume Hal_ne1 : alpha <> 1.
      exact (Hyne (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 y Hy_al Hy_Gfam1)).
  - assume Hi_ne0 : i <> 0.
    (** i = ordsucc j for some j, ws(i) = cs(j), ws(ordsucc i) = cs(j+1) **)
    claim Hi_nat : nat_p i.
    { exact (omega_nat_p i (omega_TransSet (ordsucc m) Hsm_omega i Hi)). }
    apply (nat_inv i Hi_nat).
    + assume Habs : i = 0. exact (Hi_ne0 Habs (alpha <> beta)).
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
      claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
      (** Derive j :e m and ordsucc j :e m **)
      claim Him : i :e m.
      { claim Hsi_sm : ordsucc i :e ordsucc m. { exact Hsi. }
        apply (ordsuccE m (ordsucc i) Hsi_sm).
        - assume Hsim : ordsucc i :e m. exact (nat_trans m Hm_nat (ordsucc i) Hsim i (ordsuccI2 i)).
        - assume Hsieqm : ordsucc i = m. rewrite <- Hsieqm. exact (ordsuccI2 i). }
      claim Hjm : j :e m.
      { claim Hsjm2 : ordsucc j :e m.
        { exact (Hij (fun a _:set => a :e m) Him). }
        exact (nat_trans m Hm_nat (ordsucc j) Hsjm2 j (ordsuccI2 j)). }
      claim Hsjm : ordsucc j :e m. { rewrite <- Hij. exact Him. }
      claim Hwsi_cs : apply_fun ws i = apply_fun cs j.
      { rewrite Hij. exact (Hws_succ j Hjm). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { rewrite <- Hwsi_cs. exact Hwsi_al. }
      (** ws(ordsucc i) = ws(ordsucc (ordsucc j)) = cs(ordsucc j) **)
      claim Hwssi_cs : apply_fun ws (ordsucc i) = apply_fun cs (ordsucc j).
      { rewrite Hij.
        claim Hsjm2 : ordsucc j :e m. { exact Hsjm. }
        exact (Hws_succ (ordsucc j) Hsjm2). }
      claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      { rewrite <- Hwssi_cs. exact Hwssi_be. }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
claim Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
{ prove (ordsucc m :e omega /\
    (forall i:set, i :e ordsucc m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun ws i :e apply_fun Gfam alpha /\
        apply_fun ws i <> apply_fun efam alpha)) /\
    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun ws i :e apply_fun Gfam alpha ->
        apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hsm_omega.
    + exact Hws_mem.
  - exact Hws_adj. }
(** Now build merged word from cx direction **)
set cskx := apply_fun mult (apply_fun cs k, x).
claim Hcskx_G1 : cskx :e G1. { exact (HG1mult (apply_fun cs k) x Hcsk_G1 HxG1). }
(** Apply uniqueness to cx **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxsc_all :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
claim Huniq_clause : forall n' xs':set,
  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
  word_product mult e xs' n' = apply_fun mult (c, x) ->
  n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i).
{ exact (andER
    ((reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0) /\ word_product mult e xs_c n_c = apply_fun mult (c, x))
    (forall n' xs':set,
      reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = apply_fun mult (c, x) ->
      n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
    Hxsc_all). }
(** n_c = ordsucc m from ws **)
claim Hnc_sm : n_c = ordsucc m.
{ exact (andEL (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i)
    (Huniq_clause (ordsucc m) ws Hws_red (neq_ordsucc_0 m) Hwp_ws)). }
(** Now build merged word from cx = mult(c, x) and get contradiction **)
(** cx = wp(cs,m) mult x = wp(cs, ordsucc k) mult x
    = mult(wp(cs,k), mult(cs(k),x)) = mult(wp(cs,k), cskx) **)
(** Case split on cskx = e **)
apply (xm (cskx = e)).
- assume Hcskx_e : cskx = e.
  (** cx = wp(cs, k) **)
  apply (xm (k = 0)).
  + assume Hk0 : k = 0.
    (** wp(cs, k) = wp(cs, 0) = e, so cx = e, contradiction **)
    claim Hwp_k0 : word_product mult e cs k = e.
    { rewrite Hk0. exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun cs i))). }
    claim Hwp_m_step : word_product mult e cs m = apply_fun mult (word_product mult e cs k, apply_fun cs k).
    { rewrite Hm_eq.
      exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
    claim Hc_decomp : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
    { claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
      exact (eq_i_tra c (word_product mult e cs m)
        (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_m_step). }
    claim Hcskx_mult : apply_fun mult (apply_fun cs k, x) = e. { exact Hcskx_e. }
    claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
    claim Hwpk_G : word_product mult e cs k :e G.
    { exact (word_product_in_G mult e G k cs HeG Hmult_cl
        (nat_p_omega k Hk_nat)
        (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
    claim Hcx_eq : apply_fun mult (c, x) =
      apply_fun mult (word_product mult e cs k, apply_fun mult (apply_fun cs k, x)).
    { rewrite Hc_decomp.
      exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
    claim Hid_wpk : apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k.
    { exact (andER
        (apply_fun mult (e, word_product mult e cs k) = word_product mult e cs k)
        (apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k)
        (Hid (word_product mult e cs k) Hwpk_G)). }
    claim Hcx_wpk : apply_fun mult (c, x) = word_product mult e cs k.
    { rewrite Hcx_eq. rewrite Hcskx_e. exact Hid_wpk. }
    claim Hcx_e : apply_fun mult (c, x) = e.
    { exact (eq_i_tra (apply_fun mult (c, x)) (word_product mult e cs k) e Hcx_wpk Hwp_k0). }
    exact (Hcxne Hcx_e).
  + assume Hk_ne0 : k <> 0.
    (** Build init_cs = [cs(0),...,cs(k-1)] of length k **)
    (** This is a reduced word for cx of length k **)
    (** But n_c = ordsucc m = ordsucc (ordsucc k), so ordsucc (ordsucc k) = k **)
    (** Contradiction: ordsucc (ordsucc k) > k **)
    set init_cs := graph k (fun j:set => apply_fun cs j).
    claim Hinit_shift : forall j:set, j :e k -> apply_fun init_cs j = apply_fun cs j.
    { let j. assume Hjk : j :e k. exact (apply_fun_graph k (fun j:set => apply_fun cs j) j Hjk). }
    claim Hinit_mem : forall j:set, j :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun init_cs j :e apply_fun Gfam alpha /\
        apply_fun init_cs j <> apply_fun efam alpha.
    { let j. assume Hjk : j :e k.
      claim Hjm2 : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
      claim Hinit_eq : apply_fun init_cs j = apply_fun cs j. { exact (Hinit_shift j Hjk). }
      apply (Hcs_mem j Hjm2). let al.
      assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
        apply_fun cs j <> apply_fun efam al.
      claim Hal2 : al :e 2.
      { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
      claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
      { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
      claim Hcsj_ne : apply_fun cs j <> apply_fun efam al.
      { exact (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj). }
      witness al. apply and3I.
      - exact Hal2.
      - exact (Hinit_eq (fun _ b:set => b :e apply_fun Gfam al) Hcsj_fam).
      - exact (Hinit_eq (fun _ b:set => b <> apply_fun efam al) Hcsj_ne). }
    claim Hinit_adj : forall j:set, j :e k -> ordsucc j :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun init_cs j :e apply_fun Gfam alpha ->
        apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta.
    { let j. assume Hjk : j :e k. assume Hsjk : ordsucc j :e k.
      let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
      rewrite (Hinit_shift j Hjk). rewrite (Hinit_shift (ordsucc j) Hsjk).
      assume Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      assume Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      claim Hjm : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
      claim Hsjm : ordsucc j :e m. { exact (nat_trans m Hm_nat k Hk_in_m (ordsucc j) Hsjk). }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
    claim Hinit_red : reduced_word 2 Gfam efam k init_cs.
    { prove (k :e omega /\
        (forall j:set, j :e k ->
          exists alpha:set, alpha :e 2 /\
            apply_fun init_cs j :e apply_fun Gfam alpha /\
            apply_fun init_cs j <> apply_fun efam alpha)) /\
        (forall j:set, j :e k -> ordsucc j :e k ->
          forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
            apply_fun init_cs j :e apply_fun Gfam alpha ->
            apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta ->
            alpha <> beta).
      apply andI.
      - apply andI.
        + exact (nat_p_omega k Hk_nat).
        + exact Hinit_mem.
      - exact Hinit_adj. }
    (** Word product init_cs k = cx **)
    claim Hwp_m_step : word_product mult e cs m =
      apply_fun mult (word_product mult e cs k, apply_fun cs k).
    { rewrite Hm_eq.
      exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
    claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
    claim Hwpk_G : word_product mult e cs k :e G.
    { exact (word_product_in_G mult e G k cs HeG Hmult_cl
        (nat_p_omega k Hk_nat)
        (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
    claim Hcx_eq : apply_fun mult (c, x) =
      apply_fun mult (word_product mult e cs k, cskx).
    { claim Hc_eq : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
      { claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
        exact (eq_i_tra c (word_product mult e cs m)
          (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_m_step). }
      rewrite Hc_eq.
      exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
    claim Hid_wpk : apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k.
    { exact (andER
        (apply_fun mult (e, word_product mult e cs k) = word_product mult e cs k)
        (apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k)
        (Hid (word_product mult e cs k) Hwpk_G)). }
    claim Hcx_wpk : apply_fun mult (c, x) = word_product mult e cs k.
    { rewrite Hcx_eq. rewrite Hcskx_e. exact Hid_wpk. }
    claim Hwp_init_cs : word_product mult e init_cs k = word_product mult e cs k.
    { exact (word_product_agree mult e init_cs cs k (nat_p_omega k Hk_nat) Hinit_shift). }
    claim Hwp_init_cx : word_product mult e init_cs k = apply_fun mult (c, x).
    { claim Hcx_wpk_rev : word_product mult e cs k = apply_fun mult (c, x). { symmetry. exact Hcx_wpk. }
      exact (eq_i_tra (word_product mult e init_cs k) (word_product mult e cs k)
        (apply_fun mult (c, x)) Hwp_init_cs Hcx_wpk_rev). }
    (** Uniqueness gives n_c = k **)
    claim Hnc_k : n_c = k.
    { exact (andEL (n_c = k)
        (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun init_cs i)
        (Huniq_clause k init_cs Hinit_red Hk_ne0 Hwp_init_cx)). }
    (** Contradiction: ordsucc m = k and m = ordsucc k **)
    claim Hnc_sm_rev : ordsucc m = n_c. { symmetry. exact Hnc_sm. }
    claim Hsm_eq_k : ordsucc m = k.
    { exact (eq_i_tra (ordsucc m) n_c k Hnc_sm_rev Hnc_k). }
    claim Hsk_eq_k : ordsucc (ordsucc k) = k.
    { claim Hord_sm : ordsucc (ordsucc k) = ordsucc m. { rewrite Hm_eq. reflexivity. }
      exact (eq_i_tra (ordsucc (ordsucc k)) (ordsucc m) k Hord_sm Hsm_eq_k). }
    claim Hsk_in_ssk : ordsucc k :e ordsucc (ordsucc k). { exact (ordsuccI2 (ordsucc k)). }
    claim Hsk_in_k : ordsucc k :e k.
    { exact (Hsk_eq_k (fun a _:set => ordsucc k :e a) Hsk_in_ssk). }
    exact (In_irref k (nat_trans k Hk_nat (ordsucc k) Hsk_in_k k (ordsuccI2 k))).
- assume Hcskx_ne : cskx <> e.
  (** Build merged_cs = [cs(0),...,cs(k-1), cskx] of length m **)
  set merged_cs := graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)).
  claim Hmerged_k : apply_fun merged_cs k = cskx.
  { claim Hkk : k = k. { reflexivity. }
    rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) k Hk_in_m).
    exact (If_i_1 (k = k) cskx (apply_fun cs k) Hkk). }
  claim Hmerged_agree : forall j:set, j :e m -> j <> k -> apply_fun merged_cs j = apply_fun cs j.
  { let j. assume Hjm : j :e m. assume Hjnek : j <> k.
    rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) j Hjm).
    exact (If_i_0 (j = k) cskx (apply_fun cs j) Hjnek). }
  (** Word product of merged_cs = cx **)
  claim Hwp_merged_sk : word_product mult e merged_cs (ordsucc k) =
    apply_fun mult (word_product mult e merged_cs k, apply_fun merged_cs k).
  { exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun merged_cs i)) k Hk_nat). }
  claim Hmerged_wp_step : word_product mult e merged_cs m =
    apply_fun mult (word_product mult e merged_cs k, apply_fun merged_cs k).
  { exact (Hm_eq (fun _ b:set => word_product mult e merged_cs b =
      apply_fun mult (word_product mult e merged_cs k, apply_fun merged_cs k)) Hwp_merged_sk). }
  claim Hinit_agree : forall j:set, j :e k -> apply_fun merged_cs j = apply_fun cs j.
  { let j. assume Hjk : j :e k.
    exact (Hmerged_agree j (nat_trans m Hm_nat k Hk_in_m j Hjk)
      (fun Hjek : j = k => In_irref k (Hjek (fun a _:set => a :e k) Hjk))). }
  claim Hwp_merged_k : word_product mult e merged_cs k = word_product mult e cs k.
  { exact (word_product_agree mult e merged_cs cs k (nat_p_omega k Hk_nat) Hinit_agree). }
  claim Hwpk_G : word_product mult e cs k :e G.
  { exact (word_product_in_G mult e G k cs HeG Hmult_cl
      (nat_p_omega k Hk_nat)
      (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
  claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
  claim Hwp_m_step : word_product mult e cs m =
    apply_fun mult (word_product mult e cs k, apply_fun cs k).
  { rewrite Hm_eq.
    exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
  claim Hc_eq : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
  { claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
    exact (eq_i_tra c (word_product mult e cs m)
      (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_m_step). }
  claim Hcx_eq : apply_fun mult (c, x) = apply_fun mult (word_product mult e cs k, cskx).
  { rewrite Hc_eq.
    exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
  claim Hwp_merged_cx : word_product mult e merged_cs m = apply_fun mult (c, x).
  { rewrite Hmerged_wp_step. rewrite Hmerged_k. rewrite Hwp_merged_k.
    symmetry. exact Hcx_eq. }
  (** Show merged_cs is reduced **)
  claim Hmerged_mem : forall j:set, j :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun merged_cs j :e apply_fun Gfam alpha /\
      apply_fun merged_cs j <> apply_fun efam alpha.
  { let j. assume Hjm : j :e m.
    apply (xm (j = k)).
    - assume Hjk : j = k.
      rewrite Hjk. rewrite Hmerged_k.
      witness 0. apply and3I.
      + exact In_0_2.
      + rewrite HGfam0. exact Hcskx_G1.
      + rewrite Hefam0. exact Hcskx_ne.
    - assume Hjnek : j <> k.
      rewrite (Hmerged_agree j Hjm Hjnek). exact (Hcs_mem j Hjm). }
  claim Hmerged_adj : forall j:set, j :e m -> ordsucc j :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun merged_cs j :e apply_fun Gfam alpha ->
      apply_fun merged_cs (ordsucc j) :e apply_fun Gfam beta ->
      alpha <> beta.
  { let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hmj_al : apply_fun merged_cs j :e apply_fun Gfam alpha.
    assume Hmsj_be : apply_fun merged_cs (ordsucc j) :e apply_fun Gfam beta.
    (** Neither j nor ordsucc j can be k since ordsucc j :e m = ordsucc k means ordsucc j :e ordsucc k **)
    (** ordsucc j :e ordsucc k means ordsucc j :e k or ordsucc j = k **)
    apply (xm (ordsucc j = k)).
    - assume Hsjk : ordsucc j = k.
      (** j is just before k; merged_cs(j) = cs(j), merged_cs(ordsucc j) = merged_cs(k) = cskx **)
      claim Hjnek : j <> k.
      { assume Hjek : j = k.
        claim Hsjsk : ordsucc j = ordsucc k.
        { rewrite Hjek. reflexivity. }
        claim Hsj_eq_m : ordsucc j = m.
        { rewrite Hsjsk. symmetry. exact Hm_eq. }
        exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
      claim Hmerged_j_eq : apply_fun merged_cs j = apply_fun cs j. { exact (Hmerged_agree j Hjm Hjnek). }
      claim Hmerged_sj_eq : apply_fun merged_cs (ordsucc j) = cskx.
      { rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) (ordsucc j) Hsjm).
        exact (If_i_1 (ordsucc j = k) cskx (apply_fun cs (ordsucc j)) Hsjk). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { exact (Hmerged_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
      claim Hcskx_be : cskx :e apply_fun Gfam beta.
      { exact (Hmerged_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
      assume Haleqbe : alpha = beta.
      (** alpha = beta, cs(j) in Gfam(alpha), cskx in Gfam(beta) = Gfam(alpha) **)
      (** cs(k) in G1 = Gfam(0), and by Hcs_adj j: alpha <> factor of cs(ordsucc j) = cs(k) **)
      claim Hcsk_Gfam0 : apply_fun cs k :e apply_fun Gfam 0.
      { rewrite HGfam0. exact Hcsk_G1. }
      claim Hsjm2 : ordsucc j :e m. { exact Hsjm. }
      claim Hcssk_Gfam0 : apply_fun cs (ordsucc j) :e apply_fun Gfam 0.
      { rewrite Hsjk. exact Hcsk_Gfam0. }
      claim Hal_ne_0 : alpha <> 0.
      { exact (Hcs_adj j Hjm Hsjm2 alpha 0 Hal2 In_0_2 Hcsj_al Hcssk_Gfam0). }
      (** cskx in Gfam(beta) and G1 = Gfam(0). If beta <> 0, cskx in Gfam(beta) inter Gfam(0) = {e}. **)
      claim Hbe_ne_0 : beta <> 0.
      { rewrite <- Haleqbe. exact Hal_ne_0. }
      claim Hcskx_Gfam0 : cskx :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcskx_G1. }
      exact (Hcskx_ne (Hinter beta 0 Hbe2 In_0_2 Hbe_ne_0 cskx Hcskx_be Hcskx_Gfam0)).
    - assume Hsjnek : ordsucc j <> k.
      (** Both j and ordsucc j are < k, so merged_cs agrees with cs **)
      claim Hjnek : j <> k.
      { assume Hjek : j = k.
        claim Hsjsk : ordsucc j = ordsucc k.
        { rewrite Hjek. reflexivity. }
        claim Hsj_eq_m : ordsucc j = m. { rewrite Hsjsk. symmetry. exact Hm_eq. }
        exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
      claim Hmerged_j_eq2 : apply_fun merged_cs j = apply_fun cs j. { exact (Hmerged_agree j Hjm Hjnek). }
      claim Hmerged_sj_eq2 : apply_fun merged_cs (ordsucc j) = apply_fun cs (ordsucc j).
      { exact (Hmerged_agree (ordsucc j) Hsjm Hsjnek). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { exact (Hmerged_j_eq2 (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
      claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      { exact (Hmerged_sj_eq2 (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
  claim Hmerged_red : reduced_word 2 Gfam efam m merged_cs.
  { prove (m :e omega /\
      (forall j:set, j :e m ->
        exists alpha:set, alpha :e 2 /\
          apply_fun merged_cs j :e apply_fun Gfam alpha /\
          apply_fun merged_cs j <> apply_fun efam alpha)) /\
      (forall j:set, j :e m -> ordsucc j :e m ->
        forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
          apply_fun merged_cs j :e apply_fun Gfam alpha ->
          apply_fun merged_cs (ordsucc j) :e apply_fun Gfam beta ->
          alpha <> beta).
    apply andI.
    - apply andI.
      + exact Hm_omega.
      + exact Hmerged_mem.
    - exact Hmerged_adj. }
  (** Uniqueness: n_c = m, but n_c = ordsucc m. Contradiction. **)
  claim Hnc_m : n_c = m.
  { exact (andEL (n_c = m)
      (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun merged_cs i)
      (Huniq_clause m merged_cs Hmerged_red Hmne Hwp_merged_cx)). }
  claim Hnc_m_rev : m = n_c. { symmetry. exact Hnc_m. }
  claim Hm_eq_sm : m = ordsucc m.
  { exact (eq_i_tra m n_c (ordsucc m) Hnc_m_rev Hnc_sm). }
  claim Hm_in_sm : m :e ordsucc m. { exact (ordsuccI2 m). }
  claim Hm_in_m : m :e m.
  { exact (Hm_eq_sm (fun _ b:set => m :e b) Hm_in_sm). }
  exact (In_irref m Hm_in_m).
Qed.

(** Sub-sub-helper: Both cskx and ycs0 nonzero in the G1-first-G2 case **)
(** Build back-merged and front-merged words of length m, uniqueness gives x = e **)
Lemma ex68_3_case_G1_first_G2_both_ne : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e -> apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G1 ->
  apply_fun cs 0 :e G2 ->
  apply_fun mult (apply_fun cs k, x) <> e ->
  apply_fun mult (apply_fun mult (apply_fun mult (c, x), apply_fun inv c), apply_fun cs 0) <> e ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G1 : apply_fun cs k :e G1.
assume Hcs0_G2 : apply_fun cs 0 :e G2.
set cskx := apply_fun mult (apply_fun cs k, x).
assume Hcskx_ne : cskx <> e.
set ycs0 := apply_fun mult (y, apply_fun cs 0).
assume Hycs0_ne : ycs0 <> e.
(** Extract free product **)
apply (and5E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall a b z:set, a :e G -> b :e G -> z :e G ->
    apply_fun mult (apply_fun mult (a, b), z) = apply_fun mult (a, apply_fun mult (b, z)))
  (forall z:set, z :e G -> apply_fun mult (e, z) = z /\ apply_fun mult (z, e) = z)
  (forall z:set, z :e G ->
    apply_fun mult (z, apply_fun inv z) = e /\ apply_fun mult (apply_fun inv z, z) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
apply (and4E
  (G1 c= G) (e :e G1) (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E
  (G2 c= G) (e :e G2) (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim Hmult_cl : forall a b:set, a :e G -> b :e G -> apply_fun mult (a, b) :e G.
{ let a b. assume HaG : a :e G. assume HbG : b :e G.
  exact (HmultF (a, b) (tuple_2_setprod_by_pair_Sigma G G a b HaG HbG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim Hcskx_G1 : cskx :e G1. { exact (HG1mult (apply_fun cs k) x Hcsk_G1 HxG1). }
claim Hycs0_G2 : ycs0 :e G2. { exact (HG2mult y (apply_fun cs 0) HyG2 Hcs0_G2). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (Hmult_cl c x HcG HxG). }
(** cs membership helper **)
claim Hcs_G : forall j:set, j :e m -> apply_fun cs j :e G.
{ let j. assume Hjm : j :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
    (fun al:set => apply_fun cs j <> apply_fun efam al) (Hcs_mem j Hjm)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs j :e apply_fun Gfam al. assume Hne.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  apply (ordsuccE 1 al Hal2).
  - assume Hal01 : al :e 1. apply (ordsuccE 0 al Hal01).
    + assume Hal_empty : al :e 0. exact (EmptyE al Hal_empty (apply_fun cs j :e G)).
    + assume Hal0 : al = 0.
      exact (HG1sub (apply_fun cs j)
        (HGfam0 (fun a _:set => apply_fun cs j :e a)
          (Hal0 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))).
  - assume Hal1 : al = 1.
    exact (HG2sub (apply_fun cs j)
      (HGfam1 (fun a _:set => apply_fun cs j :e a)
        (Hal1 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))). }
(** Build back-merged word: replace cs(k) with cskx **)
set back_cs := graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)).
claim Hback_k : apply_fun back_cs k = cskx.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) k Hk_in_m).
  claim Hkk : k = k. { reflexivity. }
  exact (If_i_1 (k = k) cskx (apply_fun cs k) Hkk). }
claim Hback_ne_k : forall j:set, j :e m -> j <> k -> apply_fun back_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjnek : j <> k.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = k) cskx (apply_fun cs j) Hjnek). }
(** Build front-merged word: replace cs(0) with ycs0 **)
set front_cs := graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)).
claim Hfront_0 : apply_fun front_cs 0 = ycs0.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) 0 H0_in_m).
  exact (If_i_1 (0 = 0) ycs0 (apply_fun cs 0) H00). }
claim Hfront_ne_0 : forall j:set, j :e m -> j <> 0 -> apply_fun front_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjne0 : j <> 0.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = 0) ycs0 (apply_fun cs j) Hjne0). }
(** Both words are reduced: prove membership and adjacency **)
(** For brevity, prove these via claim blocks. Membership: **)
claim Hback_mem : forall j:set, j :e m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun back_cs j :e apply_fun Gfam alpha /\
    apply_fun back_cs j <> apply_fun efam alpha.
{ let j. assume Hjm : j :e m.
  apply (xm (j = k)).
  - assume Hjk : j = k.
    (** back_cs(k) = cskx in G1 = Gfam(0), cskx ne e = efam(0) **)
    claim Hbj_eq : apply_fun back_cs j = cskx.
    { exact (Hjk (fun _ b:set => apply_fun back_cs b = cskx) Hback_k). }
    witness 0. apply and3I.
    + exact In_0_2.
    + exact (Hbj_eq (fun _ b:set => b :e apply_fun Gfam 0)
        (HGfam0 (fun _ b:set => cskx :e b) (Hcskx_G1))).
    + rewrite Hbj_eq. rewrite Hefam0. exact Hcskx_ne.
  - assume Hjnek : j <> k.
    claim Hbj_eq : apply_fun back_cs j = apply_fun cs j. { exact (Hback_ne_k j Hjm Hjnek). }
    apply (Hcs_mem j Hjm). let al.
    assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
      apply_fun cs j <> apply_fun efam al.
    witness al. apply and3I.
    + exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
        (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)).
    + exact (Hbj_eq (fun _ b:set => b :e apply_fun Gfam al)
        (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj))).
    + exact (Hbj_eq (fun _ b:set => b <> apply_fun efam al)
        (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
(** Front membership **)
claim Hfront_mem : forall j:set, j :e m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun front_cs j :e apply_fun Gfam alpha /\
    apply_fun front_cs j <> apply_fun efam alpha.
{ let j. assume Hjm : j :e m.
  apply (xm (j = 0)).
  - assume Hj0 : j = 0.
    claim Hfj_eq : apply_fun front_cs j = ycs0.
    { exact (Hj0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
    witness 1. apply and3I.
    + exact In_1_2.
    + exact (Hfj_eq (fun _ b:set => b :e apply_fun Gfam 1)
        (HGfam1 (fun _ b:set => ycs0 :e b) Hycs0_G2)).
    + rewrite Hfj_eq. rewrite Hefam1. exact Hycs0_ne.
  - assume Hjne0 : j <> 0.
    claim Hfj_eq : apply_fun front_cs j = apply_fun cs j. { exact (Hfront_ne_0 j Hjm Hjne0). }
    apply (Hcs_mem j Hjm). let al.
    assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
      apply_fun cs j <> apply_fun efam al.
    witness al. apply and3I.
    + exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
        (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)).
    + exact (Hfj_eq (fun _ b:set => b :e apply_fun Gfam al)
        (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj))).
    + exact (Hfj_eq (fun _ b:set => b <> apply_fun efam al)
        (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
(** Back adjacency **)
claim Hback_adj : forall j:set, j :e m -> ordsucc j :e m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun back_cs j :e apply_fun Gfam alpha ->
    apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hmj_al : apply_fun back_cs j :e apply_fun Gfam alpha.
  assume Hmsj_be : apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta.
  apply (xm (ordsucc j = k)).
  - assume Hsjk : ordsucc j = k.
    claim Hjnek : j <> k.
    { assume Hjek : j = k.
      claim Hsj_eq_m : ordsucc j = m.
      { claim Hsjsk : ordsucc j = ordsucc k. { rewrite Hjek. reflexivity. }
        rewrite Hsjsk. symmetry. exact Hm_eq. }
      exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
    claim Hback_j_eq : apply_fun back_cs j = apply_fun cs j. { exact (Hback_ne_k j Hjm Hjnek). }
    claim Hback_sj_eq : apply_fun back_cs (ordsucc j) = cskx.
    { rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) (ordsucc j) Hsjm).
      exact (If_i_1 (ordsucc j = k) cskx (apply_fun cs (ordsucc j)) Hsjk). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hback_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcskx_be : cskx :e apply_fun Gfam beta.
    { exact (Hback_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    assume Haleqbe : alpha = beta.
    claim Hcsk_Gfam0 : apply_fun cs k :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcsk_G1. }
    claim Hcssk_Gfam0 : apply_fun cs (ordsucc j) :e apply_fun Gfam 0.
    { exact (Hsjk (fun _ b:set => apply_fun cs b :e apply_fun Gfam 0) Hcsk_Gfam0). }
    claim Hal_ne_0 : alpha <> 0.
    { exact (Hcs_adj j Hjm Hsjm alpha 0 Hal2 In_0_2 Hcsj_al Hcssk_Gfam0). }
    claim Hbe_ne_0 : beta <> 0. { rewrite <- Haleqbe. exact Hal_ne_0. }
    claim Hcskx_Gfam0 : cskx :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcskx_G1. }
    exact (Hcskx_ne (Hinter beta 0 Hbe2 In_0_2 Hbe_ne_0 cskx Hcskx_be Hcskx_Gfam0)).
  - assume Hsjnek : ordsucc j <> k.
    claim Hjnek : j <> k.
    { assume Hjek : j = k.
      claim Hsj_eq_m : ordsucc j = m.
      { claim Hsjsk : ordsucc j = ordsucc k. { rewrite Hjek. reflexivity. }
        rewrite Hsjsk. symmetry. exact Hm_eq. }
      exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
    claim Hback_j_eq2 : apply_fun back_cs j = apply_fun cs j. { exact (Hback_ne_k j Hjm Hjnek). }
    claim Hback_sj_eq2 : apply_fun back_cs (ordsucc j) = apply_fun cs (ordsucc j).
    { exact (Hback_ne_k (ordsucc j) Hsjm Hsjnek). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hback_j_eq2 (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
    { exact (Hback_sj_eq2 (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
(** Front adjacency **)
claim Hfront_adj : forall j:set, j :e m -> ordsucc j :e m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun front_cs j :e apply_fun Gfam alpha ->
    apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hmj_al : apply_fun front_cs j :e apply_fun Gfam alpha.
  assume Hmsj_be : apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta.
  claim Hsj_ne0 : ordsucc j <> 0.
  { assume Hsj0 : ordsucc j = 0.
    exact (EmptyE j (Hsj0 (fun a _:set => j :e a) (ordsuccI2 j))). }
  claim Hfront_sj_eq : apply_fun front_cs (ordsucc j) = apply_fun cs (ordsucc j).
  { exact (Hfront_ne_0 (ordsucc j) Hsjm Hsj_ne0). }
  claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
  { exact (Hfront_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
  apply (xm (j = 0)).
  - assume Hj0 : j = 0.
    claim Hfront_j_eq : apply_fun front_cs j = ycs0.
    { exact (Hj0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
    claim Hycs0_al : ycs0 :e apply_fun Gfam alpha.
    { exact (Hfront_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1. { rewrite HGfam1. exact Hcs0_G2. }
    claim Hcsj_Gfam1 : apply_fun cs j :e apply_fun Gfam 1.
    { exact (Hj0 (fun _ b:set => apply_fun cs b :e apply_fun Gfam 1) Hcs0_Gfam1). }
    assume Haleqbe : alpha = beta.
    apply (xm (alpha = 1)).
    + assume Hal1 : alpha = 1.
      claim Hcssj_Gfam1 : apply_fun cs (ordsucc j) :e apply_fun Gfam 1.
      { claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
        exact (Hbe1 (fun a _:set => apply_fun cs (ordsucc j) :e apply_fun Gfam a) Hcssj_be). }
      claim H1ne1 : 1 <> 1.
      { exact (Hcs_adj j Hjm Hsjm 1 1 In_1_2 In_1_2 Hcsj_Gfam1 Hcssj_Gfam1). }
      claim H1eq1 : 1 = 1. { reflexivity. }
      exact (H1ne1 H1eq1).
    + assume Hal_ne1 : alpha <> 1.
      claim Hycs0_Gfam1 : ycs0 :e apply_fun Gfam 1. { rewrite HGfam1. exact Hycs0_G2. }
      exact (Hycs0_ne (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 ycs0 Hycs0_al Hycs0_Gfam1)).
  - assume Hj_ne0 : j <> 0.
    claim Hfront_j_eq : apply_fun front_cs j = apply_fun cs j. { exact (Hfront_ne_0 j Hjm Hj_ne0). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hfront_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
(** Reduced words **)
claim Hback_red : reduced_word 2 Gfam efam m back_cs.
{ prove (m :e omega /\
    (forall j:set, j :e m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun back_cs j :e apply_fun Gfam alpha /\
        apply_fun back_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e m -> ordsucc j :e m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun back_cs j :e apply_fun Gfam alpha ->
        apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI. + exact Hm_omega. + exact Hback_mem.
  - exact Hback_adj. }
claim Hfront_red : reduced_word 2 Gfam efam m front_cs.
{ prove (m :e omega /\
    (forall j:set, j :e m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun front_cs j :e apply_fun Gfam alpha /\
        apply_fun front_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e m -> ordsucc j :e m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun front_cs j :e apply_fun Gfam alpha ->
        apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI. + exact Hm_omega. + exact Hfront_mem.
  - exact Hfront_adj. }
(** Word product of back_cs = cx **)
claim Hback_agree : forall j:set, j :e k -> apply_fun back_cs j = apply_fun cs j.
{ let j. assume Hjk : j :e k.
  exact (Hback_ne_k j (nat_trans m Hm_nat k Hk_in_m j Hjk)
    (fun Hjek : j = k => In_irref k (Hjek (fun a _:set => a :e k) Hjk))). }
claim Hwpk_G : word_product mult e cs k :e G.
{ exact (word_product_in_G mult e G k cs HeG Hmult_cl
    (nat_p_omega k Hk_nat)
    (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
claim Hwp_back_k : word_product mult e back_cs k = word_product mult e cs k.
{ exact (word_product_agree mult e back_cs cs k (nat_p_omega k Hk_nat) Hback_agree). }
claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
claim Hwp_cs_step : word_product mult e cs m =
  apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ rewrite Hm_eq.
  exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
claim Hc_decomp : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
  exact (eq_i_tra c (word_product mult e cs m)
    (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_cs_step). }
claim Hcx_eq_wpk : apply_fun mult (c, x) = apply_fun mult (word_product mult e cs k, cskx).
{ rewrite Hc_decomp.
  exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
claim Hwp_back : word_product mult e back_cs m = apply_fun mult (c, x).
{ claim Hwp_step : word_product mult e back_cs (ordsucc k) =
    apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k).
  { exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun back_cs i)) k Hk_nat). }
  claim Hwp_back_m : word_product mult e back_cs m =
    apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k).
  { exact (Hm_eq (fun _ b:set => word_product mult e back_cs b =
      apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k)) Hwp_step). }
  rewrite Hwp_back_m. rewrite Hback_k. rewrite Hwp_back_k.
  symmetry. exact Hcx_eq_wpk. }
(** Word product of front_cs = cx **)
(** First derive cx = yc **)
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
claim Hcx_id : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_id. }
(** Use word_product_prepend to compute both word products **)
set shifted_cs := graph k (fun i:set => apply_fun cs (ordsucc i)).
claim Hshifted_eval : forall i:set, i :e k -> apply_fun shifted_cs i = apply_fun cs (ordsucc i).
{ let i. assume Hik : i :e k.
  exact (apply_fun_graph k (fun i:set => apply_fun cs (ordsucc i)) i Hik). }
claim Hshifted_G : forall i:set, i :e k -> apply_fun shifted_cs i :e G.
{ let i. assume Hik : i :e k.
  rewrite (Hshifted_eval i Hik).
  claim Hsi_m : ordsucc i :e m.
  { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
  exact (Hcs_G (ordsucc i) Hsi_m). }
claim Hcs_shift : forall i:set, i :e k -> apply_fun cs (ordsucc i) = apply_fun shifted_cs i.
{ let i. assume Hik : i :e k. symmetry. exact (Hshifted_eval i Hik). }
claim Hycs0_G : ycs0 :e G. { exact (HG2sub ycs0 Hycs0_G2). }
claim Hfront_shift : forall i:set, i :e k -> apply_fun front_cs (ordsucc i) = apply_fun shifted_cs i.
{ let i. assume Hik : i :e k.
  claim Hsi_ne0 : ordsucc i <> 0.
  { assume Hsi0 : ordsucc i = 0.
    exact (EmptyE i (Hsi0 (fun a _:set => i :e a) (ordsuccI2 i))). }
  claim Hsi_m : ordsucc i :e m.
  { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
  claim Hfront_si : apply_fun front_cs (ordsucc i) = apply_fun cs (ordsucc i).
  { exact (Hfront_ne_0 (ordsucc i) Hsi_m Hsi_ne0). }
  rewrite Hfront_si. exact (Hcs_shift i Hik). }
claim Hcs0_G : apply_fun cs 0 :e G. { exact (HG2sub (apply_fun cs 0) Hcs0_G2). }
claim Hcs_prepend : word_product mult e cs (ordsucc k) =
  apply_fun mult (apply_fun cs 0, word_product mult e shifted_cs k).
{ exact (word_product_prepend mult e G k shifted_cs cs
    HeG Hid Hmult_cl Hassoc Hcs0_G (nat_p_omega k Hk_nat)
    Hshifted_G Hcs_shift). }
claim Hfront_prepend_raw : word_product mult e front_cs (ordsucc k) =
  apply_fun mult (apply_fun front_cs 0, word_product mult e shifted_cs k).
{ exact (word_product_prepend mult e G k shifted_cs front_cs
    HeG Hid Hmult_cl Hassoc
    (Hfront_0 (fun _ b:set => b :e G) Hycs0_G)
    (nat_p_omega k Hk_nat)
    Hshifted_G Hfront_shift). }
claim Hfront_prepend : word_product mult e front_cs (ordsucc k) =
  apply_fun mult (ycs0, word_product mult e shifted_cs k).
{ rewrite Hfront_prepend_raw. rewrite Hfront_0. reflexivity. }
claim Hsp_G : word_product mult e shifted_cs k :e G.
{ exact (word_product_in_G mult e G k shifted_cs HeG Hmult_cl
    (nat_p_omega k Hk_nat) Hshifted_G). }
claim Hcs0_sp_eq_c : apply_fun mult (apply_fun cs 0, word_product mult e shifted_cs k) = c.
{ claim Hwp_cs_sk : word_product mult e cs (ordsucc k) = c.
  { exact (Hm_eq (fun a _:set => word_product mult e cs a = c) Hprod). }
  rewrite <- Hcs_prepend. exact Hwp_cs_sk. }
claim Hwp_front : word_product mult e front_cs m = apply_fun mult (c, x).
{ claim Hwp_front_sk : word_product mult e front_cs (ordsucc k) =
    apply_fun mult (ycs0, word_product mult e shifted_cs k).
  { exact Hfront_prepend. }
  claim Hwp_front_m : word_product mult e front_cs m =
    apply_fun mult (ycs0, word_product mult e shifted_cs k).
  { exact (Hm_eq (fun _ b:set => word_product mult e front_cs b =
      apply_fun mult (ycs0, word_product mult e shifted_cs k)) Hwp_front_sk). }
  claim Hassoc_ycs0 : apply_fun mult (ycs0, word_product mult e shifted_cs k) =
    apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e shifted_cs k)).
  { exact (Hassoc y (apply_fun cs 0) (word_product mult e shifted_cs k)
      (HG2sub y HyG2) Hcs0_G Hsp_G). }
  claim Hwp_front_yc : word_product mult e front_cs m = apply_fun mult (y, c).
  { rewrite Hwp_front_m. rewrite Hassoc_ycs0. rewrite Hcs0_sp_eq_c. reflexivity. }
  claim Hyc_eq_cx : apply_fun mult (y, c) = apply_fun mult (c, x).
  { symmetry. exact Hcx_eq_yc. }
  rewrite Hwp_front_yc. exact Hyc_eq_cx. }
(** Apply uniqueness to cx **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxs_c_conj :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply (and4E
  (reduced_word 2 Gfam efam n_c xs_c)
  (n_c <> 0)
  (word_product mult e xs_c n_c = apply_fun mult (c, x))
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
  Hxs_c_conj).
assume Hred_c Hnc_ne Hprod_c Huniq_clause.
(** Apply uniqueness to both words **)
claim Huniq_back : n_c = m /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i).
{ exact (Huniq_clause m back_cs Hback_red Hmne Hwp_back). }
claim Hnc_m : n_c = m.
{ exact (andEL (n_c = m) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i)
    Huniq_back). }
claim Hxsc_eq_back : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i.
{ exact (andER (n_c = m) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i)
    Huniq_back). }
claim Huniq_front : n_c = m /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun front_cs i).
{ exact (Huniq_clause m front_cs Hfront_red Hmne Hwp_front). }
claim Hxsc_eq_front : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun front_cs i.
{ exact (andER (n_c = m) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun front_cs i)
    Huniq_front). }
(** Compare at position k **)
claim Hk_in_nc : k :e n_c. { exact (Hnc_m (fun _ b:set => k :e b) Hk_in_m). }
claim Hback_k_eq_front_k : apply_fun back_cs k = apply_fun front_cs k.
{ claim H1 : apply_fun back_cs k = apply_fun xs_c k.
  { symmetry. exact (Hxsc_eq_back k Hk_in_nc). }
  claim H2 : apply_fun xs_c k = apply_fun front_cs k.
  { exact (Hxsc_eq_front k Hk_in_nc). }
  exact (eq_i_tra (apply_fun back_cs k) (apply_fun xs_c k) (apply_fun front_cs k) H1 H2). }
(** back_cs(k) = cskx, derive contradiction **)
claim Hcskx_eq_front_k : cskx = apply_fun front_cs k.
{ claim H : apply_fun back_cs k = apply_fun front_cs k. { exact Hback_k_eq_front_k. }
  rewrite <- Hback_k. exact H. }
apply (xm (k = 0)).
- assume Hk0 : k = 0.
  (** front_cs(0) = ycs0, so cskx = ycs0. But cskx in G1, ycs0 in G2. **)
  claim Hfront_k_ycs0 : apply_fun front_cs k = ycs0.
  { exact (Hk0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
  claim Hcskx_eq_ycs0 : cskx = ycs0.
  { rewrite Hcskx_eq_front_k. exact Hfront_k_ycs0. }
  claim Hcskx_G2 : cskx :e G2.
  { exact (Hcskx_eq_ycs0 (fun _ b:set => b :e G2) Hycs0_G2). }
  claim Hcskx_Gfam0 : cskx :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcskx_G1. }
  claim Hcskx_Gfam1 : cskx :e apply_fun Gfam 1. { rewrite HGfam1. exact Hcskx_G2. }
  exact (Hcskx_ne (Hinter 0 1 In_0_2 In_1_2 neq_0_1 cskx Hcskx_Gfam0 Hcskx_Gfam1)).
- assume Hk_ne0 : k <> 0.
  (** front_cs(k) = cs(k) since k ne 0. So cskx = cs(k). **)
  (** mult(cs(k), x) = cs(k), so x = e, contradiction **)
  claim Hfront_k_csk : apply_fun front_cs k = apply_fun cs k.
  { exact (Hfront_ne_0 k Hk_in_m Hk_ne0). }
  claim Hcskx_eq_csk : cskx = apply_fun cs k.
  { rewrite Hcskx_eq_front_k. exact Hfront_k_csk. }
  (** From cskx = cs(k): mult(inv(cs(k)), cskx) = mult(inv(cs(k)), cs(k)) = e **)
  (** Also mult(inv(cs(k)), cskx) = mult(inv(cs(k)), mult(cs(k), x)) = x by cancel **)
  claim HinvcsK_G : apply_fun inv (apply_fun cs k) :e G.
  { exact (HinvF (apply_fun cs k) Hcsk_G). }
  claim Hinvcsk_csk : apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k) = e.
  { exact (andER
      (apply_fun mult (apply_fun cs k, apply_fun inv (apply_fun cs k)) = e)
      (apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k) = e)
      (Hinverse (apply_fun cs k) Hcsk_G)). }
  claim Hcancel : apply_fun mult (apply_fun inv (apply_fun cs k), cskx) = x.
  { claim Hassoc_inv : apply_fun mult (apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k), x) =
      apply_fun mult (apply_fun inv (apply_fun cs k), cskx).
    { exact (Hassoc (apply_fun inv (apply_fun cs k)) (apply_fun cs k) x HinvcsK_G Hcsk_G HxG). }
    claim Hid_x : apply_fun mult (e, x) = x.
    { exact (andEL
        (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x)
        (Hid x HxG)). }
    claim Hex : apply_fun mult (apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k), x) = x.
    { rewrite Hinvcsk_csk. exact Hid_x. }
    rewrite <- Hassoc_inv. exact Hex. }
  claim Hcancel_e : apply_fun mult (apply_fun inv (apply_fun cs k), cskx) = e.
  { exact (Hcskx_eq_csk
      (fun _ b:set => apply_fun mult (apply_fun inv (apply_fun cs k), b) = e)
      Hinvcsk_csk). }
  claim Hx_e : x = e.
  { claim Hx_rev : x = apply_fun mult (apply_fun inv (apply_fun cs k), cskx).
    { symmetry. exact Hcancel. }
    exact (eq_i_tra x (apply_fun mult (apply_fun inv (apply_fun cs k), cskx)) e Hx_rev Hcancel_e). }
  exact (Hxne Hx_e).
Qed.

(** Sub-helper: cs(k) in G1 and cs(0) in G2 (both ends need merging) **)
(** Strategy: build back-merged [cs(0),...,cs(k-1),cskx] and front-merged [ycs0,cs(1),...,cs(k)] **)
(** Both represent cx. Uniqueness of reduced words gives contradiction. **)
Lemma ex68_3_case_G1_first_G2 : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e -> apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G1 ->
  apply_fun cs 0 :e G2 ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G1 : apply_fun cs k :e G1.
assume Hcs0_G2 : apply_fun cs 0 :e G2.
(** Extract free product components **)
apply (and5E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall a b z:set, a :e G -> b :e G -> z :e G ->
    apply_fun mult (apply_fun mult (a, b), z) = apply_fun mult (a, apply_fun mult (b, z)))
  (forall z:set, z :e G -> apply_fun mult (e, z) = z /\ apply_fun mult (z, e) = z)
  (forall z:set, z :e G ->
    apply_fun mult (z, apply_fun inv z) = e /\ apply_fun mult (apply_fun inv z, z) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E
  (G1 c= G) (e :e G1) (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E
  (G2 c= G) (e :e G2) (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (HmultF (c, x) (tuple_2_setprod_by_pair_Sigma G G c x HcG HxG)). }
claim Hmult_cl : forall a b:set, a :e G -> b :e G -> apply_fun mult (a, b) :e G.
{ let a b. assume HaG : a :e G. assume HbG : b :e G.
  exact (HmultF (a, b) (tuple_2_setprod_by_pair_Sigma G G a b HaG HbG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
(** cx = yc **)
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
claim Hcx_e : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_e. }
(** Merged definitions **)
set cskx := apply_fun mult (apply_fun cs k, x).
set ycs0 := apply_fun mult (y, apply_fun cs 0).
claim Hcskx_G1 : cskx :e G1. { exact (HG1mult (apply_fun cs k) x Hcsk_G1 HxG1). }
claim Hycs0_G2 : ycs0 :e G2. { exact (HG2mult y (apply_fun cs 0) HyG2 Hcs0_G2). }
claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
claim Hcs0_G2_g : apply_fun cs 0 :e G. { exact (HG2sub (apply_fun cs 0) Hcs0_G2). }
(** Shared infrastructure for k>0 sub-cases **)
claim Hk_omega : k :e omega. { exact (nat_p_omega k Hk_nat). }
claim Hcs_G : forall j:set, j :e m -> apply_fun cs j :e G.
{ let j. assume Hjm : j :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
    (fun al:set => apply_fun cs j <> apply_fun efam al) (Hcs_mem j Hjm)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs j :e apply_fun Gfam al. assume Hne.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  apply (ordsuccE 1 al Hal2).
  - assume Hal01 : al :e 1. apply (ordsuccE 0 al Hal01).
    + assume Hal_empty : al :e 0. exact (EmptyE al Hal_empty (apply_fun cs j :e G)).
    + assume Hal0 : al = 0.
      exact (HG1sub (apply_fun cs j)
        (HGfam0 (fun a _:set => apply_fun cs j :e a)
          (Hal0 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))).
  - assume Hal1 : al = 1.
    exact (HG2sub (apply_fun cs j)
      (HGfam1 (fun a _:set => apply_fun cs j :e a)
        (Hal1 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))). }
(** init_cs: first k entries of cs **)
set init_cs := graph k (fun j:set => apply_fun cs j).
claim Hinit_eval : forall j:set, j :e k -> apply_fun init_cs j = apply_fun cs j.
{ let j. assume Hjk : j :e k.
  exact (apply_fun_graph k (fun j:set => apply_fun cs j) j Hjk). }
(** tail_cs: entries cs(1),...,cs(k) shifted by 1 **)
set tail_cs := graph k (fun j:set => apply_fun cs (ordsucc j)).
claim Htail_eval : forall j:set, j :e k -> apply_fun tail_cs j = apply_fun cs (ordsucc j).
{ let j. assume Hjk : j :e k.
  exact (apply_fun_graph k (fun j:set => apply_fun cs (ordsucc j)) j Hjk). }
(** init_cs is reduced **)
claim Hinit_red : reduced_word 2 Gfam efam k init_cs.
{ prove (k :e omega /\
    (forall j:set, j :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun init_cs j :e apply_fun Gfam alpha /\
        apply_fun init_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e k -> ordsucc j :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun init_cs j :e apply_fun Gfam alpha ->
        apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hk_omega.
    + let j. assume Hjk : j :e k.
      claim Hjm : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
      claim Hinit_j : apply_fun init_cs j = apply_fun cs j. { exact (Hinit_eval j Hjk). }
      apply (Hcs_mem j Hjm). let al.
      assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
        apply_fun cs j <> apply_fun efam al.
      witness al. apply and3I.
      * exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)).
      * exact (Hinit_j (fun _ b:set => b :e apply_fun Gfam al)
          (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
            (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
              (apply_fun cs j <> apply_fun efam al) Hal_conj))).
      * exact (Hinit_j (fun _ b:set => b <> apply_fun efam al)
          (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)).
  - let j. assume Hjk : j :e k. assume Hsjk : ordsucc j :e k.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hmj_al : apply_fun init_cs j :e apply_fun Gfam alpha.
    assume Hmsj_be : apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta.
    claim Hjm : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
    claim Hsjm : ordsucc j :e m. { exact (nat_trans m Hm_nat k Hk_in_m (ordsucc j) Hsjk). }
    claim Hinit_j : apply_fun init_cs j = apply_fun cs j. { exact (Hinit_eval j Hjk). }
    claim Hinit_sj : apply_fun init_cs (ordsucc j) = apply_fun cs (ordsucc j).
    { exact (Hinit_eval (ordsucc j) Hsjk). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hinit_j (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
    { exact (Hinit_sj (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
(** tail_cs is reduced **)
claim Htail_red : reduced_word 2 Gfam efam k tail_cs.
{ prove (k :e omega /\
    (forall j:set, j :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun tail_cs j :e apply_fun Gfam alpha /\
        apply_fun tail_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e k -> ordsucc j :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun tail_cs j :e apply_fun Gfam alpha ->
        apply_fun tail_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hk_omega.
    + let j. assume Hjk : j :e k.
      claim Hsj_m : ordsucc j :e m.
      { exact (Hm_eq (fun _ b:set => ordsucc j :e b)
          (nat_ordsucc_in_ordsucc k Hk_nat j Hjk)). }
      claim Htail_j : apply_fun tail_cs j = apply_fun cs (ordsucc j).
      { exact (Htail_eval j Hjk). }
      apply (Hcs_mem (ordsucc j) Hsj_m). let al.
      assume Hal_conj : (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al) /\
        apply_fun cs (ordsucc j) <> apply_fun efam al.
      witness al. apply and3I.
      * exact (andEL (al :e 2) (apply_fun cs (ordsucc j) :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al)
            (apply_fun cs (ordsucc j) <> apply_fun efam al) Hal_conj)).
      * exact (Htail_j (fun _ b:set => b :e apply_fun Gfam al)
          (andER (al :e 2) (apply_fun cs (ordsucc j) :e apply_fun Gfam al)
            (andEL (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al)
              (apply_fun cs (ordsucc j) <> apply_fun efam al) Hal_conj))).
      * exact (Htail_j (fun _ b:set => b <> apply_fun efam al)
          (andER (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al)
            (apply_fun cs (ordsucc j) <> apply_fun efam al) Hal_conj)).
  - let j. assume Hjk : j :e k. assume Hsjk : ordsucc j :e k.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hmj_al : apply_fun tail_cs j :e apply_fun Gfam alpha.
    assume Hmsj_be : apply_fun tail_cs (ordsucc j) :e apply_fun Gfam beta.
    claim Hsj_m : ordsucc j :e m. { exact (nat_trans m Hm_nat k Hk_in_m (ordsucc j) Hsjk). }
    claim Hssj_m : ordsucc (ordsucc j) :e m.
    { exact (Hm_eq (fun _ b:set => ordsucc (ordsucc j) :e b)
        (nat_ordsucc_in_ordsucc k Hk_nat (ordsucc j) Hsjk)). }
    claim Htail_j : apply_fun tail_cs j = apply_fun cs (ordsucc j). { exact (Htail_eval j Hjk). }
    claim Htail_sj : apply_fun tail_cs (ordsucc j) = apply_fun cs (ordsucc (ordsucc j)).
    { exact (Htail_eval (ordsucc j) Hsjk). }
    claim Hcssj_al : apply_fun cs (ordsucc j) :e apply_fun Gfam alpha.
    { exact (Htail_j (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcsssj_be : apply_fun cs (ordsucc (ordsucc j)) :e apply_fun Gfam beta.
    { exact (Htail_sj (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    exact (Hcs_adj (ordsucc j) Hsj_m Hssj_m alpha beta Hal2 Hbe2 Hcssj_al Hcsssj_be). }
(** Word product infrastructure **)
claim Hwpk_G : word_product mult e cs k :e G.
{ exact (word_product_in_G mult e G k cs HeG Hmult_cl Hk_omega
    (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
claim Hwp_cs_step : word_product mult e cs m =
  apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ rewrite Hm_eq.
  exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
claim Hc_decomp : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
  exact (eq_i_tra c (word_product mult e cs m)
    (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_cs_step). }
claim Hwp_init_agree : word_product mult e init_cs k = word_product mult e cs k.
{ exact (word_product_agree mult e init_cs cs k Hk_omega Hinit_eval). }
claim Hcx_eq_wpk : apply_fun mult (c, x) = apply_fun mult (word_product mult e cs k, cskx).
{ rewrite Hc_decomp.
  exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
(** Tail word product via word_product_prepend **)
claim Htail_G : forall j:set, j :e k -> apply_fun tail_cs j :e G.
{ let j. assume Hjk : j :e k.
  rewrite (Htail_eval j Hjk).
  claim Hsj_m : ordsucc j :e m.
  { exact (Hm_eq (fun _ b:set => ordsucc j :e b)
      (nat_ordsucc_in_ordsucc k Hk_nat j Hjk)). }
  exact (Hcs_G (ordsucc j) Hsj_m). }
claim Hcs_shift_rev : forall j:set, j :e k -> apply_fun cs (ordsucc j) = apply_fun tail_cs j.
{ let j. assume Hjk : j :e k. symmetry. exact (Htail_eval j Hjk). }
claim Hcs_prepend_eq : word_product mult e cs (ordsucc k) =
  apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k).
{ exact (word_product_prepend mult e G k tail_cs cs
    HeG Hid Hmult_cl Hassoc Hcs0_G2_g Hk_omega
    Htail_G Hcs_shift_rev). }
claim Hsp_G : word_product mult e tail_cs k :e G.
{ exact (word_product_in_G mult e G k tail_cs HeG Hmult_cl Hk_omega Htail_G). }
claim Hcs0_sp_eq_c : apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k) = c.
{ claim Hwp_cs_sk : word_product mult e cs (ordsucc k) = c.
  { exact (Hm_eq (fun a _:set => word_product mult e cs a = c) Hprod). }
  rewrite <- Hcs_prepend_eq. exact Hwp_cs_sk. }
(** front_cs and back_cs definitions **)
set front_cs := graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)).
claim Hfront_0 : apply_fun front_cs 0 = ycs0.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) 0 H0_in_m).
  exact (If_i_1 (0 = 0) ycs0 (apply_fun cs 0) H00). }
claim Hfront_ne_0 : forall j:set, j :e m -> j <> 0 -> apply_fun front_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjne0 : j <> 0.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = 0) ycs0 (apply_fun cs j) Hjne0). }
set back_cs := graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)).
claim Hback_k : apply_fun back_cs k = cskx.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) k Hk_in_m).
  claim Hkk : k = k. { reflexivity. }
  exact (If_i_1 (k = k) cskx (apply_fun cs k) Hkk). }
claim Hback_ne_k : forall j:set, j :e m -> j <> k -> apply_fun back_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjnek : j <> k.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = k) cskx (apply_fun cs j) Hjnek). }
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim Hycs0_G : ycs0 :e G. { exact (HG2sub ycs0 Hycs0_G2). }
claim Hcskx_G : cskx :e G. { exact (HG1sub cskx Hcskx_G1). }
(** Case split on cskx = e and ycs0 = e **)
apply (xm (cskx = e)).
- assume Hcskx_e : cskx = e.
  apply (xm (ycs0 = e)).
  + assume Hycs0_e : ycs0 = e.
    (** Both zero: k=0 gives cs(0) in G1 cap G2, contradiction. k>0: entry comparison **)
    apply (xm (k = 0)).
    * assume Hk0 : k = 0.
      claim Hcs0_G1 : apply_fun cs 0 :e G1.
      { exact (Hk0 (fun a _:set => apply_fun cs a :e G1) Hcsk_G1). }
      claim Hcs0_e : apply_fun cs 0 = e.
      { exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 (apply_fun cs 0)
          (HGfam0 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G1)
          (HGfam1 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G2)). }
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
