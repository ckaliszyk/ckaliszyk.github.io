        claim HpairContProd :
          continuous_map
            (setprod (w 0) (w 1))
            (product_topology
              (w 0) (subspace_topology E Te (w 0))
              (w 1) (subspace_topology E' Te' (w 1)))
            W
            (product_topology U (subspace_topology B Tb U) U' (subspace_topology B' Tb' U'))
            (pair_map (setprod (w 0) (w 1)) f1 f2).
        {
          exact (maps_into_products
            (setprod (w 0) (w 1))
