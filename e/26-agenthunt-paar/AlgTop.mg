          forall x:set, x :e Vq ->
            apply_fun gq (apply_fun (graph Vq (fun z:set => apply_fun p z)) x) = x.
        {
          exact (andER
            (continuous_map U (subspace_topology B Tb U) Vq (subspace_topology E Te Vq) gq)
            (forall x:set, x :e Vq ->
              apply_fun gq (apply_fun (graph Vq (fun z:set => apply_fun p z)) x) = x)
            (andEL
              (continuous_map U (subspace_topology B Tb U) Vq (subspace_topology E Te Vq) gq /\
                (forall x:set, x :e Vq ->
                  apply_fun gq (apply_fun (graph Vq (fun z:set => apply_fun p z)) x) = x))
              (forall y:set, y :e U ->
                apply_fun (graph Vq (fun z:set => apply_fun p z)) (apply_fun gq y) = y)
              HgqPack)).
        }
