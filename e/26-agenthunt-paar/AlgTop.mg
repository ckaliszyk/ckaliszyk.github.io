      Hcls).
  }
  claim HcompConst :
    apply_fun
      (basepoint_change_map
        X
        Tx
        x0
        x0
        (path_concat (constant_path x0) (constant_path x0)))
      cls
    =
    apply_fun
      (compose_fun
        (fundamental_group X Tx x0)
        bc0
