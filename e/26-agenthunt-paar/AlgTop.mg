    }
    claim HuEq : u = path_homotopy_class_loop X Tx x0 fu.
    {
      exact (andER
        (fu :e loop_space X Tx x0)
        (u = path_homotopy_class_loop X Tx x0 fu)
        HuPack).
    }
    claim HfuLoopAt : loop_at X Tx x0 fu.
