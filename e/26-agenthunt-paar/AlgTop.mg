    (HyCoordFunR (x, 0) Hx0Dom)).
  rewrite (compose_fun_apply
    dom
    tproj
    flip_unit_interval
    (x, 0)
    Hx0Dom).
  rewrite (projection2_apply
    B2
    unit_interval
    (x, 0)
    Hx0Dom).
  rewrite tuple_2_1_eq.
