Axiom div_SNo_nonneg_pos_nonneg : forall x y : set , SNo x -> SNo y -> 0 <= x -> 0 < y -> 0 <= div_SNo x y.
Axiom div_SNo_minus_num : forall x y : set , SNo x -> SNo y -> y <> 0 -> div_SNo (minus_SNo x) y = minus_SNo (div_SNo x y).
