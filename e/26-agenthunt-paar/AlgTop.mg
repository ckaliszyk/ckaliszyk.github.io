      apply (ReplE_impred
        unit_interval_left_half
        (fun t:set => (t, apply_fun (reverse_path alpha) (mul_SNo 2 t)))
        p
        Hleft).
      let t.
      assume Ht Heq.
      claim H2tInI : mul_SNo 2 t :e unit_interval.
      {
        rewrite <- (double_map_apply t Ht).
        exact (double_map_function_on t Ht).
