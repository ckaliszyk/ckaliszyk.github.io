  claim Hxs_of_eq : forall i:set, i :e (n_of x0) -> apply_fun (xs_of x0) i = apply_fun xs1 i.
  { exact (andER ((n_of x0) = 1) (forall i:set, i :e (n_of x0) -> apply_fun (xs_of x0) i = apply_fun xs1 i) Huniq_app). }
