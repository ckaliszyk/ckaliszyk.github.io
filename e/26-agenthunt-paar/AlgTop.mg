    continuous_map A TA (Sn 2 :\: Sing a :\: Sing b)
      (subspace_topology (Sn 2) (Sn_topology 2) (Sn 2 :\: Sing a :\: Sing b)) f /\
    nulhomotopic A TA
      (Sn 2 :\: Sing a :\: Sing b)
      (subspace_topology (Sn 2) (Sn_topology 2) (Sn 2 :\: Sing a :\: Sing b)) f /\
    component_of (Sn 2 :\: image_of f A)
      (subspace_topology (Sn 2) (Sn_topology 2) (Sn 2 :\: image_of f A)) a <>
