Axiom ex49_density_construction_eps_lt1_piecewise_linear : forall n f eps0 r : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps0 :e R -> Rlt 0 eps0 -> Rlt eps0 1 -> r :e R -> Rlt n r -> exists g : set , g :e C_I_R /\ (forall x : set , x :e unit_interval -> Rle (R_bounded_distance (apply_fun f x) (apply_fun g x)) eps0) /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
Axiom ex49_density_construction_eps_le_1_zigzag_lt1 : forall n f eps0 r : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps0 :e R -> Rlt 0 eps0 -> Rlt eps0 1 -> r :e R -> Rlt n r -> exists g : set , g :e C_I_R /\ (forall x : set , x :e unit_interval -> Rle (R_bounded_distance (apply_fun f x) (apply_fun g x)) eps0) /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
Axiom ex49_density_construction_eps_le_1_zigzag : forall n f eps0 r : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps0 :e R -> Rlt 0 eps0 -> r :e R -> Rlt n r -> exists g : set , g :e C_I_R /\ (forall x : set , x :e unit_interval -> Rle (R_bounded_distance (apply_fun f x) (apply_fun g x)) eps0) /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
Axiom ex49_density_construction_eps_le_1_core : forall n f eps0 r : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps0 :e R -> Rlt 0 eps0 -> r :e R -> Rlt n r -> exists g : set , g :e C_I_R /\ (forall x : set , x :e unit_interval -> Rle (R_bounded_distance (apply_fun f x) (apply_fun g x)) eps0) /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
Axiom ex49_density_construction_eps_le_1 : forall n f eps r : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps :e R -> Rlt 0 eps -> ~ (Rlt 1 eps) -> r :e R -> Rlt n r -> exists g : set , g :e C_I_R /\ g :e open_ball C_I_R uniform_metric_C_I_R f eps /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
Axiom ex49_density_construction : forall n f eps r : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps :e R -> Rlt 0 eps -> r :e R -> Rlt n r -> exists g : set , g :e C_I_R /\ g :e open_ball C_I_R uniform_metric_C_I_R f eps /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
Axiom ex49_exists_open_ball_Delta_witness : forall n f eps : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps :e R -> Rlt 0 eps -> exists g : set , g :e C_I_R /\ g :e open_ball C_I_R uniform_metric_C_I_R f eps /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ exists r : set , r :e R /\ Rlt n r /\ forall x : set , x :e unit_interval -> Delta_gt g x h r.
Axiom ex49_exists_in_open_ball_U_n : forall n f eps : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps :e R -> Rlt 0 eps -> exists g : set , g :e C_I_R /\ g :e open_ball C_I_R uniform_metric_C_I_R f eps /\ g :e U_n n.
Axiom U_n_meets_open_ball_C_I_R : forall n f eps : set , n :e omega -> 2 c= n -> f :e C_I_R -> eps :e R -> Rlt 0 eps -> open_ball C_I_R uniform_metric_C_I_R f eps :/\: U_n n <> Empty.
Axiom U_n_graph_meets_open_ball : forall n c eps : set , n :e omega -> 2 c= n -> c :e C_I_R_graph -> eps :e R -> Rlt 0 eps -> open_ball C_I_R_graph uniform_metric_C_I_R_graph c eps :/\: U_n_graph n <> Empty.
Axiom U_n_graph_open_dense_uniform : forall n : set , n :e omega -> 2 c= n -> U_n_graph n :e uniform_topology_C_I_R_graph /\ dense_in (U_n_graph n) C_I_R_graph uniform_topology_C_I_R_graph.
Axiom exists_large_n_with_recip_lt_delta_local : forall L delta : set , L :e R -> delta :e R -> Rlt 0 delta -> exists n : set , n :e omega /\ 2 c= n /\ Rlt (add_SNo (Abs L) 2) n /\ Rlt (div_SNo 1 n) delta.
Axiom intersection_U_n_graph_imp_nowhere_differentiable : forall g : set , g :e intersection_over_family C_I_R_graph {U_n_graph n|n :e omega,2 c= n} -> nowhere_differentiable g.
Axiom ex30_15_CI_has_countable_dense_uniform : exists D : set , D c= C_I_R /\ countable D /\ dense_in D C_I_R uniform_topology_C_I_R /\ second_countable_space C_I_R uniform_topology_C_I_R.
Axiom ex30_16a_product_RI_countable_dense : exists D : set , D c= product_space unit_interval (const_space_family unit_interval R R_standard_topology) /\ countable D /\ dense_in D (product_space unit_interval (const_space_family unit_interval R R_standard_topology)) (product_topology_full unit_interval (const_space_family unit_interval R R_standard_topology)).
Axiom ex30_16b_large_product_no_countable_dense : forall J : set , atleastp (Power omega) J -> ~ equip J (Power omega) -> ~ (exists D : set , D c= product_space J (const_space_family J R R_standard_topology) /\ countable D /\ dense_in D (product_space J (const_space_family J R R_standard_topology)) (product_topology_full J (const_space_family J R R_standard_topology))).
Definition Q_infty : set := {f :e R_omega_space|(forall n : set , n :e omega -> apply_fun f n :e rational_numbers) /\ (exists n0 : set , n0 :e omega /\ forall m : set , m :e omega -> ~ (m :e n0) -> apply_fun f m = 0)}.
Definition Q_infty_topology : set := subspace_topology R_omega_space R_omega_box_topology Q_infty.
Axiom ex30_17_Romega_box_countability : (first_countable_space Q_infty Q_infty_topology \/ ~ first_countable_space Q_infty Q_infty_topology) /\ (second_countable_space Q_infty Q_infty_topology \/ ~ second_countable_space Q_infty Q_infty_topology) /\ (Lindelof_space Q_infty Q_infty_topology \/ ~ Lindelof_space Q_infty Q_infty_topology) /\ ((exists D : set , D c= Q_infty /\ countable D /\ dense_in D Q_infty Q_infty_topology) \/ ~ (exists D : set , D c= Q_infty /\ countable D /\ dense_in D Q_infty Q_infty_topology)).
Axiom ex30_18_first_countable_group_countable_dense_second_countable : forall G Tg : set , topological_group G Tg -> first_countable_space G Tg -> (exists D : set , D c= G /\ countable D /\ dense_in D G Tg) -> second_countable_space G Tg.
Axiom ex30_18_first_countable_group_countable_basis : forall G Tg : set , topological_group G Tg -> first_countable_space G Tg -> ((exists D : set , D c= G /\ countable D /\ dense_in D G Tg) \/ Lindelof_space G Tg) -> second_countable_space G Tg.
Axiom ex31_1_regular_disjoint_closure_neighborhoods : forall X Tx x y : set , regular_space X Tx -> x :e X -> y :e X -> x <> y -> exists U V : set , open_in X Tx U /\ open_in X Tx V /\ x :e U /\ y :e V /\ closure_of X Tx U :/\: closure_of X Tx V = Empty.
Axiom ex31_2_normal_disjoint_closure_neighborhoods : forall X Tx A B : set , normal_space X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> exists U V : set , open_in X Tx U /\ open_in X Tx V /\ A c= U /\ B c= V /\ closure_of X Tx U :/\: closure_of X Tx V = Empty.
Axiom singleton_setprod_2_omega_open_if_neq_10 : forall x : set , x :e setprod 2 omega -> x <> (1,0) -> {x} :e order_topology (setprod 2 omega).
Axiom open_in_order_topology_setprod_2_omega_if_not_10 : forall A : set , A c= setprod 2 omega -> (1,0) /:e A -> A :e order_topology (setprod 2 omega).
Axiom regular_space_order_topology_setprod_2_omega : regular_space (setprod 2 omega) (order_topology (setprod 2 omega)).
Axiom order_topology_regular_sep : forall X x F : set , simply_ordered_set X -> x :e X -> closed_in X (order_topology X) F -> x /:e F -> exists U V : set , U :e order_topology X /\ V :e order_topology X /\ x :e U /\ F c= V /\ U :/\: V = Empty.
Axiom ex31_3_order_topology_regular : forall X : set , simply_ordered_set X -> regular_space X (order_topology X).
Axiom ex31_4_comparison_topologies_separation : forall X Tx Tx' : set , topology_on X Tx -> topology_on X Tx' -> Tx c= Tx' -> ((Hausdorff_space X Tx -> Hausdorff_space X Tx') /\ (regular_space X Tx -> Hausdorff_space X Tx') /\ (normal_space X Tx -> Hausdorff_space X Tx')).
Axiom ex31_5_equalizer_closed_in_Hausdorff : forall X Tx Y Ty f g : set , continuous_map X Tx Y Ty f -> continuous_map X Tx Y Ty g -> Hausdorff_space Y Ty -> closed_in X Tx {x :e X|apply_fun f x = apply_fun g x}.
Definition closed_map : set -> set -> set -> set -> set -> prop := fun X Tx Y Ty p => function_on p X Y /\ forall A : set , closed_in X Tx A -> closed_in Y Ty (image_of p A).
Axiom ex31_6_closed_map_preserves_normal : forall X Tx Y Ty p : set , normal_space X Tx -> continuous_map X Tx Y Ty p -> closed_map X Tx Y Ty p -> (forall y : set , y :e Y -> exists x : set , x :e X /\ apply_fun p x = y) -> normal_space Y Ty.
Definition perfect_map : set -> set -> set -> set -> set -> prop := fun X Tx Y Ty p => continuous_map X Tx Y Ty p /\ closed_map X Tx Y Ty p /\ (forall y : set , y :e Y -> exists x : set , x :e X /\ apply_fun p x = y) /\ (forall y : set , y :e Y -> compact_space {x :e X|apply_fun p x = y} (subspace_topology X Tx {x :e X|apply_fun p x = y})).
Axiom ex31_7_perfect_map_properties : forall X Tx Y Ty p : set , perfect_map X Tx Y Ty p -> (Hausdorff_space X Tx -> Hausdorff_space Y Ty) /\ (regular_space X Tx -> regular_space Y Ty) /\ (locally_compact X Tx -> locally_compact Y Ty) /\ (second_countable_space X Tx -> second_countable_space Y Ty).
Axiom ex31_8_orbit_space_properties : forall G Tg X Tx alpha : set , topological_group G Tg -> compact_space G Tg -> (Hausdorff_space X Tx -> exists XG TxG : set , Hausdorff_space XG TxG) /\ (regular_space X Tx -> exists XG TxG : set , regular_space XG TxG) /\ (normal_space X Tx -> exists XG TxG : set , normal_space XG TxG) /\ (locally_compact X Tx -> exists XG TxG : set , locally_compact XG TxG) /\ (second_countable_space X Tx -> exists XG TxG : set , second_countable_space XG TxG).
Axiom ex32_1_closed_subspace_normal : forall X Tx A : set , normal_space X Tx -> closed_in X Tx A -> normal_space A (subspace_topology X Tx A).
Definition pick_family_point : set -> set -> set -> set := fun Idx Fam i => Eps_i (fun x : set => x :e space_family_set Fam i).
Axiom pick_family_point_mem : forall Idx Fam i : set , space_family_set Fam i <> Empty -> pick_family_point Idx Fam i :e space_family_set Fam i.
Axiom product_space_nonempty_of_factors_nonempty : forall Idx Fam : set , (forall i : set , i :e Idx -> space_family_set Fam i <> Empty) -> product_space Idx Fam <> Empty.
Definition product_factor_inclusion_seq : set -> set -> set -> set -> set := fun Idx Fam i x => graph Idx (fun j : set => if j = i then x else pick_family_point Idx Fam j).
Axiom product_factor_inclusion_seq_in_product_space : forall Idx Fam i x : set , (forall j : set , j :e Idx -> space_family_set Fam j <> Empty) -> i :e Idx -> x :e space_family_set Fam i -> product_factor_inclusion_seq Idx Fam i x :e product_space Idx Fam.
Axiom product_factor_inclusion_seq_apply_i : forall Idx Fam i x : set , i :e Idx -> apply_fun (product_factor_inclusion_seq Idx Fam i x) i = x.
Definition product_factor_inclusion_map : set -> set -> set -> set := fun Idx Fam i => graph (space_family_set Fam i) (fun x : set => product_factor_inclusion_seq Idx Fam i x).
Axiom product_factor_inclusion_map_function_on : forall Idx Fam i : set , (forall j : set , j :e Idx -> space_family_set Fam j <> Empty) -> i :e Idx -> function_on (product_factor_inclusion_map Idx Fam i) (space_family_set Fam i) (product_space Idx Fam).
Axiom product_factor_inclusion_map_continuous_prod : forall Idx Fam i : set , (forall j : set , j :e Idx -> topology_on (space_family_set Fam j) (space_family_topology Fam j)) -> (forall j : set , j :e Idx -> space_family_set Fam j <> Empty) -> i :e Idx -> continuous_map (space_family_set Fam i) (space_family_topology Fam i) (product_space Idx Fam) (product_topology_full Idx Fam) (product_factor_inclusion_map Idx Fam i).
Axiom ex32_2_factors_inherit_separation : forall Idx Fam : set , (forall j : set , j :e Idx -> topology_on (space_family_set Fam j) (space_family_topology Fam j)) -> (forall j : set , j :e Idx -> space_family_set Fam j <> Empty) -> ((Hausdorff_space (product_space Idx Fam) (product_topology_full Idx Fam) -> forall i : set , i :e Idx -> Hausdorff_space (space_family_set Fam i) (space_family_topology Fam i)) /\ (regular_space (product_space Idx Fam) (product_topology_full Idx Fam) -> forall i : set , i :e Idx -> regular_space (space_family_set Fam i) (space_family_topology Fam i)) /\ (normal_space (product_space Idx Fam) (product_topology_full Idx Fam) -> forall i : set , i :e Idx -> normal_space (space_family_set Fam i) (space_family_topology Fam i))).
Axiom ex32_3_locally_compact_Hausdorff_regular : forall X Tx : set , locally_compact X Tx -> Hausdorff_space X Tx -> regular_space X Tx.
Axiom ex32_4_regular_Lindelof_normal : forall X Tx : set , regular_space X Tx -> Lindelof_space X Tx -> normal_space X Tx.
Axiom Sorgenfrey_line_normal : normal_space Sorgenfrey_line Sorgenfrey_topology.
Axiom ex32_5_Romega_normality_questions : (normal_space R_omega_space R_omega_product_topology \/ ~ normal_space R_omega_space R_omega_product_topology) /\ (normal_space real_sequences uniform_topology \/ ~ normal_space real_sequences uniform_topology).
Axiom ex32_6_completely_normal_characterization : forall X Tx : set , completely_normal_space X Tx <-> (one_point_sets_closed X Tx /\ (forall A B : set , separated_subsets X Tx A B -> exists U V : set , open_in X Tx U /\ open_in X Tx V /\ A c= U /\ B c= V /\ U :/\: V = Empty)).
Definition metric_restrict : set -> set -> set -> set := fun X d A => graph (setprod A A) (fun p : set => apply_fun d p).
Axiom metric_restrict_def : forall X d A : set , metric_restrict X d A = graph (setprod A A) (fun p : set => apply_fun d p).
Axiom metric_restrict_apply : forall X d A x y : set , x :e A -> y :e A -> apply_fun (metric_restrict X d A) (x,y) = apply_fun d (x,y).
Axiom uniform_metric_C_I_R_graph_eq_metric_restrict : uniform_metric_C_I_R_graph = metric_restrict (power_real unit_interval) (uniform_metric_power_real unit_interval) C_I_R_graph.
Axiom metric_restrict_is_metric_on : forall X d A : set , metric_on X d -> A c= X -> metric_on A (metric_restrict X d A).
Axiom metric_topology_restrict_eq_subspace_topology : forall X d A : set , metric_on X d -> A c= X -> metric_topology A (metric_restrict X d A) = subspace_topology X (metric_topology X d) A.
Axiom converges_to_in_subspace_topology : forall X Tx A seq x : set , topology_on X Tx -> A c= X -> converges_to X Tx seq x -> sequence_on seq A -> x :e A -> converges_to A (subspace_topology X Tx A) seq x.
Axiom complete_metric_space_closed_subspace : forall X d A : set , complete_metric_space X d -> A c= X -> closed_in X (metric_topology X d) A -> complete_metric_space A (metric_restrict X d A).
Axiom uniform_topology_C_I_R_graph_eq_subspace : uniform_topology_C_I_R_graph = subspace_topology (power_real unit_interval) (uniform_topology_power_real unit_interval) C_I_R_graph.
Axiom complete_metric_space_C_I_R_graph_uniform : complete_metric_space C_I_R_graph uniform_metric_C_I_R_graph.
Axiom C_I_R_graph_Baire_uniform : Baire_space C_I_R_graph uniform_topology_C_I_R_graph.
Axiom dense_intersection_U_n_graph_uniform : dense_in (intersection_over_family C_I_R_graph {U_n_graph n|n :e omega,2 c= n}) C_I_R_graph uniform_topology_C_I_R_graph.
Axiom exists_nowhere_differentiable_uniform_approx_graph : forall h eps : set , h :e C_I_R_graph -> eps :e R -> Rlt 0 eps -> exists g : set , g :e C_I_R_graph /\ nowhere_differentiable g /\ forall x : set , x :e unit_interval -> Rlt (Abs (add_SNo (apply_fun h x) (minus_SNo (apply_fun g x)))) eps.
Axiom theorem_49_1_nowhere_differentiable_approx : forall h eps : set , continuous_map unit_interval I_topology R R_standard_topology h -> eps :e R -> Rlt 0 eps -> exists g : set , continuous_map unit_interval I_topology R R_standard_topology g /\ nowhere_differentiable g /\ forall x : set , x :e unit_interval -> Rlt (Abs (add_SNo (apply_fun h x) (minus_SNo (apply_fun g x)))) eps.
Axiom nowhere_differentiable_function_exists : exists f : set , continuous_map unit_interval I_topology R R_standard_topology f /\ nowhere_differentiable f.
Axiom subspace_of_metrizable_is_metrizable : forall X Tx A : set , metrizable X Tx -> A c= X -> metrizable A (subspace_topology X Tx A).
Axiom Romega_tilde_metrizable : forall n : set , n :e omega -> metrizable (Romega_tilde n) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde n)).
Axiom ex32_7_completely_normal_examples : (forall X Tx A : set , completely_normal_space X Tx -> A c= X -> completely_normal_space A (subspace_topology X Tx A)) /\ (forall X Tx Y Ty : set , completely_normal_space X Tx -> completely_normal_space Y Ty -> (completely_normal_space (setprod X Y) (product_topology X Tx Y Ty) \/ ~ completely_normal_space (setprod X Y) (product_topology X Tx Y Ty))) /\ (forall X : set , well_ordered_set X -> simply_ordered_set X -> (completely_normal_space X (order_topology X) \/ ~ completely_normal_space X (order_topology X))) /\ (forall X Tx : set , metrizable X Tx -> completely_normal_space X Tx) /\ (forall X Tx : set , compact_space X Tx -> Hausdorff_space X Tx -> (completely_normal_space X Tx \/ ~ completely_normal_space X Tx)) /\ (forall X Tx : set , regular_space X Tx -> second_countable_space X Tx -> (completely_normal_space X Tx \/ ~ completely_normal_space X Tx)) /\ (completely_normal_space R R_lower_limit_topology \/ ~ completely_normal_space R R_lower_limit_topology).
Axiom order_interval_in_order_topology : forall X a b : set , simply_ordered_set X -> a :e X -> b :e X -> order_interval X a b :e order_topology X.
Axiom lower_ray_in_order_topology : forall X b : set , simply_ordered_set X -> b :e X -> {x :e X|order_rel X x b} :e order_topology X.
Axiom upper_ray_in_order_topology : forall X a : set , simply_ordered_set X -> a :e X -> {x :e X|order_rel X a x} :e order_topology X.
Axiom connected_subspace_order_topology_convex : forall X Y : set , simply_ordered_set X -> Y c= X -> connected_space Y (subspace_topology X (order_topology X) Y) -> convex_in X Y.
Axiom linear_continuum_locally_connected : forall X Tx : set , linear_continuum X Tx -> locally_connected X Tx.
Definition ex32_8_WFpred : set -> set -> set -> set -> set -> set -> prop := fun X A B S Ts W0 => (exists x : set , x :e S /\ W0 = component_of S Ts x) /\ (exists a b : set , a :e A /\ b :e B /\ ((order_rel X a b /\ W0 = order_interval X a b) \/ (order_rel X b a /\ W0 = order_interval X b a))).
Axiom ex32_8b_WF_is_component_family : forall X A B S Ts WF : set , WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> forall W : set , W :e WF -> exists x : set , x :e S /\ W = component_of S Ts x.
Axiom ex32_8b_WF_endpoints_cases : forall X A B S Ts WF W0 : set , WF = {W1 :e Power S|ex32_8_WFpred X A B S Ts W1} -> W0 :e WF -> exists a b : set , a :e A /\ b :e B /\ ((order_rel X a b /\ W0 = order_interval X a b) \/ (order_rel X b a /\ W0 = order_interval X b a)).
Axiom ex32_8b_WF_endpoints_oriented_in_lower_ray_avoid_B : forall X A B S Ts WF W0 bb c : set , simply_ordered_set X -> bb :e X -> B c= X -> WF = {W1 :e Power S|ex32_8_WFpred X A B S Ts W1} -> W0 :e WF -> c :e W0 -> c :e {t :e X|order_rel X t bb} -> {t :e X|order_rel X t bb} c= (X :\: B) -> exists a b : set , a :e A /\ b :e B /\ order_rel X a b /\ W0 = order_interval X a b.
Axiom ex32_8b_WF_endpoints_oriented_in_upper_ray_avoid_B : forall X A B S Ts WF W0 a0 c : set , simply_ordered_set X -> a0 :e X -> B c= X -> WF = {W1 :e Power S|ex32_8_WFpred X A B S Ts W1} -> W0 :e WF -> c :e W0 -> c :e {t :e X|order_rel X a0 t} -> {t :e X|order_rel X a0 t} c= (X :\: B) -> exists a b : set , a :e A /\ b :e B /\ order_rel X b a /\ W0 = order_interval X b a.
Axiom ex32_8b_WF_endpoints_oriented_in_lower_ray_avoid_A : forall X A B S Ts WF W0 bb c : set , simply_ordered_set X -> bb :e X -> A c= X -> WF = {W1 :e Power S|ex32_8_WFpred X A B S Ts W1} -> W0 :e WF -> c :e W0 -> c :e {t :e X|order_rel X t bb} -> {t :e X|order_rel X t bb} c= (X :\: A) -> exists a b : set , a :e A /\ b :e B /\ order_rel X b a /\ W0 = order_interval X b a.
Axiom ex32_8b_WF_endpoints_oriented_in_upper_ray_avoid_A : forall X A B S Ts WF W0 a0 c : set , simply_ordered_set X -> a0 :e X -> A c= X -> WF = {W1 :e Power S|ex32_8_WFpred X A B S Ts W1} -> W0 :e WF -> c :e W0 -> c :e {t :e X|order_rel X a0 t} -> {t :e X|order_rel X a0 t} c= (X :\: A) -> exists a b : set , a :e A /\ b :e B /\ order_rel X a b /\ W0 = order_interval X a b.
Axiom ex32_8b_C_subset_S : forall X A B S Ts WF C : set , forall pick : set -> set , WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> C c= S.
Axiom ex32_8b_C_disjoint_A_union_B : forall X A B S Ts WF C : set , forall pick : set -> set , S = X :\: (A :\/: B) -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> C :/\: (A :\/: B) = Empty.
Axiom ex32_8b_C_disjoint_A : forall X A B S Ts WF C : set , forall pick : set -> set , S = X :\: (A :\/: B) -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> C :/\: A = Empty.
Axiom ex32_8b_C_disjoint_B : forall X A B S Ts WF C : set , forall pick : set -> set , S = X :\: (A :\/: B) -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> C :/\: B = Empty.
Axiom ex32_8b_WF_pairwise_disjoint : forall X A B S Ts WF : set , topology_on S Ts -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> pairwise_disjoint WF.
Axiom ex32_8b_C_intersection_W : forall X A B S Ts WF C : set , forall pick : set -> set , topology_on S Ts -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> forall W : set , W :e WF -> C :/\: W = {pick W}.
Axiom ex32_8b_component_disjoint_C_if_not_in_WF : forall X A B S Ts WF C : set , forall pick : set -> set , topology_on S Ts -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W0 : set , W0 :e WF -> pick W0 :e W0) -> forall x : set , x :e S -> forall W : set , W = component_of S Ts x -> ~ (W :e WF) -> C :/\: W = Empty.
Axiom ex32_8b_finite_C_intersection_basis_avoid_B : forall X Tx A B S Ts WF C : set , forall pick : set -> set , forall b0 : set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> S = X :\: (A :\/: B) -> Ts = subspace_topology X Tx S -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W0 : set , W0 :e WF -> pick W0 :e W0) -> b0 :e order_topology_basis X -> b0 c= (X :\: B) -> finite (C :/\: b0).
Axiom ex32_8b_finite_C_intersection_basis_avoid_A : forall X Tx A B S Ts WF C : set , forall pick : set -> set , forall b0 : set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> S = X :\: (A :\/: B) -> Ts = subspace_topology X Tx S -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W0 : set , W0 :e WF -> pick W0 :e W0) -> b0 :e order_topology_basis X -> b0 c= (X :\: A) -> finite (C :/\: b0).
Axiom ex32_8a_component_of_complement_shape : forall X Tx C x : set , linear_continuum X Tx -> closed_in X Tx C -> C <> Empty -> x :e (X :\: C) -> (exists c c' : set , c :e C /\ c' :e C /\ order_rel X c c' /\ component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x = order_interval X c c') \/ (exists c : set , c :e C /\ (forall d : set , d :e C -> ~ order_rel X c d) /\ component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x = {y :e X|order_rel X c y}) \/ (exists c : set , c :e C /\ (forall d : set , d :e C -> ~ order_rel X d c) /\ component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x = {y :e X|order_rel X y c}).
Axiom ex32_8a_component_of_complement_shape_sketch : forall X Tx C x : set , linear_continuum X Tx -> closed_in X Tx C -> C <> Empty -> x :e (X :\: C) -> (exists c c' : set , c :e C /\ c' :e C /\ order_rel X c c' /\ component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x = order_interval X c c') \/ (exists c : set , c :e C /\ (forall d : set , d :e C -> ~ order_rel X c d) /\ component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x = {y :e X|order_rel X c y}) \/ (exists c : set , c :e C /\ (forall d : set , d :e C -> ~ order_rel X d c) /\ component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x = {y :e X|order_rel X y c}).
Axiom ex32_8b_basis_neighborhood_for_x_in_A : forall X Tx A B S Ts WF C x : set , forall pick : set -> set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> S = X :\: (A :\/: B) -> Ts = subspace_topology X Tx S -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> x :e A -> x :e (X :\: C) -> exists b :e order_topology_basis X , x :e b /\ b c= (X :\: C).
Axiom ex32_8b_basis_neighborhood_for_x_in_B : forall X Tx A B S Ts WF C x : set , forall pick : set -> set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> S = X :\: (A :\/: B) -> Ts = subspace_topology X Tx S -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> x :e B -> x :e (X :\: C) -> exists b :e order_topology_basis X , x :e b /\ b c= (X :\: C).
Axiom ex32_8b_complement_open_sketch : forall X Tx A B S Ts WF C : set , forall pick : set -> set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> S = X :\: (A :\/: B) -> Ts = subspace_topology X Tx S -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> (X :\: C) :e Tx.
Axiom ex32_8b_complement_open : forall X Tx A B S Ts WF C : set , forall pick : set -> set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> S = X :\: (A :\/: B) -> Ts = subspace_topology X Tx S -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> (X :\: C) :e Tx.
Axiom ex32_8b_chosen_points_set_closed : forall X Tx A B S Ts WF C : set , forall pick : set -> set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> S = X :\: (A :\/: B) -> Ts = subspace_topology X Tx S -> WF = {W0 :e Power S|ex32_8_WFpred X A B S Ts W0} -> C = {pick W0|W0 :e WF} -> (forall W : set , W :e WF -> pick W :e W) -> closed_in X Tx C.
Axiom ex32_8c_find_interval_component_in_component : forall X Tx A B C x a b : set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> closed_in X Tx C -> a :e A -> b :e B -> x :e (X :\: C) -> a :e component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x -> b :e component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x -> exists W : set , (exists y : set , y :e (X :\: (A :\/: B)) /\ W = component_of (X :\: (A :\/: B)) (subspace_topology X Tx (X :\: (A :\/: B))) y) /\ (exists a0 b0 : set , a0 :e A /\ b0 :e B /\ ((order_rel X a0 b0 /\ W = order_interval X a0 b0) \/ (order_rel X b0 a0 /\ W = order_interval X b0 a0))) /\ W c= component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x.
Axiom ex32_8c_find_interval_component_in_component_sketch : forall X Tx A B C x a b : set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> closed_in X Tx C -> a :e A -> b :e B -> x :e (X :\: C) -> a :e component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x -> b :e component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x -> exists W : set , (exists y : set , y :e (X :\: (A :\/: B)) /\ W = component_of (X :\: (A :\/: B)) (subspace_topology X Tx (X :\: (A :\/: B))) y) /\ (exists a0 b0 : set , a0 :e A /\ b0 :e B /\ ((order_rel X a0 b0 /\ W = order_interval X a0 b0) \/ (order_rel X b0 a0 /\ W = order_interval X b0 a0))) /\ W c= component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x.
Axiom ex32_8c_component_of_X_minus_C_not_both : forall X Tx A B C : set , linear_continuum X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> (forall W : set , (exists x : set , x :e (X :\: (A :\/: B)) /\ W = component_of (X :\: (A :\/: B)) (subspace_topology X Tx (X :\: (A :\/: B))) x) -> (exists a b : set , a :e A /\ b :e B /\ ((order_rel X a b /\ W = order_interval X a b) \/ (order_rel X b a /\ W = order_interval X b a))) -> exists cW : set , cW :e C /\ cW :e W) -> closed_in X Tx C -> (forall x : set , x :e (X :\: C) -> ~ (exists a b : set , a :e A /\ b :e B /\ a :e component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x /\ b :e component_of (X :\: C) (subspace_topology X Tx (X :\: C)) x)).
Axiom ex32_8_linear_continuum_normal : forall X Tx : set , linear_continuum X Tx -> normal_space X Tx.
Axiom ex32_9_uncountable_product_not_normal : forall J : set , ~ countable J -> ~ normal_space (product_space J (const_space_family J R R_standard_topology)) (product_topology_full J (const_space_family J R R_standard_topology)).
Definition perfectly_normal_space : set -> set -> prop := fun X Tx => normal_space X Tx /\ (forall A : set , closed_in X Tx A -> Gdelta_in X Tx A).
Axiom perfectly_normal_space_normal : forall X Tx : set , perfectly_normal_space X Tx -> normal_space X Tx.
Axiom perfectly_normal_space_topology_on : forall X Tx : set , perfectly_normal_space X Tx -> topology_on X Tx.
Axiom perfectly_normal_open_is_countable_union_closed : forall X Tx U : set , perfectly_normal_space X Tx -> open_in X Tx U -> exists Fam : set , countable_set Fam /\ (forall C :e Fam , closed_in X Tx C) /\ Union Fam = U.
Axiom ex33_1_level_sets_urysohn : forall X Tx A B : set , forall U : set -> set , normal_space X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> exists f : set , continuous_map X Tx R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 0) /\ (forall x : set , x :e B -> apply_fun f x = 1).
Axiom atleastp_R_closed_interval_0_1 : atleastp R (closed_interval 0 1).
Axiom closed_interval_0_1_uncountable : ~ countable (closed_interval 0 1).
Axiom ex33_2a_connected_normal_uncountable : forall X Tx : set , connected_space X Tx -> normal_space X Tx -> (exists x y : set , x :e X /\ y :e X /\ x <> y) -> ~ countable X.
Axiom ex33_2b_connected_regular_uncountable : forall X Tx : set , connected_space X Tx -> regular_space X Tx -> (exists x y : set , x :e X /\ y :e X /\ x <> y) -> ~ countable X.
Axiom ex33_3_urysohn_metric_direct : forall X d A B : set , metric_on X d -> closed_in X (metric_topology X d) A -> closed_in X (metric_topology X d) B -> A :/\: B = Empty -> exists f : set , continuous_map X (metric_topology X d) R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 0) /\ (forall x : set , x :e B -> apply_fun f x = 1).
Axiom ex33_4_closed_Gdelta_vanishing_function : forall X Tx A : set , normal_space X Tx -> closed_in X Tx A -> (Gdelta_in X Tx A <-> exists f : set , continuous_map X Tx R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 0) /\ (forall x : set , x :e X -> x /:e A -> ~ (apply_fun f x = 0))).
Axiom singleton_Gdelta_in_R_standard_topology : forall r : set , r :e R -> Gdelta_in R R_standard_topology {r}.
Axiom ex33_5_strong_urysohn : forall X Tx A B : set , normal_space X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> (Gdelta_in X Tx A /\ Gdelta_in X Tx B <-> exists f : set , continuous_map X Tx R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 0) /\ (forall x : set , x :e B -> apply_fun f x = 1) /\ (forall x : set , x :e X -> x /:e A -> x /:e B -> Rlt 0 (apply_fun f x) /\ Rlt (apply_fun f x) 1)).
Axiom metric_closed_is_Gdelta : forall X d A : set , metric_on X d -> closed_in X (metric_topology X d) A -> Gdelta_in X (metric_topology X d) A.
Axiom ex33_6a_metrizable_perfectly_normal : forall X Tx : set , metrizable X Tx -> perfectly_normal_space X Tx.
Axiom ex33_6b_perfectly_completely_normal_sep : forall X Tx A B : set , perfectly_normal_space X Tx -> separated_subsets X Tx A B -> exists U V : set , open_in X Tx U /\ open_in X Tx V /\ A c= U /\ B c= V /\ U :/\: V = Empty.
Axiom ex33_6b_perfectly_completely_normal : forall X Tx : set , perfectly_normal_space X Tx -> completely_normal_space X Tx.
Axiom ordered_square_completely_normal : completely_normal_space ordered_square ordered_square_topology.
Axiom ordered_square_not_perfectly_normal : ~ perfectly_normal_space ordered_square ordered_square_topology.
Axiom ex33_6c_completely_not_perfectly_normal : exists X Tx : set , completely_normal_space X Tx /\ ~ perfectly_normal_space X Tx.
Axiom ex33_7_locally_compact_Hausdorff_completely_regular : forall X Tx : set , locally_compact X Tx -> Hausdorff_space X Tx -> completely_regular_space X Tx.
Axiom ex33_8_compact_subset_continuous_separation : forall X Tx A B : set , completely_regular_space X Tx -> A c= X -> compact_space A (subspace_topology X Tx A) -> closed_in X Tx B -> A :/\: B = Empty -> exists f : set , continuous_map X Tx R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 0) /\ (forall x : set , x :e B -> apply_fun f x = 1).
Axiom ex33_9_Romega_box_completely_regular : completely_regular_space (product_space omega (const_space_family omega R R_standard_topology)) (box_topology omega (const_space_family omega R R_standard_topology)).
Axiom ex33_10_topological_group_completely_regular : forall G Tg : set , topological_group G Tg -> completely_regular_space G Tg.
Axiom ex33_11_regular_not_completely_regular : exists X Tx : set , regular_space X Tx /\ ~ completely_regular_space X Tx.
Definition retraction_of : set -> set -> set -> prop := fun X Tx A => A c= X /\ exists r : set , function_on r X X /\ continuous_map X Tx X Tx r /\ (forall x : set , x :e X -> apply_fun r x :e A) /\ (forall x : set , x :e A -> apply_fun r x = x).
Definition image_of_map : set -> set -> set -> set -> set -> set := fun X Tx Y Ty f => image_of f X.
Definition absolute_retract : set -> set -> prop := fun X Tx => normal_space X Tx /\ forall Z Tz Y0 f : set , normal_space Z Tz -> Y0 c= Z -> closed_in Z Tz Y0 -> homeomorphism X Tx Y0 (subspace_topology Z Tz Y0) f -> retraction_of Z Tz Y0.
Definition coherent_union : set -> set := fun Xi => Union {apply_fun Xi i|i :e omega}.
Axiom coherent_union_contains : forall Xi i x : set , i :e omega -> x :e apply_fun Xi i -> x :e coherent_union Xi.
Axiom coherent_unionE : forall Xi x : set , x :e coherent_union Xi -> exists i : set , i :e omega /\ x :e apply_fun Xi i.
Axiom coherent_union_component_subset : forall Xi i : set , i :e omega -> apply_fun Xi i c= coherent_union Xi.
Definition coherent_topology : set -> set -> set := fun Xi Ti => {U :e Power (coherent_union Xi)|forall i :e omega , (U :/\: apply_fun Xi i) :e apply_fun Ti i}.
Definition coherent_chain : set -> set -> prop := fun Xi Ti => (forall i : set , i :e omega -> topology_on (apply_fun Xi i) (apply_fun Ti i)) /\ (forall i : set , i :e omega -> apply_fun Xi i c= apply_fun Xi (ordsucc i)) /\ (forall i : set , i :e omega -> subspace_topology (apply_fun Xi (ordsucc i)) (apply_fun Ti (ordsucc i)) (apply_fun Xi i) = apply_fun Ti i) /\ (forall i : set , i :e omega -> closed_in (apply_fun Xi (ordsucc i)) (apply_fun Ti (ordsucc i)) (apply_fun Xi i)).
Axiom coherent_chain_mono_add_nat : forall Xi Ti i k : set , coherent_chain Xi Ti -> i :e omega -> k :e omega -> apply_fun Xi i c= apply_fun Xi (add_nat i k).
Axiom coherent_chain_mono_mem : forall Xi Ti j : set , coherent_chain Xi Ti -> j :e omega -> forall i : set , i :e j -> apply_fun Xi i c= apply_fun Xi j.
Axiom coherent_chain_closed_in_succ : forall Xi Ti i A : set , coherent_chain Xi Ti -> i :e omega -> closed_in (apply_fun Xi i) (apply_fun Ti i) A -> closed_in (apply_fun Xi (ordsucc i)) (apply_fun Ti (ordsucc i)) A.
Axiom coherent_chain_Tietze_extend_interval_succ : forall Xi Ti i a b f : set , coherent_chain Xi Ti -> i :e omega -> Rle a b -> normal_space (apply_fun Xi (ordsucc i)) (apply_fun Ti (ordsucc i)) -> continuous_map (apply_fun Xi i) (apply_fun Ti i) (closed_interval a b) (closed_interval_topology a b) f -> exists g : set , continuous_map (apply_fun Xi (ordsucc i)) (apply_fun Ti (ordsucc i)) (closed_interval a b) (closed_interval_topology a b) g /\ (forall x : set , x :e apply_fun Xi i -> apply_fun g x = apply_fun f x).
Axiom closed_in_coherent_component : forall Xi Ti A i : set , (forall j : set , j :e omega -> topology_on (apply_fun Xi j) (apply_fun Ti j)) -> closed_in (coherent_union Xi) (coherent_topology Xi Ti) A -> i :e omega -> closed_in (apply_fun Xi i) (apply_fun Ti i) (A :/\: apply_fun Xi i).
Axiom coherent_chain_extend_interval_succ_with_boundary : forall Xi Ti A B i fi : set , coherent_chain Xi Ti -> (forall j : set , j :e omega -> normal_space (apply_fun Xi j) (apply_fun Ti j)) -> i :e omega -> closed_in (coherent_union Xi) (coherent_topology Xi Ti) A -> closed_in (coherent_union Xi) (coherent_topology Xi Ti) B -> A :/\: B = Empty -> continuous_map (apply_fun Xi i) (apply_fun Ti i) (closed_interval 0 1) (closed_interval_topology 0 1) fi -> (forall x : set , x :e (A :/\: apply_fun Xi i) -> apply_fun fi x = 0) -> (forall x : set , x :e (B :/\: apply_fun Xi i) -> apply_fun fi x = 1) -> exists gi : set , continuous_map (apply_fun Xi (ordsucc i)) (apply_fun Ti (ordsucc i)) (closed_interval 0 1) (closed_interval_topology 0 1) gi /\ (forall x : set , x :e apply_fun Xi i -> apply_fun gi x = apply_fun fi x) /\ (forall x : set , x :e (A :/\: apply_fun Xi (ordsucc i)) -> apply_fun gi x = 0) /\ (forall x : set , x :e (B :/\: apply_fun Xi (ordsucc i)) -> apply_fun gi x = 1).
Definition compact_spaces_family : set -> set -> prop := fun I Xi => forall i : set , i :e I -> compact_space (product_component Xi i) (product_component_topology Xi i).
Definition surjective_map : set -> set -> set -> prop := fun X Y f => function_on f X Y /\ forall y : set , y :e Y -> exists x : set , x :e X /\ apply_fun f x = y.
Definition ex34_1_Hausdorff_countable_basis_not_metrizable_example : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ Hausdorff_space X Tx /\ second_countable_space X Tx /\ ~ metrizable X Tx}.
Definition ex34_2_completely_normal_not_metrizable_example : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ completely_normal_space X Tx /\ ~ metrizable X Tx}.
Definition ex34_3_compact_Hausdorff_metrizable_iff_second_countable : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ compact_space X Tx /\ Hausdorff_space X Tx /\ (metrizable X Tx <-> second_countable_space X Tx)}.
Definition ex34_4_locally_compact_Hausdorff_metrizable_questions : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ locally_compact X Tx /\ Hausdorff_space X Tx /\ (second_countable_space X Tx -> metrizable X Tx)}.
Definition ex34_5_one_point_compactification_metrizable_questions : set := {q :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx Y Ty p : set , q = setprod (setprod (setprod X Tx) (setprod Y Ty)) p /\ one_point_compactification X Tx Y Ty /\ p :e Y /\ ~ p :e X /\ (metrizable X Tx <-> metrizable Y Ty)}.
Definition ex34_6_check_imbedding_proof : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx f : set , p = setprod (setprod X Tx) f /\ completely_regular_space X Tx /\ Hausdorff_space X Tx /\ embedding_of X Tx (power_real omega) (product_topology_full omega (const_space_family omega R R_standard_topology)) f}.
Definition ex34_7_locally_metrizable_compact_Hausdorff_metrizable : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ locally_metrizable_space X Tx /\ compact_space X Tx /\ Hausdorff_space X Tx /\ metrizable X Tx}.
Definition ex34_8_regular_Lindelof_locally_metrizable_metrizable : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ (regular_space X Tx /\ Lindelof_space X Tx /\ locally_metrizable_space X Tx -> metrizable X Tx)}.
Definition ex34_9_compact_union_two_metrizable_closed_metrizable : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx A B : set , p = setprod (setprod X Tx) (setprod A B) /\ compact_space X Tx /\ Hausdorff_space X Tx /\ closed_in X Tx A /\ closed_in X Tx B /\ Union (UPair A B) = X /\ metrizable A (subspace_topology X Tx A) /\ metrizable B (subspace_topology X Tx B) /\ metrizable X Tx}.
Definition ex35_1_Tietze_implies_Urysohn : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ normal_space X Tx /\ (forall A B : set , closed_in X Tx A /\ closed_in X Tx B /\ A :/\: B = Empty -> exists f : set , continuous_map X Tx R R_standard_topology f /\ (forall x : set , x :e A -> apply_fun f x = 0) /\ (forall x : set , x :e B -> apply_fun f x = 1))}.
Definition ex35_2_interval_partition_parameter : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ normal_space X Tx}.
Definition ex35_3_boundedness_equivalences_metrizable : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx d : set , p = setprod (setprod X Tx) d /\ metric_on X d /\ metric_topology X d = Tx}.
Definition ex35_4_retract_properties : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx A : set , p = setprod (setprod X Tx) A /\ retraction_of X Tx A}.
Definition ex35_5_universal_extension_retracts : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx A : set , p = setprod (setprod X Tx) A /\ normal_space X Tx /\ retraction_of X Tx A /\ forall Y Ty f : set , continuous_map A (subspace_topology X Tx A) Y Ty f -> exists g : set , continuous_map X Tx Y Ty g /\ forall x : set , x :e A -> apply_fun g x = apply_fun f x}.
Definition ex35_6_absolute_retract_universal_extension : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ absolute_retract X Tx}.
Definition ex35_7_retract_examples : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx A : set , p = setprod (setprod X Tx) A /\ retraction_of X Tx A}.
Definition ex35_8_absolute_retract_equivalence : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx : set , p = setprod X Tx /\ absolute_retract X Tx}.
Axiom ex35_9a_coherent_topology_is_topology : forall Xi Ti : set , (forall i : set , i :e omega -> topology_on (apply_fun Xi i) (apply_fun Ti i)) -> topology_on (coherent_union Xi) (coherent_topology Xi Ti).
Axiom ex35_9b_continuous_if_restrictions_continuous : forall Xi Ti Y Ty f : set , (forall i : set , i :e omega -> topology_on (apply_fun Xi i) (apply_fun Ti i)) -> topology_on Y Ty -> function_on f (coherent_union Xi) Y -> (forall i : set , i :e omega -> continuous_map (apply_fun Xi i) (apply_fun Ti i) Y Ty f) -> continuous_map (coherent_union Xi) (coherent_topology Xi Ti) Y Ty f.
Axiom ex35_9c_coherent_topology_normal : forall Xi Ti : set , coherent_chain Xi Ti -> (forall i : set , i :e omega -> normal_space (apply_fun Xi i) (apply_fun Ti i)) -> normal_space (coherent_union Xi) (coherent_topology Xi Ti).
Definition ex36_manifold_embedding_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists M TM m f : set , p = setprod (setprod M TM) f /\ m_manifold M TM m -> exists n : set , embedding_of M TM (euclidean_space n) (euclidean_topology n) f}.
Definition ex37_tychonoff_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists I Xi : set , p = setprod I Xi /\ compact_spaces_family I Xi /\ compact_space (product_space I Xi) (product_topology_full I Xi)}.
Definition ex38_stone_cech_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx Y Ty : set , p = setprod (setprod X Tx) (setprod Y Ty) /\ completely_regular_space X Tx /\ compact_space Y Ty /\ Hausdorff_space Y Ty /\ exists e : set , embedding_of X Tx Y Ty e}.
Definition ex39_local_finiteness_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx U : set , p = setprod (setprod X Tx) U /\ locally_finite_family X Tx U}.
Definition ex40_nagata_smirnov_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx B : set , p = setprod (setprod X Tx) B /\ (regular_space X Tx /\ basis_on X B /\ locally_finite_family X Tx B -> metrizable X Tx)}.
Definition ex41_paracompactness_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx U : set , p = setprod (setprod X Tx) U /\ paracompact_space X Tx /\ open_cover X Tx U}.
Definition ex42_smirnov_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx B : set , p = setprod (setprod X Tx) B /\ (regular_space X Tx /\ basis_on X B /\ locally_finite_family X Tx B -> metrizable X Tx)}.
Definition ex43_complete_metric_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X d Tx : set , p = setprod (setprod X d) Tx /\ metric_on X d /\ Tx = metric_topology X d /\ complete_metric_space X d}.
Definition ex44_space_filling_exercises : set := {f :e Power (Power (Power R))|continuous_map unit_interval R2_standard_topology unit_square unit_square_topology f /\ surjective_map unit_interval unit_square f}.
Definition ex45_compact_metric_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X d Tx : set , p = setprod (setprod X d) Tx /\ metric_on X d /\ Tx = metric_topology X d /\ compact_space X Tx}.
Definition ex46_convergence_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx Y Ty : set , p = setprod (setprod X Tx) (setprod Y Ty) /\ topology_on X Tx /\ topology_on Y Ty}.
Definition ex47_ascoli_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx Y Ty : set , p = setprod (setprod X Tx) (setprod Y Ty) /\ compact_space X Tx /\ Hausdorff_space Y Ty}.
Axiom ex48_1_Baire_union_interior : forall X Tx : set , forall Fam : set , Baire_space X Tx -> X <> Empty -> countable_set Fam -> X = Union Fam -> exists B : set , B :e Fam /\ exists U : set , U :e Tx /\ U <> Empty /\ U c= (closure_of X Tx B).
Axiom ex48_2_R_not_countable_empty_interior : forall Fam : set , countable_set Fam -> (forall C : set , C :e Fam -> closed_in R R_standard_topology C /\ (forall U : set , U :e R_standard_topology -> U c= C -> U = Empty)) -> R <> Union Fam.
Axiom ex48_4_locally_Baire_implies_Baire : forall X Tx : set , topology_on X Tx -> (forall x : set , x :e X -> exists U : set , U :e Tx /\ x :e U /\ Baire_space U (subspace_topology X Tx U)) -> Baire_space X Tx.
Axiom ex48_3_locally_compact_Hausdorff_Baire : forall X Tx : set , locally_compact X Tx -> Hausdorff_space X Tx -> Baire_space X Tx.
Axiom compact_Hausdorff_Gdelta_subspace_Baire : forall X Tx Y : set , compact_space X Tx -> Hausdorff_space X Tx -> Gdelta_in X Tx Y -> Baire_space Y (subspace_topology X Tx Y).
Axiom metric_dist_to_open_complement_pos : forall X d U x : set , metric_on X d -> open_in X (metric_topology X d) U -> x :e U -> X :\: U <> Empty -> Rlt 0 (metric_dist_to_set X d x (X :\: U)).
Axiom metric_dist_to_set_continuous_on_metric_restrict : forall X d Y A : set , metric_on X d -> Y c= X -> A c= X -> A <> Empty -> continuous_map Y (metric_topology Y (metric_restrict X d Y)) R R_standard_topology (graph Y (fun y : set => metric_dist_to_set X d y A)).
Axiom complete_metric_Gdelta_nonempty_family_has_complete_metric : forall X d Y Fam : set , complete_metric_space X d -> Fam <> Empty -> countable_set Fam -> (forall U : set , U :e Fam -> open_in X (metric_topology X d) U) -> intersection_over_family X Fam = Y -> exists dY : set , complete_metric_space Y dY /\ metric_topology Y dY = subspace_topology X (metric_topology X d) Y.
Axiom Gdelta_subspace_of_complete_metric_has_complete_metric : forall X d Y : set , complete_metric_space X d -> Gdelta_in X (metric_topology X d) Y -> exists dY : set , complete_metric_space Y dY /\ metric_topology Y dY = subspace_topology X (metric_topology X d) Y.
Axiom complete_metric_Gdelta_subspace_Baire : forall X d Y : set , complete_metric_space X d -> Gdelta_in X (metric_topology X d) Y -> Baire_space Y (subspace_topology X (metric_topology X d) Y).
Axiom ex48_5_Gdelta_Baire : forall X Tx Y : set , ((compact_space X Tx /\ Hausdorff_space X Tx) \/ (exists d : set , complete_metric_space X d /\ Tx = metric_topology X d)) -> (exists Fam : set , countable_set Fam /\ (forall W : set , W :e Fam -> W :e Tx) /\ Y = intersection_over_family X Fam) -> Baire_space Y (subspace_topology X Tx Y).
Axiom ex48_6_irrationals_Baire : Baire_space (R :\: Q) (subspace_topology R R_standard_topology (R :\: Q)).
Axiom ex48_7a_continuity_set_Gdelta : forall f : set , function_on f R R -> exists Fam : set , countable_set Fam /\ (forall U : set , U :e Fam -> U :e R_standard_topology) /\ {x :e R|continuous_at f x} = intersection_over_family R Fam.
Axiom ex48_7b_countable_dense_not_Gdelta : forall D : set , D c= R -> countable_set D -> dense_in D R R_standard_topology -> ~ (exists Fam : set , countable_set Fam /\ (forall W : set , W :e Fam -> W :e R_standard_topology) /\ D = intersection_over_family R Fam).
Axiom ex48_7_no_function_continuous_on_countable_dense : forall D : set , D c= R -> countable_set D -> dense_in D R R_standard_topology -> ~ (exists f : set , function_on f R R /\ (forall x : set , x :e D -> continuous_at f x) /\ (forall x : set , x :e R -> x /:e D -> ~ continuous_at f x)).
Definition pointwise_limit_of_sequence_of_functions : set -> set -> prop := fun fn f => forall x : set , x :e R -> forall eps : set , eps :e R -> Rlt 0 eps -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> Rlt (Abs (add_SNo (apply_fun (apply_fun fn n) x) (minus_SNo (apply_fun f x)))) eps.
Axiom ex48_8_pointwise_limit_continuity : forall fn : set , forall f : set , (forall n : set , n :e omega -> continuous_map R R_standard_topology R R_standard_topology (apply_fun fn n)) -> function_on f R R -> pointwise_limit_of_sequence_of_functions fn f -> ~ countable_set {x :e R|continuous_at f x}.
Axiom R_open_bump_value : forall x U c : set , x :e R -> U :e R_standard_topology -> x :e U -> c :e R -> exists h : set , continuous_map R R_standard_topology R R_standard_topology h /\ apply_fun h x = c /\ forall y : set , y :e R :\: U -> apply_fun h y = 0.
Axiom R_open_bump_1 : forall x U : set , x :e R -> U :e R_standard_topology -> x :e U -> exists h : set , continuous_map R R_standard_topology R R_standard_topology h /\ apply_fun h x = 1 /\ forall y : set , y :e R :\: U -> apply_fun h y = 0.
Axiom R_open_bump_unit_interval : forall x U : set , x :e R -> U :e R_standard_topology -> x :e U -> exists h : set , continuous_map R R_standard_topology unit_interval unit_interval_topology h /\ apply_fun h x = 1 /\ forall y : set , y :e R :\: U -> apply_fun h y = 0.
Axiom R_open_ball_bump_value : forall x0 r c : set , x0 :e R -> r :e R -> Rlt 0 r -> c :e R -> exists h : set , continuous_map R R_standard_topology R R_standard_topology h /\ apply_fun h x0 = c /\ forall y : set , y :e R :\: open_ball R R_bounded_metric x0 r -> apply_fun h y = 0.
Axiom R_open_ball_bump_inv_at_enumQ : forall g i r : set , bijection omega Q g -> i :e omega -> r :e R -> Rlt 0 r -> exists h : set , continuous_map R R_standard_topology R R_standard_topology h /\ apply_fun h (apply_fun g i) = inv_nat (ordsucc i) /\ forall y : set , y :e R :\: open_ball R R_bounded_metric (apply_fun g i) r -> apply_fun h y = 0.
Axiom unit_interval_mul_const_bounds : forall t c : set , t :e unit_interval -> c :e R -> Rle 0 c -> Rle 0 (mul_SNo t c) /\ Rle (mul_SNo t c) c.
Axiom R_open_ball_bump_unit_interval : forall x0 r : set , x0 :e R -> r :e R -> Rlt 0 r -> exists h : set , continuous_map R R_standard_topology unit_interval unit_interval_topology h /\ apply_fun h x0 = 1 /\ forall y : set , y :e R :\: open_ball R R_bounded_metric x0 r -> apply_fun h y = 0.
Axiom R_open_ball_bump_value_bounded : forall x0 r c : set , x0 :e R -> r :e R -> Rlt 0 r -> c :e R -> Rle 0 c -> exists h : set , continuous_map R R_standard_topology R R_standard_topology h /\ apply_fun h x0 = c /\ (forall y : set , y :e R :\: open_ball R R_bounded_metric x0 r -> apply_fun h y = 0) /\ (forall y : set , y :e R -> Rle 0 (apply_fun h y) /\ Rle (apply_fun h y) c).
Axiom R_open_ball_bump_inv_at_enumQ_bounded : forall g i r : set , bijection omega Q g -> i :e omega -> r :e R -> Rlt 0 r -> exists h : set , continuous_map R R_standard_topology R R_standard_topology h /\ apply_fun h (apply_fun g i) = inv_nat (ordsucc i) /\ (forall y : set , y :e R :\: open_ball R R_bounded_metric (apply_fun g i) r -> apply_fun h y = 0) /\ (forall y : set , y :e R -> Rle 0 (apply_fun h y) /\ Rle (apply_fun h y) (inv_nat (ordsucc i))).
Axiom R_disjoint_eps_balls_of_neq : forall x y : set , x :e R -> y :e R -> x <> y -> exists N M : set , N :e omega /\ M :e omega /\ open_ball R R_bounded_metric x (eps_ N) :/\: open_ball R R_bounded_metric y (eps_ M) = Empty.
Axiom R_disjoint_eps_balls_of_eps_lt_dist : forall x y N : set , x :e R -> y :e R -> x <> y -> N :e omega -> eps_ N < apply_fun R_bounded_metric (x,y) -> open_ball R R_bounded_metric x (eps_ (ordsucc N)) :/\: open_ball R R_bounded_metric y (eps_ (ordsucc N)) = Empty.
Axiom finite_prefix_uniform_disjoint_balls_Q : forall g n : set , bijection omega Q g -> n :e omega -> exists N0 : set , N0 :e omega /\ forall i j : set , i :e n -> j :e n -> i <> j -> open_ball R R_bounded_metric (apply_fun g i) (eps_ (ordsucc N0)) :/\: open_ball R R_bounded_metric (apply_fun g j) (eps_ (ordsucc N0)) = Empty.
Axiom R_exists_eps_ball_avoids_distinct_point : forall x y : set , x :e R -> y :e R -> x <> y -> exists N : set , N :e omega /\ y /:e open_ball R R_bounded_metric x (eps_ N).
Axiom finite_prefix_disjoint_balls_Q_bounded : forall g n b : set , bijection omega Q g -> n :e omega -> b :e R -> Rlt 0 b -> exists r : set , r :e R /\ Rlt 0 r /\ Rlt r b /\ forall i j : set , i :e n -> j :e n -> i <> j -> open_ball R R_bounded_metric (apply_fun g i) r :/\: open_ball R R_bounded_metric (apply_fun g j) r = Empty.
Axiom finite_prefix_disjoint_balls_Q_bounded_inv_nat : forall g n : set , bijection omega Q g -> n :e omega -> exists r : set , r :e R /\ Rlt 0 r /\ Rlt r (inv_nat (ordsucc n)) /\ forall i j : set , i :e n -> j :e n -> i <> j -> open_ball R R_bounded_metric (apply_fun g i) r :/\: open_ball R R_bounded_metric (apply_fun g j) r = Empty.
Axiom ex48_9_Thomae_function : forall g : set , forall f : set , bijection omega Q g -> function_on f R R -> (forall n : set , n :e omega -> apply_fun f (apply_fun g n) = inv_nat (ordsucc n)) -> (forall x : set , x :e R -> x /:e Q -> apply_fun f x = 0) -> (forall x : set , x :e R -> x /:e Q -> continuous_at f x) /\ (forall q : set , q :e Q -> ~ continuous_at f q).
Axiom ex48_9_Thomae_function_pointwise_limit : forall g : set , forall f : set , bijection omega Q g -> function_on f R R -> (forall n : set , n :e omega -> apply_fun f (apply_fun g n) = inv_nat (ordsucc n)) -> (forall x : set , x :e R -> x /:e Q -> apply_fun f x = 0) -> exists fn : set , sequence_on fn (continuous_function_space R R_standard_topology R R_standard_topology) /\ pointwise_limit_metric R R R_bounded_metric fn f.
Axiom ex48_10_uniform_boundedness : forall X d : set , forall FF : set , complete_metric_space X d -> X <> Empty -> FF c= continuous_function_space X (metric_topology X d) R R_standard_topology -> (forall a : set , a :e X -> exists M : set , M :e R /\ forall f : set , f :e FF -> Rle (Abs (apply_fun f a)) M) -> exists U : set , exists M : set , U :e (metric_topology X d) /\ U <> Empty /\ M :e R /\ forall f : set , f :e FF -> forall x : set , x :e U -> Rle (Abs (apply_fun f x)) M.
Axiom ex48_11_Rl_Baire : Baire_space R R_lower_limit_topology.
Axiom ex48_12_RJ_Baire_box_product_uniform : forall J : set , Baire_space (power_real J) (box_topology J (const_space_family J R R_standard_topology)) /\ Baire_space (power_real J) (product_topology_full J (const_space_family J R R_standard_topology)) /\ Baire_space (power_real J) (uniform_topology_power_real J).
Definition fine_basic_neighborhood : set -> set -> set -> set -> set -> set -> set := fun X Tx Y d f delta => {g :e continuous_function_space X Tx Y (metric_topology Y d)|function_on d (setprod Y Y) R /\ forall x : set , x :e X -> Rlt (apply_fun d (apply_fun g x,apply_fun f x)) (apply_fun delta x)}.
Definition fine_subbasis : set -> set -> set -> set -> set := fun X Tx Y d => {B :e Power (continuous_function_space X Tx Y (metric_topology Y d))|exists f : set , f :e continuous_function_space X Tx Y (metric_topology Y d) /\ exists delta : set , continuous_map X Tx R R_standard_topology delta /\ (forall x : set , x :e X -> Rlt 0 (apply_fun delta x)) /\ B = fine_basic_neighborhood X Tx Y d f delta}.
Definition fine_topology : set -> set -> set -> set -> set := fun X Tx Y d => generated_topology_from_subbasis (continuous_function_space X Tx Y (metric_topology Y d)) (fine_subbasis X Tx Y d).
Axiom ex48_13_CXY_Baire_fine_topology : forall X Tx Y d : set , topology_on X Tx -> complete_metric_space Y d -> Baire_space (continuous_function_space X Tx Y (metric_topology Y d)) (fine_topology X Tx Y d).
Definition ex49_example1_f : set := Eps_i (fun f : set => f :e C_I_R).
Definition ex49_example1_g : set := Eps_i (fun g : set => g :e C_I_R).
Definition ex49_example1_k : set := Eps_i (fun k : set => k :e C_I_R).
Axiom C_I_R_nonempty : exists f : set , f :e C_I_R.
Axiom ex49_example1_f_in_C_I_R : ex49_example1_f :e C_I_R.
Axiom ex49_example1_g_in_C_I_R : ex49_example1_g :e C_I_R.
Axiom ex49_example1_k_in_C_I_R : ex49_example1_k :e C_I_R.
Axiom ex49_1_verify_example_functions : continuous_map unit_interval I_topology R R_standard_topology ex49_example1_f /\ continuous_map unit_interval I_topology R R_standard_topology ex49_example1_g /\ continuous_map unit_interval I_topology R R_standard_topology ex49_example1_k.
Axiom ex49_2_construct_bounded_function : forall n : set , forall eps : set , n :e omega -> 2 c= n -> eps :e R -> Rlt 0 eps -> exists f : set , continuous_map unit_interval I_topology R R_standard_topology f /\ (forall x : set , x :e unit_interval -> apply_fun f x :e R) /\ f :e U_n n /\ (forall x : set , x :e unit_interval -> Rle (Abs (apply_fun f x)) eps).
Definition ex50_dimension_exercises : set := {p :e Power (Power (Power (Power (Power (Power R)))))|exists X Tx n : set , p = setprod (setprod X Tx) n /\ topology_on X Tx /\ ordinal n}.
End Topology.

Section AlgTop.

(** ============================================================ **)
(** Chapter 9: The Fundamental Group                             **)
(** Formalizing Munkres Topology Chapters 9-14 (algtop.tex)      **)
(** ============================================================ **)

(** ============================================================ **)
(** S51 Homotopy of Paths                                        **)
(** ============================================================ **)

(** from S51 Definition (line 90 in algtop.tex): homotopy between continuous maps **)
(** LATEX VERSION: If f and f' are continuous maps of X into Y, f is homotopic to f' if there is a continuous map F: X x I -> Y with F(x,0)=f(x) and F(x,1)=f'(x). The map F is called a homotopy. **)
Definition homotopic_maps : set -> set -> set -> set -> set -> set -> prop :=
  fun X Tx Y Ty f f' =>
    continuous_map X Tx Y Ty f /\
    continuous_map X Tx Y Ty f' /\
    exists F:set,
      continuous_map (setprod X unit_interval)
        (product_topology X Tx unit_interval unit_interval_topology)
        Y Ty F /\
      (forall x:set, x :e X ->
        apply_fun F (x, 0) = apply_fun f x) /\
      (forall x:set, x :e X ->
        apply_fun F (x, 1) = apply_fun f' x).

(** from S51 Definition (line 96 in algtop.tex): nulhomotopic map **)
(** LATEX VERSION: If f is homotopic to f' and f' is a constant map, we say that f is nulhomotopic. **)
Definition nulhomotopic : set -> set -> set -> set -> set -> prop :=
  fun X Tx Y Ty f =>
    exists y0:set, y0 :e Y /\
      homotopic_maps X Tx Y Ty f (const_fun X y0).

(** from S51 Definition (line 104 in algtop.tex): path homotopy **)
(** LATEX VERSION: Two paths f and f' mapping I into X are path homotopic if they have the same initial point x0 and final point x1, and there is a continuous map F: I x I -> X with F(s,0)=f(s), F(s,1)=f'(s), F(0,t)=x0, F(1,t)=x1. **)
Definition path_homotopic : set -> set -> set -> set -> set -> set -> prop :=
  fun X Tx x0 x1 f f' =>
    continuous_map unit_interval unit_interval_topology X Tx f /\
    continuous_map unit_interval unit_interval_topology X Tx f' /\
    apply_fun f 0 = x0 /\ apply_fun f 1 = x1 /\
    apply_fun f' 0 = x0 /\ apply_fun f' 1 = x1 /\
    exists F:set,
      continuous_map unit_square unit_square_topology X Tx F /\
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 0) = apply_fun f s) /\
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 1) = apply_fun f' s) /\
      (forall t:set, t :e unit_interval ->
        apply_fun F (0, t) = x0) /\
      (forall t:set, t :e unit_interval ->
        apply_fun F (1, t) = x1).

(** Proven Bob **)
Theorem homotopic_maps_left_continuous : forall X Tx Y Ty f f':set,
  homotopic_maps X Tx Y Ty f f' ->
  continuous_map X Tx Y Ty f.
let X Tx Y Ty f f'.
assume H.
exact (andEL
  (continuous_map X Tx Y Ty f)
  (continuous_map X Tx Y Ty f')
  (andEL
    (continuous_map X Tx Y Ty f /\ continuous_map X Tx Y Ty f')
    (exists F:set,
      continuous_map (setprod X unit_interval)
        (product_topology X Tx unit_interval unit_interval_topology)
        Y Ty F /\
      (forall x:set, x :e X ->
        apply_fun F (x, 0) = apply_fun f x) /\
      (forall x:set, x :e X ->
        apply_fun F (x, 1) = apply_fun f' x))
    H)).
Qed.

(** Proven Bob **)
Theorem homotopic_maps_right_continuous : forall X Tx Y Ty f f':set,
  homotopic_maps X Tx Y Ty f f' ->
  continuous_map X Tx Y Ty f'.
let X Tx Y Ty f f'.
assume H.
exact (andER
  (continuous_map X Tx Y Ty f)
  (continuous_map X Tx Y Ty f')
  (andEL
    (continuous_map X Tx Y Ty f /\ continuous_map X Tx Y Ty f')
    (exists F:set,
      continuous_map (setprod X unit_interval)
        (product_topology X Tx unit_interval unit_interval_topology)
        Y Ty F /\
      (forall x:set, x :e X ->
        apply_fun F (x, 0) = apply_fun f x) /\
      (forall x:set, x :e X ->
        apply_fun F (x, 1) = apply_fun f' x))
    H)).
Qed.

(** Proven Bob **)
Theorem homotopic_maps_has_witness : forall X Tx Y Ty f f':set,
  homotopic_maps X Tx Y Ty f f' ->
  exists F:set,
